<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Sets the default environment to 'dv' in case it was not set -->
  <PropertyGroup>
    <Environment Condition="'$(Environment)' == ''">dev</Environment>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>true</DebugType>
  </PropertyGroup>

  <!-- Import the MSBuild Tasks -->
  <Import Project="$(MSBuildExtensionsPath)\MSBuildCommunityTasks\MSBuild.Community.Tasks.Targets" />
  <!-- Import the customized-by-project targets -->
  <Import Project="$(MSBuildProjectDirectory)\build.targets" />

  <!-- Add Using to report generation -->
  <UsingTask TaskName="ReportGenerator" AssemblyFile="$(ReportGeneratorTool)" />

  <!-- Build projects by calling the Project solution -->
  <Target Name="Build">
    <MSBuild Projects="$(ProjectSolution)" />
  </Target>

  <Target Name="Testing">
    <ItemGroup>
      <UnitTestProjects Include="$(NUnitProject)"/>
    </ItemGroup>

    <!--Build all the projects in UnitTestProjects-->
    <MSBuild Projects="$(UnitTestProjects)"/>
    <!--Execute the test cases, if any fail so will the build-->
    <!--<Message Text="*** Executing Unit Tests ***" />
    <NUnit Assemblies="@(UnitTestProjects)" ToolPath="$(NUnitToolPath)" ProjectConfiguration="Jenkins" DisableShadowCopy="true"/>-->

    <Message Text="*** Executing Unit Tests and Performing Test Coverage ***" />
    <Exec Command="&quot;$(OpenCoverTool)&quot; -register:administrator -filter:&quot;$(OpenCoverFilter)&quot; -target:&quot;$(NUnitToolPath)\nunit-console.exe&quot; -targetargs:&quot;/nologo /noshadow /config:Jenkins $(NUnitProject)&quot; -output:coverage.xml" />

    <!--Generate solution coverage report-->
    <RemoveDir Directories="report" />
    <ReportGenerator ReportFiles="coverage.xml" TargetDirectory="report/opencover" />
  </Target>
  
  <Target Name="Publish">
        <Message Text="Publicando Editor de WF $(ApplicationRevision)" />
        <MSBuild Projects="..\Molinos.Scato.WfEditorWeb\Molinos.Scato.WfEditorweb.csproj" Properties="Configuration=Jenkins" Targets="Publish"/>   

        <PropertyGroup>
    	    <YourDestinationDirectory>..\Molinos.Scato.Web\WfEditor</YourDestinationDirectory>
    	    <YourSourceDirectory>..\Molinos.Scato.WfEditorWeb\bin\Jenkins\app.publish</YourSourceDirectory>
        </PropertyGroup>
        <CreateItem Include="$(YourSourceDirectory)\**\*.*">
    		    <Output TaskParameter="Include" ItemName="YourFilesToCopy" />
    	  </CreateItem>
   
        <Message Text="Limpiamos archivos anteriores:" />
        <RemoveDir Directories="$(YourDestinationDirectory)"/>
        <MakeDir Directories="$(YourDestinationDirectory)" />
    
        <Message Text="Copiamos nuevos archivos en capa web:" />
        <Copy SourceFiles="@(YourFilesToCopy)"
    			DestinationFiles="@(YourFilesToCopy->'$(YourDestinationDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
  
        <Message Text="Clean project:" />
        <MSBuild Projects="..\Molinos.Scato.WfEditorWeb\Molinos.Scato.WfEditorWeb.csproj" Properties="Configuration=Jenkins" Targets="Clean"/>
    </Target>
  
  <Target Name="CIC">
    <CallTarget Targets="Publish"/>
    <CallTarget Targets="CR"/>
  </Target>

  <Target Name="CI">
    
    <Message Text="*** Performing build ***" />
    <CallTarget Targets="Build"/>

    <Message Text="*** Performing Testing ***" />
    <CallTarget Targets="Testing"/>

    <!-- Create Deploy directory -->
    <Message Text="*** Creating Output Directory ***"/>
    <RemoveDir Directories="$(OutputDir)"/>
    <MakeDir Directories="$(OutputDir)" />
    
    <!-- Copy the Package's files to Output Directory -->
    <Message Text="*** Copying files to Output Directory ***"/>
    <ItemGroup>
      <SourceFilesWeb Include="$(PackageWeb)"/>
      <SourceFilesServicios Include="$(PackageServicios)"/>
      <SourceFilesWorkflow Include="$(PackageWorkflow)"/>
      <SourceFilesWebMobile Include="$(PackageWebMobile)"/>
      <SourceFilesWebOperaciones Include="$(PackageWebOperaciones)"/>
      <SourceFilesModuloImpresor Include="$(PackageModuloImpresor)"/>
      <SourceFilesWebPuerto Include="$(PackageWebPuerto)"/>
      <SourceFilesWebPuertoApi Include="$(PackageWebPuertoApi)"/>

      <XamlxWorkflow Include="$(XamlxWorkflow)"/>
    </ItemGroup>

    <Copy SourceFiles="@(SourceFilesWeb)"
      DestinationFiles="@(SourceFilesWeb->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesServicios)"
      DestinationFiles="@(SourceFilesServicios->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWorkflow)"
      DestinationFiles="@(SourceFilesWorkflow->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebMobile)"
      DestinationFiles="@(SourceFilesWebMobile->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebOperaciones)"
      DestinationFiles="@(SourceFilesWebOperaciones->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesModuloImpresor)"
          DestinationFiles="@(SourceFilesModuloImpresor->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebPuerto)"
          DestinationFiles="@(SourceFilesWebPuerto->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebPuertoApi)"
          DestinationFiles="@(SourceFilesWebPuertoApi->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />

    <Message Text="*** Generando instaladores del Editor WF ***" />
    <Exec Command="..\Molinos.Scato.Build\WfEditor\build.bat" />
    
    <Message Text="*** Creating Output DirectoryPack ***"/>
    <MakeDir Directories="$(OutputPackDir)" />
    <MakeDir Directories="$(OutputPackEditorDir)" />
    <MakeDir Directories="$(OutputPackWebDir)" />
    <MakeDir Directories="$(OutputPackServiciosWebDir)" />
    <MakeDir Directories="$(OutputPackWorkflowDir)" />
    <MakeDir Directories="$(OutputPackReportsDir)" />
    <MakeDir Directories="$(OutputPackWebMobileDir)" />
    <MakeDir Directories="$(OutputPackWebOperacionesDir)" />
    <MakeDir Directories="$(OutputPackModuloImpresorDir)" />
    <MakeDir Directories="$(OutputPackWebPuertoDir)" />
    <MakeDir Directories="$(OutputPackWebPuertoApiDir)" />

    <ItemGroup>
      <ZipDir Include="$(ZipDir)"/>
      <CmdDir Include="$(CmdDir)"/>
    </ItemGroup>

    <Copy SourceFiles="@(ZipDir)" DestinationFiles="@(ZipDir->'$(OutputPackDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(CmdDir)" DestinationFiles="@(CmdDir->'$(OutputPackDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />

    <ItemGroup>
      <DeployParametersWeb Include="$(DeployParametersWeb)"/>
      <DeployParametersServicios Include="$(DeployParametersServicios)"/>
      <DeployParametersWorkflow Include="$(DeployParametersWorkflow)"/>
      <DeployParametersWebMobile Include="$(DeployParametersWebMobile)"/>
      <DeployParametersWebMobile Include="$(DeployParametersWebOperaciones)"/>    
      <DeployParametersModuloImpresor Include="$(DeployParametersModuloImpresor)"/>
      <DeployParametersWebPuerto Include="$(DeployParametersWebPuerto)"/>
      <DeployParametersWebPuerto Include="$(DeployParametersWebPuertoApi)"/>

    </ItemGroup>
    
    <Copy SourceFiles="@(DeployParametersWeb)" DestinationFiles="@(DeployParametersWeb->'$(OutputPackWebDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersServicios)" DestinationFiles="@(DeployParametersServicios->'$(OutputPackServiciosWebDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWorkflow)" DestinationFiles="@(DeployParametersWorkflow->'$(OutputPackWorkflowDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebMobile)" DestinationFiles="@(DeployParametersWebMobile->'$(OutputPackWebMobileDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebOperaciones)" DestinationFiles="@(DeployParametersWebOperaciones->'$(OutputPackWebOperacionesDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersModuloImpresor)" DestinationFiles="@(DeployParametersModuloImpresor->'$(OutputPackModuloImpresorDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebPuerto)" DestinationFiles="@(DeployParametersWebPuerto->'$(OutputPackWebPuertoDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebPuertoApi)" DestinationFiles="@(DeployParametersWebPuertoApi->'$(OutputPackWebPuertoApiDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />

    <ItemGroup>
      <QaMsiDir Include="$(QaMsiDir)"/>
      <ProdMsiDir Include="$(ProdMsiDir)"/>
    </ItemGroup>

    <Zip Files="@(QaMsiDir)" WorkingDirectory="$(MsiDir)" ZipFileName="$(OutputPackEditorDir)\%(Filename).zip" />
    <Zip Files="@(ProdMsiDir)" WorkingDirectory="$(MsiDir)" ZipFileName="$(OutputPackEditorDir)\%(Filename).zip" />

    <ItemGroup>
      <ReportsDir Include="$(ReportsDir)"/>
    </ItemGroup>

    <Copy SourceFiles="@(ReportsDir)" DestinationFiles="@(ReportsDir->'$(OutputPackReportsDir)\%(RecursiveDir)\%(Filename)%(Extension)')"
          Condition="$([MSBuild]::Subtract($([System.DateTime]::Now.Ticks) , $([System.DateTime]::Parse('%(ModifiedTime)').Ticks))) &lt; 18012202000000"/>

    <ItemGroup>
      <BatDir Include="$(BatDir)"/>
    </ItemGroup>
    <Copy SourceFiles="@(BatDir)" DestinationFiles="@(BatDir->'$(OutputPackDir)\%(RecursiveDir)\%(Filename)Prod%(Extension)')" />
    <Copy SourceFiles="@(BatDir)" DestinationFiles="@(BatDir->'$(OutputPackDir)\%(RecursiveDir)\%(Filename)Qa%(Extension)')" />

    <ItemGroup>
      <BatProdPackDir Include="$(OutputPackDir)\*Prod.bat"/>
      <BatQaPackDir Include="$(OutputPackDir)\*Qa.bat"/>
      <OutputPackDir Include="$(OutputPackDir)\**\*.*"/>
    </ItemGroup>

    <FileUpdate Files="@(BatProdPackDir)"
                Regex="(.*\\)([^\\]*)(.DeployParameters.xml&quot;)$"
                ReplacementText="$1VICSCATOPROD$3" />

    <FileUpdate Files="@(BatQaPackDir)"
                Regex="(.*\\)([^\\]*)(.DeployParameters.xml&quot;)$"
                ReplacementText="$1VICSCATOQA$3" />
    <Zip Files="@(OutputPackDir)" WorkingDirectory="$(OutputPackDir)" ZipFileName="$(OutputPackDir).zip" />

    <!--<RemoveDir Directories="$(OutputPackDir)"/>-->
    <!-- Finish Build-->
    <Message Text="*** Build Finished ***" />
  </Target>

  <Target Name="CR">

    <Message Text="*** Performing build ***" />
    <CallTarget Targets="Build"/>

    <!-- Create Deploy directory -->
    <Message Text="*** Creating Output Directory ***"/>
    <RemoveDir Directories="$(OutputDir)"/>
    <MakeDir Directories="$(OutputDir)" />

    <!-- Copy the Package's files to Output Directory -->
    <Message Text="*** Copying files to Output Directory ***"/>
    <ItemGroup>
      <SourceFilesWeb Include="$(PackageWeb)"/>
      <SourceFilesServicios Include="$(PackageServicios)"/>
      <SourceFilesWorkflow Include="$(PackageWorkflow)"/>
      <SourceFilesWebMobile Include="$(PackageWebMobile)"/>
      <SourceFilesWebOperaciones Include="$(PackageWebOperaciones)"/>
      <SourceFilesModuloImpresor Include="$(PackageModuloImpresor)"/>
      <SourceFilesWebPuerto Include="$(PackageWebPuerto)"/>
      <SourceFilesWebPuertoApi Include="$(PackageWebPuertoApi)"/>

      <XamlxWorkflow Include="$(XamlxWorkflow)"/>
    </ItemGroup>

    <Copy SourceFiles="@(SourceFilesWeb)"
      DestinationFiles="@(SourceFilesWeb->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesServicios)"
      DestinationFiles="@(SourceFilesServicios->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWorkflow)"
      DestinationFiles="@(SourceFilesWorkflow->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebMobile)"
      DestinationFiles="@(SourceFilesWebMobile->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebOperaciones)"
      DestinationFiles="@(SourceFilesWebOperaciones->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesModuloImpresor)"
          DestinationFiles="@(SourceFilesModuloImpresor->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebPuerto)"
          DestinationFiles="@(SourceFilesWebPuerto->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SourceFilesWebPuertoApi)"
          DestinationFiles="@(SourceFilesWebPuertoApi->'$(OutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="*** Generando instaladores del Editor WF ***" />
    <Exec Command="..\Molinos.Scato.Build\WfEditor\build.bat" />

    <Message Text="*** Creating Output DirectoryPack ***"/>
    <MakeDir Directories="$(OutputPackDir)" />
    <MakeDir Directories="$(OutputPackEditorDir)" />
    <MakeDir Directories="$(OutputPackWebDir)" />
    <MakeDir Directories="$(OutputPackServiciosWebDir)" />
    <MakeDir Directories="$(OutputPackWorkflowDir)" />
    <MakeDir Directories="$(OutputPackReportsDir)" />
    <MakeDir Directories="$(OutputPackWebMobileDir)" />
    <MakeDir Directories="$(OutputPackWebOperacionesDir)" />
    <MakeDir Directories="$(OutputPackModuloImpresorDir)" />
    <MakeDir Directories="$(OutputPackWebPuertoDir)" />
    <MakeDir Directories="$(OutputPackWebPuertoApiDir)" />
    
    <ItemGroup>
      <DeployParametersWeb Include="$(DeployParametersWeb)"/>
      <DeployParametersServicios Include="$(DeployParametersServicios)"/>
      <DeployParametersWorkflow Include="$(DeployParametersWorkflow)"/>
      <DeployParametersWebMobile Include="$(DeployParametersWebMobile)"/>
      <DeployParametersWebOperaciones Include="$(DeployParametersWebOperaciones)"/>
      <DeployParametersModuloImpresor Include="$(DeployParametersModuloImpresor)"/>
      <DeployParametersWebPuerto Include="$(DeployParametersWebPuerto)"/>
      <DeployParametersWebPuertoApi Include="$(DeployParametersWebPuertoApi)"/>
    </ItemGroup>

    <Copy SourceFiles="@(DeployParametersWeb)" DestinationFiles="@(DeployParametersWeb->'$(OutputPackWebDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersServicios)" DestinationFiles="@(DeployParametersServicios->'$(OutputPackServiciosWebDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWorkflow)" DestinationFiles="@(DeployParametersWorkflow->'$(OutputPackWorkflowDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebMobile)" DestinationFiles="@(DeployParametersWebMobile->'$(OutputPackWebMobileDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebOperaciones)" DestinationFiles="@(DeployParametersWebOperaciones->'$(OutputPackWebOperacionesDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersModuloImpresor)" DestinationFiles="@(DeployParametersModuloImpresor->'$(OutputPackModuloImpresorDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebPuerto)" DestinationFiles="@(DeployParametersWebPuerto->'$(OutputPackWebPuertoDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployParametersWebPuertoApi)" DestinationFiles="@(DeployParametersWebPuertoApi->'$(OutputPackWebPuertoApiDir)\%(RecursiveDir)\%(Filename)%(Extension)')" />

    <ItemGroup>
      <ReportsDir Include="$(ReportsDir)"/>
    </ItemGroup>

    <Copy SourceFiles="@(ReportsDir)" DestinationFiles="@(ReportsDir->'$(OutputPackReportsDir)\%(RecursiveDir)\%(Filename)%(Extension)')"
          Condition="$([MSBuild]::Subtract($([System.DateTime]::Now.Ticks) , $([System.DateTime]::Parse('%(ModifiedTime)').Ticks))) &lt; 18012202000000"/>

    <ItemGroup>
      <BatDir Include="$(BatDir)"/>
    </ItemGroup>
    <Copy SourceFiles="@(BatDir)" DestinationFiles="@(BatDir->'$(OutputPackDir)\%(RecursiveDir)\%(Filename)Prod%(Extension)')" />
    <Copy SourceFiles="@(BatDir)" DestinationFiles="@(BatDir->'$(OutputPackDir)\%(RecursiveDir)\%(Filename)Qa%(Extension)')" />

    <ItemGroup>
      <BatProdPackDir Include="$(OutputPackDir)\*Prod.bat"/>
      <BatQaPackDir Include="$(OutputPackDir)\*Qa.bat"/>
      <OutputPackDir Include="$(OutputPackDir)\**\*.*"/>
    </ItemGroup>

    <FileUpdate Files="@(BatProdPackDir)"
                Regex="(.*\\)([^\\]*)(.DeployParameters.xml&quot;)$"
                ReplacementText="$1VICSCATOPROD$3" />

    <FileUpdate Files="@(BatQaPackDir)"
                Regex="(.*\\)([^\\]*)(.DeployParameters.xml&quot;)$"
                ReplacementText="$1VICSCATOQA$3" />
    <!--<RemoveDir Directories="$(OutputPackDir)"/>-->
    <!-- Finish Build-->
    <Message Text="*** Build Finished ***" />
  </Target>
  
  
</Project>