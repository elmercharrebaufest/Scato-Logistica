<Window xmlns:Views="clr-namespace:Molinos.Scato.WfEditor.Views"  x:Class="Molinos.Scato.WfEditor.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Molinos.Scato.WfEditor.Properties"
        xmlns:toolbox="clr-namespace:System.Activities.Presentation.Toolbox;assembly=System.Activities.Presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Molinos.Scato.WfEditor.Conversores" mc:Ignorable="d"
        Title="{Binding Path=Titulo, Mode=OneTime}" Height="350" Width="525" WindowState="Maximized" 
        DataContext="{Binding Path=MainWindowViewModel, Source={StaticResource ViewModelLocator}}" >
    
    <Window.Resources>
        <ResourceDictionary>
            <local:BooleanoATipoErrorConverter x:Key="BooleanoATipoErrorConverter" />
        </ResourceDictionary>
    </Window.Resources>
    
    <Window.InputBindings>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="{x:Static properties:Resources.MenuArchivo}">
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoNuevo}" Command="{Binding Path=NuevoWorkflowCommand}" />
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoAbrir}" Command="{Binding Path=AbrirWorkflowCommand}" />
                <Separator/>
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoGuardar}" Command="{Binding Path=GuardarWorkflowCommand}" />
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoGuardarActivar}" Command="{Binding Path=GuardarActivarWorkflowCommand}" />
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoGuardarComo}" Command="{Binding Path=GuardarWorkflowComoCommand}" />
                <Separator/>
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoActivarDesactivar}" Command="{Binding Path=ActivarDesactivarWorkflowCommand}" />
                <Separator/>
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoCerrar}" Command="{Binding Path=CerrarWorkflowCommand}" />
                <Separator/>
                <MenuItem Header="{x:Static properties:Resources.MenuArchivoSalir}" Command="{Binding Path=SalirCommand}" />
            </MenuItem>
        </Menu>
        
        <Grid Grid.Row="1" x:Name="DesignerGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <toolbox:ToolboxControl Grid.Column="0" x:Name="Toolbox" />
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center"
              VerticalAlignment="Stretch" ShowsPreview="True" Width="5" />
            <ContentControl Grid.Column="2" Content="{Binding Path=DesignerView}" />
            <GridSplitter Grid.Column="3" HorizontalAlignment="Center" 
              VerticalAlignment="Stretch" ShowsPreview="True" Width="5" />
            <ContentControl Grid.Column="4" Content="{Binding Path=PropertyInspectorView}" />
        </Grid>
        <GridSplitter Grid.Row="2"  VerticalAlignment="Center" 
              HorizontalAlignment="Stretch" ShowsPreview="True" Height="5" />
        <DataGrid Grid.Row="3" AutoGenerateColumns="False" ItemsSource="{Binding Path=ErroresValidacion, Mode=OneWay}" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static properties:Resources.ErrorId}" Binding="{Binding Id}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static properties:Resources.ErrorTipo}" Binding="{Binding IsWarning, Converter={StaticResource BooleanoATipoErrorConverter}}" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ErrorMensaje}" Binding="{Binding Message}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Name="TextoStatus" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
