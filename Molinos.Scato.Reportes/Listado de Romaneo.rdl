<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>be74aac9-14c7-4bc9-89a3-b5ef19d061ae</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Workflows">
            <Value>=Parameters!Workflows.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Almacen">
            <Value>=Parameters!Almacen.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=Parameters!TipoComercial.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ClienteId">
            <Value>=Parameters!ClienteId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @CentroIdp INT,
		@Materialp INT,
		@Workflowsp INT,
		@Almacenp INT,
		@TipoComercialp INT,
		@FechaDesdep DATETIME,
		@FechaHastap DATETIME,
		@ClienteIdp INT

SET		@CentroIdp = @CentroId
SET		@Materialp = @Material
SET		@Workflowsp = @Workflows
SET		@Almacenp = @Almacen
SET		@TipoComercialp = @TipoComercial
SET		@FechaDesdep = @FechaDesde
SET		@FechaHastap = @FechaHasta
SET		@ClienteIdp = @ClienteId

SELECT WF.descripcion                        AS Circuito, 
       (CASE TWF.Id WHEN 0 THEN 'E' WHEN 1 THEN 'S' END) AS ES, 
       MAT.descripcion                       AS Material, 
       isnull( ALM.descripcion, '') AS Almacen, 
       Count(RE.id)                       AS Cantidad, 
       RE.pesobruto                  AS PesoBruto, 
       RE.pesobruto - RE.pesotara AS PesoNeto,
       CEN.CodigoSAP AS CentroSap,
       (CASE RE.TipoDocumentoIngreso 
			WHEN 0 THEN (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE (SELECT Orden.Destino_Id FROM OrdenCargaInterna AS Orden WHERE Orden.Recorrido_Id = RE.Id) = Cliente.Id)
			WHEN 1 THEN (CASE WHEN CP.CentroDestino_Id IS NOT NULL THEN (SELECT Centro.Descripcion FROM Centro WITH (NOLOCK) WHERE CP.CentroDestino_Id = Centro.Id) ELSE (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE CP.ClienteDestino_Id = Cliente.Id) END)
			WHEN 2 THEN CEN.Descripcion
			WHEN 3 THEN (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE (SELECT Orden.Cliente_Id FROM OrdenCargaFas AS Orden WITH (NOLOCK) WHERE Orden.Recorrido_Id = RE.Id) = Cliente.Id)
			WHEN 4 THEN CEN.Descripcion
			WHEN 5 THEN (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE (SELECT Orden.Cliente_Id FROM OrdenCargaInternaFason AS Orden WITH (NOLOCK) WHERE Orden.Recorrido_Id = RE.Id) = Cliente.Id)
			WHEN 6 THEN (SELECT Centro.Descripcion FROM Centro WITH (NOLOCK) WHERE (SELECT Orden.CentroDestino_Id FROM OrdenEntrePlantas AS Orden WITH (NOLOCK) WHERE Orden.Recorrido_Id = RE.Id) = Centro.Id)
			WHEN 7 THEN CEN.Descripcion
			ELSE ''
       END) AS Destino,
	   SUM((CASE
	        WHEN APC.DescuentoEnPorcentaje IS NULL 
			THEN ((RE.PesoBruto - RE.PesoTara) * CPC.DescuentoEnPorcentaje / 100)
			ELSE ((RE.PesoBruto - RE.PesoTara) * APC.DescuentoEnPorcentaje / 100)
			END)) AS Descuento,
       RE.NumeroDocumentoIngreso	AS   DocumentoIngreso,
	  (CASE
	   WHEN MAT.CodigoSAP = '19908027' THEN CASE WHEN CP.TrigoEspecial = 1 THEN 'Sustentable' ELSE 'Normal' END
	   WHEN MAT.CodigoSAP = '19908017' THEN CASE WHEN Re.Establecimiento_Id IS NOT NULL THEN 'Sustentable' ELSE 'Normal' END
	   ELSE 'Normal'
	   END) AS Calidad,
	  isnull(  (CASE RE.TipoDocumentoIngreso 
			WHEN 0 THEN (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE (SELECT Orden.Destino_Id FROM OrdenCargaInterna AS Orden WHERE Orden.Recorrido_Id = RE.Id) = Cliente.Id)
			WHEN 1 THEN (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE CP.ClienteDestino_Id = Cliente.Id)
			WHEN 3 THEN (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE (SELECT Orden.Cliente_Id FROM OrdenCargaFas AS Orden WITH (NOLOCK) WHERE Orden.Recorrido_Id = RE.Id) = Cliente.Id)
			WHEN 5 THEN (SELECT Cliente.Descripcion COLLATE SQL_Latin1_General_CP1_CI_AS FROM Cliente WITH (NOLOCK) WHERE (SELECT Orden.Cliente_Id FROM OrdenCargaInternaFason AS Orden WITH (NOLOCK) WHERE Orden.Recorrido_Id = RE.Id) = Cliente.Id)
			ELSE ''
       END) ,'')as Cliente

FROM   Recorrido RE WITH (NOLOCK)
       INNER JOIN dbo.workflow WF WITH (NOLOCK)
              ON (RE.workflow_id = WF.id)
       INNER JOIN dbo.tipodeworkflow TWF WITH (NOLOCK)
              ON WF.tipodeworkflow = TWF.id 
       LEFT JOIN dbo.almacen ALM WITH (NOLOCK)
              ON RE.almacen_id = ALM.id 
       INNER JOIN dbo.centro CEN WITH (NOLOCK)
              ON RE.centro_id = CEN.id 
       LEFT JOIN dbo.material MAT WITH (NOLOCK)
              ON RE.material_id = MAT.id
	   LEFT JOIN dbo.Calado CAL WITH (NOLOCK)
			  ON RE.Calado_Id = CAL.Id
	   LEFT JOIN dbo.AnalisisDeCalidad ADC WITH (NOLOCK)
			  ON ADC.Calado_Id = CAL.Id
	   LEFT JOIN [CaladoPorCaracteristica] CPC WITH (NOLOCK)
			  ON CAL.[Id] = CPC.[Calado_Id] AND ADC.[Id] IS NULL
	   LEFT JOIN [AnalisisPorCaracteristica] APC WITH (NOLOCK)
			  ON ADC.[Id] = APC.[AnalisisDeCalidad_Id]
	   LEFT JOIN Vehiculo v WITH (NOLOCK)
		      ON RE.Vehiculo_Id = v.Id
	   LEFT JOIN CartaPorte CP WITH (NOLOCK)
			  ON v.CartaPorte_Id = CP.Id
	   INNER JOIN TipoComercial TC WITH (NOLOCK)
			  ON TC.Id = RE.TipoComercial_Id
			  
               
WHERE 
	  ((MAT.Id = @Materialp and @Materialp&gt;0 )or @Materialp IS NULL or (@Materialp =-1 and Mat.EsGrano =0) or (@Materialp =-2 and Mat.EsGrano =1)) AND
	  (CEN.Id = @CentroIdp)   AND
	  (WF.Id = @Workflowsp or @Workflowsp IS NULL) AND
	  (ALM.Id = @Almacenp or @Almacenp IS NULL) AND
	  (TC.Id = @TipoComercialp or @TipoComercialp IS NULL) AND
	   RE.Rechazado = 0 AND RE.Terminado = 1 AND
	  ((WF.TipoDeWorkflow = 0 AND RE.PesoTaraFecha IS NOT NULL AND RE.PesoTaraFecha &gt;= @FechaDesdep AND RE.PesoTaraFecha &lt;= @FechaHastap)
	  or (WF.TipoDeWorkflow = 1 AND RE.PesoBrutoFecha IS NOT NULL AND RE.PesoBrutoFecha &gt;= @FechaDesdep AND RE.PesoBrutoFecha &lt;= @FechaHastap))  AND
	 ( @ClienteIdp  IS NULL or (CASE RE.TipoDocumentoIngreso 
			WHEN 0 THEN (SELECT Orden.Destino_Id FROM OrdenCargaInterna AS Orden WHERE Orden.Recorrido_Id = RE.Id)
			WHEN 1 THEN (CP.ClienteDestino_Id)
			WHEN 3 THEN (SELECT Orden.Cliente_Id FROM OrdenCargaFas AS Orden WITH (NOLOCK) WHERE Orden.Recorrido_Id = RE.Id)
			WHEN 5 THEN (SELECT Cliente.Id  FROM Cliente WITH (NOLOCK) WHERE (SELECT Orden.Cliente_Id FROM OrdenCargaInternaFason AS Orden WITH (NOLOCK) WHERE Orden.Recorrido_Id = RE.Id) = Cliente.Id)
			ELSE ''
       END)=@ClienteIdp)


GROUP  BY WF.Descripcion, 
		  WF.Id,
          TWF.Id, 
          MAT.Descripcion,
          ALM.Descripcion,
          CEN.Descripcion,
          CEN.CodigoSAP,
          RE.PesoBruto, 
          RE.PesoBruto - RE.PesoTara,
          RE.NumeroDocumentoIngreso,
          RE.TipoDocumentoIngreso,
          CP.CentroDestino_Id,
          CP.ClienteDestino_Id,
          WF.TipoDeWorkflow,
          RE.Id,
          MAT.CodigoSAP,
          CP.TrigoEspecial,
          RE.Establecimiento_Id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FechaDesde">
          <DataField>FechaDesde</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Circuito">
          <DataField>Circuito</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaHasta">
          <DataField>FechaHasta</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="ES">
          <DataField>ES</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Almacen">
          <DataField>Almacen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cantidad">
          <DataField>Cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PesoBruto">
          <DataField>PesoBruto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PesoNeto">
          <DataField>PesoNeto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Destino">
          <DataField>Destino</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descuento">
          <DataField>Descuento</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="DocumentoIngreso">
          <DataField>DocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Calidad">
          <DataField>Calidad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cliente">
          <DataField>Cliente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Material, ' ' AS ord
UNION
SELECT        -1 AS Id, 'No Grano' AS Material, ' ' AS ord
UNION
SELECT        -2 AS Id, 'Granos' AS Material, ' ' AS ord
UNION
SELECT        Material.Id AS Id, Descripcion AS Material, Descripcion AS ord
FROM            Material WITH (NOLOCK) 
INNER JOIN Recorrido WITH (NOLOCK) 
                               ON (Material_Id = Material.Id) AND (Centro_Id = @CentroId) AND TERMINADO = 1

ORDER BY ord</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Workflows">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Workflow, '0' AS ord
UNION
SELECT        Id, Descripcion AS Workflow, Descripcion AS ord
FROM            Workflow WITH (NOLOCK) 
WHERE        (Centro_Id = @CentroId)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Workflow">
          <DataField>Workflow</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Centro.CodigoSap as CentroSap,
              Centro.Descripcion as CentroDescripcion

FROM [Centro] as Centro WITH (NOLOCK) 

WHERE Centro.Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Almacenes">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Almacen, '0' AS ord
UNION
SELECT        Id, Descripcion AS Almacen, Descripcion AS ord
FROM          Almacen WITH (NOLOCK) 
WHERE         Centro_Id = @CentroId
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Almacen">
          <DataField>Almacen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposComerciales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT NULL AS Id, 'Todos' AS TipoComercial, '0' AS ord
UNION
Select Id, Descripcion as TipoComercial, Descripcion AS ord from TipoComercial
WITH (NOLOCK) 
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Clientes">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT NULL AS Id, 'Todos' AS Descripcion, '0' AS ord
UNION
Select Id, Descripcion as TipoComercial, Descripcion AS ord from Cliente
WITH (NOLOCK) 
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
