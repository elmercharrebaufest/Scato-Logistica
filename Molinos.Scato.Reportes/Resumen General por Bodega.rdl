  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>731bbbef-abcd-42a7-a7ad-a782b02222b9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Vinedo">
            <Value>=Parameters!Viñedo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Bodegas">
            <Value>=Parameters!Bodegas.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaDesdep DATETIME,
		@FechaHastap DATETIME,
		@Vinedop INT

SET		@FechaDesdep = @FechaDesde
SET		@FechaHastap = @FechaHasta
SET		@Vinedop = @Vinedo

SELECT        c.NumeroINV + ' - ' + c.Descripcion AS Bodega, r.Centro_Id, MIN(CAST(r.NumeroCiu AS Int)) AS PrimerCIU, MAX(CAST(r.NumeroCiu AS Int)) AS UltimoCiu, SUM(r.PesoBruto - r.PesoTaraBodega) AS Total, 
                         SUM((r.PesoBruto - r.PesoTaraBodega) * (CASE WHEN ancar.valoranalisis IS NULL THEN calcar.valorcalado ELSE ancar.valoranalisis END)) / SUM(r.PesoBruto - r.PesoTaraBodega) AS Azucar
FROM            Recorrido AS r WITH (NOLOCK) INNER JOIN
                         Centro AS c WITH (NOLOCK) ON r.Centro_Id = c.Id INNER JOIN
                         RemitoBodegaUva AS remito WITH (NOLOCK) ON r.Id = remito.Recorrido_Id LEFT OUTER JOIN
                         AnalisisDeCalidad WITH (NOLOCK) ON AnalisisDeCalidad.Calado_Id = r.Calado_Id LEFT OUTER JOIN
                         CaladoPorCaracteristica AS calcar WITH (NOLOCK) ON calcar.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH (NOLOCK)
                               WHERE        (Id = calcar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
                         AnalisisPorCaracteristica AS ancar ON ancar.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH (NOLOCK)
                               WHERE        (Id = ancar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1))
WHERE        (r.Rechazado &lt;&gt; 1) AND (r.Terminado = 1) AND (r.FechaInicio IS NOT NULL) AND (@FechaDesdep &lt;= r.FechaInicio) AND (@FechaHastap &gt;= r.FechaInicio) AND (@Vinedop = remito.Vinedo_Id OR
                         @Vinedop = 0) AND (r.Centro_Id IN (@Bodegas))
GROUP BY r.Centro_Id, c.NumeroINV, c.Descripcion
HAVING        (c.NumeroINV IS NOT NULL)</CommandText>
      </Query>
      <Fields>
        <Field Name="Bodega">
          <DataField>Bodega</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Centro_Id">
          <DataField>Centro_Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PrimerCIU">
          <DataField>PrimerCIU</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="UltimoCiu">
          <DataField>UltimoCiu</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Total">
          <DataField>Total</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Azucar">
          <DataField>Azucar</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NumeroINV + ' - ' + Descripcion AS Bodega, Id,Descripcion as ord
FROM            Centro WITH (NOLOCK)
WHERE        (NumeroINV IS NOT NULL)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Bodega">
          <DataField>Bodega</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Id, NumeroINV + ' - ' + Descripcion AS Descripcion,Descripcion as ord
FROM            Vinedo WITH (NOLOCK)
UNION
SELECT        0 AS Expr1, 'TODOS' AS Expr2, '' as ord
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
