<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4abcad8d-0935-4650-8674-91d97e2779ce</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Almacen">
            <Value>=Parameters!Almacen.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaHora_Desde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHora_Hasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
	[Material].Descripcion as Material,
	[Almacen].Descripcion as Almacen,
	Recorrido.FechaInicio,
	[Material].TipoDeGrano AS TipoDeGrano,
	[Transportista].Cuit as Transportista,
	CartaPorte.NroCartaPorte,
	(CASE 
      WHEN WorkFlow.TipoDeWorkflow = 0 THEN Recorrido.PesoBruto - Recorrido.PesoTara
      ELSE (Recorrido.PesoBruto - Recorrido.PesoTara) * -1
	END) as PesoNeto,
	(CASE 
      WHEN AnalisisPorCaracteristica.DescuentoEnKg IS NULL THEN CaladoPorCaracteristica.DescuentoEnKg
      ELSE AnalisisPorCaracteristica.DescuentoEnKg
	END)as 'Descuentos por Humedad',
	Centro.Descripcion as Centro,
	Centro.Id as CentroId,
	DAY(Recorrido.FechaInicio) as 'Dia',
	MONTH(Recorrido.FechaInicio) as 'Mes'
FROM [Recorrido] with (nolock)

INNER JOIN [Material] with (nolock)
  ON [Recorrido].[Material_Id] = [Material].Id

INNER JOIN [Transportista] with (nolock)
  ON [Recorrido].Transportista_Id = [Transportista].Id
  
INNER JOIN [Almacen] with (nolock)
  ON Almacen.Id = [Recorrido].Almacen_Id
  
INNER JOIN  [Vehiculo] with (nolock)
  ON Recorrido.Vehiculo_Id = [Vehiculo].Id

INNER JOIN  [CartaPorte] with (nolock)
  ON [Vehiculo].CartaPorte_Id = [CartaPorte].Id
  
INNER JOIN [Workflow] as WorkFlow with (nolock)
  ON [Recorrido].Workflow_Id = WorkFlow.Id
   
INNER JOIN Centro with (nolock)
  ON [Recorrido].Centro_Id = Centro.Id

LEFT JOIN AnalisisDeCalidad with (nolock)
  ON AnalisisDeCalidad.Calado_Id = [Recorrido].Calado_Id
   
LEFT JOIN CaladoPorCaracteristica with (nolock)
  ON CaladoPorCaracteristica.Calado_Id = [Recorrido].Calado_Id AND EXISTS (select 1 from CaracteristicaDeCalidad with (nolock) where CaracteristicaDeCalidad.Id = CaladoPorCaracteristica.CaracteristicaDeCalidad_Id AND EsHumedad = 1)
  
LEFT JOIN AnalisisPorCaracteristica with (nolock)
  ON AnalisisPorCaracteristica.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id  AND EXISTS (select 1 from CaracteristicaDeCalidad with (nolock) where CaracteristicaDeCalidad.Id = AnalisisPorCaracteristica.CaracteristicaDeCalidad_Id AND EsHumedad = 1)

where Centro.Id=@Centro and (@Material ='' or Material.Descripcion like '%'+@Material+'%') and
(@Almacen ='' or Almacen.Descripcion like '%'+@Almacen+'%')
and (@FechaDesde is null or @FechaDesde &lt;= Recorrido.FechaInicio)
and (@FechaHasta is null or @FechaHasta &gt;= Recorrido.FechaInicio)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Almacen">
          <DataField>Almacen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaInicio">
          <DataField>FechaInicio</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TipoDeGrano">
          <DataField>TipoDeGrano</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Transportista">
          <DataField>Transportista</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NroCartaPorte">
          <DataField>NroCartaPorte</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PesoNeto">
          <DataField>PesoNeto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descuentos_por_Humedad">
          <DataField>Descuentos por Humedad</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Dia">
          <DataField>Dia</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Mes">
          <DataField>Mes</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Id, Descripcion
FROM            Centro WITH (NOLOCK)
order by Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
