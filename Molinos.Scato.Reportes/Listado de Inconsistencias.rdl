<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5667d4be-b261-46c9-806a-111a89818a43</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoraEgreso_Desde">
            <Value>=Parameters!FechaHoraEgreso_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraEgreso_Hasta">
            <Value>=Parameters!FechaHoraEgreso_Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=Parameters!TipoComercial.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @Centrop int,@Materialp int,@TipoComercialp int,
@FechaHoraEgreso_Desdep datetime, @FechaHoraEgreso_Hastap datetime


set @Centrop= @Centro
set @Materialp=@Material
set @TipoComercialp=@TipoComercial
set @FechaHoraEgreso_Desdep =@FechaHoraEgreso_Desde
set @FechaHoraEgreso_Hastap =@FechaHoraEgreso_Hasta

SELECT        TipoDocumentoIngreso.Descripcion, R.NumeroDocumentoIngreso, R.Patente, Material.Descripcion AS Material, TipoComercial.Descripcion AS TipoComercial, R.FechaEgreso, 
                         FuncionSap.Descripcion AS 'FuncionSap', (CASE transmisionasap.estado WHEN 1 THEN 'No' WHEN 2 THEN 'Si' END) AS Estado, Centro.Descripcion AS Centro, Centro.Id AS CentroId, 
                         TransmisionASap.MensajeError AS 'Mensaje de Error', Material.Id AS MaterialId, TipoComercial.Id AS TipoComercialId
FROM            TransmisionASap INNER JOIN
                         Recorrido AS R WITH (NOLOCK) ON R.InstanciaWorkflow = TransmisionASap.InstanciaWorkflow INNER JOIN
                         Vehiculo AS V WITH (NOLOCK) ON R.Vehiculo_Id = V.Id INNER JOIN
                         CartaPorte WITH (NOLOCK) ON V.CartaPorte_Id = CartaPorte.Id INNER JOIN
                         Material WITH (NOLOCK) ON Material.Id = R.Material_Id INNER JOIN
                         TipoComercial WITH (NOLOCK) ON TipoComercial.Id = R.TipoComercial_Id INNER JOIN
                         Centro WITH (NOLOCK) ON R.Centro_Id = Centro.Id INNER JOIN
                         TipoDocumentoIngreso WITH (NOLOCK) ON TipoDocumentoIngreso.Id = R.TipoDocumentoIngreso INNER JOIN
                         FuncionSap WITH (NOLOCK) ON FuncionSap.Id = TransmisionASap.FuncionSap
WHERE        (TransmisionASap.Estado = 1 OR
                         TransmisionASap.Estado = 2) AND (@FechaHoraEgreso_Desdep &lt;= R.FechaEgreso) AND (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND (Material.Id = @Materialp) AND (TipoComercial.Id = @TipoComercialp) 
                         AND (@Centrop = R.Centro_Id) OR
                         (TransmisionASap.Estado = 1 OR
                         TransmisionASap.Estado = 2) AND (@FechaHoraEgreso_Desdep &lt;= R.FechaEgreso) AND (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND (TipoComercial.Id = @TipoComercialp) AND (@Centrop = R.Centro_Id) 
                         AND (@Materialp IS NULL) OR
                         (TransmisionASap.Estado = 1 OR
                         TransmisionASap.Estado = 2) AND (@FechaHoraEgreso_Desdep &lt;= R.FechaEgreso) AND (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND (Material.Id = @Materialp) AND (@Centrop = R.Centro_Id) AND 
                         (@TipoComercialp IS NULL) OR
                         (TransmisionASap.Estado = 1 OR
                         TransmisionASap.Estado = 2) AND (@FechaHoraEgreso_Desdep &lt;= R.FechaEgreso) AND (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND (@Centrop = R.Centro_Id) AND (@Materialp IS NULL) AND 
                         (@TipoComercialp IS NULL)</CommandText>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NumeroDocumentoIngreso">
