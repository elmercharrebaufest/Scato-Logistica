        </Field>
        <Field Name="FechaCierre">
          <DataField>FechaCierre</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Estado">
          <DataField>Estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RemitoNro">
          <DataField>RemitoNro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="KgDeclarados">
          <DataField>KgDeclarados</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FechaRemito">
          <DataField>FechaRemito</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PesoBruto">
          <DataField>PesoBruto</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PesoTara">
          <DataField>PesoTara</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PesoNeto">
          <DataField>PesoNeto</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
