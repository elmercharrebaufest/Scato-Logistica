<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5dccdd17-a752-48c4-989e-9e768843ce04</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoDesde">
            <Value>=Parameters!FechaIngresoDesde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoHasta">
            <Value>=Parameters!FechaIngresoHasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int, @FechaIngresoDesdep datetime, @FechaIngresoHastap datetime


set @CentroIdp = @CentroId
set @FechaIngresoDesdep = @FechaIngresoDesde
set @FechaIngresoHastap = @FechaIngresoHasta

SELECT RE.fechainicio                         AS FechaIngreso, 
       RO.id                                  AS RomaneoNro, 
       RO.nropedido                           AS PedidoNro, 
       RE.id                                  AS IngresoNro, 
       RE.patente                             AS Patente, 
       PRO.descripcion                        AS Proveedor, 
       RO.FechaInicio                             AS FechaInicio, 
       RO.FechaCierre                              AS FechaCierre, 
       ESTROM.descripcion                     AS Estado, 
       RE.numerodocumentoingreso              AS RemitoNro, 
       RE.pesobrutoorigen - RE.pesotaraorigen AS KgDeclarados, 
       OD.fechamovimiento                    AS FechaRemito, 
       Sum(RITEM.pesobruto)                   AS PesoBruto,
       Sum(RITEM.pesotara)                    AS PesoTara,
       Sum(RITEM.pesobruto - RITEM.pesotara)  AS PesoNeto,
       RE.Centro_Id As CentroId
FROM   romaneo RO with (NOLOCK)
       LEFT JOIN recorrido RE with (NOLOCK)
               ON RO.workflowinstanceid = RE.instanciaworkflow 
       LEFT JOIN OrdenDeDescarga OD with (NOLOCK)
               ON OD.Numero = RE.numerodocumentoingreso 
       LEFT JOIN proveedor PRO with (NOLOCK)
               ON OD.proveedor_id = PRO.id 
       LEFT JOIN estadoromaneo ESTROM with (NOLOCK)
               ON ESTROM.id = RO.estado 
       LEFT JOIN romaneoitem RITEM with (NOLOCK)
               ON RO.id = RITEM.romaneo_id 

where @CentroIdp=RE.Centro_Id and (@FechaIngresoDesdep is null or cast(@FechaIngresoDesdep as date) &lt;= cast(RE.fechainicio as date))
and (@FechaIngresoHastap is null or cast(@FechaIngresoHastap as date) &gt;= cast(RE.fechainicio as date))

GROUP  BY RE.fechainicio, 
          RO.id, 
          RO.nropedido, 
          RE.id, 
          RE.patente, 
          PRO.descripcion, 
          ESTROM.descripcion, 
          RE.numerodocumentoingreso, 
          RE.pesobrutoorigen - RE.pesotaraorigen, 
          OD.fechamovimiento,
          RO.FechaInicio, 
          RO.FechaCierre,
          RE.Centro_Id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FechaIngreso">
          <DataField>FechaIngreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RomaneoNro">
          <DataField>RomaneoNro</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PedidoNro">
          <DataField>PedidoNro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IngresoNro">
          <DataField>IngresoNro</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Proveedor">
