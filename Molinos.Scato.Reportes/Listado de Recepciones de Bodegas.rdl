    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NumeroINV + ' - ' + Descripcion AS Bodega, Id,Descripcion as ord
FROM            Centro WITH (NOLOCK)
WHERE        (NumeroINV IS NOT NULL)
order by ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Bodega">
          <DataField>Bodega</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="vinedospropios">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        '(excluir todos)' AS Vinedo, 0 AS Id,'' as ord
UNION
SELECT        NumeroINV + ' - ' + Descripcion AS Vinedo, Id,Descripcion as ord
FROM            Vinedo WITH (NOLOCK)
WHERE        (Discriminator = 'VinedoPropio')
order by ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Vinedo">
          <DataField>Vinedo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
