  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>78ec88e8-4405-49d1-9c8f-42a3459f7ec3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Bodegas">
            <Value>=Parameters!Bodegas.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@VinedosPropios">
            <Value>=Parameters!VinedosPropios.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@VinedosTerceros">
            <Value>=Parameters!VinedosTerceros.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaDesdep DATETIME,
		@FechaHastap DATETIME

SET		@FechaDesdep = @FechaDesde
SET		@FechaHastap = @FechaHasta

select Centro_Id,Centro,NumeroINV,Operacion,CIU,Fecha,NumeroDocumentoIngreso,Remito,Proveedor,ProveedorCuil,Vinedo,vinedo_id,Variedad,Azucar,Calidad,Estado,OrdenDeCompra,Bruto,Neto,Tara,SUM(CantidadBinesIngreso) as CantidadBinesIngreso,TipoBinesIngreso,SUM(CantidadBinesSalida) as CantidadBinesSalida,TipoBinesSalida,TaraBalanza,Observaciones,DocumentoInternoSap from (
SELECT
r.Centro_Id,c.Descripcion as Centro,c.NumeroINV,
(CASE WHEN tc.EsParaUva = 1 THEN 'P'
	  WHEN tc.EsParaUva = 2 THEN 'T' ELSE '' END) as Operacion,
r.NumeroCiu as CIU,
r.FechaEgreso as Fecha,
r.NumeroDocumentoIngreso as NumeroDocumentoIngreso,
remito.NroRemito as Remito,
prov.Descripcion as Proveedor,
prov.Cuil as ProveedorCuil,
vinedo.NumeroINV as Vinedo,vinedo.id as vinedo_id,
v.Descripcion as Variedad,
(CASE WHEN ancarAz.valoranalisis IS NULL 
                         THEN calcarAz.valorcalado ELSE ancarAz.valoranalisis END) as Azucar,
(CASE WHEN ancarCal.valoranalisis IS NULL 
                         THEN calcarCal.valorcalado ELSE ancarCal.valoranalisis END) as Calidad,
(CASE WHEN ancarEst.valoranalisis IS NULL 
                         THEN calcarEst.valorcalado ELSE ancarEst.valoranalisis END) as Estado,
remito.OrdenDeCompra as OrdenDeCompra,
r.PesoBruto as Bruto,
r.PesoBruto - r.PesoTaraBodega as Neto,
r.PesoTaraBodega as Tara,
0 as CantidadBinesIngreso,
matsbin.Descripcion as TipoBinesIngreso,
sbin.CantidadBines as CantidadBinesSalida,
matsbin.Descripcion as TipoBinesSalida,
r.PesoTara as TaraBalanza,
remito.Observacion as Observaciones,
r.DocumentoInternoSap

FROM	CargaDeBines AS sbin WITH(NOLOCK) INNER JOIN
		RemitoBodegaUva AS remito WITH(NOLOCK) ON sbin.remitobodegauva_id = remito.id INNER JOIN
		Recorrido AS r WITH(NOLOCK) ON remito.Recorrido_Id = r.id  INNER JOIN		
		Centro AS c WITH(NOLOCK) ON r.Centro_Id = c.Id INNER JOIN
		Material AS m WITH(NOLOCK) ON r.Material_Id = m.Id INNER JOIN
		Variedad AS v WITH(NOLOCK) ON m.Variedad_Id = v.Id INNER JOIN
		TipoComercial AS tc WITH(NOLOCK) ON r.TipoComercial_Id = tc.Id INNER JOIN
		Proveedor AS prov WITH(NOLOCK) ON remito.Proveedor_Id = prov.Id INNER JOIN
		Vinedo AS vinedo WITH(NOLOCK) ON remito.Vinedo_Id = vinedo.Id INNER JOIN         
		Material AS matsbin WITH(NOLOCK) ON sbin.Tipo_Id = matsbin.Id LEFT OUTER JOIN
				
		AnalisisDeCalidad WITH(NOLOCK) ON AnalisisDeCalidad.Calado_Id = r.Calado_Id LEFT OUTER JOIN
		CaladoPorCaracteristica AS calcarAz WITH(NOLOCK) ON calcarAz.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcarAz.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancarAz ON ancarAz.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancarAz.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
		CaladoPorCaracteristica AS calcarCal ON calcarCal.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcarCal.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancarCal ON ancarCal.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancarCal.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN
		CaladoPorCaracteristica AS calcarEst ON calcarEst.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcarEst.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancarEst ON ancarEst.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancarEst.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1))
                               
LEFT OUTER JOIN
		
		CaladoPorCaracteristica AS calcar ON calcar.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancar WITH(NOLOCK) ON ancar.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1))
                          
WHERE       (r.Rechazado &lt;&gt; 1) AND (r.Terminado = 1) AND (c.NumeroINV IS NOT NULL) AND (r.FechaInicio IS NOT NULL) 
			AND (@FechaDesde &lt;= r.FechaInicio) AND (@FechaHasta &gt;= r.FechaInicio) 
			/*AND (@Vinedo = remito.Vinedo_Id OR @Vinedo = 0)*/ AND (R.Centro_Id IN (@Bodegas))
	AND 1=CASE
		WHEN 0 IN(@VinedosPropios) 
			THEN (CASE WHEN 0 IN (@VinedosTerceros) 
					THEN(0)
				WHEN Vinedo.Discriminator = 'VinedoTerceros' AND 0 NOT IN(@VinedosTerceros) AND remito.Vinedo_Id IN (@VinedosTerceros) THEN (1)
				END)
		WHEN 0 NOT IN(@VinedosPropios) 
			THEN (CASE 
				WHEN 0 IN (@VinedosTerceros) AND vinedo.Discriminator = 'VinedoPropio' AND remito.Vinedo_Id IN (@VinedosPropios) THEN (1) 
				WHEN 0 NOT IN (@VinedosTerceros)  AND (remito.Vinedo_Id IN (@VinedosTerceros) OR remito.Vinedo_Id IN (@VinedosPropios)) THEN (1)
				END)
		END

union all ( 

SELECT
r.Centro_Id,c.Descripcion as Centro,c.NumeroINV,
(CASE WHEN tc.EsParaUva = 1 THEN 'P'
	  WHEN tc.EsParaUva = 2 THEN 'T' ELSE '' END) as Operacion,
r.NumeroCiu as CIU,
r.FechaEgreso as Fecha,
r.NumeroDocumentoIngreso as NumeroDocumentoIngreso,
remito.NroRemito as Remito,
prov.Descripcion as Proveedor,
prov.Cuil as ProveedorCuil,
vinedo.NumeroINV as Vinedo,vinedo.id as vinedo_id,
v.Descripcion as Variedad,
(CASE WHEN ancarAz.valoranalisis IS NULL 
                         THEN calcarAz.valorcalado ELSE ancarAz.valoranalisis END) as Azucar,
(CASE WHEN ancarCal.valoranalisis IS NULL 
                         THEN calcarCal.valorcalado ELSE ancarCal.valoranalisis END) as Calidad,
(CASE WHEN ancarEst.valoranalisis IS NULL 
                         THEN calcarEst.valorcalado ELSE ancarEst.valoranalisis END) as Estado,
remito.OrdenDeCompra as OrdenDeCompra,
r.PesoBruto as Bruto,
r.PesoBruto - r.PesoTaraBodega as Neto,
r.PesoTaraBodega as Tara,
ibin.CantidadBines as CantidadBinesIngreso,
matibin.Descripcion as TipoBinesIngreso,
0 as CantidadBinesSalida,
matibin.Descripcion as TipoBinesSalida,
r.PesoTara as TaraBalanza,
remito.Observacion as Observaciones,
r.DocumentoInternoSap

FROM	DescargaDeBines AS ibin WITH(NOLOCK) INNER JOIN
		RemitoBodegaUva AS remito WITH(NOLOCK) ON ibin.RemitoBodegaUva_Id = remito.id INNER JOIN
		Recorrido AS r WITH(NOLOCK) ON r.Id = remito.Recorrido_Id INNER JOIN
		Centro AS c WITH(NOLOCK) ON r.Centro_Id = c.Id INNER JOIN
		Material AS m WITH(NOLOCK) ON r.Material_Id = m.Id INNER JOIN
		Variedad AS v WITH(NOLOCK) ON m.Variedad_Id = v.Id INNER JOIN
		TipoComercial AS tc WITH(NOLOCK) ON r.TipoComercial_Id = tc.Id INNER JOIN
		Proveedor AS prov WITH(NOLOCK) ON remito.Proveedor_Id = prov.Id INNER JOIN
		Vinedo AS vinedo WITH(NOLOCK) ON remito.Vinedo_Id = vinedo.Id LEFT OUTER JOIN
		Material AS matibin WITH(NOLOCK) ON ibin.Tipo_Id = matibin.Id LEFT OUTER JOIN
				
		AnalisisDeCalidad WITH(NOLOCK) ON AnalisisDeCalidad.Calado_Id = r.Calado_Id LEFT OUTER JOIN
		CaladoPorCaracteristica AS calcarAz WITH(NOLOCK) ON calcarAz.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcarAz.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancarAz ON ancarAz.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancarAz.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
		CaladoPorCaracteristica AS calcarCal ON calcarCal.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcarCal.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancarCal ON ancarCal.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancarCal.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN
		CaladoPorCaracteristica AS calcarEst ON calcarEst.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcarEst.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancarEst ON ancarEst.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancarEst.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1))
                               
LEFT OUTER JOIN
		
		CaladoPorCaracteristica AS calcar ON calcar.Calado_Id = r.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad AS car WITH(NOLOCK)
                               WHERE        (Id = calcar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
		AnalisisPorCaracteristica AS ancar WITH(NOLOCK) ON ancar.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH(NOLOCK)
                               WHERE        (Id = ancar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1))
                          
WHERE       (r.Rechazado &lt;&gt; 1) AND (r.Terminado = 1) AND (c.NumeroINV IS NOT NULL) AND (r.FechaInicio IS NOT NULL) 
			AND (@FechaDesde &lt;= r.FechaInicio) AND (@FechaHasta &gt;= r.FechaInicio) 
			/*AND (@Vinedo = remito.Vinedo_Id OR @Vinedo = 0)*/ AND (R.Centro_Id IN (@Bodegas))
	AND 1=CASE
		WHEN 0 IN(@VinedosPropios) 
			THEN (CASE WHEN 0 IN (@VinedosTerceros) 
					THEN(0)
				WHEN Vinedo.Discriminator = 'VinedoTerceros' AND 0 NOT IN(@VinedosTerceros) AND remito.Vinedo_Id IN (@VinedosTerceros) THEN (1)
				END)
		WHEN 0 NOT IN(@VinedosPropios) 
			THEN (CASE 
				WHEN 0 IN (@VinedosTerceros) AND vinedo.Discriminator = 'VinedoPropio' AND remito.Vinedo_Id IN (@VinedosPropios) THEN (1) 
				WHEN 0 NOT IN (@VinedosTerceros)  AND (remito.Vinedo_Id IN (@VinedosTerceros) OR remito.Vinedo_Id IN (@VinedosPropios)) THEN (1)
				END)
		END

)

) as T group by Centro_Id,Centro,NumeroINV,Operacion,CIU,Fecha,NumeroDocumentoIngreso,Remito,Proveedor,ProveedorCuil,Vinedo,vinedo_id,Variedad,Azucar,Calidad,Estado,OrdenDeCompra,Bruto,Neto,Tara,TipoBinesIngreso,TipoBinesSalida,TaraBalanza,Observaciones,DocumentoInternoSap</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
