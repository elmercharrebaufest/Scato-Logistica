<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>f0bb9f87-b74a-4e4e-97bd-802f52f3ec3a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Diferencia">
            <Value>=Parameters!Diferencia.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaDesdep DATETIME, 
		@FechaHastap DATETIME,
		@CentroIdp INT,
		@Materialp INT,
		@Diferenciap Bit


SET		@FechaDesdep = @FechaDesde
SET		@FechaHastap = @FechaHasta
SET		@CentroIdp = @CentroId
SET		@Materialp = @Material
SET		@Diferenciap = @Diferencia

Select R.NumeroDocumentoIngreso,
		M.Descripcion,
		case when R.PesoTaraFecha is not null then R.PesoTaraFecha else R.FechaInicio end as FechaDescarga,
		C.Usuario,
		CO.Descripcion as Corredor,
		CO.Cuil as CorredorCuil,
		P.RazonSocial as Proveedor,
		P.Cuil as ProveedorCuil,
		CA.Grado,
		MCA.ValorCamara
from MuestraEnvioACamaraAuditoria MCA
inner join Recorrido R on R.Id = MCA.Recorrido_Id
inner join Calado C on C.Id = R.Calado_Id 
inner join material M on M.Id = R.Material_Id
inner join Vehiculo V on V.Id = R.Vehiculo_Id
inner join CartaPorte CP on CP.Id = V.CartaPorte_Id
left join Proveedor P on P. id = CP.TitularCartaPorte_Id 
left join Proveedor CO on CO.Id = CP.Corredor_Id
inner join CaracteristicasAnalizadas CA on CA.Recorrido_Id = R.Id						 

WHERE   (@Materialp  IS NULL OR @Materialp  = M.Id)
                AND (@CentroIdp IS NULL OR @CentroIdp = R.Centro_Id )
                AND (@FechaHastap &gt;= R.PesoTaraFecha OR @FechaHastap IS NULL) 
                AND( @FechaDesdep &lt;= R.PesoTaraFecha OR @FechaDesdep IS NULL) 
                AND( @Diferenciap is null or (@Diferenciap = 1 AND CA.Grado &lt;&gt; MCA.ValorCamara) OR (@Diferenciap = 0 AND CA.Grado = MCA.ValorCamara))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaDescarga">
          <DataField>FechaDescarga</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Corredor">
          <DataField>Corredor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CorredorCuil">
          <DataField>CorredorCuil</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Proveedor">
          <DataField>Proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProveedorCuil">
          <DataField>ProveedorCuil</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Grado">
          <DataField>Grado</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ValorCamara">
          <DataField>ValorCamara</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Material, ' ' AS ord
UNION
SELECT        Material.Id, Material.Descripcion AS Material, Material.Descripcion AS ord
FROM            Material WITH (NOLOCK) INNER JOIN
                         MaterialPorCentro WITH (NOLOCK) ON Material.Id = MaterialPorCentro.Material_Id AND MaterialPorCentro.Centro_Id = @CentroId
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            Recorrido WITH (NOLOCK)
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @CentroId))
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
