          </QueryParameter>
          <QueryParameter Name="@BocaDestino">
            <Value>=Parameters!BocaDestino.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaIngresoDesdep DATETIME,
		@FechaIngresoHastap DATETIME, 
		@FechaSalidaDesdep DATETIME,
		@FechaSalidaHastap DATETIME,
		@Patentep NVARCHAR(MAX),
		@Usuariop NVARCHAR(MAX),
		@RecorridosActivosp NVARCHAR(MAX),
		@NivelDeDetallep INT,
		@TipoVehiculop INT,
		@Workflowp INT,
		@BalanzaBrutop INT,
		@BalanzaTarap INT,
		@CentroIdp INT,
		@Materialp INT,
		@TipoPesadap INT,
		@TipoComercialp INT,
		@TitularCPp INT,
		@Corredorp INT,
		@Entregadorp INT,
		@AlmacenOrigenp INT,
		@AlmacenDestinop INT,
		@BocaDestinop INT

SET		@FechaIngresoDesdep = @FechaIngresoDesde
SET		@FechaIngresoHastap =@FechaIngresoHasta
SET		@FechaSalidaDesdep = @FechaSalidaDesde
SET		@FechaSalidaHastap = @FechaSalidaHasta
SET		@Patentep = @Patente
SET		@Usuariop = @Usuario
SET		@Materialp = @Material
SET		@RecorridosActivosp = @RecorridosActivos
SET		@NivelDeDetallep = @NivelDeDetalle
SET		@TipoVehiculop = @TipoVehiculo
SET		@Workflowp = @Workflow
SET		@BalanzaBrutop = @BalanzaBruto
SET		@BalanzaTarap =@BalanzaTara
SET		@CentroIdp = @CentroId
SET		@TipoPesadap = @TipoPesada
SET		@TipoComercialp = @TipoComercial
SET		@TitularCPp = @TitularCP
SET		@Corredorp = @Corredor
SET		@Entregadorp = @Entregador
SET		@AlmacenOrigenp = @AlmacenOrigen
SET		@AlmacenDestinop = @AlmacenDestino
SET		@BocaDestinop = @BocaDestino

SELECT ISNULL(tv.descripcion,'Camión') AS 'TipoVehiculo',
       tipocomercial.descripcion AS TipoComercial,
       TipoDocumentoIngreso.Descripcion as TipoDocumentoIngreso,
       TipoDocumentoIngreso.Id as TipoDocumentoIngresoId,
       material.descripcion AS Material,
       Recorrido.NumeroDocumentoIngreso,
       Recorrido.Patente,
       Recorrido.FechaInicio,
       Recorrido.FechaEgreso,
       Recorrido.PesoBruto,
       Recorrido.PesoTara,
       (recorrido.pesobruto - recorrido.pesotara) AS PesoNeto,
       recorrido.usuario,
       NULLIF((recorrido.pesobrutoorigen - recorrido.pesotaraorigen), 0) AS NetoOrigen,
       (NULLIF((recorrido.pesobrutoorigen - recorrido.pesotaraorigen), 0) - (recorrido.pesobruto - recorrido.pesotara)) AS DiferenciaNeto,
       proveedor.descripcion AS Proveedor,
       corredor.descripcion AS Corredor,
       transportista.razonsocial AS Transportista,
       balanzaBruto.nombre AS BalanzaBruto,
       balanzaTara.nombre AS BalanzaTara ,
       entregador.razonsocial AS Entregador,
       workflow.descripcion AS Workflow,
       recorrido.centro_id AS CentroId,
       establecimiento.NombreDeEstablecimiento as Establecimiento,
       CASE
           WHEN recorrido.pesobruto IS NOT NULL THEN (CASE balanzaBruto.modalidad
                                                          WHEN 0 THEN (tp1.descripcion)
                                                          WHEN 1 THEN (tp2.descripcion)
                                                          ELSE 'M/A'
                                                      END)
       END AS TipoPesada,
       (CASE workflow.tipodeworkflow
            WHEN 0 THEN
                   ''
            WHEN 1 THEN
                   (SELECT almacen.descripcion
                    FROM almacen WITH(NOLOCK)
                    WHERE recorrido.almacen_id = almacen.id)
        END) AS almacenOrigen,
       (CASE workflow.tipodeworkflow
            WHEN 0 THEN
                   (SELECT almacen.descripcion
                    FROM almacen AS almacen WITH(NOLOCK)
                    WHERE recorrido.almacen_id = almacen.id)
            WHEN 1 THEN
                   ''
        END) AS almacenDestino,
		BD.NombreBocaDeDestino
FROM Recorrido
LEFT JOIN dbo.vehiculo V WITH(NOLOCK) ON Recorrido.vehiculo_id = V.id
LEFT JOIN dbo.cartaporte CP WITH(NOLOCK) ON V.cartaporte_id = CP.id
LEFT JOIN BocaDestino BD WITH(NOLOCK)ON CP.BocaDestino_Id = BD.Id
LEFT JOIN tipovehiculo tv WITH(NOLOCK) ON Recorrido.TipoVehiculo = tv.id
LEFT JOIN transportista WITH(NOLOCK) ON Recorrido.transportista_id = transportista.id
LEFT JOIN proveedor AS proveedor WITH(NOLOCK) ON CP.titularcartaporte_id = proveedor.id
LEFT JOIN proveedor AS corredor WITH(NOLOCK) ON CP.corredor_id = corredor.id
LEFT JOIN entregador WITH(NOLOCK) ON CP.entregador_id = entregador.id
LEFT JOIN establecimiento WITH(NOLOCK) ON Recorrido.establecimiento_id = establecimiento.id
LEFT JOIN balanza AS balanzaBruto WITH(NOLOCK) ON recorrido.balanzabruto_id = balanzaBruto.id
LEFT JOIN tipopesada tp1 WITH(NOLOCK) ON balanzaBruto.modalidad = tp1.id
LEFT JOIN balanza AS balanzaTara WITH(NOLOCK) ON recorrido.balanzatara_id = balanzaTara.id
LEFT JOIN tipopesada tp2 WITH(NOLOCK) ON balanzaTara.modalidad = tp2.id
LEFT JOIN workflow WITH(NOLOCK) ON recorrido.workflow_id = workflow.id
LEFT JOIN tipocomercial WITH(NOLOCK) ON Recorrido.TipoComercial_Id = tipocomercial.id
LEFT JOIN material WITH(NOLOCK) ON recorrido.Material_Id = material.id
LEFT JOIN TipoDocumentoIngreso WITH(NOLOCK) ON recorrido.TipoDocumentoIngreso = TipoDocumentoIngreso.id
WHERE
(Recorrido.FechaInicio &gt;= @FechaIngresoDesdep or @FechaIngresoDesdep IS NULL)AND(Recorrido.FechaInicio &lt;= @FechaIngresoHastap or @FechaIngresoHastap IS NULL)
AND 
(Recorrido.FechaEgreso &gt;=  @FechaSalidaDesdep or @FechaSalidaDesdep IS NULL) AND (Recorrido.FechaEgreso &lt;= @FechaSalidaHastap or @FechaSalidaHastap IS NULL)
AND
(@Patentep is null or Recorrido.Patente = @Patentep)
AND
(@Usuariop is null or Recorrido.Usuario = @Usuariop)
AND
Recorrido.Rechazado &lt;&gt; 1
AND ((@RecorridosActivosp = -1) OR (Recorrido.Terminado = @RecorridosActivosp))
AND ((workflow.TipoDeWorkflow = 0 AND Recorrido.PesoTaraFecha IS NOT NULL)  or (workflow.TipoDeWorkflow = 1 AND Recorrido.PesoBrutoFecha IS NOT NULL))
AND (@NivelDeDetallep = 1 or @NivelDeDetallep = 2 or (@NivelDeDetallep = 3 AND Recorrido.Establecimiento_Id IS NOT NULL) or (@NivelDeDetallep = 4 AND (CP.BocaDestino_Id = @BocaDestinop or @BocaDestinop = 0)))
AND ((Recorrido.TipoVehiculo = @TipoVehiculop) OR (@TipoVehiculop = -2 AND Recorrido.TipoVehiculo IN (0,1,2,3,4,5)) OR (@TipoVehiculop = -1 AND Recorrido.TipoVehiculo IN (0,3,4,5)))
AND (Recorrido.Workflow_Id = @Workflowp or @Workflowp = 0)
AND (Recorrido.balanzabruto_id = @BalanzaBrutop or @BalanzaBrutop = 0)
AND (Recorrido.balanzatara_id = @BalanzaTarap or @BalanzaTarap = 0)
AND (Recorrido.centro_id = @CentroIdp or @CentroIdp = 0)
AND ((@Materialp = -1 AND Material.Esgrano = 1) OR (@Materialp = -2 AND Material.EsGrano = 0 AND Material.EsInsumo = 0) OR (@Materialp = -3 AND Material.EsInsumo = 1) OR (@Materialp = Recorrido.Material_Id) OR (@Materialp = 0))
AND (@TipoPesadap = Recorrido.PesoTaraModalidad or @TipoPesadap = -1)

AND (Recorrido.TipoComercial_Id = @TipoComercialp or @TipoComercialp = 0)
AND (recorrido.workflow_id = @Workflowp or @Workflowp = 0)

AND ( CP.titularcartaporte_id = @TitularCPp or @TitularCPp = 0)
AND (CP.corredor_id = @Corredorp or @Corredorp = 0)
AND (CP.entregador_id = @Entregadorp or @Entregadorp = 0)

AND ((CASE workflow.tipodeworkflow
            WHEN 0 THEN
                   0
            WHEN 1 THEN
                   recorrido.almacen_id
        END) = @AlmacenOrigenp or @AlmacenOrigenp = 0)
AND ((CASE workflow.tipodeworkflow
            WHEN 0 THEN
                   recorrido.almacen_id
            WHEN 1 THEN
                   0
        END) = @AlmacenDestinop or @AlmacenDestinop = 0)
ORDER BY Recorrido.FechaInicio</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
