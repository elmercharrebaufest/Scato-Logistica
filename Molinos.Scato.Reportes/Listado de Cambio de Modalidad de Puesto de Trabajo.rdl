  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>da93e132-c283-4745-9f3d-ae44584b6b48</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@centroid">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @centroidp int, @FechaDesdep datetime, @FechaHastap datetime

set @centroidp= @centroid
set @fechaDesdep =@fechaDesde
set @fechaHastap = @fechaHasta

SELECT
          Modificacion.Fecha as Fecha,
                    CASE WHEN Modificacion.Automatico = 0 THEN 'Manual' ELSE 'Automático' END as Modalidad,

          Modificacion.Motivo as Motivo,
          Modificacion.NombreUsuarioResponsable as Usuario,
          Puesto.Lector as LectorEntrada,
          Puesto.NombrePuesto as NombrePuesto,
          Centro.Id as CentroId

 FROM [PuestoDeTrabajoModificacionModalidad] AS Modificacion
	INNER JOIN  [PuestoDeTrabajo] as Puesto
	ON Modificacion.PuestoDeTrabajo_Id = Puesto.Id
	INNER JOIN [Centro] as Centro
	ON Modificacion.Centro_Id = Centro.Id
 WHERE
(Modificacion.Centro_Id = @centroidp)
AND (cast(Modificacion.Fecha as date) &gt;= cast(@fechaDesdep as date))
AND (cast(Modificacion.Fecha as date) &lt;= cast(@fechaHastap as date))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Modalidad">
          <DataField>Modalidad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LectorEntrada">
          <DataField>LectorEntrada</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombrePuesto">
          <DataField>NombrePuesto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Centro.CodigoSap as CentroSap,
              Centro.Descripcion as CentroDescripcion

FROM [Centro] as Centro

WHERE Centro.Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
