    <DataSet Name="DSDescargaCamionVagon">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy; SELECT        a.Descripcion AS Almacen, m.descripcion AS Material, count(CASE WHEN TipoVehiculo != 1 THEN 1 ELSE NULL END) AS CantCamiones, 
                                                                                                                      count(CASE WHEN TipoVehiculo = 1 THEN 1 ELSE NULL END) AS CantTrenes, cast(sum(cast(CASE WHEN r.TipoVehiculo != 1 THEN r.PesoBruto - r.PesoTara ELSE 0 END AS numeric(18,
                                                                                                                       2))) / 1000 AS numeric(18, 2)) AS ToneladasCamiones, cast(sum(cast(CASE WHEN r.TipoVehiculo = 1 THEN r.PesoBruto - r.PesoTara ELSE 0 END AS numeric(18, 2))) 
                                                                                                                      / 1000 AS numeric(18, 2)) AS ToneladasTren
                                                                                             FROM            [Recorrido] AS r WITH (NOLOCK) JOIN
                                                                                                                      Workflow AS w WITH (NOLOCK) ON r.Workflow_Id = w.Id JOIN
                                                                                                                      Almacen AS a WITH (NOLOCK) ON a.Id = r.Almacen_Id JOIN
                                                                                                                      Material AS m WITH (NOLOCK) ON m.Id = r.material_id
                                                                                             WHERE        w.TipoDeWorkflow = 0 AND r.Centro_Id = @CentroId AND r.Material_Id IN (4, 386, 1) AND terminado = 1 AND Rechazado = 0 AND r.PesoTaraFecha IS NOT NULL AND 
                                                                                                                      r.PesoTaraFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' AND r.PesoTaraFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59'
                                                                                             GROUP BY a.Descripcion, m.descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Almacen">
          <DataField>Almacen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantCamiones">
          <DataField>CantCamiones</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CantTrenes">
          <DataField>CantTrenes</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ToneladasCamiones">
          <DataField>ToneladasCamiones</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ToneladasTren">
          <DataField>ToneladasTren</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
