          <DataField>Observaciones</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CodigoSAP, Descripcion 
FROM Centro
WHERE Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CodigoSAP">
          <DataField>CodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CentroProductor">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>(
SELECT null as Id, 'Todos' as Descripcion, '0' as ord 
UNION
SELECT CAST(Proveedor.Id as VARCHAR) + ',P' as Id, Proveedor.Descripcion as Descripcion, Proveedor.Descripcion as ord
FROM Proveedor 
INNER JOIN Vinedo ON Vinedo.Proveedor_Id = Proveedor.Id
)
UNION ALL(

SELECT CAST(Centro.Id as VARCHAR) + ',C' as Id, Centro.Descripcion as Descripcion, Centro.Descripcion as ord 
FROM Centro 
WHERE Centro.NumeroINV IS NOT NULL
)
UNION ALL(

SELECT CAST(Vinedo.Id as VARCHAR) + ',V' as Id, Vinedo.Descripcion as Descripcion, Vinedo.Descripcion as ord 
FROM Vinedo
WHERE [Discriminator]='VinedoPropio'
)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposDeBin">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT NULL AS ID, 'Todos' as Descripcion, '' as ord
UNION
SELECT ID, Descripcion, Descripcion as ord 
FROM Material 
WHERE UsaBinPallet = 1
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Detalles">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroProductor">
            <Value>=Parameters!CentroProductor.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT * FROM (SELECT 1 as Detalle, 'Resumido' as Descripcion
				UNION ALL 
				SELECT CASE WHEN @CentroProductor IS NOT NULL
						THEN 0
						END as Detalle,
						CASE WHEN @CentroProductor IS NOT NULL
						THEN 'Detallado'
						END as Descripcion) as T
WHERE T.Detalle IS NOT NULL
ORDER BY T.Detalle</CommandText>
      </Query>
      <Fields>
        <Field Name="Detalle">
          <DataField>Detalle</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="CentroId">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>0</Value>
        </Values>
      </DefaultValue>
      <Prompt>Centro Id</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
