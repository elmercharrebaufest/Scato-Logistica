  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>01ffa12c-f31b-4401-9cba-f91bfcf8c65b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroProductor">
            <Value>=Parameters!CentroProductor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoBIN">
            <Value>=Parameters!TipoBIN.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @TablaCoP VARCHAR(2), @CentProd INT

SET @TablaCoP = SUBSTRING(@CentroProductor,LEN(@CentroProductor) ,LEN(@CentroProductor))

DECLARE @xml xml, @str varchar(100), @delimiter varchar(10)
SET @str = @CentroProductor
SET @delimiter = ','
SET @xml = cast(('&lt;X&gt;'+replace(@str, @delimiter, '&lt;/X&gt;&lt;X&gt;')+'&lt;/X&gt;') as xml)
SET @CentProd = (SELECT TOP 1 C.value('.', 'varchar(MAX)') as value FROM @xml.nodes('X') as X(C))

DECLARE @Saldos_Iniciales TABLE(SaldoInicial INT,MaterialBin INT,ProveedorId INT,CentroINV_Id INT,VinedoId INT)
INSERT INTO @Saldos_Iniciales select * from [dbo].[CalcularSaldo](@FechaDesde, @TipoBIN, @TablaCoP, @CentProd)

IF (@CentProd IS NULL)
BEGIN

	DECLARE @Saldos_Finales TABLE(SaldoInicial INT,MaterialBin INT,ProveedorId INT,CentroINV_Id INT,VinedoId INT)
	INSERT INTO @Saldos_Finales select * from [dbo].[CalcularSaldo](DATEADD(DAY,1,@FechaHasta), @TipoBIN, @TablaCoP, @CentProd)
	
	SELECT 
		NULL AS FechaEgreso,
                                      (CASE WHEN P.Descripcion IS NOT NULL THEN 'P-' + P.Descripcion 
                                                   WHEN C.Descripcion IS NOT NULL THEN 'C-' + C.Descripcion
		              WHEN V.Descripcion IS NOT NULL THEN 'V-' + V.Descripcion END) as CentroProveedor,
		C.Descripcion as centroDesc,
		V.Descripcion as Vinedo,
		p.Id as ProveedorId,
		P.Descripcion as Productor,
		(CASE WHEN P.Cuil IS NOT NULL THEN P.Cuil
                                                   ELSE '' END) as CUIT_Titular,
		'' as NumeroCiu,
		(SELECT Descripcion FROM Material WHERE Material.Id = SF.MaterialBIN)  as TipoBIN,
		0 as Ingreso,
		0 as Egreso,
		SF.SaldoInicial AS  Sumarizable,
		SI.SaldoInicial AS SaldoInicial,
		'' AS Observaciones
    FROM @Saldos_Finales SF
	LEFT JOIN @Saldos_Iniciales SI ON SF.MaterialBin = SI.MaterialBin AND (SF.ProveedorId = SI.ProveedorId or (SF.ProveedorId is Null and SI.ProveedorId is null)) AND (SF.CentroINV_Id = SI.CentroINV_Id or (SF.CentroINV_Id is null and SI.CentroINV_Id is null)) AND (SF.VinedoId = SI.VinedoId or (SF.VinedoId is null and SI.VinedoId is null))
	LEFT JOIN Proveedor P ON P.Id = SF.ProveedorId
	LEFT JOIN Centro C ON C.Id = SF.CentroINV_Id	
	LEFT JOIN Vinedo V ON V.Id = SF.VinedoId
END
ELSE
SELECT * FROM (
---------------------
----Remito bodega uba
---------------------
SELECT FechaEgreso,CentroProveedor,centroDesc,Vinedo,ProveedorId,Productor,CUIT_Titular,NumeroCiu,TipoBIN,
SUM(Ingreso) as Ingreso,
SUM( Egreso) as Egreso,
SUM(Sumarizable) as Sumarizable,
MIN(SaldoInicial) as SaldoInicial,
 '' as Observaciones
FROM (
SELECT Recorrido.FechaEgreso,
	'' as CentroProveedor,
	centro.descripcion as centroDesc,
	Vinedo.Descripcion as Vinedo,
	Vinedo.Proveedor_Id as ProveedorId,

(CASE WHEN @TablaCoP = 'C' THEN Vinedo.[Descripcion]
            ELSE Proveedor.Descripcion END)

	 as Productor,
	Vinedo.CUIT_Titular,
	recorrido.NumeroCiu, 
	MaterialCarga.Descripcion as TipoBIN,
	(CASE WHEN @TablaCoP = 'C' THEN 0
			ELSE  ISNULL(CargaDeBines.CantidadBines,0)
			END) as Ingreso, 
	(CASE WHEN @TablaCoP = 'C' THEN ISNULL(CargaDeBines.CantidadBines,0)
			ELSE  0
			END) as Egreso,  
         (CASE WHEN CargaDeBines.CantidadBines IS NULL
					THEN 0					
					ELSE CASE WHEN @TablaCoP = 'C' THEN (-1)*CargaDeBines.CantidadBines
						ELSE CargaDeBines.CantidadBines
						END						
				END)
 as Sumarizable,
	ISNULL((SELECT S.SaldoInicial FROM @Saldos_Iniciales AS S
			WHERE 
			CargaDeBines.Tipo_Id =S.MaterialBin AND
			((Proveedor.Id = S.ProveedorId AND @TablaCoP = 'P') or
			(Centro.Id = S.CentroINV_Id AND @TablaCoP = 'C') or
			(Vinedo.Id = S.VinedoId AND @TablaCoP = 'V'))
			),0) AS SaldoInicial

FROM  CargaDeBines
INNER JOIN RemitoBodegaUva on RemitoBodegaUva.id = CargaDeBines.RemitoBodegaUva_Id
INNER JOIN recorrido on recorrido.id = RemitoBodegaUva.Recorrido_Id
INNER JOIN  centro on centro.id = recorrido.centro_id
LEFT JOIN Vinedo on Vinedo.Id = RemitoBodegaUva.Vinedo_Id
INNER JOIN Material as MaterialCarga on MaterialCarga.id = CargaDeBines.Tipo_Id
LEFT JOIN Proveedor on Proveedor.Id = Vinedo.Proveedor_Id
WHERE 
recorrido.fechaegreso &lt;= DATEADD(DAY,1,@FechaHasta) and recorrido.FechaEgreso &gt;= @FechaDesde AND 
(CargaDeBines.Tipo_Id =@TipoBIN or @TipoBIN IS NULL)
AND 1 = (SELECT CASE 
				WHEN (@TablaCoP = 'P' and Proveedor.Id = CAST(@CentProd as INT)) or @CentProd IS Null THEN 1
				WHEN (@TablaCoP = 'C'and Centro.Id = CAST(@CentProd as INT)) or @CentProd IS Null THEN 1
				WHEN (@TablaCoP = 'V'and Vinedo.Id = CAST(@CentProd as INT)) or @CentProd IS Null THEN 1
			ELSE 0
			END)
			
union ALL(
SELECT Recorrido.FechaEgreso,
	'' as CentroProveedor,
	centro.descripcion as centroDesc,
	Vinedo.Descripcion as Vinedo,
	Vinedo.Proveedor_Id as ProveedorId,

(CASE WHEN @TablaCoP = 'C' THEN Vinedo.[Descripcion]
            ELSE Proveedor.Descripcion END)

	 as Productor,
	Vinedo.CUIT_Titular,
	recorrido.NumeroCiu, 
	MaterialCarga.Descripcion as TipoBIN,
	(CASE WHEN @TablaCoP = 'C' THEN ISNULL(DescargaDeBines.CantidadBines,0)
			ELSE  0
			END) as Ingreso, 
	(CASE WHEN @TablaCoP = 'C' THEN 0
			ELSE  ISNULL(DescargaDeBines.CantidadBines,0)
			END) as Egreso,  
         (CASE WHEN DescargaDeBines.CantidadBines IS NULL
					THEN 0					
					ELSE CASE WHEN @TablaCoP = 'C' THEN DescargaDeBines.CantidadBines
						ELSE (-1)*DescargaDeBines.CantidadBines
						END						
				END)
 as Sumarizable,
	ISNULL((SELECT S.SaldoInicial FROM @Saldos_Iniciales AS S
			WHERE 
			DescargaDeBines.Tipo_Id =S.MaterialBin AND
			((Proveedor.Id = S.ProveedorId AND @TablaCoP = 'P') or
			(Centro.Id = S.CentroINV_Id AND @TablaCoP = 'C') or
			(Vinedo.Id = S.VinedoId AND @TablaCoP = 'V'))
			),0) AS SaldoInicial

FROM  DescargaDeBines
INNER JOIN RemitoBodegaUva on RemitoBodegaUva.id = DescargaDeBines.RemitoBodegaUva_Id
INNER JOIN recorrido on recorrido.id = RemitoBodegaUva.Recorrido_Id
INNER JOIN  centro on centro.id = recorrido.centro_id
LEFT JOIN Vinedo on Vinedo.Id = RemitoBodegaUva.Vinedo_Id
INNER JOIN Material as MaterialCarga on MaterialCarga.id = DescargaDeBines.Tipo_Id
LEFT JOIN Proveedor on Proveedor.Id = Vinedo.Proveedor_Id
WHERE 
recorrido.fechaegreso &lt;= DATEADD(DAY,1,@FechaHasta) and recorrido.FechaEgreso &gt;= @FechaDesde AND 
(DescargaDeBines.Tipo_Id =@TipoBIN or @TipoBIN IS NULL)
AND 1 = (SELECT CASE 
				WHEN (@TablaCoP = 'P' and Proveedor.Id = CAST(@CentProd as INT)) or @CentProd IS Null THEN 1
				WHEN (@TablaCoP = 'C'and Centro.Id = CAST(@CentProd as INT)) or @CentProd IS Null THEN 1
				WHEN (@TablaCoP = 'V'and Vinedo.Id = CAST(@CentProd as INT)) or @CentProd IS Null THEN 1
			ELSE 0
			END)
)
) as T GROUP BY FechaEgreso,CentroProveedor,centroDesc,Vinedo,ProveedorId,Productor,CUIT_Titular,NumeroCiu,TipoBIN

UNION ALL(
-----------------------------
--Incluimos ajustes de stock-
-----------------------------
SELECT ASB.Fecha as FechaEgreso,
'' as CentroProveedor,
C.Descripcion as centroDesc,
V.Descripcion as Vinedo,
p.Id as ProveedorId,
P.Descripcion as Productor,
'' as CUIT_Titular,
'' as NumeroCiu,
(SELECT Descripcion FROM Material WHERE Material.Id = ASB.Material_Id)  as TipoBIN,
(CASE ASB.Movimiento WHEN  1      THEN 0
                       WHEN 0 THEN Stock END) as Ingreso,-----------
(CASE ASB.Movimiento WHEN  1      THEN Stock
                       WHEN 0 THEN 0 END) as Egreso, ---------------------
(CASE ASB.Movimiento WHEN  1      THEN 0 - Stock
                       WHEN 0 THEN Stock END) as Sumarizable, ------
ISNULL((SELECT SaldoInicial
			FROM @Saldos_Iniciales as S 
			WHERE S.MaterialBin = ASB.Material_Id AND
				((ASB.Proveedor_Id = S.ProveedorId AND @TablaCoP = 'P') or
				(ASB.Centro_Id = S.CentroINV_Id AND @TablaCoP = 'C') or 
				(ASB.VinedoPropio_Id = S.VinedoId AND @TablaCoP = 'V'))
),0)AS SaldoInicial,
ASB.Observaciones AS Observaciones
FROM AjusteStockBines ASB
LEFT JOIN Proveedor P ON P.Id = ASB.Proveedor_Id
LEFT JOIN Centro C ON C.Id = ASB.Centro_Id
LEFT JOIN Vinedo V ON V.Id = ASB.VinedoPropio_Id
WHERE @FechaDesde &lt;= ASB.Fecha AND ASB.Fecha &lt;= DATEADD(DAY,1,@FechaHasta)
AND 1 = (CASE	WHEN @TablaCoP = 'P' AND P.Id = @CentProd AND ASB.TipoAjuste = 1 THEN 1
				WHEN @TablaCoP = 'C' AND C.Id = @CentProd AND ASB.TipoAjuste = 0 THEN 1
				WHEN @TablaCoP = 'V' AND V.Id = @CentProd AND ASB.TipoAjuste = 2 THEN 1
				ELSE 0
				END)
AND (ASB.Material_Id = @TipoBIN or @TipoBIN IS NULL)
)

UNION ALL(
-----------------------------
--Movimientos de Bines-
-----------------------------
SELECT MDB.Fecha as FechaEgreso,
'' as CentroProveedor,
(CASE MDB.TipoAjuste WHEN 0 THEN  C.Descripcion 
ELSE CO.Descripcion END)
 as centroDesc,
V.Descripcion as Vinedo,
p.Id as ProveedorId,
P.Descripcion as Productor,
'' as CUIT_Titular,
MDB.Numero as NumeroCiu,
(SELECT Descripcion FROM Material WHERE Material.Id = MDB.Material_Id)  as TipoBIN,
(CASE MDB.Movimiento WHEN  1      THEN 0
                       WHEN 0 THEN Cantidad END) as Ingreso,-----------
(CASE MDB.Movimiento WHEN  1      THEN Cantidad
                       WHEN 0 THEN 0 END) as Egreso, ---------------------
(CASE MDB.Movimiento WHEN  1      THEN 0 - Cantidad
                       WHEN 0 THEN Cantidad END) as Sumarizable, ------
ISNULL((SELECT SaldoInicial
			FROM @Saldos_Iniciales as S 
			WHERE S.MaterialBin = MDB.Material_Id AND
				((MDB.Proveedor_Id = S.ProveedorId AND @TablaCoP = 'P') or
				(MDB.Centro_Id = S.CentroINV_Id AND @TablaCoP = 'C') or
				(MDB.VinedoPropio_Id = S.VinedoId AND @TablaCoP = 'V'))
),0)AS SaldoInicial,
MDB.Observaciones AS Observaciones
FROM MovimientoDeBines MDB
LEFT JOIN Proveedor P ON P.Id = MDB.Proveedor_Id
LEFT JOIN Centro C ON C.Id = MDB.Centro_Id
LEFT JOIN Vinedo V ON V.Id = MDB.VinedoPropio_Id
LEFT JOIN Centro CO ON CO.Id = MDB.CentroOrigen_Id
WHERE @FechaDesde &lt;= MDB.Fecha AND MDB.Fecha &lt;= DATEADD(DAY,1,@FechaHasta)
AND 1 = (CASE	WHEN @TablaCoP = 'P' AND P.Id = @CentProd AND MDB.TipoAjuste = 1 THEN 1
				WHEN @TablaCoP = 'C' AND C.Id = @CentProd AND MDB.TipoAjuste = 0 THEN 1
				WHEN @TablaCoP = 'V' AND V.Id = @CentProd AND MDB.TipoAjuste = 2 THEN 1
				ELSE 0
				END)
AND (MDB.Material_Id = @TipoBIN or @TipoBIN IS NULL)
)

UNION ALL (
------------------------------
-- incluimos saldos iniciales-
------------------------------
SELECT 
NULL AS FechaEgreso,
'' as CentroProveedor,
C.Descripcion as centroDesc,
V.Descripcion as Vinedo,
p.Id as ProveedorId,
P.Descripcion as Productor,
'' as CUIT_Titular,
'' as NumeroCiu,
(SELECT Descripcion FROM Material WHERE Material.Id = S.MaterialBIN)  as TipoBIN,
'' as Ingreso,
'' as Egreso,
S.SaldoInicial Sumarizable,
S.SaldoInicial,
'' AS Observaciones
FROM @Saldos_Iniciales as S
LEFT JOIN Proveedor P ON P.Id = S.ProveedorId
LEFT JOIN Centro C ON C.Id = S.CentroINV_Id
LEFT JOIN Vinedo V ON V.Id = S.VinedoId
WHERE (S.MaterialBin = @TipoBIN or @TipoBIN IS NULL)
AND 1 = (CASE	WHEN @TablaCoP = 'P' AND P.Id = @CentProd THEN 1
				WHEN @TablaCoP = 'C' AND C.Id = @CentProd THEN 1
				WHEN @TablaCoP = 'V' AND V.Id = @CentProd THEN 1
				WHEN @CentProd IS NULL THEN 1
				ELSE 0
				END)	
)) AS T
ORDER BY T.FechaEgreso DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FechaEgreso">
          <DataField>FechaEgreso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CentroProveedor">
          <DataField>CentroProveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="centroDesc">
          <DataField>centroDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vinedo">
          <DataField>Vinedo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProveedorId">
          <DataField>ProveedorId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Productor">
          <DataField>Productor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIT_Titular">
          <DataField>CUIT_Titular</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NumeroCiu">
          <DataField>NumeroCiu</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoBIN">
          <DataField>TipoBIN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ingreso">
          <DataField>Ingreso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Egreso">
          <DataField>Egreso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Sumarizable">
          <DataField>Sumarizable</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
