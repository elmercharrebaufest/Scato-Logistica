      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>=IIF(IsNothing(Parameters!CentroProductor.Value),1,0)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Detalle</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Detalles</DataSetName>
