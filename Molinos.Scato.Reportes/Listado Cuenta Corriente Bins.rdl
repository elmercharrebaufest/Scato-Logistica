          <ValueField>ID</ValueField>
          <LabelField>Descripcion</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
  <Code>Public Function SeleccionoCentro(ByVal s as String) as Boolean
        If(s Is Nothing OrElse not s.EndsWith("C")) Then 
            Return False
        Else: Return True
        End If
    End Function

Public Function SeleccionoProveedor(ByVal s as String) as Boolean
        If(s Is Nothing OrElse NOT s.EndsWith("P")) Then 
            Return False
        Else: Return True
        End If
    End Function

Public Function SeleccionoVinedo(ByVal s as String) as Boolean
        If(s Is Nothing OrElse NOT s.EndsWith("V")) Then 
            Return False
        Else: Return True
        End If
    End Function</Code>
