        </Field>
        <Field Name="kilosNeto">
          <DataField>kilosNeto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Ingreso_por_Compra_de_Granos___Calada_Externa">
          <DataField>Ingreso por Compra de Granos - Calada Externa</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ingreso_por_Redespacho_de_Granos___Calada_Externa">
          <DataField>Ingreso por Redespacho de Granos - Calada Externa</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CentroNombre">
          <DataField>CentroNombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroCodigoSAP">
          <DataField>CentroCodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT       '' AS Id, 'Todos' AS Material, '0' AS ord
UNION
SELECT        Id, Descripcion AS Material, Descripcion AS ord
FROM            Material WITH (nolock)
where CodigoSAP = '19908017' 
   OR CodigoSAP = '19908036'
   OR CodigoSAP = '19908027'
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDs">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposComerciales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        '' AS Id, 'Todos' AS TipoComercial, '0' AS ord
UNION
SELECT        Id, Descripcion AS TipoComercial, Descripcion AS ord
FROM            TipoComercial WITH (nolock)
where Descripcion = 'COMPRA DE GRANOS' 
   OR Descripcion = 'INGRESO POR REDESPACHO'
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
