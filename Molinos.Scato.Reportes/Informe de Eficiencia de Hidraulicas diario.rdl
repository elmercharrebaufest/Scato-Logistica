<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>62210bef-d880-4b43-b70e-5c0e309df265</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=Parameters!TipoComercial.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @FechaDesdep datetime2, @FechaHastap datetime2, @MaterialIdp int, @TipoComercialIdp int, @CentroIdp int

set @FechaDesdep = @FechaDesde
set @FechaHastap = @FechaHasta
set @MaterialIdp = @Material
set @TipoComercialIdp = @TipoComercial
set @CentroIdp = @CentroId

select 
CAST(fecha as date) fecha,
Hidraulica, 
material, 
tipoComercial, 
kilosBruto, 
kilosNeto,
[Ingreso por Compra de Granos - Calada Externa], [Ingreso por Redespacho de Granos - Calada Externa],
CentroId,
CentroNombre,
CentroCodigoSAP
from (

                select max(p.Nombre) as Hidraulica,
                    mat.Descripcion as material,
					R.pesotarafecha as fecha,
                    R.PesoBruto as kilosBruto, 
                    R.PesoBruto - R.PesoTara as kilosNeto, 
                    wf.Descripcion as workflow,
                    tc.Descripcion as tipoComercial,
					centro.Id		         As CentroId,
					centro.Descripcion        AS CentroNombre,
					centro.CodigoSAP          AS CentroCodigoSAP
                from PuestosDeCargaDescarga p WITH (NOLOCK)
                inner join ControlRecorrido cr WITH (NOLOCK) on cr.PuestoDeTrabajo_Id = p.PuestoDeTrabajo_Id
                inner join Recorrido r WITH (NOLOCK) on R.instanciaworkflow = cr.WorkflowInstanceId
                inner join Material mat WITH (NOLOCK) on R.Material_Id = mat.Id
                inner join Workflow wf with (nolock) on R.Workflow_Id = wf.Id
                inner join TipoComercial tc with (nolock) on R.TipoComercial_Id = tc.Id
				inner join Centro centro with (nolock) on R.Centro_Id = centro.Id
                where R.pesotarafecha is not null
                and cr.ActividadXaml = 'ConfirmacionDeCargaDescarga'
                and cast(@FechaDesdep as datetime2) &lt;= cast(R.pesotarafecha as datetime2) 
                and cast(R.pesotarafecha as datetime2) &lt; cast(@FechaHastap as datetime2)
                and cr.PuestoDeTrabajo_Id is not null
                AND R.Rechazado = 0 
                AND R.centro_id = @CentroIdp
                and (@TipoComercialIdp = '' or R.TipoComercial_Id = @TipoComercialIdp)
                and (@MaterialIdp = '' or R.Material_Id = @MaterialIdp)
                group by r.InstanciaWorkflow, r.pesotarafecha, r.PesoBruto, r.PesoTara, mat.Descripcion, wf.Descripcion, tc.Descripcion, centro.Id, centro.Descripcion, centro.CodigoSAP
)PVT 
       PIVOT (max(workflow) FOR PVT.workflow IN ([Ingreso por Compra de Granos - Calada Externa], [Ingreso por Redespacho de Granos - Calada Externa]))
       AS ColumnasPivotadas</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="fecha">
          <DataField>fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Hidraulica">
          <DataField>Hidraulica</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="material">
          <DataField>material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tipoComercial">
          <DataField>tipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="kilosBruto">
