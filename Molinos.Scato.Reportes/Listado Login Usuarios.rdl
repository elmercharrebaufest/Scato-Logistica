<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>01ffa12c-f31b-4401-9cba-f91bfcf8c65b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@NombreUsuario">
            <Value>=Parameters!NombreUsuario.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @NombreUsuariop varchar(40), @FechaDesdep Datetime, @FechaHastap Datetime

set @NombreUsuariop = @NombreUsuario
set @FechaDesdep = @FechaDesde
set @FechaHastap = @FechaHasta

Select Nombre, Apellido, NombreUsuario, UltimoLogin
FROM Usuario u WITH (NOLOCK) where (@NombreUsuariop = u.NombreUsuario OR  @NombreUsuariop = '') and
((@FechaDesdep is null AND @FechaHastap IS NULL) or (cast(@FechaDesdep as date) &lt;= cast(u.UltimoLogin as date) AND @FechaHastap IS NULL AND @FechaDesdep is not null) or 
 ((cast(@FechaDesdep as date) &lt;= cast(u.UltimoLogin as date) AND cast(@FechaHastap as date) &gt;= cast(u.UltimoLogin as date))))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NombreUsuario">
          <DataField>NombreUsuario</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Apellido">
          <DataField>Apellido</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="UltimoLogin">
          <DataField>UltimoLogin</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
