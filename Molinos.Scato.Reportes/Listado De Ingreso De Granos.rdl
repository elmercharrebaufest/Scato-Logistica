    <DataSet Name="Proveedores">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Proveedor, '0' AS ord
UNION
SELECT        Proveedor.Id, Proveedor.Descripcion AS Proveedor, Proveedor.Descripcion AS ord
FROM            Proveedor WITH (NOLOCK) INNER JOIN
                         CartaPorte WITH (NOLOCK) ON CartaPorte.TitularCartaPorte_Id = Proveedor.Id
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Proveedor">
          <DataField>Proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
