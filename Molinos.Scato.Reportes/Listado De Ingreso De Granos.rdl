    <DataSet Name="Workflows">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Workflow, '0' AS ord
UNION
SELECT        Id, Descripcion AS Workflow, Descripcion AS ord
FROM            Workflow WITH (NOLOCK)
WHERE        (Centro_Id = @Centro) OR
                         (@Centro = NULL)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Workflow">
