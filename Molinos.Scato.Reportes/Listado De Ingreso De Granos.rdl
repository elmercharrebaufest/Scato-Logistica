          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AlmacenOrigen">
            <Value>=Parameters!AlmacenOrigen.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AlmacenDestino">
            <Value>=Parameters!AlmacenDestino.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BalanzaBruto">
            <Value>=Parameters!BalanzaBruto.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BalanzaTara">
            <Value>=Parameters!BalanzaTara.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Proveedor">
            <Value>=Parameters!Proveedor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Corredor">
            <Value>=Parameters!Corredor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Entregador">
            <Value>=Parameters!Entregador.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoVehiculo">
            <Value>=Parameters!TipoVehiculo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Usuario">
            <Value>=Parameters!Usuario.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoDesde">
            <Value>=Parameters!FechaIngresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoHasta">
            <Value>=Parameters!FechaIngresoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaSalidaDesde">
            <Value>=Parameters!FechaSalidaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaSalidaHasta">
            <Value>=Parameters!FechaSalidaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoPesada">
            <Value>=Parameters!TipoPesada.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Centrop INT, 
		@Workflowp INT, 
		@TipoComercialp INT, 
		@Materialp INT, 
		@AlmacenOrigenp INT,
		@AlmacenDestinop INT,                         
		@BalanzaBrutop INT, 
		@BalanzaTarap INT, 
		@Proveedorp INT, 
		@Corredorp INT, 
		@Entregadorp INT, 
		@TipoVehiculop INT  ,
		@Patentep NVARCHAR(MAX) ,
		@Usuariop NVARCHAR(MAX),                    
		@FechaIngresoDesdep DATETIME,
        @FechaIngresoHastap DATETIME,                         
		@FechaSalidaDesdep DATETIME,                         
		@FechaSalidaHastap DATETIME,				                         
		@TipoPesadap INT                 

SET		@Centrop = @Centro 
SET		@Workflowp = @Workflow
SET		@TipoComercialp = @TipoComercial
SET		@Materialp = @Material 
SET		@AlmacenOrigenp = @AlmacenOrigen
SET		@AlmacenDestinop = @AlmacenDestino                         
SET		@BalanzaBrutop = @BalanzaBruto
SET		@BalanzaTarap = @BalanzaTara 
SET		@Proveedorp = @Proveedor
SET		@Corredorp = @Corredor
SET		@Entregadorp = @Entregador
SET		@TipoVehiculop = @TipoVehiculo
SET		@Patentep = @Patente
SET		@Usuariop = @Usuario                   
SET		@FechaIngresoDesdep = @FechaIngresoDesde
SET     @FechaIngresoHastap = @FechaIngresoHasta                      
SET		@FechaSalidaDesdep = @FechaSalidaDesde                       
SET		@FechaSalidaHastap = @FechaSalidaHasta			                         
SET		@TipoPesadap = @TipoPesada

SELECT        R.Id, ISNULL(TipoVehiculo.Descripcion, 'Camión') AS 'Vehiculo', TC.Descripcion AS 'Tipo Comercial', M.Descripcion AS 'Material', R.Id AS 'Nº de Orden', 
                         TipoDocumentoIngreso.Descripcion AS 'Tipo de Documento', R.NumeroDocumentoIngreso AS 'N° de Documento', R.Patente, R.FechaInicio AS 'Fecha/Hora de Ingreso', R.FechaEgreso AS 'Fecha/Hora de Egreso', 
                         R.PesoBruto AS 'Peso Bruto en Balanza', R.PesoTara AS 'Peso Tara en Balanza', R.PesoBruto - R.PesoTara AS 'Peso Neto en Balanza', R.PesoBrutoOrigen - R.PesoTaraOrigen AS 'Peso Neto en Origen', 
                         (R.PesoBrutoOrigen - R.PesoTaraOrigen) - (R.PesoBruto - R.PesoTara) AS 'Diferencia en Kilogramos', (CASE WHEN analisisporcaracteristica.valoranalisis IS NULL 
                         THEN caladoporcaracteristica.valorcalado ELSE analisisporcaracteristica.valoranalisis END) AS 'Humedad', 
                         (CASE workflow.tipodeworkflow WHEN 0 THEN centro.descripcion WHEN 1 THEN OtroCentro.descripcion END) AS 'Centro Destino', 
                         (CASE workflow.tipodeworkflow WHEN 0 THEN almacen.descripcion WHEN 1 THEN OtroAlmacen.descripcion END) AS 'Almacen Destino', 
                         (CASE workflow.tipodeworkflow WHEN 0 THEN OtroCentro.descripcion WHEN 1 THEN centro.descripcion END) AS 'Centro Origen', 
                         (CASE workflow.tipodeworkflow WHEN 0 THEN OtroAlmacen.descripcion WHEN 1 THEN almacen.descripcion END) AS 'Almacen Origen', TRANSP.Cuit, TRANSP.RazonSocial AS 'Transportista', 
                         BBruto.TipoBalanza AS 'TipoPesada', BBruto.Nombre AS 'BalanzaBruto', BTara.Nombre AS 'BalanzaTara', R.Usuario, C.TipoVehiculo, Proveedor.Descripcion AS Proveedor, Corredor.Descripcion AS Corredor, 
                         Entregador.DescripcionCorta AS Entregador, WorkFlow.Descripcion AS WorkFlow, Centro.Descripcion AS Centro
FROM            Recorrido AS R WITH (NOLOCK) INNER JOIN
                         Workflow AS WorkFlow WITH (NOLOCK) ON R.Workflow_Id = WorkFlow.Id INNER JOIN
                         TipoDocumentoIngreso WITH (NOLOCK) ON TipoDocumentoIngreso.Id = R.TipoDocumentoIngreso INNER JOIN
                         TipoComercial AS TC WITH (NOLOCK) ON R.TipoComercial_Id = TC.Id INNER JOIN
                         Material AS M WITH (NOLOCK) ON R.Material_Id = M.Id INNER JOIN
                         Transportista AS TRANSP WITH (NOLOCK) ON R.Transportista_Id = TRANSP.Id INNER JOIN
                         Almacen AS Almacen WITH (NOLOCK) ON Almacen.Id = R.Almacen_Id INNER JOIN
                         Centro AS Centro WITH (NOLOCK) ON Centro.Id = R.Centro_Id LEFT OUTER JOIN
                         Vehiculo AS V WITH (NOLOCK) ON R.Vehiculo_Id = V.Id LEFT OUTER JOIN
                         CartaPorte AS C WITH (NOLOCK) ON V.CartaPorte_Id = C.Id LEFT OUTER JOIN
                         TipoVehiculo WITH (NOLOCK) ON TipoVehiculo.Id = R.TipoVehiculo LEFT OUTER JOIN
                         Recorrido AS Rotro WITH (NOLOCK) ON Rotro.Id &lt;&gt; R.Id AND Rotro.NumeroDocumentoIngreso = R.NumeroDocumentoIngreso AND R.Rechazado &lt;&gt; 1 AND EXISTS
                             (SELECT        Id
                               FROM            Workflow AS wOtro WITH (NOLOCK)
                               WHERE        (Id = Rotro.Workflow_Id) AND (TipoDeWorkflow &lt;&gt; WorkFlow.TipoDeWorkflow)) LEFT OUTER JOIN
                         Balanza AS BBruto WITH (NOLOCK) ON R.BalanzaBruto_Id = BBruto.Id LEFT OUTER JOIN
                         Balanza AS BTara WITH (NOLOCK) ON R.BalanzaTara_Id = BTara.Id LEFT OUTER JOIN
                         Almacen AS OtroAlmacen WITH (NOLOCK) ON OtroAlmacen.Id = Rotro.Almacen_Id LEFT OUTER JOIN
                         Centro AS OtroCentro WITH (NOLOCK) ON OtroCentro.Id = Rotro.Centro_Id LEFT OUTER JOIN
                         Proveedor AS Proveedor WITH (NOLOCK) ON Proveedor.Id = C.TitularCartaPorte_Id LEFT OUTER JOIN
                         Proveedor AS Corredor WITH (NOLOCK) ON Corredor.Id = C.Corredor_Id LEFT OUTER JOIN
                         Entregador AS Entregador WITH (NOLOCK) ON Entregador.Id = C.Entregador_Id LEFT OUTER JOIN
                         AnalisisDeCalidad WITH (NOLOCK) ON AnalisisDeCalidad.Calado_Id = R.Calado_Id LEFT OUTER JOIN
                         CaladoPorCaracteristica WITH (NOLOCK) ON CaladoPorCaracteristica.Calado_Id = R.Calado_Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH (NOLOCK)
                               WHERE        (Id = CaladoPorCaracteristica.CaracteristicaDeCalidad_Id) AND (EsHumedad = 1)) LEFT OUTER JOIN
                         AnalisisPorCaracteristica WITH (NOLOCK) ON AnalisisPorCaracteristica.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CaracteristicaDeCalidad WITH (NOLOCK)
                               WHERE        (Id = AnalisisPorCaracteristica.CaracteristicaDeCalidad_Id) AND (EsHumedad = 1))
WHERE        (R.Centro_Id = @Centrop OR
                         @Centrop IS NULL) AND (R.Workflow_Id = @Workflowp OR
                         @Workflowp IS NULL) AND (R.TipoComercial_Id = @TipoComercialp OR
                         @TipoComercialp IS NULL) AND (R.Material_Id = @Materialp OR
                         @Materialp IS NULL) AND ((CASE workflow.tipodeworkflow WHEN 0 THEN OtroAlmacen.Id WHEN 1 THEN almacen.Id END) = @AlmacenOrigenp OR
                         @AlmacenOrigenp IS NULL) AND ((CASE workflow.tipodeworkflow WHEN 0 THEN almacen.Id WHEN 1 THEN OtroAlmacen.Id END) = @AlmacenDestinop OR
                         @AlmacenDestinop IS NULL) AND (R.BalanzaBruto_Id = @BalanzaBrutop OR
                         @BalanzaBrutop IS NULL) AND (R.BalanzaTara_Id = @BalanzaTarap OR
                         @BalanzaTarap IS NULL) AND (Proveedor.Id = @Proveedorp OR
                         @Proveedorp IS NULL) AND (Corredor.Id = @Corredorp OR
                         @Corredorp IS NULL) AND (Entregador.Id = @Entregadorp OR
                         @Entregadorp IS NULL) AND ((@TipoVehiculop IS NULL) OR 
						 (R.TipoVehiculo = @TipoVehiculop)) AND (@Patentep = '' OR
                         R.Patente = @Patentep) AND (@Usuariop = '' OR
                         R.Usuario LIKE '%' + @Usuariop + '%') AND (@FechaIngresoDesdep IS NULL OR
                         @FechaIngresoDesdep &lt;= R.FechaInicio) AND (@FechaIngresoHastap IS NULL OR
                         @FechaIngresoHastap &gt;= R.FechaInicio) AND (@FechaSalidaDesdep IS NULL OR
                         @FechaSalidaDesdep &lt;= R.FechaEgreso) AND (@FechaSalidaHastap IS NULL OR
                         @FechaSalidaHastap &gt;= R.FechaEgreso) AND (@TipoPesadap IS NULL OR
                         @TipoPesadap = BBruto.TipoBalanza)</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Vehiculo">
          <DataField>Vehiculo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tipo_Comercial">
          <DataField>Tipo Comercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nº_de_Orden">
          <DataField>Nº de Orden</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Tipo_de_Documento">
          <DataField>Tipo de Documento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="N__de_Documento">
          <DataField>N° de Documento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha_Hora_de_Ingreso">
          <DataField>Fecha/Hora de Ingreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Fecha_Hora_de_Egreso">
          <DataField>Fecha/Hora de Egreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Peso_Bruto_en_Balanza">
          <DataField>Peso Bruto en Balanza</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Peso_Tara_en_Balanza">
          <DataField>Peso Tara en Balanza</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Peso_Neto_en_Balanza">
          <DataField>Peso Neto en Balanza</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Peso_Neto_en_Origen">
          <DataField>Peso Neto en Origen</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Diferencia_en_Kilogramos">
          <DataField>Diferencia en Kilogramos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Humedad">
          <DataField>Humedad</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Centro_Destino">
          <DataField>Centro Destino</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Almacen_Destino">
          <DataField>Almacen Destino</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Centro_Origen">
          <DataField>Centro Origen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Almacen_Origen">
          <DataField>Almacen Origen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cuit">
          <DataField>Cuit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Transportista">
          <DataField>Transportista</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoPesada">
          <DataField>TipoPesada</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BalanzaBruto">
          <DataField>BalanzaBruto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
