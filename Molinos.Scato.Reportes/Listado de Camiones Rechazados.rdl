    <DataSet Name="Balanzas">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Balanza, '' AS ord
UNION
SELECT        Id, Nombre AS Balanza, Nombre AS ord
FROM            Balanza WITH (NOLOCK)
WHERE        (Centro_Id = @Centro) OR
                         (@Centro = NULL)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
