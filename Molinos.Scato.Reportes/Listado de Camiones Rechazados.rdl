        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposComerciales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS TipoComercial, '' AS ord
UNION
SELECT        Id, Descripcion AS TipoComercial, Descripcion AS ord
FROM            TipoComercial WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Material, '' AS ord
UNION
SELECT        Material.Id, Material.Descripcion AS Material, Material.Descripcion AS ord
FROM            Material WITH (NOLOCK) INNER JOIN
                         Recorrido WITH (NOLOCK) ON Recorrido.Material_Id = Material.Id AND Recorrido.Centro_Id = @Centro
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Almacen">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Almacen, '' AS ord
UNION
SELECT        Id, Descripcion AS Almacen, Descripcion AS ord
FROM            Almacen WITH (NOLOCK)
WHERE        (Centro_Id = @Centro) OR
                         (@Centro = NULL)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
