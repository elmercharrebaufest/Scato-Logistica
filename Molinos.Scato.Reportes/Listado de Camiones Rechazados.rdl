<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>44ffd377-21b7-4c53-a6c0-d447bfaa36b4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@NivelDeDetalle">
            <Value>=Parameters!NivelDeDetalle.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoVehiculo">
            <Value>=Parameters!TipoVehiculo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BalanzaBruto">
            <Value>=Parameters!BalanzaBruto.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BalanzaTara">
            <Value>=Parameters!BalanzaTara.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoPesada">
            <Value>=Parameters!TipoPesada.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Tipocomercial">
            <Value>=Parameters!TipoComercial.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AlmacenOrigen">
            <Value>=Parameters!AlmacenOrigen.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AlmacenDestino">
            <Value>=Parameters!AlmacenDestino.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoDesde">
            <Value>=Parameters!FechaIngresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoHasta">
            <Value>=Parameters!FechaIngresoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaSalidaDesde">
            <Value>=Parameters!FechaEgresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaSalidaHasta">
            <Value>=Parameters!FechaEgresoHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>Declare @NivelDeDetallep int, @TipoVehiculop int, @BalanzaBrutop int, @BalanzaTarap int, @Centrop int, @Materialp int, @TipoPesadap int, @Tipocomercialp int, 
@AlmacenOrigenp int, @AlmacenDestinop int, @Patentep nvarchar(MAX), @FechaIngresoDesdep datetime, @FechaIngresoHastap datetime, @FechaSalidaDesdep datetime,
@FechaSalidaHastap datetime

set @NivelDeDetallep = @NivelDeDetalle
set @TipoVehiculop = @TipoVehiculo
set @BalanzaBrutop = @BalanzaBruto
set @BalanzaTarap = @BalanzaTara
set @Centrop = @Centro
set @Materialp =@Material
set @TipoPesadap = @TipoPesada
set @Tipocomercialp = @Tipocomercial
set @AlmacenOrigenp =@AlmacenOrigen
set @AlmacenDestinop =@AlmacenDestino
set @Patentep =@Patente
set @FechaIngresoDesdep =@FechaIngresoDesde
set @FechaIngresoHastap =@FechaIngresoHasta
set @FechaSalidaDesdep =@FechaSalidaDesde
set @FechaSalidaHastap =@FechaSalidaHasta

SELECT DISTINCT ISNULL(tipovehiculo.descripcion,'Camión')         AS 'Vehiculo', 
                TC.descripcion                   AS 'Tipo Comercial', 
                M.descripcion                    AS 'Material', 
                tipodocumentoingreso.descripcion AS 'Tipo de Documento', 
                R.numerodocumentoingreso         AS 'Nro. Documento Ingreso', 
                R.patente                        AS 'Patente', 
                R.FechaInicio                       AS 'Fecha/Hora de Ingreso', 
                R.fechaegreso                    AS 'Fecha/Hora de Egreso', 
                R.pesobruto                      AS 'Peso Bruto en Balanza', 
                R.pesotara                       AS 'Peso Tara en Balanza', 
                R.pesobruto - R.[pesotara]       AS 'Peso Neto en Balanza', 
                CASE WHEN EXISTS(SELECT 1 
						FROM   recorrido rReingreso WITH (NOLOCK)
							INNER JOIN Workflow wReingreso WITH (NOLOCK)
							ON wReingreso.Id = rReingreso.Workflow_Id
						WHERE (R.Id &lt; rReingreso.Id AND wReingreso.TipoDeWorkflow = W.TipoDeWorkflow AND rReingreso.Rechazado = 0 AND rReingreso.Terminado = 1 AND rReingreso.numerodocumentoingreso = R.NumeroDocumentoIngreso)) THEN 'Sí' 
					ELSE 'No' 
                END                              AS 'Reingreso',
				CP.Cupo							 AS 'Cupo',
                MO.descripcion                   AS 'Motivo', 
                CR.comentario, 
	R.Centro_Id As CentroId
FROM   dbo.recorrido AS R WITH (NOLOCK)
       INNER JOIN tipocomercial TC WITH (NOLOCK)
               ON R.tipocomercial_id = TC.id 
       INNER JOIN material M WITH (NOLOCK)
               ON R.material_id = M.id 
       INNER JOIN tipodocumentoingreso WITH (NOLOCK)
               ON R.tipodocumentoingreso = tipodocumentoingreso.id 
       INNER JOIN workflow AS W WITH (NOLOCK)
              ON R.workflow_id = W.id
       LEFT JOIN controlrecorrido CR WITH (NOLOCK)
              ON R.instanciaworkflow = CR.workflowinstanceid AND EXISTS(Select 1 from Motivo WITH (NOLOCK) where CR.mensaje = Motivo.descripcion)
       LEFT JOIN motivo MO WITH (NOLOCK)
               ON CR.mensaje = MO.descripcion
       LEFT JOIN tipovehiculo WITH (NOLOCK)
               ON R.tipovehiculo = tipovehiculo.id
	   LEFT JOIN balanza AS balanzaBruto WITH (NOLOCK)
			  ON R.BalanzaBruto_Id = balanzaBruto.id
	   LEFT JOIN balanza AS balanzaTara WITH (NOLOCK)
			  ON R.BalanzaTara_Id = balanzaTara.id
	   LEFT JOIN tipopesada tp1 WITH (NOLOCK)
			  ON balanzaBruto.modalidad = tp1.id	
	   LEFT JOIN tipopesada tp2 WITH (NOLOCK)
			  ON balanzaTara.modalidad = tp2.id
	   LEFT JOIN Vehiculo V WITH (NOLOCK)
			  ON V.id = r.Vehiculo_Id
	   LEFT JOIN CartaPorte CP WITH (NOLOCK)
			  ON CP.Id = v.CartaPorte_Id
			  
WHERE  R.rechazado = 1
AND (@NivelDeDetallep &lt;&gt; 0)
AND ((@TipoVehiculop IS NULL) or (R.TipoVehiculo = @TipoVehiculop))
AND (R.balanzabruto_id = @BalanzaBrutop or @BalanzaBrutop IS NULL)
AND (R.balanzatara_id = @BalanzaTarap or @BalanzaTarap IS NULL)
AND (R.centro_id = @Centrop or @Centrop IS NULL)
AND (R.material_id = @Materialp or @Materialp IS NULL)
AND (tp2.Id = @TipoPesadap or @TipoPesadap IS NULL)
AND (R.TipoComercial_Id = @Tipocomercialp or @Tipocomercialp IS NULL)

AND (R.almacen_id = @AlmacenOrigenp or @AlmacenOrigenp IS NULL)
AND (R.almacen_id = @AlmacenDestinop or @AlmacenDestinop IS NULL)
AND (@Patentep = '' OR
                         R.Patente = @Patentep) AND  (@FechaIngresoDesdep IS NULL OR
                         @FechaIngresoDesdep &lt;= R.FechaInicio) AND (@FechaIngresoHastap IS NULL OR
                         @FechaIngresoHastap &gt;= R.FechaInicio) AND (@FechaSalidaDesdep IS NULL OR
                         @FechaSalidaDesdep &lt;= R.FechaEgreso) AND (@FechaSalidaHastap IS NULL OR
                         @FechaSalidaHastap &gt;= R.FechaEgreso)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Vehiculo">
          <DataField>Vehiculo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tipo_Comercial">
          <DataField>Tipo Comercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tipo_de_Documento">
          <DataField>Tipo de Documento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nro__Documento_Ingreso">
          <DataField>Nro. Documento Ingreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha_Hora_de_Ingreso">
          <DataField>Fecha/Hora de Ingreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Fecha_Hora_de_Egreso">
          <DataField>Fecha/Hora de Egreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Peso_Bruto_en_Balanza">
          <DataField>Peso Bruto en Balanza</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Peso_Tara_en_Balanza">
          <DataField>Peso Tara en Balanza</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Peso_Neto_en_Balanza">
          <DataField>Peso Neto en Balanza</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Reingreso">
          <DataField>Reingreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Comentario">
          <DataField>comentario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Cupo">
          <DataField>Cupo</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Centro, '' AS ord
UNION
SELECT        Id, Descripcion AS Centro, Descripcion AS ord
FROM            Centro WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="NivelDeDetalle">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        1 AS Id, 'Detallado' AS Nivel
UNION
SELECT        2 AS Id, 'Resumido' AS Nivel</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Nivel">
          <DataField>Nivel</DataField>
