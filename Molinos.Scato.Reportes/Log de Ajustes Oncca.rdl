  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>da93e132-c283-4745-9f3d-ae44584b6b48</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int
declare @Materialp int
declare @FechaDesdep datetime
declare @FechaHastap datetime

set @CentroIdp = @CentroId
set @Materialp = @Material
set @FechaDesdep = @FechaDesde
set @FechaHastap = @FechaHasta

SELECT        la.Tipo, la.NombreUsuario AS 'Usuario', la.Fecha, TipoComprobanteOncca.CodigoOncca + '-' + TipoComprobanteOncca.Descripcion AS 'Tipo Doc', la.NumeroDocumentoIngreso AS 'Nº Doc', 
                         la.PesoBrutoIngreso AS 'Kg Bruto Ingreso', la.PesoNetoIngreso AS 'Kg Neto Ingreso', la.PesoNetoEgreso AS 'Kg Neto Egreso', la.Observaciones, la.FechaAjuste AS 'Fecha Ajuste', LA.Material_Id
FROM LogAjusteDeStock AS la WITH(NOLOCK)
INNER JOIN      TipoComprobanteOncca WITH(NOLOCK) ON TipoComprobanteOncca.Id = la.TipoComprobanteOncca_Id
                       
WHERE        (la.Centro_Id = @CentroIdp)   AND (la.Material_Id = @Materialp) AND 
			(la.FechaAjuste &gt;= @FechaDesdep) AND
			(la.FechaAjuste &lt;= @FechaHastap )</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Tipo">
          <DataField>Tipo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Tipo_Doc">
          <DataField>Tipo Doc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nº_Doc">
          <DataField>Nº Doc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Kg_Bruto_Ingreso">
          <DataField>Kg Bruto Ingreso</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Kg_Neto_Ingreso">
          <DataField>Kg Neto Ingreso</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Kg_Neto_Egreso">
          <DataField>Kg Neto Egreso</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Observaciones">
          <DataField>Observaciones</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha_Ajuste">
          <DataField>Fecha Ajuste</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Material_Id">
          <DataField>Material_Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Material">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, Descripcion AS Material
FROM            Material WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            AjusteDeStock WITH (NOLOCK)
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @Centro))
ORDER BY Material</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
