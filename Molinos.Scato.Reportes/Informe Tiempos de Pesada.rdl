<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8f01a068-126b-463b-ae79-35dd7323f6e8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHora_Desde">
            <Value>=Parameters!FechaHora_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHora_Hasta">
            <Value>=Parameters!FechaHora_Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Circuito">
            <Value>=Parameters!Circuito.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int, @FechaHora_Desdep datetime, @FechaHora_Hastap datetime

set @CentroIdp = @CentroId
set @FechaHora_Desdep = @FechaHora_Desde
set @FechaHora_Hastap = @FechaHora_Hasta

SELECT 
R.Id,
 R.patente as Patente, 
       material.descripcion       AS Material, 
       r.PesoTaraFecha,       
       r.PesoBrutoFecha,  
	   case when WorkFlow.TipoDeWorkflow = 0 then 
			CONVERT(VARCHAR(5), DATEDIFF(SECOND,r.PesoBrutoFecha,r.PesoTaraFecha)/60/60) + ':' + RIGHT('0' + CONVERT(VARCHAR(2), DATEDIFF(SECOND,r.PesoBrutoFecha,r.PesoTaraFecha)/60%60), 2)
       	else 
			CONVERT(VARCHAR(5), DATEDIFF(SECOND,r.PesoTaraFecha,r.PesoBrutoFecha)/60/60) + ':' + RIGHT('0' + CONVERT(VARCHAR(2), DATEDIFF(SECOND,r.PesoTaraFecha,r.PesoBrutoFecha)/60%60), 2)
       end 
	   
	   as Diferencia,

case when WorkFlow.TipoDeWorkflow = 0 then 
			DATEDIFF(SECOND,r.PesoBrutoFecha,r.PesoTaraFecha)
       	else 
			DATEDIFF(SECOND,r.PesoTaraFecha,r.PesoBrutoFecha)
       end 
	   
	   as DiferenciaEnSeg,
       COALESCE((R.PesoBruto - R.PesoTara),0) AS 'KilosNeto', 
	   case when WorkFlow.TipoDeWorkflow = 0 then 'Ingreso' else 'Egreso' end as Circuito
FROM   dbo.recorrido AS r WITH(NOLOCK)
	   INNER JOIN [workflow] AS WorkFlow WITH(NOLOCK)
               ON R.workflow_id = workflow.id 
       INNER JOIN [material] WITH(NOLOCK)
               ON R.Material_Id = [material].id                      
       
WHERE  R.[Terminado] = 1
	--and R.Rechazado = 0
	AND (R.Centro_Id = @CentroIdp) 
	AND (WorkFlow.TipoDeWorkflow = @Circuito or @Circuito is null) 
	AND (R.FechaEgreso &gt;= @FechaHora_Desdep AND R.FechaEgreso&lt;= @FechaHora_Hastap)
	AND (material.Id in (@Material))
order by r.FechaInicio</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PesoTaraFecha">
          <DataField>PesoTaraFecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PesoBrutoFecha">
          <DataField>PesoBrutoFecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Diferencia">
          <DataField>Diferencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DiferenciaEnSeg">
          <DataField>DiferenciaEnSeg</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="KilosNeto">
          <DataField>KilosNeto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Circuito">
          <DataField>Circuito</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Material">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, Descripcion AS Material
FROM            Material WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            Recorrido WITH (NOLOCK)
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @CentroId))
ORDER BY Material</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDs">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
