<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3a956ca3-a161-42d3-b49b-1146919a227c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PuestoDeTrabajoId">
            <Value>=Parameters!PuestoDeTrabajoId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select  
LogLecturaDeTarjeta.Fecha,
LogLecturaDeTarjeta.Patente,
isnull(LogLecturaDeTarjeta.PatenteLeida,'') as PatenteLeida,
case when isnull(LogLecturaDeTarjeta.PatenteLeida,'')=LogLecturaDeTarjeta.Patente  then 1 else 0 end as PatenteLeidaCorrectamente ,
puestodetrabajo.nombrepuesto
from LogLecturaDeTarjeta
inner join puestodetrabajo on LogLecturaDeTarjeta.puestodetrabajo_id = puestodetrabajo.id
where  LogLecturaDeTarjeta.Fecha  &gt; @FechaDesde and  LogLecturaDeTarjeta.Fecha &lt; DATEADD(day, 1, @FechaHasta)
and (@PuestoDeTrabajoId is null or @PuestoDeTrabajoId  = puestodetrabajo_id)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PatenteLeida">
          <DataField>PatenteLeida</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PatenteLeidaCorrectamente">
          <DataField>PatenteLeidaCorrectamente</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="nombrepuesto">
          <DataField>nombrepuesto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PuestosDeTrabajo">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS NombrePuesto
UNION
select Id,
NombrePuesto
from PuestoDeTrabajo</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NombrePuesto">
          <DataField>NombrePuesto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
