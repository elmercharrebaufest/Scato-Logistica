      <Filters>
        <Filter>
          <FilterExpression>=Fields!FechaEgreso.Value</FilterExpression>
          <Operator>Between</Operator>
          <FilterValues>
            <FilterValue>=Parameters!FechaHoraEgresoDesde.Value</FilterValue>
            <FilterValue>=Parameters!FechaHoraEgresoHasta.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=IsNothing(Parameters!FechaHoraIngresoDesde.Value) OR CDate(Fields!FechaIngreso.Value) &gt;= Parameters!FechaHoraIngresoDesde.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue DataType="Boolean">true</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=IsNothing(Parameters!FechaHoraIngresoHasta.Value) OR CDate(Fields!FechaIngreso.Value) &lt;= Parameters!FechaHoraIngresoHasta.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue DataType="Boolean">true</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Id, Descripcion, CodigoSAP
FROM            Centro WITH (NOLOCK)
ORDER BY Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CodigoSAP">
          <DataField>CodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Transportista">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Transportista
UNION
SELECT        Id, RazonSocial AS Transportista
FROM            Transportista WITH (NOLOCK)
ORDER BY Transportista</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Transportista">
          <DataField>Transportista</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoComercial">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS TipoComercial
UNION
SELECT        Id, Descripcion AS TipoComercial
FROM            TipoComercial WITH (NOLOCK)</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Material">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Material
UNION
SELECT        Id, Descripcion AS Material
FROM            Material WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            Recorrido WITH (NOLOCK)
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @CentroId))</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Workflow">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Workflow
UNION
SELECT        Id, Descripcion AS Workflow
FROM            Workflow WITH (NOLOCK)
WHERE        (Centro_Id = @CentroId) OR
                         (@CentroId = NULL)</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Workflow">
          <DataField>Workflow</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
