<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a1a16f96-5d9a-49b5-9aa6-b66d73ee436a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Transportista">
            <Value>=Parameters!Transportista.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=Parameters!TipoComercial.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Workflow">
            <Value>=Parameters!Workflow.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@AlmacenOrigen">
            <Value>=Parameters!AlmacenOrigen.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@AlmacenDestino">
            <Value>=Parameters!AlmacenDestino.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraIngresoDesde">
            <Value>=Parameters!FechaHoraIngresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraIngresoHasta">
            <Value>=Parameters!FechaHoraIngresoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraEgresoDesde">
            <Value>=Parameters!FechaHoraEgresoDesde.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int,@Transportistap int,@Materialp int,@TipoComercialp int,@Workflowp int,@AlmacenOrigenp nvarchar(MAX),@AlmacenDestinop nvarchar(MAX),@FechaHoraIngresoDesdep datetime, @FechaHoraIngresoHastap datetime,@FechaHoraEgresoDesdep datetime,@FechaHoraEgresoHastap datetime


set @CentroIdp= @CentroId
set @Transportistap=@Transportista
set @Materialp=@Material
set @TipoComercialp=@TipoComercial
set @Workflowp = @Workflow
set @AlmacenOrigenp=@AlmacenOrigen
set @AlmacenDestinop= @AlmacenDestino
set @FechaHoraIngresoDesdep =@FechaHoraIngresoDesde
set @FechaHoraIngresoHastap = @FechaHoraIngresoHasta
set @FechaHoraEgresoDesdep =@FechaHoraEgresoDesde
set @FechaHoraEgresoHastap =@FechaHoraIngresoHasta

SELECT        TipoDocumentoIngreso.Descripcion AS TipoDocumentoIngreso, Recorrido.NumeroDocumentoIngreso, Material.Descripcion AS Material, Transportista.RazonSocial AS Transportista, 
                         Chofer.Nombre + ' ' + Chofer.Apellido AS Chofer, recorridoOtro.PesoBruto - recorridoOtro.PesoTara AS PesoOrigen, Recorrido.PesoBruto - Recorrido.PesoTara AS PesoDestino, 
                         (recorridoOtro.PesoBruto - recorridoOtro.PesoTara) - (Recorrido.PesoBruto - Recorrido.PesoTara) AS DiferenciaPeso, Recorrido.FechaInicio AS FechaIngreso, Recorrido.FechaEgreso,
                             (SELECT        Descripcion
                               FROM            Centro AS centroOtro
                               WHERE        (Id = recorridoOtro.Centro_Id)) AS CentroOrigen,
                             (SELECT        Id
                               FROM            Centro AS centroOtro
                               WHERE        (Id = recorridoOtro.Centro_Id)) AS CentroOrigenId,
                             (SELECT        Descripcion
                               FROM            Centro AS centroOtro
                               WHERE        (Recorrido.Centro_Id = Id)) AS CentroDestino,
                             (SELECT        Id
                               FROM            Centro AS centroOtro
                               WHERE        (Recorrido.Centro_Id = Id)) AS CentroDestinoId, Workflow.Descripcion AS Workflow, tp.Descripcion AS TipoComercial, Transportista.Cuit AS TransportistaCuit, 
                         Chofer.NumeroDeDocumento AS ChoferDocumento, recorridoOtro.Almacen_Id AS AlmacenOrigen,
                             (SELECT        Descripcion
                               FROM            Almacen
                               WHERE        (Id = recorridoOtro.Almacen_Id)) AS AlmacenOrigenDescripcion, Recorrido.Almacen_Id AS AlmacenDestino,
                             (SELECT        Descripcion
                               FROM            Almacen AS Almacen_1
                               WHERE        (Id = Recorrido.Almacen_Id)) AS AlmacenDestinoDescripcion, recorridoOtro.PesoBruto, recorridoOtro.PesoTara, Transportista.Id AS TransportistaId, Material.Id AS MaterialId, 
                         tp.Id AS TipoComercialId, Workflow.Id AS WorkflowId, recorridoOtro.Workflow_Id AS Expr1
FROM            Recorrido WITH(NOLOCK)LEFT OUTER JOIN
                         Vehiculo WITH(NOLOCK) ON Recorrido.Vehiculo_Id = Vehiculo.Id LEFT OUTER JOIN
                         CartaPorte WITH(NOLOCK) ON Vehiculo.CartaPorte_Id = CartaPorte.Id LEFT OUTER JOIN
                         OrdenCargaInterna WITH(NOLOCK) ON OrdenCargaInterna.NumeroOrden = Recorrido.NumeroDocumentoIngreso LEFT OUTER JOIN
                         Transportista WITH(NOLOCK) ON Recorrido.Transportista_Id = Transportista.Id LEFT OUTER JOIN
                         TipoDocumentoIngreso WITH(NOLOCK) ON Recorrido.TipoDocumentoIngreso = TipoDocumentoIngreso.Id LEFT OUTER JOIN
                         Chofer WITH(NOLOCK) ON Recorrido.Chofer_Id = Chofer.Id LEFT OUTER JOIN
                         Workflow WITH(NOLOCK) ON Recorrido.Workflow_Id = Workflow.Id LEFT OUTER JOIN
                         Material WITH(NOLOCK) ON Recorrido.Material_Id = Material.Id LEFT OUTER JOIN
                         Recorrido  AS recorridoOtro WITH(NOLOCK) ON recorridoOtro.NumeroDocumentoIngreso = CartaPorte.NroCartaPorte AND recorridoOtro.Id &lt;&gt; Recorrido.Id AND recorridoOtro.Rechazado &lt;&gt; 'True' AND EXISTS
                             (SELECT        Id
                               FROM            Workflow AS wOtro WITH(NOLOCK)
                               WHERE        (Id = recorridoOtro.Workflow_Id) AND (TipoDeWorkflow &lt;&gt; Workflow.TipoDeWorkflow)) LEFT OUTER JOIN
                         TipoComercial AS tp WITH(NOLOCK) ON Recorrido.TipoComercial_Id = tp.Id
 LEFT OUTER JOIN
                         Almacen WITH(NOLOCK) ON Recorrido.Almacen_Id = Almacen .Id 
 LEFT OUTER JOIN
                         Almacen as AlmacenOtro WITH(NOLOCK) ON recorridoOtro.Almacen_Id = AlmacenOtro.Id 

WHERE        (Workflow.TipoDeWorkflow = 0) AND (recorridoOtro.NumeroDocumentoIngreso = Recorrido.NumeroDocumentoIngreso)
 AND (Recorrido.Rechazado &lt;&gt; 'True') 
 AND (Transportista.Id = @Transportistap OR @Transportistap IS NULL) 
 AND (Material.Id = @Materialp OR   @Materialp IS NULL) 
 AND (tp.Id = @TipoComercialp OR  @TipoComercialp IS NULL)
  AND (Workflow.Id = @Workflowp OR   @Workflowp IS NULL) 
  AND (AlmacenOtro.CodigoSAP = @AlmacenOrigenp OR  @AlmacenOrigenp = '') 
  AND (Almacen.CodigoSAP = @AlmacenDestinop OR   @AlmacenDestinop  = '') 
  AND (Recorrido.Centro_Id = @CentroIdp OR     @CentroIdp IS NULL)
  AND (@FechaHoraIngresoDesdep IS NULL OR Recorrido.FechaInicio &gt;= @FechaHoraIngresoDesdep)
  AND (@FechaHoraIngresoHastap IS NULL OR Recorrido.FechaInicio &lt;= @FechaHoraIngresoHastap)
  AND (@FechaHoraEgresoDesdep &lt;= Recorrido.FechaEgreso)AND(Recorrido.FechaEgreso &lt;= @FechaHoraEgresoHastap)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TipoDocumentoIngreso">
          <DataField>TipoDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
