          <DataField>TransportistaCuit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ChoferDocumento">
          <DataField>ChoferDocumento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AlmacenOrigen">
          <DataField>AlmacenOrigen</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AlmacenOrigenDescripcion">
          <DataField>AlmacenOrigenDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AlmacenDestino">
          <DataField>AlmacenDestino</DataField>
