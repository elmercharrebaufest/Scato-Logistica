<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3c7d5602-5396-4c1c-9c07-6bc0a1900780</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AlmacenDestino">
            <Value>=Parameters!AlmacenDestino.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoCompra">
            <Value>=Parameters!TipoCompra.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoDestino">
            <Value>=Parameters!TipoDestino.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoSustentable">
            <Value>=Parameters!TipoSustentable.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare 
@FechaDesdep datetime, 
@FechaHastap datetime,
@MaterialIdp int,
@AlmacenIdp int,
@CuitMOA varchar(11),
@CuitMRP varchar(11),
@TipoCompraIdp varchar(1),
@CuitVicentin varchar(11),
@CuitChivilcoy varchar(13),
@TipoDestinoIdp varchar(1),
@TipoSustentableIdp varchar(1)

set @FechaDesdep = @FechaDesde
set @FechaHastap = @FechaHasta
set @MaterialIdp = @Material
set @AlmacenIdp = @AlmacenDestino
set @CuitMOA = '30715118773'
set @CuitMRP = '30500858628'
set @TipoCompraIdp = @TipoCompra
set @CuitVicentin = '30500959629'
set @CuitChivilcoy = '30-50085862-8'
set @TipoDestinoIdp = @TipoDestino
set @TipoSustentableIdp = @TipoSustentable

SELECT DISTINCT
	SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 4, 1) Pref,
	SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 5, 8) NroCartaPorte,
	'A' TipoTransporte,
	0 NroVagon,
	cp.FechaCarga FechaCartaPorte,
	cp.FechaVencimiento  FechaVencimiento,
	CASE WHEN cp.CEE = 'null' THEN NULL ELSE cp.CEE END CEE,
	CONCAT(RIGHT('00000' + CAST(cp.Sucursal AS VARCHAR(5)), 5), RIGHT('00000000' + CAST(cp.NroOrden AS VARCHAR(8)), 8))  NroCTG,
	cp.FechaCarga  FechaCTG,
	REPLACE(cp.TitularCuit, '-','') TitularCuit,
	cp.TitularRazonSocial TitularRS,
	'' NroPlanta,
	REPLACE(cp.IntermediarioCuit, '-','') IntermediarioCuit,
	cp.IntermediarioRazonSocial IntermediarioRS,
	CASE
		WHEN (cp.CuitRemitenteComercialVentaSecundaria2 IS NOT NULL 
			AND cp.CuitRemitenteComercialVentaSecundaria2 NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN REPLACE(cp.CuitRemitenteComercialVentaSecundaria2, '-','')
		WHEN (cp.CuitRemitenteComercialVentaSecundaria IS NOT NULL 
			AND cp.CuitRemitenteComercialVentaSecundaria NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN REPLACE(cp.CuitRemitenteComercialVentaSecundaria, '-','')
		WHEN (cp.CuitRemitenteComercialVentaPrimaria IS NOT NULL
			AND cp.CuitRemitenteComercialVentaPrimaria NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN REPLACE(cp.CuitRemitenteComercialVentaPrimaria, '-','')
		WHEN (cp.RemitenteCuit IS NOT NULL
			AND cp.RemitenteCuit NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN REPLACE(cp.RemitenteCuit, '-','')
		ELSE NULL
	END RemitenteCuit,
	CASE
		WHEN (cp.CuitRemitenteComercialVentaSecundaria2 IS NOT NULL
			AND cp.CuitRemitenteComercialVentaSecundaria2 NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN cp.RazonSocialRemitenteComercialVentaSecundaria2
		WHEN (cp.CuitRemitenteComercialVentaSecundaria IS NOT NULL
			AND cp.CuitRemitenteComercialVentaSecundaria NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN cp.RazonSocialRemitenteComercialVentaSecundaria
		WHEN (cp.CuitRemitenteComercialVentaPrimaria IS NOT NULL
			AND cp.CuitRemitenteComercialVentaPrimaria NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN cp.RazonSocialRemitenteComercialVentaPrimaria
		WHEN (cp.RemitenteCuit IS NOT NULL
			AND cp.RemitenteCuit NOT IN(@CuitMOA,@CuitMRP, ''))
		THEN cp.RemitenteRazonSocial
	END RemitenteRS,
	REPLACE(cp.CuitMercadoATermino, '-','') AgenteDeComprasCuit,
	cp.ProductoCodigo ProductoCodigo,
	m.DescripcionCorta Mercaderia,
	'' TipoGrano,
	cp.ProductoCosecha Cosecha,
	CASE WHEN ecc.CodigoSap in ('MPTRPGRA', 'MPMAZGRA') AND ccp.Valor &lt;= 3 THEN SUBSTRING(CONCAT('G',CAST(ccp.Valor AS varchar)), 1,2) ELSE 'CC' END Cal,
	cp.ProcedenciaCodigo ProcedenciaCodigo,
	cp.ProcedenciaLocalidad Procedencia,
	cp.ProcedenciaProvincia Provincia,
	cp.ProcedenciaCP CodigoPostal,
	cp.ProcedenciaPB KBPr,
	cp.ProcedenciaPT KTPr,
	cp.ProcedenciaPN KNPr,
	'' Observaciones,
	CASE
		WHEN  cp.DestinatarioCuit NOT IN(@CuitMOA,@CuitMRP)
		THEN NULL
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Productor'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) = '01'
			AND  (cp.CuitRemitenteComercialVentaPrimaria IS NULL 
				OR cp.CuitRemitenteComercialVentaPrimaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria IS NULL 
				OR cp.CuitRemitenteComercialVentaSecundaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria2 IS NULL
				OR cp.CuitRemitenteComercialVentaSecundaria2 IN(@CuitMOA,@CuitMRP ,''))
			AND cp.CorredorCuit IS NOT NULL AND cp.CorredorCuit != ''
		THEN REPLACE(cp.CorredorCuit, '-','')
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Productor'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) = '01'
			AND ( (cp.CuitRemitenteComercialVentaPrimaria IS NOT NULL 
				AND cp.CuitRemitenteComercialVentaPrimaria NOT IN(@CuitMOA,@CuitMRP, ''))
			OR (cp.CuitRemitenteComercialVentaSecundaria IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria NOT IN(@CuitMOA,@CuitMRP, ''))
			OR (cp.CuitRemitenteComercialVentaSecundaria2 IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria2 NOT IN(@CuitMOA,@CuitMRP, '') ))
			AND cp.CuitCorredorVentaSecundaria IS NOT NULL AND cp.CuitCorredorVentaSecundaria != ''
		THEN REPLACE(cp.CuitCorredorVentaSecundaria, '-','')
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Otro'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) != '01'
			AND (cp.RemitenteCuit IS NULL  
				OR cp.RemitenteCuit IN(@CuitMOA,@CuitMRP ,'') )
			AND cp.CuitCorredorVentaSecundaria IS NOT NULL AND cp.CuitCorredorVentaSecundaria != ''
		THEN REPLACE(cp.CuitCorredorVentaSecundaria, '-','')
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Otro'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) != '01'
			AND  (cp.RemitenteCuit IS NOT NULL 
				AND cp.RemitenteCuit NOT IN(@CuitMOA,@CuitMRP ,'')) 
			AND ( (cp.CuitRemitenteComercialVentaPrimaria IS NULL 
				OR cp.CuitRemitenteComercialVentaPrimaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria IS NULL
				OR cp.CuitRemitenteComercialVentaSecundaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria2 IS NULL
				OR cp.CuitRemitenteComercialVentaSecundaria2 IN(@CuitMOA,@CuitMRP ,'') ))
			AND cp.CorredorCuit IS NOT NULL AND cp.CorredorCuit != ''
		THEN REPLACE(cp.CorredorCuit, '-','')
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			
			--AND cp.CTG = 'Otro'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) != '01'
			AND (cp.RemitenteCuit IS NOT NULL
				AND cp.RemitenteCuit NOT IN(@CuitMOA,@CuitMRP ,'') )
			AND ( (cp.CuitRemitenteComercialVentaPrimaria IS NOT NULL
				AND cp.CuitRemitenteComercialVentaPrimaria NOT IN(@CuitMOA,@CuitMRP ,'')) 
			OR (cp.CuitRemitenteComercialVentaSecundaria IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria NOT IN(@CuitMOA,@CuitMRP ,'') )
			OR (cp.CuitRemitenteComercialVentaSecundaria2 IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria2 NOT IN(@CuitMOA,@CuitMRP ,'') ))
			AND cp.CuitCorredorVentaSecundaria IS NOT NULL AND cp.CuitCorredorVentaSecundaria != ''
		THEN REPLACE(cp.CuitCorredorVentaSecundaria, '-','')
		ELSE NULL
	END CorredorCuit,
	CASE
		WHEN  cp.DestinatarioCuit NOT IN(@CuitMOA,@CuitMRP)
		THEN NULL
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Productor'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) = '01'
			AND  (cp.CuitRemitenteComercialVentaPrimaria IS NULL 
				OR cp.CuitRemitenteComercialVentaPrimaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria IS NULL 
				OR cp.CuitRemitenteComercialVentaSecundaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria2 IS NULL
				OR cp.CuitRemitenteComercialVentaSecundaria2 IN(@CuitMOA,@CuitMRP ,''))
			AND cp.CorredorCuit IS NOT NULL AND cp.CorredorCuit != ''
		THEN cp.CorredorRazonSocial
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Productor'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) = '01'
			AND ( (cp.CuitRemitenteComercialVentaPrimaria IS NOT NULL 
				AND cp.CuitRemitenteComercialVentaPrimaria NOT IN(@CuitMOA,@CuitMRP, ''))
			OR (cp.CuitRemitenteComercialVentaSecundaria IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria NOT IN(@CuitMOA,@CuitMRP, ''))
			OR (cp.CuitRemitenteComercialVentaSecundaria2 IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria2 NOT IN(@CuitMOA,@CuitMRP, '') ))
			AND cp.CuitCorredorVentaSecundaria IS NOT NULL AND cp.CuitCorredorVentaSecundaria != ''
		THEN cp.RazonSocialCorredorVentaSecundaria
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Otro'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) != '01'
			AND (cp.RemitenteCuit IS NULL  
				OR cp.RemitenteCuit IN(@CuitMOA,@CuitMRP ,'') )
			AND cp.CuitCorredorVentaSecundaria IS NOT NULL AND cp.CuitCorredorVentaSecundaria != ''
		THEN cp.RazonSocialCorredorVentaSecundaria
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			--AND cp.CTG = 'Otro'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) != '01'
			AND  (cp.RemitenteCuit IS NOT NULL 
				AND cp.RemitenteCuit NOT IN(@CuitMOA,@CuitMRP ,'')) 
			AND ( (cp.CuitRemitenteComercialVentaPrimaria IS NULL 
				OR cp.CuitRemitenteComercialVentaPrimaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria IS NULL
				OR cp.CuitRemitenteComercialVentaSecundaria IN(@CuitMOA,@CuitMRP ,''))
			AND (cp.CuitRemitenteComercialVentaSecundaria2 IS NULL
				OR cp.CuitRemitenteComercialVentaSecundaria2 IN(@CuitMOA,@CuitMRP ,'') ))
			AND cp.CorredorCuit IS NOT NULL AND cp.CorredorCuit != ''
		THEN cp.CorredorRazonSocial
		WHEN cp.DestinatarioCuit IN (@CuitMOA,@CuitMRP)
			
			--AND cp.CTG = 'Otro'
			AND SUBSTRING(RIGHT('000000000000' + cp.NroCartaPorte, 12), 3, 2) != '01'
			AND (cp.RemitenteCuit IS NOT NULL
				AND cp.RemitenteCuit NOT IN(@CuitMOA,@CuitMRP ,'') )
			AND ( (cp.CuitRemitenteComercialVentaPrimaria IS NOT NULL
				AND cp.CuitRemitenteComercialVentaPrimaria NOT IN(@CuitMOA,@CuitMRP ,'')) 
			OR (cp.CuitRemitenteComercialVentaSecundaria IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria NOT IN(@CuitMOA,@CuitMRP ,'') )
			OR (cp.CuitRemitenteComercialVentaSecundaria2 IS NOT NULL
				AND cp.CuitRemitenteComercialVentaSecundaria2 NOT IN(@CuitMOA,@CuitMRP ,'') ))
			AND cp.CuitCorredorVentaSecundaria IS NOT NULL AND cp.CuitCorredorVentaSecundaria != ''
		THEN cp.RazonSocialCorredorVentaSecundaria
		ELSE NULL
	END CorredorRS,
	REPLACE(cp.EntregadorCuit, '-','') EntregadorCuit,
	cp.EntregadorRazonSocial EntregadorRS,
	REPLACE(cp.DestinatarioCuit, '-','') DestinatarioCuit,
	cp.DestinatarioRazonSocial DestinatarioRS,
	REPLACE(cp.DestinoCuit, '-','') DestinoCuit,
	cp.DestinoRazonSocial DestinoRS,
	CASE WHEN cp.Planta = '25567' THEN 'San Lorenzo' WHEN cp.Planta = '21832' THEN 'RICARDONE' ELSE '' END Planta,
	REPLACE(cp.TransporteCuit, '-','') TransporteCuit,
	cp.TransporteRazonSocial TransporteRS,
	cp.TransportePatente Patente,
	'' PatenteAcoplado,
	'' KmARecorrer,
	'' TarfiaXTonelada,
	REPLACE(cp.ChoferCuit, '-','') ChoferCuit,
	cp.ChoferRazonSocial ChoferRS,
	DATEADD(HOUR,-3,cp.FechaArribo) FechaCompletaArribo,
	DATEADD(HOUR,-3,cp.FechaDescarga) FechaCompletaDescarga,
	cp.DestinoPB Bruto,
	cp.DestinoPT Tara,
	cp.DestinoPN Neto,
	CASE WHEN cp.DestinoCuit = @CuitChivilcoy THEN CONVERT(Numeric(10,0), ((SumCaracteristicasChivilcoy.Valor * cp.DestinoPN) / 100))
		 ELSE cp.MermaTotal 
	END Merma,
	CASE WHEN cp.DestinoCuit = @CuitChivilcoy THEN cp.DestinoPN - CONVERT(Numeric(10,0), ((SumCaracteristicasChivilcoy.Valor * cp.DestinoPN) / 100))
		 ELSE cp.NetoConvenido 
	END NetoAplicado,
	'' Clasificacion,
	'' InterFlete,
	'' Cupo,
	CASE WHEN ecc.EsHumedad = 1 then (case when m.CodigoONCCA = 23 AND cp.DestinoCuit = @CuitChivilcoy THEN ccp.Valor
										   when m.CodigoONCCA = 19 AND cp.DestinoCuit = @CuitChivilcoy THEN ccp.Valor
										   when m.CodigoONCCA = 15 AND cp.DestinoCuit = @CuitChivilcoy THEN ccp.Valor
										   when m.CodigoONCCA = 2  AND cp.DestinoCuit = @CuitChivilcoy THEN ccp.Valor
										   when m.CodigoONCCA = 23 AND ccp.Valor &gt; 13.5 THEN 13.5 --soja
										   when m.CodigoONCCA = 19 AND ccp.Valor &gt; 14.5 THEN 14.5 --maiz
										   when m.CodigoONCCA = 15 AND ccp.Valor &gt; 14 THEN 14 --trigo
										   when m.CodigoONCCA = 2 AND ccp.Valor &gt; 11 THEN 11 --girasol
										   ELSE ccp.Valor END) else 0 end Humedad,

	CASE WHEN ecc.CodigoSap = 'MPSOJHUM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &gt; 13.5 THEN CONVERT(INT, CASE WHEN IsNumeric(CONVERT(VARCHAR(50), cp.DestinoPN)) = 1 THEN CONVERT(VARCHAR(50), cp.DestinoPN) ELSE 0 END) * 13.5 / 100
		 WHEN ecc.CodigoSap = 'MPSOJHUM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &lt;= 13.5 THEN 0	
		 WHEN ecc.CodigoSap = 'MPSOJHUM' THEN cp.MermaTotal -isnull(SumCaracteristicas.Valor,0) 
		 ELSE 0 
	END MPSOJHUM,
 
	CASE WHEN ecc.CodigoSap = 'MPSOJGQU' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJGQU' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor
		 ELSE 0 
	END MPSOJGQU,

	CASE WHEN ecc.CodigoSap = 'MPSOJGDA' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJGDA' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJGDA,

	CASE WHEN ecc.CodigoSap = 'MPSOJCEX' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJCEX' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJCEX,

	CASE WHEN ecc.CodigoSap = 'MPSOJMCHA' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJMCHA' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJMCHA,

	CASE WHEN ecc.CodigoSap = 'MPSOJTIE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJTIE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJTIE,

	CASE WHEN ecc.CodigoSap = 'MPSOJOLO' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJOLO' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJOLO,

	CASE WHEN ecc.CodigoSap = 'MPSOJMCH' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJMCH' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJMCH,

	CASE WHEN ecc.CodigoSap = 'MPSOJREV' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJREV' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJREV,

	CASE WHEN ecc.CodigoSap = 'MPSOJMOH' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJMOH' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJMOH,

	CASE WHEN ecc.CodigoSap = 'MPSOJAVE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJAVE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJAVE,

	CASE WHEN ecc.CodigoSap = 'MPSOJGQU' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPSOJGVE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPSOJGVE,

	CASE WHEN ecc.CodigoSap = 'MPMAZGRA' AND ccp.Valor &lt;= 3 THEN ccp.Valor 
		 ELSE 0 
	END MPMAZGRA,

	CASE WHEN ecc.CodigoSap = 'MPMAZPHE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZPHE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZPHE,

	CASE WHEN ecc.CodigoSap = 'MPMAZGDA' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZGDA' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZGDA,

	CASE WHEN ecc.CodigoSap = 'MPMAZQUE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZQUE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZQUE,

	CASE WHEN ecc.CodigoSap = 'MPMAZMEX' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZMEX' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZMEX,

	CASE WHEN ecc.CodigoSap = 'MPMAZTIP' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZTIP' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZTIP,

	CASE WHEN ecc.CodigoSap = 'MPMAZHUM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &gt; 14.5 THEN CONVERT(INT, CASE WHEN IsNumeric(CONVERT(VARCHAR(50), cp.DestinoPN)) = 1 THEN CONVERT(VARCHAR(50), cp.DestinoPN) ELSE 0 END) * 14.5 / 100
		 WHEN ecc.CodigoSap = 'MPMAZHUM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &lt;= 14.5 THEN 0	
		 WHEN ecc.CodigoSap = 'MPMAZHUM' THEN cp.MermaTotal - isnull(SumCaracteristicas.Valor,0) ELSE 0 END MPMAZHUM,

	CASE WHEN ecc.CodigoSap = 'MPMAZOLO' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZOLO' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZOLO,

	CASE WHEN ecc.CodigoSap = 'MPMAZAMO' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZAMO' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZAMO,

	CASE WHEN ecc.CodigoSap = 'MPMAZMCH' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPMAZMCH' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPMAZMCH,

	CASE WHEN ecc.CodigoSap = 'MPTRPGRA' AND ccp.Valor &lt;= 3 THEN ccp.Valor 
		 ELSE 0 
	END MPTRPGRA,

	CASE WHEN ecc.CodigoSap = 'MPTRPPHE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPPHE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPPHE,

	CASE WHEN ecc.CodigoSap = 'MPTRPCEX' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPCEX' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPCEX,

	CASE WHEN ecc.CodigoSap = 'MPTRPARD' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPARD' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPARD,

	CASE WHEN ecc.CodigoSap = 'MPTRPTDA' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPTDA' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPTDA,

	CASE WHEN ecc.CodigoSap = 'MPTRPCAR' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPCAR' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPCAR,

	CASE WHEN ecc.CodigoSap = 'MPTRPPZB' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPPZB' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPPZB,

	CASE WHEN ecc.CodigoSap = 'MPTRPQUE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPQUE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPQUE,

	CASE WHEN ecc.CodigoSap = 'MPTRPPIC' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPPIC' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPPIC,

	CASE WHEN ecc.CodigoSap = 'MPTRPTRE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPTRE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPTRE,

	CASE WHEN ecc.CodigoSap = 'MPTRPHM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &gt; 14.0 THEN CONVERT(INT, CASE WHEN IsNumeric(CONVERT(VARCHAR(50), cp.DestinoPN)) = 1 THEN CONVERT(VARCHAR(50), cp.DestinoPN) ELSE 0 END) * 14.0 / 100
		 WHEN ecc.CodigoSap = 'MPTRPHM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &lt;= 14.0 THEN 0	
		 WHEN ecc.CodigoSap = 'MPTRPHM' THEN  cp.MermaTotal - isnull(SumCaracteristicas.Valor,0) ELSE 0 END MPTRPHM,

	CASE WHEN ecc.CodigoSap = 'MPTRPINS' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPINS' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPINS,

	CASE WHEN ecc.CodigoSap = 'MPTRPOLO' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPOLO' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPOLO,

	CASE WHEN ecc.CodigoSap = 'MPTRPPST' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPPST' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPPST,

	CASE WHEN ecc.CodigoSap = 'MPTRPRTI' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPRTI' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPRTI,

	CASE WHEN ecc.CodigoSap = 'MPTRPRO' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPTRPRO' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPTRPRO,

	CASE WHEN ecc.CodigoSap = 'MPGIRACI' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRACI' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRACI,

	CASE WHEN ecc.CodigoSap = 'MPGIRAOL' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRAOL' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRAOL,

	CASE WHEN ecc.CodigoSap = 'MPGIRCEX' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRCEX' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRCEX,

	CASE WHEN ecc.CodigoSap = 'MPGIRCHA' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRCHA' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRCHA,

	CASE WHEN ecc.CodigoSap = 'MPGIRESC' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRESC' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRESC,

	CASE WHEN ecc.CodigoSap = 'MPGIRGAR' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRGAR' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRGAR,

	CASE WHEN ecc.CodigoSap = 'MPGIRHUM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &gt; 11.0 THEN CONVERT(INT, CASE WHEN IsNumeric(CONVERT(VARCHAR(50), cp.DestinoPN)) = 1 THEN CONVERT(VARCHAR(50), cp.DestinoPN) ELSE 0 END) * 11.0 / 100
		 WHEN ecc.CodigoSap = 'MPGIRHUM' AND cp.DestinoCuit = @CuitChivilcoy AND isnull(SumCaracteristicas.Valor,0) &lt;= 11.0 THEN 0
		 WHEN ecc.CodigoSap = 'MPGIRHUM' THEN cp.MermaTotal - isnull(SumCaracteristicas.Valor,0) ELSE 0 END MPGIRHUM,

	CASE WHEN ecc.CodigoSap = 'MPGIRHUR' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRHUR' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRHUR,

	CASE WHEN ecc.CodigoSap = 'MPGIRINV' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRINV' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRINV,

	CASE WHEN ecc.CodigoSap = 'MPGIRMGR' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRMGR' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRMGR,

	CASE WHEN ecc.CodigoSap = 'MPGIRMOH' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRMOH' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRMOH,

	CASE WHEN ecc.CodigoSap = 'MPGIROLO' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIROLO' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIROLO,

	CASE WHEN ecc.CodigoSap = 'MPGIRREV' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRREV' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRREV,

	CASE WHEN ecc.CodigoSap = 'MPGIRTEM' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRTEM' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRTEM,

	CASE WHEN ecc.CodigoSap = 'MPGIRGCL' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRGCL' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRGCL,

	CASE WHEN ecc.CodigoSap = 'MPGIRTIE' AND cp.DestinoCuit = @CuitChivilcoy THEN (ccp.Valor * cp.DestinoPN) / 100
		 WHEN ecc.CodigoSap = 'MPGIRTIE' AND cp.DestinoCuit &lt;&gt; @CuitChivilcoy THEN ccp.Valor 
		 ELSE 0 
	END MPGIRTIE

FROM CartaPorteOtrosPuertos cp
LEFT JOIN Material m ON m.Id = cp.Material_Id
LEFT JOIN (
	SELECT CartaPorteOtrosPuertos_Id, SUM(Valor) Valor 
	FROM CaracteristicasCartaPorteOtrosPuertos 
	WHERE CodigoExterno &lt;&gt; 'HUMEDAD' 
	GROUP BY CartaPorteOtrosPuertos_Id
) SumCaracteristicas ON SumCaracteristicas.CartaPorteOtrosPuertos_Id = cp.Id
LEFT JOIN (
	SELECT CartaPorteOtrosPuertos_Id as Id, SUM(Valor) Valor FROM 
		(SELECT CartaPorteOtrosPuertos_Id,
		CASE WHEN CodigoExterno = 'MPSOJHUM' AND Valor &gt; 13.5 THEN 13.5
			 WHEN CodigoExterno = 'MPSOJHUM' AND Valor &lt;= 13.5 THEN 0
			 WHEN CodigoExterno = 'MPMAZHUM' AND Valor &gt; 14.5 THEN 14.5
			 WHEN CodigoExterno = 'MPMAZHUM' AND Valor &lt;= 14.5 THEN 0
			 WHEN CodigoExterno = 'MPTRPHM' AND Valor &gt; 14.0 THEN 14.0
			 WHEN CodigoExterno = 'MPTRPHM' AND Valor &lt;= 14.0 THEN 0
			 WHEN CodigoExterno = 'MPGIRHUM' AND Valor &gt; 11.0 THEN 11.0
			 WHEN CodigoExterno = 'MPGIRHUM' AND Valor &lt;= 11.0 THEN 0
			 ELSE Valor
		END Valor
		FROM CaracteristicasCartaPorteOtrosPuertos) as temp
	GROUP BY CartaPorteOtrosPuertos_Id
) SumCaracteristicasChivilcoy ON SumCaracteristicasChivilcoy.Id = cp.Id
LEFT JOIN CaracteristicasCartaPorteOtrosPuertos ccp ON ccp.CartaPorteOtrosPuertos_Id = cp.Id 
LEFT JOIN EquivalenciasCaracteristicasCpOtrosPuertos ecc ON ecc.CodigoExterno = ccp.CodigoExterno AND ecc.Material_Id = cp.Material_Id

WHERE CAST(DATEADD(HOUR,-3,cp.FechaDescarga) AS date) &gt;= CAST(@FechaDesdep AS DATE) AND CAST(DATEADD(HOUR,-3,cp.FechaDescarga) AS date) &lt;= CAST(@FechaHastap AS DATE) AND CAST(@FechaDesdep AS DATE) &gt;= CAST('2021-11-01' AS DATE)
AND cp.Material_Id = @MaterialIdp
AND (@AlmacenIdp = '0' OR @AlmacenIdp = cp.Planta)
AND (@TipoCompraIdp = '0' OR (@TipoCompraIdp = '1' AND cp.TitularCuit != @CuitMOA OR @TipoCompraIdp = '2' AND cp.TitularCuit = @CuitMOA))
AND (@TipoDestinoIdp = '0' OR (@TipoDestinoIdp = '1' AND cp.DestinoCuit = @CuitVicentin OR @TipoDestinoIdp = '2' AND cp.DestinoCuit = @CuitChivilcoy))
AND (@TipoSustentableIdp = '0' OR (@TipoSustentableIdp = '1' AND cp.EsSustentable = 1 OR @TipoSustentableIdp = '2' AND (cp.EsSustentable = 0 OR cp.EsSustentable is null)))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
