    <DataSet Name="TipoSustentable">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        '0' AS Id, 'Todos' AS TipoSustentable, '0' AS ord
UNION
SELECT        '1' AS Id, 'Si' AS TipoSustentable, '1' AS ord
UNION
SELECT        '2' AS Id, 'No' AS TipoSustentable, '2' AS ord
ORDER BY ord</CommandText>
      </Query>
