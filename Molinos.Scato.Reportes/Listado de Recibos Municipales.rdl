        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Tipo_Doc">
          <DataField>Tipo Doc.</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Nº_Documento">
          <DataField>Nº Documento</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Producto">
          <DataField>Producto</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Doc_Chofer">
          <DataField>Doc Chofer</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Empresa_Transportista">
          <DataField>Empresa Transportista</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Fecha_Pago_Digital">
          <DataField>Fecha Pago Digital</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Material">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
    NULL AS Id, 
    'Todos' AS Material, 
    '0' AS ord
UNION ALL
SELECT 
    Id, 
    Descripcion AS Material, 
    Descripcion AS ord
FROM Material WITH (NOLOCK)
WHERE EXISTS (
    SELECT 1
    FROM Recorrido WITH (NOLOCK)
    WHERE Material_Id = Material.Id
      AND Centro_Id = @Centro
)
ORDER BY ord;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Garita">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT
    
	CASE WHEN Id IN (2, 48) THEN '0001' ELSE '0002' END AS Id,
    
	CASE WHEN Id IN (2, 48) THEN '0001 - MP' ELSE '0002 - MP' END AS GaritaDescripcion

FROM PuestoDeTrabajo WITH (NOLOCK)

WHERE Id IN (46, 48) AND Centro_Id = @Centro



UNION



SELECT
    
	CASE WHEN Id IN (2, 48) THEN '1001' ELSE '1002' END AS Id,
    
	CASE WHEN Id IN (2, 48) THEN '1001 - EFECTIVO' ELSE '1002 - EFECTIVO' END AS GaritaDescripcion

FROM PuestoDeTrabajo WITH (NOLOCK)

WHERE Id IN (2, 46) AND Centro_Id = @Centro



UNION



SELECT
    
	CASE WHEN Id IN (2, 48) THEN '2001' ELSE '2002' END AS Id,
    
	CASE WHEN Id IN (2, 48) THEN '2001 - DIGITAL' ELSE '2002 - DIGITAL' END AS GaritaDescripcion

FROM PuestoDeTrabajo WITH (NOLOCK)

WHERE Id IN (46, 48) AND Centro_Id = @Centro</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GaritaDescripcion">
          <DataField>GaritaDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
