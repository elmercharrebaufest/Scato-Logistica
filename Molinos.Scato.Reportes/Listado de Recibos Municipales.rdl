  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ReciboDesde">
            <Value>=Parameters!ReciboDesde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@ReciboHasta">
            <Value>=Parameters!ReciboHasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Garitas">
            <Value>=Parameters!Garitas.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int
declare @Materialp int
declare @FechaDesdep datetime
declare @FechaHastap datetime
declare @ReciboDesdep int 
declare @ReciboHastap int 

set @CentroIdp = @CentroId
set @Materialp =@Material
set @FechaDesdep =@FechaDesde
set @FechaHastap = @FechaHasta
set @ReciboDesdep = @ReciboDesde
set @ReciboHastap = @ReciboHasta



;WITH TicketFiltro AS (
    SELECT *,
           ReciboNum = 
               CASE 
                   WHEN LEN(TicketNro) &gt; 7 THEN CONVERT(INT, SUBSTRING(TicketNro, 6, 7))
                   ELSE TRY_CAST(TicketNro AS INT)
               END
    FROM ImpReciboMunicipal WITH(NOLOCK)
),
BaseRecibos AS (
    SELECT
        r.TarjetaDeAcceso AS 'Tarjeta',
        LEFT(t.TicketNro, 13) AS 'Recibo',
        r.Patente,
        tdi.Descripcion AS 'Tipo Doc.',
        r.NumeroDocumentoIngreso AS 'Nº Documento',
        m.Descripcion AS 'Producto',
        ch.Cuil AS 'Doc Chofer',
        ch.Nombre + ' ' + ch.Apellido AS Chofer,
        tr.RazonSocial AS 'Empresa Transportista',
        CASE 
            WHEN t.TicketNro = 'Tasa abonada dentro del día' THEN t.TicketNro
            WHEN LEFT(t.TicketNro,1) = '0' THEN LEFT(t.TicketNro,4) + ' - MP'
            ELSE LEFT(t.TicketNro,4) + ' - EFECTIVO'
        END AS 'Garita',
        t.Valor AS 'Monto Cobrado',
        i.FechaImpresion AS 'Fecha Cobro',
        null AS 'Fecha Pago Digital'
    FROM TicketFiltro t
    INNER JOIN Impresion i WITH(NOLOCK) ON t.Id = i.Id
    INNER JOIN Recorrido r WITH(NOLOCK) ON r.InstanciaWorkflow = i.WorkflowId
    INNER JOIN TipoDocumentoIngreso tdi WITH(NOLOCK) ON r.TipoDocumentoIngreso = tdi.Id
    INNER JOIN Material m WITH(NOLOCK) ON r.Material_Id = m.Id
    INNER JOIN Chofer ch WITH(NOLOCK) ON r.Chofer_Id = ch.Id
    INNER JOIN Transportista tr WITH(NOLOCK) ON r.Transportista_Id = tr.Id
    WHERE
        (@Materialp IS NULL OR m.Id = @Materialp)
        AND r.Centro_Id = @CentroIdp
        AND i.FechaImpresion BETWEEN @FechaDesdep AND @FechaHastap
        AND (t.TicketNro = 'Tasa abonada dentro del día' OR LEFT(t.TicketNro,4) IN (@Garitas))
        AND LEFT(t.TicketNro,1) &lt;&gt; '2'
        AND (
            @ReciboDesdep IS NULL OR
            t.TicketNro = 'Tasa abonada dentro del día' OR
            t.ReciboNum &gt;= RIGHT('0000000' + CAST(@ReciboDesdep AS VARCHAR),7)
        )
        AND (
            @ReciboHastap IS NULL OR
            t.TicketNro = 'Tasa abonada dentro del día' OR
            t.ReciboNum &lt;= RIGHT('0000000' + CAST(@ReciboHastap AS VARCHAR),7)
        )
),
BaseDigital AS (
    SELECT
        r.TarjetaDeAcceso AS 'Tarjeta',
        LEFT(ptam.NroRecibo, 13) AS 'Recibo',
        r.Patente,
        tdi.Descripcion AS 'Tipo Doc.',
        r.NumeroDocumentoIngreso AS 'Nº Documento',
        m.Descripcion AS 'Producto',
        ch.Cuil AS 'Doc Chofer',
        ch.Nombre + ' ' + ch.Apellido AS Chofer,
        tr.RazonSocial AS 'Empresa Transportista',
        LEFT(ptam.NroRecibo,4) + ' - DIGITAL' AS 'Garita',
        ptam.Importe AS 'Monto Cobrado',
        i.FechaImpresion AS 'Fecha Cobro',
        ptam.FechaPago AS 'Fecha Pago Digital'
    FROM PagosTasaMunicipal ptam
    INNER JOIN ImpReciboMunicipal imp ON ptam.NroRecibo = imp.TicketNro
	  INNER JOIN Impresion i ON imp.Id = i.Id
    INNER JOIN Recorrido r WITH(NOLOCK) ON r.InstanciaWorkflow = ptam.Instance_Id
    INNER JOIN TipoDocumentoIngreso tdi WITH(NOLOCK) ON r.TipoDocumentoIngreso = tdi.Id
    INNER JOIN Material m WITH(NOLOCK) ON r.Material_Id = m.Id
    INNER JOIN Chofer ch WITH(NOLOCK) ON r.Chofer_Id = ch.Id
    INNER JOIN Transportista tr WITH(NOLOCK) ON r.Transportista_Id = tr.Id
    WHERE
        (@Materialp IS NULL OR m.Id = @Materialp)
        AND r.Centro_Id = @CentroIdp
        AND ptam.NroRecibo IS NOT NULL
		    AND i.TipoImpresion = 15
        AND ptam.NroRecibo IS NOT NULL
        AND ptam.FechaPago BETWEEN @FechaDesdep AND @FechaHastap
        AND LEFT(ptam.NroRecibo,4) IN (@Garitas)
        AND (
            @ReciboDesdep IS NULL OR
            CONVERT(INT, SUBSTRING(ptam.NroRecibo, 6, 7)) &gt;= @ReciboDesdep
        )
        AND (
            @ReciboHastap IS NULL OR
            CONVERT(INT, SUBSTRING(ptam.NroRecibo, 6, 7)) &lt;= @ReciboHastap
        )
),
Borrado AS (
    SELECT
        NroTarjeta AS 'Tarjeta',
        Recibo,
        TMB.Patente,
        TDI.Descripcion AS 'Tipo Doc.',
        NroDocumento AS 'Nº Documento',
        m.Descripcion AS 'Producto',
        ChoferCuil AS 'Doc Chofer',
        ChoferNombre AS Chofer,
        t.RazonSocial AS 'Empresa Transportista',
        NULL AS 'Garita',
        '' AS 'Monto Cobrado',
        NULL AS 'Fecha Cobro',
        NULL AS 'Fecha Pago Digital'
    FROM TicketMunicipalBorrado TMB
    INNER JOIN TipoDocumentoIngreso TDI ON TMB.TipoDocumento = TDI.Id
    INNER JOIN Material m ON m.Id = TMB.materialId
    INNER JOIN Recorrido r ON r.TipoDocumentoIngreso = TMB.Id
    INNER JOIN Transportista t ON t.Id = r.Transportista_Id
    WHERE
        (@Materialp IS NULL OR m.Id = @Materialp)
        AND TMB.CentroId = @CentroIdp
        AND TMB.Fecha BETWEEN @FechaDesdep AND @FechaHastap
        AND (TMB.Recibo = 'Tasa abonada dentro del día' OR LEFT(TMB.Recibo,4) IN (@Garitas))
)

SELECT *
FROM (
    SELECT * FROM BaseRecibos
    UNION ALL
    SELECT * FROM BaseDigital
    UNION ALL
    SELECT * FROM Borrado
) AS ResultadoFinal
ORDER BY [Fecha Cobro] DESC;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Fecha_Cobro">
          <DataField>Fecha Cobro</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Monto_Cobrado">
          <DataField>Monto Cobrado</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Garita">
          <DataField>Garita</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Recibo">
          <DataField>Recibo</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Tarjeta">
          <DataField>Tarjeta</DataField>
