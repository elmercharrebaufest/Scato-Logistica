    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Material, '0' AS ord
UNION
SELECT        Id, Descripcion AS Material, Descripcion AS ord
FROM            Material WITH (nolock)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            RomaneoItem WITH (nolock) INNER JOIN
                                                         Romaneo WITH (nolock) ON Romaneo.Id = RomaneoItem.Romaneo_Id
                               WHERE        (RomaneoItem.Material_Id = Material.Id) AND EXISTS
                                                             (SELECT        1 AS Expr1
                                                               FROM            Recorrido WITH (nolock)
                                                               WHERE        (Romaneo.WorkflowInstanceId = InstanciaWorkflow) AND (Centro_Id = @CentroId)))
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Almacenes">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Almacen, '0' AS ord
UNION
SELECT        Id, Descripcion AS Almacen, Descripcion AS ord
FROM            Almacen WITH (nolock)
WHERE        (Centro_Id = @CentroId) OR
                         (@CentroId = NULL)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Almacen">
          <DataField>Almacen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
