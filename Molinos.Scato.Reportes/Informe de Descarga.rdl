  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Almacen">
            <Value>=Parameters!Almacen.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaEgresoDesde">
            <Value>=Parameters!FechaEgresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaEgresoHasta">
            <Value>=Parameters!FechaEgresoHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int,@Materialp int,@Almacenp int, @FechaEgresoDesdep datetime, @FechaEgresoHastap datetime

set @Materialp = @Material
set @Almacenp =@Almacen
set @CentroIdp = @CentroId
set @FechaEgresoDesdep = @FechaEgresoDesde
set @FechaEgresoHastap = @FechaEgresoHasta


SELECT 
       ALM.descripcion                        AS Almacen, 
       MAT.descripcion                        AS Material, 
       RE.FechaEgreso,
       RO.id                                  AS RomaneoNro, 
       Sum(RITEM.pesobruto)                   AS PesoBruto, 
       Sum(RITEM.pesotara)                    AS PesoTara, 
       Sum(RITEM.pesobruto - RITEM.pesotara)  AS PesoNeto, 
       Count(RITEM.id)                        AS Bultos,
	   RE.fechainicio                         AS FechaIngreso, 
       RO.nropedido                           AS PedidoNro, 
       RE.id                                  AS IngresoNro, 
       RE.patente                             AS Patente, 
       PRO.descripcion                        AS Proveedor, 
       RO.FechaInicio                             AS FechaInicio, 
       RO.FechaCierre                              AS FechaCierre, 
       ESTROM.descripcion                     AS Estado, 
       RE.numerodocumentoingreso              AS RemitoNro, 
       RE.pesobrutoorigen - RE.pesotaraorigen AS KgDeclarados, 
       OD.fechamovimiento                    AS FechaRemito,
       RE.Centro_Id		         As CentroId,
	   C.Descripcion        AS CentroNombre,
	   C.CodigoSAP          AS CentroCodigoSAP
	   
FROM   romaneo RO with (nolock)
       LEFT JOIN recorrido RE with (nolock)
              ON RO.workflowinstanceid = RE.instanciaworkflow 
	   LEFT JOIN Centro C with (nolock)
			  ON RE.Centro_Id = C.Id
       LEFT JOIN OrdenDeDescarga OD with (nolock)
              ON OD.Numero = RE.numerodocumentoingreso 
       LEFT JOIN proveedor PRO with (nolock)
              ON OD.proveedor_id = PRO.id 
       LEFT JOIN estadoromaneo ESTROM with (nolock)
              ON ESTROM.id = RO.estado 
       LEFT JOIN romaneoitem RITEM with (nolock)
              ON RO.id = RITEM.romaneo_id 
       LEFT JOIN dbo.almacen ALM with (nolock)
              ON RITEM.almacen_id = ALM.id 
       LEFT JOIN dbo.material MAT with (nolock)
              ON RITEM.Material_Id = MAT.id 

WHERE @CentroIdp = RE.Centro_Id AND (RITEM.Material_Id = @Materialp or @Materialp IS NULL)  AND (RE.Almacen_Id = @Almacenp or @Almacenp IS NULL) AND RE.FechaEgreso IS NOT NULL AND RITEM.Almacen_Id IN (SELECT A.Id FROM Almacen A WHERE A.Centro_Id = @CentroIdp)  AND RE.Rechazado = 0
and (@FechaEgresoDesdep is null or cast(@FechaEgresoDesdep as date )&lt;= cast(RE.FechaEgreso as date))
and (@FechaEgresoHastap is null or cast(@FechaEgresoHastap as date )&gt;= cast(RE.FechaEgreso as date))

GROUP  BY RE.fechainicio, 
          RO.id, 
          RO.nropedido, 
          RE.id, 
          RE.patente, 
          PRO.descripcion, 
          ESTROM.descripcion, 
          RE.numerodocumentoingreso, 
          RE.pesobrutoorigen - RE.pesotaraorigen, 
          OD.fechamovimiento, 
          ALM.descripcion, 
          MAT.descripcion,
          RE.FechaEgreso,          
          RO.FechaInicio, 
          RO.FechaCierre,
          RE.Centro_Id,
		  C.Descripcion,
		  C.CodigoSAP</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
