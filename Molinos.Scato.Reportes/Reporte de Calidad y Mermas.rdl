<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>f7b68eab-4255-4221-ae11-6d802c815bab</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@TipoDocumento">
            <Value>=Parameters!TipoDocumento.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Documento">
            <Value>=Parameters!Documento.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=Parameters!TipoComercial.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Recibidor">
            <Value>=Parameters!Recibidor.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @Centrop int,@Materialp int,@TipoComercialp int,@Patentep nvarchar(100),@Documentop nvarchar(100),@TipoDocumentop int,@FechaDesdep datetime, @FechaHastap datetime, @Recibidorp nvarchar(30)

set @Patentep=@Patente
set @Centrop=@CentroId
set @Materialp=@Material
set @TipoComercialp=@TipoComercial
set @TipoDocumentop=@TipoDocumento
set @Documentop = @Documento
set @FechaDesdep =@FechaDesde
set @FechaHastap =@FechaHasta
set @Recibidorp = @Recibidor

SELECT
	R.NumeroDocumentoIngreso,
	M.[Descripcion] as 'Material',
	R.[PesoBruto] - R.[PesoTara] AS 'Kilos Netos',
	CASE W.TipoDeWorkflow
				WHEN 0  THEN ( R.PesoTaraFecha)
				WHEN 1  THEN ( R.PesoBrutoFecha)
				END as 'Fecha',
	W.TipoDeWorkflow as 'Tipo de Workflow',
	TC.Descripcion as 'Tipo Comercial',
	(CASE
			WHEN APC.DescuentoEnKg IS NULL 
			THEN CPC.DescuentoEnKg
			ELSE APC.DescuentoEnKg
			END) as 'DescuentoKg',
	(CASE
			WHEN APC.DescuentoEnPorcentaje IS NULL 
			THEN CPC.DescuentoEnPorcentaje
			ELSE APC.DescuentoEnPorcentaje
			END) as 'DescuentoPorcentaje',
	CDCM.Descripcion as 'Caracteristica',
		R.Id as 'RecorridoId',
		R.Patente as 'Patente',
        R.Centro_Id As CentroId,
		C.Usuario As 'Perito',
       Centro.Descripcion as CentroDescripcion,
       Centro.CodigoSAP as CentroCodigoSap
       , U.Apellido + ' ' + U.Nombre As Recibidor
	
FROM Recorrido R WITH (NOLOCK)

INNER JOIN Material M WITH (NOLOCK)
	ON R.[Material_Id] = M.[Id]

INNER JOIN [Workflow] W WITH (NOLOCK)
	ON R.[Workflow_Id] = W.[Id]
	
INNER JOIN dbo.Calado C WITH (NOLOCK)
ON C.Id = R.Calado_Id

INNER JOIN [TipoComercial] TC WITH (NOLOCK)
	ON R.[TipoComercial_Id] = TC.[Id]
	
LEFT JOIN dbo.AnalisisDeCalidad ADC WITH (NOLOCK)
	ON ADC.Id = R.AnalisisDeCalidad_Id

	INNER JOIN MaterialPorCentro Mpc WITH(NOLOCK) on Mpc.Material_Id = r.material_Id and Mpc.centro_id = r.centro_id 
	LEFT JOIN CaracteristicaDeCalidad CDC WITH(NOLOCK) on CDC.MaterialPorCentro_id = Mpc.id and (r.calado_id is not null or r.AnalisisdeCalidad_id is not null)
	FULL OUTER JOIN CaladoPorCaracteristica CPC WITH(NOLOCK) on CPC.Calado_Id = R.Calado_Id and CPC.CaracteristicaDeCalidad_Id = CDC.id
	FULL OUTER JOIN AnalisisPorCaracteristica APC WITH(NOLOCK) on APC.AnalisisDeCalidad_Id = R.AnalisisDeCalidad_Id and APC.CaracteristicaDeCalidad_Id = CDC.id
	LEFT JOIN CaracteristicaDeCalidadMaestro CDCM WITH(NOLOCK) on CDCM.Id = CDC.CaracteristicaDeCalidadMaestro_Id

LEFT JOIN dbo.Centro Centro WITH (NOLOCK)
	ON Centro.ID = R.Centro_Id
LEFT JOIN dbo.Usuario U WITH (NOLOCK) ON (R.AnalisisDeCalidad_Id is not null and U.NombreUsuario = ADC.Usuario) or (R.AnalisisDeCalidad_Id is null and R.Calado_Id is not null and U.NombreUsuario = C.Usuario)
 
WHERE 
	 (R.centro_id = @Centrop)
AND (R.material_id = @Materialp)
AND (@TipoComercialp IS NULL or R.TipoComercial_Id = @TipoComercialp)
AND CDCM.Descripcion IS NOT NULL
AND R.Rechazado &lt;&gt; 1 AND R.PesoBruto IS NOT NULL AND R.PesoTara IS NOT NULL
and (CPC.Id is not null or APC.Id is not null)
AND (@Patentep = '' or R.Patente = @Patentep)
AND (@TipoDocumentop IS NULL or @TipoDocumentop = R.TipoDocumentoIngreso)
AND (@Documentop = '' or @Documentop = R.NumeroDocumentoIngreso or @Documentop = R.NumeroDocumentoIngresoLegal)

AND  (CASE W.TipoDeWorkflow
				WHEN 0  THEN ( R.PesoTaraFecha)
				WHEN 1  THEN ( R.PesoBrutoFecha)
				END) &gt;= @FechaDesdep
AND (CASE W.TipoDeWorkflow
				WHEN 0  THEN ( R.PesoTaraFecha)
				WHEN 1  THEN ( R.PesoBrutoFecha)
				END) &lt;= @FechaHastap
AND (@Recibidorp = 'Todos' or U.NombreUsuario = @Recibidorp)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos">
          <DataField>Kilos Netos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Tipo_de_Workflow">
          <DataField>Tipo de Workflow</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Tipo_Comercial">
          <DataField>Tipo Comercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DescuentoKg">
          <DataField>DescuentoKg</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="DescuentoPorcentaje">
          <DataField>DescuentoPorcentaje</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Caracteristica">
          <DataField>Caracteristica</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecorridoId">
          <DataField>RecorridoId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Perito">
          <DataField>Perito</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroCodigoSap">
          <DataField>CentroCodigoSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Recibidor">
          <DataField>Recibidor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposComerciales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT NULL AS Id, 'Todos' AS TipoComercial, '0' AS ord
UNION
Select Id, Descripcion as TipoComercial, Descripcion AS ord from TipoComercial WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Material.Id, Material.Descripcion AS Material
FROM            Material WITH (NOLOCK)
Where Exists(Select 1 from Recorrido WITH (NOLOCK) where Recorrido.Material_Id = Material.Id AND (Recorrido.Centro_Id = @CentroId))
order by Material.Descripcion </CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoDocumento">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT NULL AS Id, 'Todos' AS TipoDocumento, '0' AS ord
UNION
Select Id, Descripcion as TipoDocumento, Descripcion AS ord from TipoDocumentoIngreso WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoDocumento">
          <DataField>TipoDocumento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Recibidores">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@centroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT  'Todos' AS NombreUsuario, 'Todos' AS Id,'0' AS ord
UNION
SELECT   Apellido + ' ' + Nombre as NombreUsuario, NombreUsuario AS Id, Apellido + ' ' + Nombre  as ord 
FROM            Usuario U
INNER JOIN UsuarioCentro UC ON UC.Usuario_Id = U.Id
WHERE U.Matricula is not null AND UC.Centro_Id = @centroId
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="NombreUsuario">
          <DataField>NombreUsuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
