<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6fc98eb1-2b01-45b3-ae75-a54670d272e3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHora_Desde">
            <Value>=Parameters!FechaHora_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHora_Hasta">
            <Value>=Parameters!FechaHora_Hasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @Centrop int,@FechaHora_Desdep datetime, @FechaHora_Hastap datetime


set @Centrop= @Centro
set @FechaHora_Desdep =@FechaHora_Desde
set @FechaHora_Hastap = @FechaHora_Hasta

SELECT 
	EXC.FechaDeCarga,
	Material.Descripcion as Material,
	Transportista.RazonSocial as Transportista,
	EXC.FechaDesde,
	EXC.FechaHasta,
	Centro.CodigoSAP as Centro,
	Centro.Id as CentroId,
	EXC.Usuario,
	MEAL.Descripcion as Motivo
FROM [ExcepcionAlControl] as EXC WITH(NOLOCK)

INNER JOIN [Material] WITH(NOLOCK)
ON EXC.Material_Id = Material.Id

INNER JOIN [Transportista] WITH(NOLOCK)
ON EXC.Transportista_Id = Transportista.Id

INNER JOIN [Centro]  WITH(NOLOCK)
ON EXC.Centro_Id = Centro.Id

INNER JOIN [MotivoExcepcionAlControl] MEAL WITH(NOLOCK)
ON  MEAL.Id = EXC.Motivo

AND (Centro.Id = @Centrop or @Centrop IS NULL)
WHERE (CAST(@FechaHora_Desdep AS DATE) &lt;= CAST(EXC.FechaDeCarga AS DATE) AND CAST(@FechaHora_Hastap AS DATE) &gt;= CAST(EXC.FechaDeCarga AS DATE))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FechaDeCarga">
          <DataField>FechaDeCarga</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Transportista">
          <DataField>Transportista</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaDesde">
          <DataField>FechaDesde</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FechaHasta">
          <DataField>FechaHasta</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Centro, '' AS ord
UNION
SELECT        Id, Descripcion AS Centro, Descripcion AS ord
FROM            Centro WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP, Descripcion
FROM            Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CodigoSAP">
          <DataField>CodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
