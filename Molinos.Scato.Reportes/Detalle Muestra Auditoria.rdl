          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Entregador">
          <DataField>Entregador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EntregadorCuit">
          <DataField>EntregadorCuit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Procedencia">
          <DataField>Procedencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="KilosNetosDescargados">
          <DataField>KilosNetosDescargados</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PatenteAcoplado">
          <DataField>PatenteAcoplado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaHoraCalado">
          <DataField>FechaHoraCalado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UsuarioCalado">
          <DataField>UsuarioCalado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
