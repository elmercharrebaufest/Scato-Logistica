  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>8c164980-7b05-429d-83d2-f35d58293468</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoraCaladoDesde">
            <Value>=Parameters!FechaHoraCaladoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraCaladoHasta">
            <Value>=Parameters!FechaHoraCaladoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE	 @FechaHoraCaladoDesdep DATE, 
		 @FechaHoraCaladoHastap DATE,
		 @Materialp INT	 

SET @FechaHoraCaladoDesdep = @FechaHoraCaladoDesde
SET @FechaHoraCaladoHastap = @FechaHoraCaladoHasta
SET @Materialp = @Material

  SELECT 	IMA.NroMuestra,
			IMA.Proveedor, 
			IMA.ProveedorCuit, 
			IMA.Corredor, 
			IMA.CorredorCuit, 
			IMA.Entregador, 
			IMA.EntregadorCuit,
			IMA.Centro, 
			IMA.Procedencia,
			IMA.Material,
			R.Patente,
			R.PesoBruto - R.PesoTara as KilosNetosDescargados,
			IMA.PatenteAcoplado,
			IMA.FechaHoraCalado,
			IMA.UsuarioCalado,
			IMA.NumeroDeOrden
  FROM ImpIdentificacionMuestraAuditoria IMA
  INNER JOIN Impresion I on IMA.Id = I.Id
  INNER JOIN Recorrido R on R.InstanciaWorkflow = I.WorkflowId
  INNER JOIN Calado C on C.Id = R.Calado_Id

  WHERE (IMA.MaterialId = @Materialp or @Materialp IS NULL)AND
 R.Centro_Id = @CentroId AND
(C.FechaCreacion &gt;= @FechaHoraCaladoDesdep AND C.FechaCreacion &lt;= DATEADD(day,1,@FechaHoraCaladoHastap))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProveedorCuit">
          <DataField>ProveedorCuit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NroMuestra">
