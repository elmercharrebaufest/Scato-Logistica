  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>e5fb4ec5-a8d3-4840-a0e9-7c889adc9a38</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@fechaDesde">
            <Value>=Parameters!fechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaHasta">
            <Value>=Parameters!fechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE  @FechaDesdep DATETIME, 
	@FechaHastap DATETIME

SET	@FechaDesdep = @fechaDesde
SET	@FechaHastap = @fechaHasta


select ctg ,codigoLocalidadDestino, numeroPlantaDestino,codigoBiotecnologiaDeclarada,
codigoEspecie,codigoLocalidadProcedencia, establecimiento,destinatario,destino,remitenteComercial, rtteComercialCuit, titularCartaPorte, titularCartaPorteCuit,
numeroCartaPorte,FechaInicio,FechaEgreso,CAST(KilosNetos-sum(DescuentoKilos) as int) as kilosNetosSecos
from (

select cp.CTG as ctg,lc.codigoafip as codigoLocalidadDestino,c.CodigoEstablecimiento as numeroPlantaDestino, t.Nombre as codigoBiotecnologiaDeclarada,
m.CodigoEspecie as codigoEspecie,case lcp.CodigoAfip when '' then '0' else lcp.CodigoAfip end as codigoLocalidadProcedencia, case cp.CodEstab when '999999' then '' else cp.CodEstab end as establecimiento,
dest.Cuil as destinatario,c.Cuit as destino,rtte.Descripcion as remitenteComercial,rtte.Cuil as rtteComercialCuit,titcp.Descripcion as titularCartaPorte,titcp.Cuil as titularCartaPorteCuit,
case cp.NroCartaPorte when '' then '0' else cp.NroCartaPorte end as numeroCartaPorte,r.FechaInicio,r.FechaEgreso,ac.DescuentoEnKg as DescuentoKilos,r.PesoBruto-r.PesoTara as KilosNetos
from recorrido r left join MaterialPorCentro mc on r.material_id = mc.material_id and r.centro_id = mc.Centro_Id
left join centro c on c.id=r.centro_id
left join localidad lc on lc.id=c.Localidad_Id
left join vehiculo v on v.id=r.vehiculo_id
left join cartaporte cp on cp.id=v.cartaporte_id
left join Tecnologia t on t.id=cp.Tecnologia_Id
left join Material m on m.id=r.Material_Id
left join Localidad lcp on lcp.id=cp.Procedencia_Id
left join Proveedor dest on dest.id=cp.Destinatario_Id
left join Proveedor rtte on rtte.id=cp.RtteComercial_Id
left join Proveedor titcp on titcp.id=cp.TitularCartaPorte_Id
inner join AnalisisPorCaracteristica ac on ac.AnalisisDeCalidad_Id=r.AnalisisDeCalidad_Id
inner join Workflow w on W.Id = r.Workflow_Id 
where mc.RequiereTecnologia = 1 and r.rechazado=0 and (v.TipoVehiculo = 0 or v.TipoVehiculo = 2) and r.fechainicio &gt; @fechaDesde and r.fechainicio &lt; @fechaHasta
and dest.Id not in (select Proveedor_Id from ProveedorExcluidoIntacta) and w.TipoDeWorkflow = 0

union all

select cp.CTG as ctg,lc.codigoafip as codigoLocalidadDestino,c.CodigoEstablecimiento as numeroPlantaDestino, t.Nombre as codigoBiotecnologiaDeclarada,
m.CodigoEspecie as codigoEspecie,case lcp.CodigoAfip when '' then '0' else lcp.CodigoAfip end as codigoLocalidadProcedencia, case cp.CodEstab when '999999' then '' else cp.CodEstab end as establecimiento,
dest.Cuil as destinatario,c.Cuit as destino,rtte.Descripcion as remitenteComercial,rtte.Cuil as rtteComercialCuit,titcp.Descripcion as titularCartaPorte,titcp.Cuil as titularCartaPorteCuit,
case cp.NroCartaPorte when '' then '0' else cp.NroCartaPorte end as numeroCartaPorte,r.FechaInicio,r.FechaEgreso,cc.DescuentoEnKg as DescuentoKilos,r.PesoBruto-r.PesoTara as KilosNetos

from recorrido r left join MaterialPorCentro mc on r.material_id = mc.material_id and r.centro_id = mc.Centro_Id
left join centro c on c.id=r.centro_id
left join localidad lc on lc.id=c.Localidad_Id
left join vehiculo v on v.id=r.vehiculo_id
left join cartaporte cp on cp.id=v.cartaporte_id
left join Tecnologia t on t.id=cp.Tecnologia_Id
left join Material m on m.id=r.Material_Id
left join Localidad lcp on lcp.id=cp.Procedencia_Id
left join Proveedor dest on dest.id=cp.Destinatario_Id
left join Proveedor rtte on rtte.id=cp.RtteComercial_Id
left join Proveedor titcp on titcp.id=cp.TitularCartaPorte_Id
inner join Workflow w on W.Id = r.Workflow_Id 

inner join CaladoPorCaracteristica cc on cc.Calado_Id=r.Calado_Id and not exists (select id from AnalisisPorCaracteristica where AnalisisDeCalidad_Id=r.AnalisisDeCalidad_Id and cc.CaracteristicaDeCalidad_Id= CaracteristicaDeCalidad_Id)
where mc.RequiereTecnologia = 1 and r.rechazado=0 and (v.TipoVehiculo = 0 or v.TipoVehiculo = 2) and r.fechainicio &gt; @fechaDesde and r.fechainicio &lt; @fechaHasta
and dest.Id not in (select Proveedor_Id from ProveedorExcluidoIntacta) and w.TipoDeWorkflow = 0

) asde
group by ctg ,codigoLocalidadDestino, numeroPlantaDestino,codigoBiotecnologiaDeclarada,
codigoEspecie,codigoLocalidadProcedencia, establecimiento,destinatario,destino,remitenteComercial, rtteComercialCuit, titularCartaPorte, titularCartaPorteCuit,
numeroCartaPorte,FechaInicio,FechaEgreso,KilosNetos
order by FechaInicio</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
