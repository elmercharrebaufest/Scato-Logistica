        <Field Name="ctg">
          <DataField>ctg</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="codigoLocalidadDestino">
          <DataField>codigoLocalidadDestino</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="numeroPlantaDestino">
          <DataField>numeroPlantaDestino</DataField>
