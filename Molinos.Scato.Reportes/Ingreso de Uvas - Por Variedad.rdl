  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7741cc28-c759-424c-91c3-b919aa97a84b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Vinedo">
            <Value>=Parameters!Vinedo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Bodegas">
            <Value>=Parameters!Bodegas.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Vinatero">
            <Value>=Parameters!Viñatero.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @FechaDesdep datetime, @FechaHastap datetime, @Vinedop int, @Vinaterop int


set @Vinedop = @Vinedo
set @FechaDesdep = @FechaDesde
set @FechaHastap = @FechaHasta
set @Vinaterop = @Vinatero

SELECT      			Variedad.Descripcion AS Variedad,
            SUM(r.PesoBruto - r.PesoTaraBodega) AS MateriaPrima,            
            SUM((r.PesoBruto - r.PesoTaraBodega) * (CASE WHEN ancarazucar.ValorAnalisis IS NOT NULL 
				THEN ancarazucar.ValorAnalisis WHEN calcarazucar.ValorCalado IS NOT NULL THEN calcarazucar.ValorCalado ELSE 0 END)) / SUM(r.PesoBruto - r.PesoTaraBodega) AS Azucar,
            SUM((r.PesoBruto - r.PesoTaraBodega) * (CASE WHEN ancarcalidad.ValorAnalisis IS NOT NULL 
				THEN ancarcalidad.ValorAnalisis WHEN calcarcalidad.ValorCalado IS NOT NULL THEN calcarcalidad.ValorCalado ELSE 0 END)) / SUM(r.PesoBruto - r.PesoTaraBodega) AS Calidad,
            SUM((r.PesoBruto - r.PesoTaraBodega) * (CASE WHEN ancarsanidad.ValorAnalisis IS NOT NULL 
				THEN ancarsanidad.ValorAnalisis WHEN calcarsanidad.valorcalado IS NOT NULL THEN calcarsanidad.ValorCalado ELSE 0 END)) / SUM(r.PesoBruto - r.PesoTaraBodega) AS Sanidad
				
FROM        Recorrido AS r with (nolock) INNER JOIN
				Centro AS c with (nolock) ON r.Centro_Id = c.Id INNER JOIN
				Material AS material with (nolock) ON r.Material_Id = material.Id INNER JOIN
				Variedad AS variedad with (nolock) ON material.Variedad_Id = Variedad.Id INNER JOIN
                RemitoBodegaUva AS remito with (nolock) ON r.Id = remito.Recorrido_Id LEFT OUTER JOIN
                AnalisisDeCalidad with (nolock) ON AnalisisDeCalidad.Calado_Id = r.Calado_Id LEFT OUTER JOIN
                
                CaladoPorCaracteristica AS calcarazucar with (nolock) ON calcarazucar.Calado_Id = r.Calado_Id AND EXISTS
					(SELECT        1 AS Expr1
					FROM            CaracteristicaDeCalidad AS car with (nolock)
					WHERE        (Id = calcarazucar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
					AnalisisPorCaracteristica AS ancarazucar with (nolock) ON ancarazucar.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
						(SELECT        1 AS Expr1
						FROM            CaracteristicaDeCalidad with (nolock)
			            WHERE        (Id = ancarazucar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
			            
                CaladoPorCaracteristica AS calcarcalidad with (nolock) ON calcarcalidad.Calado_Id = r.Calado_Id AND EXISTS
					(SELECT        1 AS Expr1
					FROM            CaracteristicaDeCalidad AS car with (nolock)
					WHERE        (Id = calcarcalidad.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN
					AnalisisPorCaracteristica AS ancarcalidad with (nolock) ON ancarcalidad.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
						(SELECT        1 AS Expr1
						FROM            CaracteristicaDeCalidad with (nolock)
			            WHERE        (Id = ancarcalidad.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN

                CaladoPorCaracteristica AS calcarsanidad with (nolock) ON calcarsanidad.Calado_Id = r.Calado_Id AND EXISTS
					(SELECT        1 AS Expr1
					FROM            CaracteristicaDeCalidad AS car with (nolock)
					WHERE        (Id = calcarsanidad.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1)) LEFT OUTER JOIN
					AnalisisPorCaracteristica AS ancarsanidad with (nolock) ON ancarsanidad.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
						(SELECT        1 AS Expr1
						FROM            CaracteristicaDeCalidad with (nolock)
			            WHERE        (Id = ancarsanidad.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1))

WHERE        (r.Rechazado &lt;&gt; 1) AND (r.Terminado = 1) AND (r.FechaInicio IS NOT NULL) AND (@FechaDesdep &lt;= r.FechaInicio) AND (@FechaHastap &gt;= r.FechaInicio) AND 
                         ((@Vinedop &lt;&gt; 0 AND @Vinedop = remito.Vinedo_Id) OR
                                                       @Vinaterop = 0 OR
                                                       (@Vinedop = 0 AND remito.Vinedo_Id IN
                                                           (SELECT        Id
                                                             FROM            Vinedo WITH (nolock)
                                                             WHERE        Vinedo.Proveedor_Id = @Vinaterop)))
and r.Centro_Id in (@Bodegas)
GROUP BY variedad.Descripcion</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Variedad">
          <DataField>Variedad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MateriaPrima">
          <DataField>MateriaPrima</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Azucar">
          <DataField>Azucar</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Calidad">
          <DataField>Calidad</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Sanidad">
          <DataField>Sanidad</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NumeroINV + ' - ' + Descripcion AS Bodega, Id
FROM            Centro WITH (nolock)
WHERE        (NumeroINV IS NOT NULL)
order by NumeroINV ,Descripcion </CommandText>
      </Query>
      <Fields>
        <Field Name="Bodega">
          <DataField>Bodega</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Viñatero">
            <Value>=Parameters!Viñatero.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, NumeroINV + ' - ' + Descripcion AS Descripcion, NumeroINV + ' - ' + Descripcion AS ord
FROM            Vinedo WITH (nolock)
WHERE        (Proveedor_Id = @Viñatero) OR
                         (@Viñatero = NULL)
UNION
SELECT        0 AS id, 'TODOS' AS Descripcion, '0' AS ord
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet4">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Id, RazonSocial as Descripcion, RazonSocial as ord
FROM            Proveedor WITH (nolock)
WHERE Id in (select distinct Proveedor_Id from vinedo WITH (nolock))
UNION
SELECT        0 AS Id, 'TODOS' AS Descripcion, '0' as ord
order by ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
