  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.\SQLEXPRESS;Initial Catalog=Scato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>da93e132-c283-4745-9f3d-ae44584b6b48</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoDocumentoIngreso">
            <Value>=Parameters!TipoDocumentoIngreso.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int,@TipoDocumentoIngresop int, @fechaDesdep datetime, @fechaHastap datetime

set @CentroIdp= @CentroId
set @TipoDocumentoIngresop=@TipoDocumentoIngreso
set @fechaDesdep =@fechaDesde
set @fechaHastap = @fechaHasta

SELECT
    TipoDocumentoIngreso.Descripcion as 'Comprobante',
    DocumentoBorrado.NumeroDocumentoIngreso,
    Patente,
    Fecha,
    DocumentoBorrado.NombreUsuario,
    motivo,
Centro.CodigoSAP as CentroSap,
Centro.Descripcion as CentroDescripcion,
UltimaActividad,
EtapaDeBorrado

 FROM DocumentoBorrado WITH (NOLOCK)
	INNER JOIN  TipoDocumentoIngreso WITH (NOLOCK)
	ON DocumentoBorrado.TipoDocumentoIngreso = TipoDocumentoIngreso.Id
	INNER JOIN [Centro] as Centro WITH (NOLOCK)
	ON DocumentoBorrado.Centro_Id = Centro.Id
Where DocumentoBorrado.Centro_Id = @CentroIdp
and (TipoDocumentoIngreso.Id = @TipoDocumentoIngresop or @TipoDocumentoIngresop is null )
AND (cast(Fecha as date) &gt;= cast(@fechaDesdep as date))
AND (cast(Fecha as date) &lt;= cast(@fechaHastap as date))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="UltimaActividad">
          <DataField>UltimaActividad</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Comprobante">
          <DataField>Comprobante</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EtapaDeBorrado">
          <DataField>EtapaDeBorrado</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NombreUsuario">
          <DataField>NombreUsuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="motivo">
          <DataField>motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Centro.CodigoSap as CentroSap,
              Centro.Descripcion as CentroDescripcion

FROM [Centro] as Centro WITH (NOLOCK)

WHERE Centro.Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoDocumentoIngreso">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Descripcion, '0' AS ord
UNION
SELECT        Id, Descripcion, Descripcion AS ord
FROM            TipoDocumentoIngreso WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
