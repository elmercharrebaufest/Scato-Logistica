<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4bee3536-0691-4ddd-8af9-50dc8d78ae91</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Contingencia">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @FechaDesdep datetime
declare @FechaHastap datetime

set @FechaDesdep =@FechaDesde
set @FechaHastap = @FechaHasta

SELECT TipoContingencia AS Contingencia,
Fecha,
Usuario,
(CASE WHEN Activado = 1 THEN 'Habilitado'
ELSE 'Deshabilitado' END) as 'Activa',
Motivo
FROM   Contingencia
Where (CAST(@FechaDesdep  AS DATE)) &lt;=  (CAST(Fecha AS DATE)) AND
 (CAST(@FechaHastap AS DATE)) &gt;=  (CAST(Fecha AS DATE))</CommandText>
      </Query>
      <Fields>
        <Field Name="Contingencia">
          <DataField>Contingencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Activa">
          <DataField>Activa</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
