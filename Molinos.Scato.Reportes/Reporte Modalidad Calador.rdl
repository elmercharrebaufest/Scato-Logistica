      <rd:DataSourceID>b91053bd-1ff2-45e5-b21b-61077cd75416</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Modalidad">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaDesdep datetime DECLARE @FechaHastap datetime
SET                @FechaDesdep = @FechaDesde
SET                @FechaHastap = @FechaHasta
                             SELECT        CASE Automatico WHEN 1 THEN 'Activo' WHEN 0 THEN 'Desactivado' END AS Automatico, Motivo, c.Nombre, Fecha, Usuario
                              FROM            LogCambioDeModalidadCalle AS l JOIN
                                                       Calle c ON c.Id = l.Calle_Id
                              WHERE        (CAST(@FechaDesdep AS DATE)) &lt;= (CAST(Fecha AS DATE)) AND (CAST(@FechaHastap AS DATE)) &gt;= (CAST(Fecha AS DATE))</CommandText>
      </Query>
      <Fields>
        <Field Name="Automatico">
          <DataField>Automatico</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
