<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>12cf217a-54d1-4a08-8b9b-58f029cac834</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Lote">
            <Value>=RIGHT("000000" &amp; RIGHT(Parameters!Lote.Value, 6), 6)</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Centrop INT,
		@Lotep NVARCHAR(MAX)

SET @Centrop = @Centro
SET @Lotep = @Lote	

SELECT 
		[M].Descripcion AS [Producto],
		[Loc].Descripcion AS [Localidad],
	    [CP].NroCartaPorte AS [NroCartaPorte],
	    [MEA].[fechadescarga]  AS [FechaDescarga], 
	    [P].Descripcion AS [Vendedor],
	    [P2].Descripcion AS [Corredor],
	    [VEH].Patente AS [Patente],
	    [MEA].PesoNeto  AS [Kilos], 
	    [L].NumeroDeLote  AS [Lote], 
	    [C].Descripcion  AS [Centro],
	    [C].Id  AS [CentroId],
	    [CAM].Descripcion  AS [Camara]
FROM   [dbo].[muestraenvioacamara] AS [MEA] WITH (NOLOCK)
       INNER JOIN [Lote] L WITH (NOLOCK) ON MEA.Lote_Id = L.Id 
       LEFT JOIN [dbo].[cartaporte] AS [CP] WITH (NOLOCK)
                    ON [MEA].[cartaporte_id] = [CP].[id] 
       LEFT JOIN [dbo].[Vehiculo] AS [VEH] WITH (NOLOCK)
                    ON [VEH].CartaPorte_Id  = [MEA].[cartaporte_id]
       LEFT JOIN [dbo].[recorrido] AS [R] WITH (NOLOCK)
                    ON [VEH].Id = [R].Vehiculo_Id
	   LEFT JOIN [dbo].[centro] AS [C] WITH (NOLOCK)
                    ON [C].[Id] = [R].[Centro_Id] 
	   LEFT JOIN [dbo].[material] AS [M] WITH (NOLOCK)
                    ON [M].[Id] = [R].[Material_Id] 
       LEFT JOIN [dbo].[proveedor] AS [P] WITH (NOLOCK)
                    ON [CP].[TitularCartaPorte_Id] = [P].[Id] 
       LEFT JOIN [dbo].[proveedor] AS [P2] WITH (NOLOCK)
                    ON [CP].[Corredor_Id] = [P2].[Id] 
       LEFT JOIN [dbo].[localidad] AS [Loc] WITH (NOLOCK)
                    ON [CP].[Procedencia_Id] = [Loc].[Id] 
       LEFT JOIN [dbo].[Camara] AS [CAM] WITH (NOLOCK)
                    ON [CAM].[Id] = [L].[Camara_Id]
where [R].[Centro_Id] = @Centrop
AND RIGHT([L].NumeroDeLote, 6) = @Lotep</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Producto">
          <DataField>Producto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Localidad">
          <DataField>Localidad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NroCartaPorte">
          <DataField>NroCartaPorte</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaDescarga">
          <DataField>FechaDescarga</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Vendedor">
          <DataField>Vendedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Corredor">
          <DataField>Corredor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Kilos">
          <DataField>Kilos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Lote">
          <DataField>Lote</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Camara">
          <DataField>Camara</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT Id, Descripcion FROM dbo.Centro  WITH (NOLOCK)
ORDER BY Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDs">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        TOP (1) Logo
FROM            Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
