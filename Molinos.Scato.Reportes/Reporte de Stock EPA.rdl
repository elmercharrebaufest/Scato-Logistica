          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Intermediario">
          <DataField>Intermediario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Campaña">
          <DataField>Campaña</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RemitenteComercial">
          <DataField>RemitenteComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Stock_Declarado">
          <DataField>Stock Declarado</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Corredor">
          <DataField>Corredor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Stock_Utilizado">
          <DataField>Stock Utilizado</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Stock_Disponible">
          <DataField> Stock Disponible</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Provisorio">
          <DataField>Provisorio</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="Standard2">
          <DataField>Standard2</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
