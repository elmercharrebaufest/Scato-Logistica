<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d46afeca-7595-416d-9ebb-9f0eebfef022</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaEgresoDesde">
            <Value>=Parameters!FechaEgresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaEgresoHasta">
            <Value>=Parameters!FechaEgresoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoDesde">
            <Value>=Parameters!FechaIngresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoHasta">
            <Value>=Parameters!FechaIngresoHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @FechaIngresoDesdep datetime, @FechaIngresoHastap datetime, @FechaEgresoDesdep datetime, @FechaEgresoHastap datetime


set @FechaIngresoDesdep = @FechaIngresoDesde
set @FechaIngresoHastap = @FechaIngresoHasta
set @FechaEgresoDesdep = @FechaEgresoDesde
set @FechaEgresoHastap = @FechaEgresoHasta

SELECT OD.numero                  AS        NroDocumento,
          C.Descripcion              AS        Centro,
          C.Id             	       AS        CentroId,
          RE.fechainicio             AS        FechaIngreso,
          RE.fechaegreso             AS        FechaEgreso,
          RO.Id				      AS	    NroRomaneo,
          RO.NroPedido			      AS        NroPedido,
          RITEM.RemitoNro		      AS        NroRemito,
          M.CodigoSAP		          AS        MaterialCodigo,
          M.Descripcion		      AS        MaterialDescripcion,
          RITEM.pesobruto               AS        PesoBruto,
          RITEM.pesotara                AS        PesoTara,
          RITEM.pesobruto - RITEM.pesotara AS        PesoNeto,
          RITEM.DocMaterial AS		DocumentoSAPIngreso,
          RITEM.EjercicioDocMaterialAnulacion AS DocumentoSAPAnulacion
          FROM   dbo.ordendedescarga OD WITH(NOLOCK)
          INNER JOIN dbo.recorrido RE WITH(NOLOCK)
          ON RE.NumeroDocumentoIngreso = OD.Numero
          AND RE.tipodocumentoingreso = (SELECT id
          FROM   dbo.tipodocumentoingreso WITH(NOLOCK)
          WHERE
          descripcion = 'Orden de Descarga')
          LEFT JOIN romaneo RO WITH(NOLOCK)
          ON RO.workflowinstanceid = RE.instanciaworkflow
          LEFT JOIN romaneoitem RITEM WITH(NOLOCK)
          ON RO.id = RITEM.romaneo_id
          LEFT JOIN Material M WITH(NOLOCK)
          ON M.Id = RITEM.Material_Id
          LEFT JOIN dbo.Centro C WITH(NOLOCK)
          ON C.Id = RE.Centro_Id

          WHERE RITEM.Rechazado = 1 AND RE.FechaEgreso IS NOT NULL AND  
		   (CAST(RE.FechaEgreso AS DATE) &gt;= CAST(@FechaEgresoDesdep AS DATE) OR @FechaEgresoDesdep IS NULL)
		  AND (CAST(RE.FechaEgreso AS DATE)&lt;= CAST(@FechaEgresoHastap AS DATE) OR @FechaEgresoHastap IS NULL) 
		  AND(CAST(RE.FechaInicio AS DATE) &gt;= CAST(@FechaIngresoDesdep AS DATE) 
		AND CAST(RE.FechaInicio AS DATE) &lt;= CAST(@FechaIngresoHastap AS DATE))
 ORDER BY Centro</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NroDocumento">
          <DataField>NroDocumento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
