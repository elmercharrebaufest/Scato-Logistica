<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fb525df4-7129-4fd4-ae67-70743067d55d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoDocumentoIngreso">
            <Value>=Parameters!TipoDocumentoEntrada.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@NumeroDocumentoDeEntrada">
            <Value>=Parameters!NumeroDocumentoDeEntrada.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Centrop DATETIME, 
		@TipoDocumentoIngresop INT,
		@NumeroDocumentoDeEntradap NVARCHAR(MAX),
		@Patentep NVARCHAR(MAX)

SET		@Centrop = @Centro
SET		@TipoDocumentoIngresop = @TipoDocumentoIngreso
SET		@NumeroDocumentoDeEntradap = @NumeroDocumentoDeEntrada
SET		@Patentep = @Patente


SELECT
          Centro.Descripcion as Centro,
          Centro.Id as CentroId,
          TipoDocumentoIngreso.Descripcion as TipoDocumentoDeEntrada,
          TipoDocumentoIngreso.Id as IdTipo,
          Recorrido.NumeroDocumentoIngreso,
          Recorrido.Patente,

          /*datos cargados en mesa de entrada?*/
          Recorrido.FechaInicio,
          Recorrido.PesoBruto,
          Recorrido.PesoBrutoFecha,
          Recorrido.PesoTara,
          Recorrido.PesoTaraFecha,
          CASE WHEN Recorrido.Terminado = 1
		  THEN 'Fin De Workflow'
		  ELSE (SELECT TOP 1 Actividad FROM LogActividad WITH (NOLOCK) where LogActividad.WorkflowInstanceId = Recorrido.InstanciaWorkflow order by id desc)
	      END as 'Etapa',
          (SELECT TOP 1 BajaCTG.CodigoDeBaja FROM BajaCTG WITH (NOLOCK) where BajaCTG.WorkflowId = Recorrido.InstanciaWorkflow) as BajaCTG,
          CASE WHEN Recorrido.AnalisisDeCalidad_Id &gt; 0
	THEN 'S' 
	ELSE 'N' 
	END as 'Análisis de Calidad',
	'SIN ASIGNAR' as 'Ruta Asignada'
	
FROM [Recorrido] WITH (NOLOCK)
	LEFT JOIN  [Vehiculo] WITH (NOLOCK)
	ON Recorrido.Vehiculo_Id = [Vehiculo].Id

	LEFT JOIN  [CartaPorte] WITH (NOLOCK)
	ON [Vehiculo].CartaPorte_Id = [CartaPorte].Id
	
	INNER JOIN [Centro] WITH (NOLOCK)
	ON Recorrido.Centro_Id = Centro.Id

	INNER JOIN [TipoDocumentoIngreso] WITH (NOLOCK)
	ON TipoDocumentoIngreso.Id = Recorrido.TipoDocumentoIngreso
	
WHERE
	(Recorrido.Centro_Id = @Centro)
	AND (Recorrido.TipoDocumentoIngreso = @TipoDocumentoIngreso or @TipoDocumentoIngreso IS NULL)
	AND (Recorrido.NumeroDocumentoIngreso = @NumeroDocumentoDeEntrada or @NumeroDocumentoDeEntrada = '')
	AND (Recorrido.Patente = @Patente or @Patente = '')</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoDocumentoDeEntrada">
          <DataField>TipoDocumentoDeEntrada</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IdTipo">
          <DataField>IdTipo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaInicio">
          <DataField>FechaInicio</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PesoBruto">
          <DataField>PesoBruto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PesoBrutoFecha">
          <DataField>PesoBrutoFecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PesoTara">
          <DataField>PesoTara</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PesoTaraFecha">
          <DataField>PesoTaraFecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Etapa">
          <DataField>Etapa</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BajaCTG">
          <DataField>BajaCTG</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Análisis_de_Calidad">
          <DataField>Análisis de Calidad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ruta_Asignada">
          <DataField>Ruta Asignada</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Descripcion AS Centro, Id
FROM            Centro WITH (NOLOCK)
ORDER BY Centro</CommandText>
      </Query>
      <Fields>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposDeDocumentos">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS TipoDocumentoIngreso, '0' AS ord
UNION
SELECT        Id, Descripcion AS TipoDocumentoIngreso, Descripcion AS ord
FROM            TipoDocumentoIngreso WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoDocumentoIngreso">
          <DataField>TipoDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @Centro)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
