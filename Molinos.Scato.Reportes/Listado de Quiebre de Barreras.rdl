<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8bfa80e0-2a42-4b48-82ff-db9a4ae90cf7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE  @FechaDesdep DATETIME, 
	@FechaHastap DATETIME , 
	@CentroIdp INT

SET @FechaDesdep = @FechaDesde 
SET @FechaHastap = @FechaHasta 
SET @CentroIdp = @CentroId

select distinct MQB.Fecha as 'Fecha',
MQB.Motivo as 'Motivo',
MQB.Patente as 'Patente',
T.RazonSocial as 'Transportista',
P.Lector as 'Lector Entrada',
P.NombrePuesto as 'Puesto Trabajo',
C.Id as 'CentroId',
C.CodigoSAP as 'CodigoSap',
C.Descripcion as 'Descripcion'
from MotivoQuiebreBarrera MQB WITH (NOLOCK)
inner join PuestoDeTrabajo P WITH (NOLOCK) on MQB.PuestoTrabajo_Id = P.Id
inner join Centro C WITH (NOLOCK) on P.Centro_Id = C.Id
left join Transportista T WITH (NOLOCK) on MQB.Transportista_Id = T.Id
where MQB.Fecha &gt;= @FechaDesdep and MQB.Fecha &lt; @FechaHastap and P.Centro_Id = @CentroIdp</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Transportista">
          <DataField>Transportista</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Lector_Entrada">
          <DataField>Lector Entrada</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Puesto_Trabajo">
          <DataField>Puesto Trabajo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CodigoSap">
          <DataField>CodigoSap</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
