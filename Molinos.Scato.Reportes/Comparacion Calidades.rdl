<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c193c2bc-064a-41aa-ba4d-dfb52dc96d12</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaOrigen_Desde">
            <Value>=Parameters!FechaOrigen_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaOrigen_Hasta">
            <Value>=Parameters!FechaOrigen_Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDestino_Desde">
            <Value>=Parameters!FechaDestino_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDestino_Hasta">
            <Value>=Parameters!FechaDestino_Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DocumentoIngreso">
            <Value>=Parameters!DocumentoIngreso.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaOrigen_Desdep DATETIME,
		@FechaDestino_Desdep DATETIME,
		@FechaOrigen_Hastap DATETIME,
		@FechaDestino_Hastap DATETIME,
		@CentroIdp INT,
		@Patentep NVARCHAR(10),
		@DocumentoIngresop NVARCHAR(20)

SET		@FechaOrigen_Desdep = @FechaOrigen_Desde
SET		@FechaDestino_Desdep = @FechaOrigen_Hasta
SET		@FechaOrigen_Hastap = @FechaDestino_Desde
SET		@FechaDestino_Hastap = @FechaDestino_Hasta
SET		@CentroIdp = @CentroId
SET		@Patentep = @Patente
SET		@DocumentoIngresop = @DocumentoIngreso                     

SELECT [Patente] as 'Patente'
	,[NumeroDocumentoIngreso] as 'N de Documento'
	  
     	,[Tipo Vehiculo] as 'Tipo Vehiculo'
      	,[Material] as 'Material'
	 ,[Centro Origen] as 'Centro Origen'
	 ,[Centro Destino] as 'Centro Destino'
	,[Peso Bruto Origen] AS 'Peso Bruto Origen'
	,[Peso Bruto Destino] AS 'Peso Bruto Destino'
	,[Peso Tara Origen] AS 'Peso Tara Origen'
	,[Peso Tara Destino] AS 'Peso Tara Destino'
	  ,[HUMEDAD1] as 'Humedad Origen'
	  ,[HUMEDAD2] as 'Humedad Destino'
	  ,[CHAMICO1] as 'Chamico Origen'
	  ,[CHAMICO2] as 'Chamico Destino'
	  ,[CUERPOS EXTRAÑOS1] as 'Cuerpos extranios Origen'
	  ,[CUERPOS EXTRAÑOS2] as 'Cuerpos extranios Destino'
	  ,[GRANOS VERDES1] as 'Granos Verdes Origen'
	  ,[GRANOS VERDES2] as 'Granos Verdes Destino'
	  ,[DAÑADOS1] as 'Daniados Origen'
	  ,[DAÑADOS2] as 'Daniados Destino'
	  ,[GRANOS AVERIADOS o QUEMADOS1] as 'Granos Averiados o Quemados Origen'
	  ,[GRANOS AVERIADOS o QUEMADOS2] as 'Granos Averiados o Quemados Destino'
	  ,[GRANOS COLOREADOS1] as 'Granos Coloreados Origen'
	  ,[GRANOS COLOREADOS2] as 'Granos Coloreados Destino'
	  ,[GRANOS NEGROS1] as 'Granos Negros Origen'
	  ,[GRANOS NEGROS2] as 'Granos Negros Destino'
	  ,[REVOLCADO1] as 'Revolcado Origen'
	  ,[REVOLCADO2] as 'Revolcado Destino'
	  ,[OLOR1] as 'Olor Origen'
	  ,[OLOR2] as 'Olor Destino'
	  ,[TIERRA1] as 'Tierra Origen'
	  ,[TIERRA2] as 'Tierra Destino'
	  ,[INSECTOS VIVOS1] as 'Insectos Vivos Origen'
	  ,[INSECTOS VIVOS2] as 'Insectos Vivos Destino'
	  ,[INSECTOS Y ARACNIDOS1] as 'Insectos y Aracnidos Origen'
	  ,[INSECTOS Y ARACNIDOS2] as 'Insectos y Aracnidos Destino'
	  ,[MERMA CHAMICO1] as 'Merma Chamico Origen'
	  ,[MERMA CHAMICO2] as 'Merma Chamico Destino'
	  ,[MOHO1] as 'Moho Origen'
	  ,[MOHO2] as 'Moho Destino'
	  ,[QUEBRADOS1]  as 'Quebrados Origen'
	  ,[QUEBRADOS2]  as 'Quebrados Destino'
	  ,[PROTEINAS1]  as 'Proteinas Origen'
	  ,[PROTEINAS2]  as 'Proteinas Destino'
	  ,[PESO HECTOLITRICO1]  as 'PH Origen'
	  ,[PESO HECTOLITRICO2]  as 'PH Destino'
	  ,[GRADO1]  as 'Grado Origen'
	  ,[GRADO2]  as 'Grado Destino'
	  ,[GRANOS DAÑADOS1]  as 'Granos Danados Origen'
	  ,[GRANOS DAÑADOS2]  as 'Granos Danados Destino'
	  ,[GRANOS QUEBRADOS1]  as 'Granos Quebrados Origen'
	  ,[GRANOS QUEBRADOS2]  as 'Granos Quebrados Destino'
	  ,[MATERIAS EXTRAÑAS1]  as 'Materias Extranas Origen'
	  ,[MATERIAS EXTRAÑAS2]  as 'Materias Extranas Destino'
	  ,[GRANOS ARDIDOS1]  as 'Granos Ardidos Origen'
	  ,[GRANOS ARDIDOS2]  as 'Granos Ardidos Destino'
	  ,[TOTAL DAÑADOS1]  as 'Total daniados Origen'
	  ,[TOTAL DAÑADOS2]  as 'Total daniados Destino'
	  ,[GRANOS CON CARBON1]  as 'Granos con Carbon Origen'
	  ,[GRANOS CON CARBON2]  as 'Granos con Carbon Destino'
	  ,[GRANOS PANZA BLANCA1]  as 'Granos panza blanca Origen'
	  ,[GRANOS PANZA BLANCA2]  as 'Granos panza blanca Destino'
FROM 
(SELECT 
r.id AS 'Id Origen' ,
r2.id AS 'Id Destino',
r.NumeroDocumentoIngreso AS 'NumeroDocumentoIngreso',
m.Descripcion As 'Material',
r.Patente As 'Patente',
v.Descripcion AS 'Tipo Vehiculo',
r.PesoBruto As 'Peso Bruto Origen',
r2.PesoBruto As 'Peso Bruto Destino',
r.PesoTara As 'Peso Tara Origen',
r2.PesoTara As 'Peso Tara Destino',
r.FechaInicio AS 'Fecha Origen',
r2.FechaInicio AS 'Fecha Destino',
C1.Descripcion As 'Centro Origen',
C2.Descripcion AS 'Centro Destino',
(CASE
			WHEN AnaPorCar.ValorAnalisis IS NULL 
			THEN CalPorCar.ValorCalado
			ELSE AnaPorCar.ValorAnalisis
			END) as 'ValorDeCalidad',
(CASE
			WHEN AnaPorCar2.ValorAnalisis IS NULL 
			THEN CalPorCar2.ValorCalado
			ELSE AnaPorCar2.ValorAnalisis
			END) as 'ValorDeCalidad2',
CDCM.Descripcion+'1' as 'Calidad1',
CDCM2.Descripcion+'2' as 'Calidad2'

FROM Recorrido r 
LEFT JOIN REcorrido r2 On r.NumeroDocumentoIngreso = r2.NumeroDocumentoIngreso
LEFT JOIN WorkflowDefinicion wd1 ON  wd1.Id = r.WorkflowDefinicion_Id 
LEFT JOIN WorkflowDefinicion wd2 ON  wd2.Id = r2.WorkflowDefinicion_Id 

LEFT JOIN Workflow w1 ON  wd1.Workflow_Id = w1.Id
LEFT JOIN Workflow w2 ON  wd2.Workflow_Id = w2.Id
INNER JOIN Material M WITH(NOLOCK) on M.Id = r.material_Id  
INNER JOIN TipoVehiculo v WITH(NOLOCK) on v.Id = r.TipoVehiculo
INNER JOIN Centro C1 WITH(NOLOCK) on C1.Id = r.Centro_Id  
INNER JOIN Centro C2 WITH(NOLOCK) on C2.Id = r2.Centro_Id  

INNER JOIN MaterialPorCentro Mpc WITH(NOLOCK) on Mpc.Material_Id = r.material_Id and Mpc.centro_id = r.centro_id 
LEFT JOIN CaracteristicaDeCalidad CarDeCal WITH(NOLOCK) on CarDeCal.MaterialPorCentro_id = Mpc.id and (r.calado_id is not null or r.AnalisisdeCalidad_id is not null)
FULL OUTER JOIN CaladoPorCaracteristica CalPorCar WITH(NOLOCK) on CalPorCar.Calado_Id = R.Calado_Id and CalPorCar.CaracteristicaDeCalidad_Id = CarDeCal.id
FULL OUTER JOIN AnalisisPorCaracteristica AnaPorCar WITH(NOLOCK) on AnaPorCar.AnalisisDeCalidad_Id = R.AnalisisDeCalidad_Id and AnaPorCar.CaracteristicaDeCalidad_Id = CarDeCal.id
LEFT JOIN CaracteristicaDeCalidadMaestro CDCM WITH(NOLOCK) on CDCM.Id = CarDeCal.CaracteristicaDeCalidadMaestro_Id

INNER JOIN MaterialPorCentro Mpc2 WITH(NOLOCK) on Mpc2.Material_Id = r2.material_Id and Mpc2.centro_id = r2.centro_id 
LEFT JOIN CaracteristicaDeCalidad CarDeCal2 WITH(NOLOCK) on CarDeCal2.MaterialPorCentro_id = Mpc2.id and (r2.calado_id is not null or r2.AnalisisdeCalidad_id is not null)
FULL OUTER JOIN CaladoPorCaracteristica CalPorCar2 WITH(NOLOCK) on CalPorCar2.Calado_Id = R2.Calado_Id and CalPorCar2.CaracteristicaDeCalidad_Id = CarDeCal2.id
FULL OUTER JOIN AnalisisPorCaracteristica AnaPorCar2 WITH(NOLOCK) on AnaPorCar2.AnalisisDeCalidad_Id = R2.AnalisisDeCalidad_Id and AnaPorCar2.CaracteristicaDeCalidad_Id = CarDeCal2.id
LEFT JOIN CaracteristicaDeCalidadMaestro CDCM2 WITH(NOLOCK) on CDCM2.Id = CarDeCal2.CaracteristicaDeCalidadMaestro_Id


where w1.TipoDeWorkflow = 1 AND w2.TipoDeWorkflow = 0 AND
	  ((@FechaOrigen_Desdep IS NULL OR @FechaOrigen_Desdep &lt;= r.FechaInicio) AND  (@FechaOrigen_Hastap IS NULL OR r.FechaInicio &lt;= @FechaOrigen_Hastap)) AND
	  ((@FechaDestino_Desdep IS NULL OR @FechaDestino_Desdep &lt;= r2.FechaInicio) AND (@FechaDestino_Hastap IS NULL OR  r2.FechaInicio &lt;= @FechaDestino_Hastap)) AND
	  (@Patentep = r.Patente OR @Patentep IS NULL OR @Patentep = '') AND
	  (@DocumentoIngresop = r.NumeroDocumentoIngreso OR @DocumentoIngresop IS NULL OR @DocumentoIngresop = '') 

)PVT

	PIVOT (MAX([ValorDeCalidad]) 
	FOR Calidad1 IN ([HUMEDAD1], 
						[CHAMICO1],
						[CUERPOS EXTRAÑOS1], 
						[GRANOS VERDES1], 
						[DAÑADOS1], 
						[GRANOS AVERIADOS o QUEMADOS1], 
						[GRANOS COLOREADOS1],
						[GRANOS NEGROS1], 
						[REVOLCADO1],
						[OLOR1],
						[TIERRA1],
						[INSECTOS VIVOS1],
						[INSECTOS Y ARACNIDOS1],
						[MERMA CHAMICO1],
						[MOHO1],
						[QUEBRADOS1],
						[PROTEINAS1],
						[PESO HECTOLITRICO1],
						[GRADO1],
						[GRANOS DAÑADOS1],
						[GRANOS QUEBRADOS1],
						[MATERIAS EXTRAÑAS1],
						[GRANOS ARDIDOS1],
						[TOTAL DAÑADOS1],
						[GRANOS CON CARBON1],
						[GRANOS PANZA BLANCA1])
						
	
	) AS PV1
	
	PIVOT (MAX([ValorDeCalidad2]) 
	FOR Calidad2 IN ([HUMEDAD2], 
						[CHAMICO2],
						[CUERPOS EXTRAÑOS2], 
						[GRANOS VERDES2], 
						[DAÑADOS2], 
						[GRANOS AVERIADOS o QUEMADOS2], 
						[GRANOS COLOREADOS2],
						[GRANOS NEGROS2], 
						[REVOLCADO2],
						[OLOR2],
						[TIERRA2],
						[INSECTOS VIVOS2],
						[INSECTOS Y ARACNIDOS2],
						[MERMA CHAMICO2],
						[MOHO2],
						[QUEBRADOS2],
						[PROTEINAS2],
						[PESO HECTOLITRICO2],
						[GRADO2],
						[GRANOS DAÑADOS2],
						[GRANOS QUEBRADOS2],
						[MATERIAS EXTRAÑAS2],
						[GRANOS ARDIDOS2],
						[TOTAL DAÑADOS2],
						[GRANOS CON CARBON2],
						[GRANOS PANZA BLANCA2])
	) AS PV2</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
