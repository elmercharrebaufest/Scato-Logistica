  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>01ffa12c-f31b-4401-9cba-f91bfcf8c65b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CodigoSAP, Descripcion 
FROM Centro
WHERE Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CodigoSAP">
          <DataField>CodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CentroProductor">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoBIN">
            <Value>=Parameters!TipoBIN.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Proveedor.Descripcion, ISNULL((select SaldoInicial from [dbo].[CalcularSaldo](DATEADD(DAY,1,@FechaDesde), @TipoBIN, 'P', Proveedor.Id)),0) as Stock
FROM            Proveedor where exists(select 1 from
                         Vinedo where Vinedo.Proveedor_Id = Proveedor.Id)
UNION ALL
SELECT        Descripcion, ISNULL((select SaldoInicial from [dbo].[CalcularSaldo](DATEADD(DAY,1,@FechaDesde), @TipoBIN, 'C', Centro.Id)),0) as Stock
FROM            Centro
WHERE        (NumeroINV IS NOT NULL)
ORDER BY Proveedor.Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Stock">
          <DataField>Stock</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposDeBin">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>
SELECT ID, Descripcion, Descripcion as ord 
FROM Material 
WHERE UsaBinPallet = 1
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Material_Id">
            <Value>=Parameters!TipoBIN.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT  Descripcion 
FROM material 
WHERE Id = @Material_Id</CommandText>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDs">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        TOP (1) Logo
FROM            Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="CentroId">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>5</Value>
        </Values>
      </DefaultValue>
      <Prompt>Centro Id</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
    <ReportParameter Name="FechaDesde">
      <DataType>DateTime</DataType>
      <Prompt>Fecha</Prompt>
    </ReportParameter>
    <ReportParameter Name="Language">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>es-Ar</Value>
        </Values>
      </DefaultValue>
      <Prompt>Language</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
    <ReportParameter Name="TipoBIN">
      <DataType>Integer</DataType>
      <Prompt>Tipo de Bin</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>TiposDeBin</DataSetName>
          <ValueField>ID</ValueField>
          <LabelField>Descripcion</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
  <Code>Public Function SeleccionoCentro(ByVal s as String) as Boolean
        If(s Is Nothing OrElse s.EndsWith("P")) Then 
            Return False
        Else: Return True
        End If
    End Function

Public Function SeleccionoProveedor(ByVal s as String) as Boolean
        If(s Is Nothing OrElse s.EndsWith("C")) Then 
            Return False
        Else: Return True
        End If
    End Function</Code>
