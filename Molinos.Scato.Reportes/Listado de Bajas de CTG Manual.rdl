<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>62210bef-d880-4b43-b70e-5c0e309df265</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraIngreso_Desde">
            <Value>=Parameters!FechaHoraIngreso_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraIngreso_Hasta">
            <Value>=Parameters!FechaHoraIngreso_Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraEgreso_Desde">
            <Value>=Parameters!FechaHoraEgreso_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraEgreso_Hasta">
            <Value>=Parameters!FechaHoraEgreso_Hasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @Centrop int
declare @FechaHoraIngreso_Desdep datetime
declare @FechaHoraIngreso_Hastap datetime
declare @FechaHoraEgreso_Desdep datetime
declare @FechaHoraEgreso_Hastap datetime

set @Centrop = @Centro
set @FechaHoraIngreso_Desdep = @FechaHoraIngreso_Desde
set @FechaHoraIngreso_Hastap = @FechaHoraIngreso_Hasta
set @FechaHoraEgreso_Desdep = @FechaHoraEgreso_Desde
set @FechaHoraEgreso_Hastap = @FechaHoraEgreso_Hasta


SELECT DISTINCT TD.Descripcion AS TipoDocumento, R.NumeroDocumentoIngreso, M.Descripcion AS Material, CR.Actividad, R.FechaInicio AS Fecha, R.Usuario, R.Centro_Id AS CentroId, C.Descripcion AS Centro
FROM            BajaCTG AS B WITH (NOLOCK) INNER JOIN
                         Recorrido AS R WITH (NOLOCK) ON B.WorkflowId = R.InstanciaWorkflow INNER JOIN
                         TipoDocumentoIngreso AS TD WITH (NOLOCK) ON R.TipoDocumentoIngreso = TD.Id INNER JOIN
                         ControlRecorrido AS CR WITH (NOLOCK) ON B.WorkflowId = CR.WorkflowInstanceId INNER JOIN
                         Material AS M WITH (NOLOCK) ON R.Material_Id = M.Id INNER JOIN
                         Centro AS C WITH (NOLOCK) ON R.Centro_Id = C.Id
WHERE        (CR.Mensaje = 'Manual') AND (CR.Actividad = 'Baja de CTG' OR
                         CR.Actividad = 'Baja CTG Definitivo') AND (R.Centro_Id = @Centrop) AND (R.FechaInicio &gt;= @FechaHoraIngreso_Desdep) AND (R.FechaInicio &lt;= @FechaHoraIngreso_Hastap) AND 
                         (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND (R.FechaEgreso &gt;= @FechaHoraEgreso_Desdep) OR
                         (CR.Mensaje = 'Manual') AND (CR.Actividad = 'Baja de CTG' OR
                         CR.Actividad = 'Baja CTG Definitivo') AND (R.Centro_Id = @Centrop) AND (R.FechaInicio &lt;= @FechaHoraIngreso_Hastap) AND (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND 
                         (R.FechaEgreso &gt;= @FechaHoraEgreso_Desdep) AND (@FechaHoraIngreso_Desdep IS NULL) OR
                         (CR.Mensaje = 'Manual') AND (CR.Actividad = 'Baja de CTG' OR
                         CR.Actividad = 'Baja CTG Definitivo') AND (R.Centro_Id = @Centrop) AND (R.FechaInicio &gt;= @FechaHoraIngreso_Desdep) AND (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND 
                         (R.FechaEgreso &gt;= @FechaHoraEgreso_Desdep) AND (@FechaHoraIngreso_Hastap IS NULL) OR
                         (CR.Mensaje = 'Manual') AND (CR.Actividad = 'Baja de CTG' OR
                         CR.Actividad = 'Baja CTG Definitivo') AND (R.Centro_Id = @Centrop) AND (R.FechaEgreso &lt;= @FechaHoraEgreso_Hastap) AND (R.FechaEgreso &gt;= @FechaHoraEgreso_Desdep) AND 
                         (@FechaHoraIngreso_Desdep IS NULL) AND (@FechaHoraIngreso_Hastap IS NULL)</CommandText>
      </Query>
      <Fields>
        <Field Name="TipoDocumento">
          <DataField>TipoDocumento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
