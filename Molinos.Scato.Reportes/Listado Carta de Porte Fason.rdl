  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>da93e132-c283-4745-9f3d-ae44584b6b48</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Proveedor">
            <Value>=Parameters!Proveedor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ConCorredor">
            <Value>=Parameters!ConCorredor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int,@Materialp int,@Proveedorp int ,@ConCorredorp bit,@FechaDesdep datetime, @FechaHastap datetime


set @CentroIdp= @CentroId
set @Materialp= @Material
set @Proveedorp=@Proveedor
set @ConCorredorp=@ConCorredor
set @fechaDesdep =@fechaDesde
set @fechaHastap = @fechaHasta

SELECT DISTINCT 
	   R.Id,
	   R.NumeroDocumentoIngreso AS 'Nº CCPP',
       R.FechaEgreso AS 'Fecha Descarga',
       Rtte.Descripcion AS 'Razon Social(Cargador)',
       Rtte.Cuil AS 'CUIT(Cargador)',
       Inter.Descripcion AS 'Cuenta y Orden 1',
       Inter.Cuil AS 'CUIT Cuenta y Orden 1',
       Agent.Descripcion AS 'Cuenta y Orden 2',
       Agent.Cuil AS 'CUIT Cuenta y Orden 2',
       M.Descripcion AS 'Grano',
       C.Variedad AS 'Tipo',
       C.AcuerdoMarco AS 'Contrato',
       L.Descripcion AS 'Procedencia Partido o Dep.',
       P.Descripcion AS 'Procedencia Provincia',
       Corr.Descripcion AS 'Corredor',
       Entr.RazonSocial AS 'Representante / Entregador',
       Destinatario.Descripcion AS 'Razon Social del Destinatario',
       Destino.Descripcion AS 'Lugar de destino de los granos',
       R.PesoBruto - R.PesoTara AS 'Kilos Descargados',
       (CASE
            WHEN AnaHumedad.valoranalisis IS NULL THEN CalHumedad.DescuentoEnPorcentaje
            ELSE AnaHumedad.DescuentoEnPorcentaje
        END) AS 'Humedad',
       (CASE
            WHEN AnaHumedad.valoranalisis IS NULL THEN CalHumedad.DescuentoEnKg
            ELSE AnaHumedad.DescuentoEnKg
        END) AS 'Humedad Descuento Kg',
		(CASE
            WHEN AnaCuerpos.valoranalisis IS NULL THEN CalCuerpos.DescuentoEnPorcentaje
            ELSE AnaCuerpos.DescuentoEnPorcentaje
        END) AS 'Cuerpos extranios',
       (CASE
            WHEN AnaCuerpos.valoranalisis IS NULL THEN CalCuerpos.DescuentoEnKg
            ELSE AnaCuerpos.DescuentoEnKg
        END) AS 'Cuerpos extranios Desc Kg',
		(CASE
            WHEN AnaGranos.valoranalisis IS NULL THEN CalGranos.DescuentoEnPorcentaje
            ELSE AnaGranos.DescuentoEnPorcentaje
        END) AS 'Granos Verdes',
       (CASE
            WHEN AnaGranos.valoranalisis IS NULL THEN CalGranos.DescuentoEnKg
            ELSE AnaGranos.DescuentoEnKg
        END) AS 'Granos Verdes Desc Kg',
		((R.PesoBruto - R.PesoTara) - 
		 ISNULL((CASE
            WHEN AnaHumedad.valoranalisis IS NULL THEN CalHumedad.DescuentoEnKg
            ELSE AnaHumedad.DescuentoEnKg
        END), 0) -
		       ISNULL((CASE
            WHEN AnaCuerpos.valoranalisis IS NULL THEN CalCuerpos.DescuentoEnKg
            ELSE AnaCuerpos.DescuentoEnKg
        END), 0) -
		       ISNULL((CASE
            WHEN AnaGranos.valoranalisis IS NULL THEN CalGranos.DescuentoEnKg
            ELSE AnaGranos.DescuentoEnKg
        END), 0)) AS 'Kg Netos a Aplicar',
       C.TitularCartaPorte_Id,
       R.Centro_Id
FROM Recorrido AS R
INNER JOIN Vehiculo AS V WITH (NOLOCK) ON V.Id = R.Vehiculo_Id
INNER JOIN CartaPorte AS C WITH (NOLOCK) ON C.Id = V.CartaPorte_Id
INNER JOIN Material AS M WITH (NOLOCK) ON R.Material_Id = M.Id
INNER JOIN Localidad AS L WITH (NOLOCK) ON L.Id = C.Procedencia_Id
INNER JOIN Provincia AS P WITH (NOLOCK) ON P.Id = L.Provincia_Id
INNER JOIN Workflow as W WITH (NOLOCK) ON W.Id = R.Workflow_Id
LEFT OUTER JOIN Proveedor AS Rtte WITH (NOLOCK) ON C.RtteComercial_Id = Rtte.Id
LEFT OUTER JOIN Proveedor AS Inter WITH (NOLOCK) ON C.Intermediario_Id = Inter.Id
LEFT OUTER JOIN Proveedor AS Agent WITH (NOLOCK) ON C.AgenteCompras_Id = Agent.Id
LEFT OUTER JOIN Proveedor AS Corr WITH (NOLOCK) ON C.Corredor_Id = Corr.Id
LEFT OUTER JOIN Entregador AS Entr WITH (NOLOCK) ON C.Entregador_Id = Entr.Id
LEFT OUTER JOIN Proveedor AS Destinatario WITH (NOLOCK) ON C.Destinatario_Id = Destinatario.Id
LEFT OUTER JOIN Centro AS Destino WITH (NOLOCK) ON C.CentroDestino_Id = Destino.Id
LEFT OUTER JOIN AnalisisDeCalidad WITH (NOLOCK) ON AnalisisDeCalidad.Calado_Id = R.Calado_Id
LEFT OUTER JOIN CaladoPorCaracteristica AS CalHumedad WITH (NOLOCK) ON CalHumedad.Calado_Id = R.Calado_Id
AND EXISTS
  (SELECT 1 AS Expr1
   FROM CaracteristicaDeCalidad WITH (NOLOCK) 
   WHERE (Id = CalHumedad.CaracteristicaDeCalidad_Id)
     AND (EsHumedad = 1))
LEFT OUTER JOIN AnalisisPorCaracteristica AS AnaHumedad WITH (NOLOCK) ON AnaHumedad.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id
AND EXISTS
  (SELECT 1 AS Expr1
   FROM CaracteristicaDeCalidad WITH (NOLOCK) 
   WHERE (Id = AnaHumedad.CaracteristicaDeCalidad_Id)
     AND (EsHumedad = 1))
LEFT OUTER JOIN CaladoPorCaracteristica AS CalCuerpos WITH (NOLOCK) ON CalCuerpos.Calado_Id = R.Calado_Id
AND EXISTS
  (SELECT 1 AS Expr1
   FROM CaracteristicaDeCalidad as cdc WITH (NOLOCK) 
   WHERE (Id = CalCuerpos.CaracteristicaDeCalidad_Id)
     AND (EsCuerposExtranos = 1))
LEFT OUTER JOIN AnalisisPorCaracteristica AS AnaCuerpos WITH (NOLOCK) ON AnaCuerpos.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id
AND EXISTS
  (SELECT 1 AS Expr1
   FROM CaracteristicaDeCalidad WITH (NOLOCK) 
   WHERE (Id = AnaCuerpos.CaracteristicaDeCalidad_Id)
     AND (EsCuerposExtranos = 1))
	 LEFT OUTER JOIN CaladoPorCaracteristica AS CalGranos ON CalGranos.Calado_Id = R.Calado_Id
AND EXISTS
  (SELECT 1 AS Expr1
   FROM CaracteristicaDeCalidad WITH (NOLOCK) 
   WHERE (Id = CalGranos.CaracteristicaDeCalidad_Id)
     AND (EsGranosVerdes = 1))
LEFT OUTER JOIN AnalisisPorCaracteristica AS AnaGranos ON AnaGranos.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id
AND EXISTS
  (SELECT 1 AS Expr1
   FROM CaracteristicaDeCalidad WITH (NOLOCK) 
   WHERE (Id = AnaGranos.CaracteristicaDeCalidad_Id)
     AND (EsGranosVerdes = 1))
WHERE
(R.Material_Id = @Materialp)
  AND ((C.TitularCartaPorte_Id = @Proveedorp)
       OR (C.Intermediario_Id = @Proveedorp)
       OR (C.RtteComercial_Id = @Proveedorp)
       OR (C.Corredor_Id = @Proveedorp)
       OR (C.AgenteCompras_Id = @Proveedorp)
       OR (C.Destinatario_Id = @Proveedorp))
  AND (R.Centro_Id = @CentroIdp)
  AND (R.Terminado = 1)
  AND (R.Rechazado &lt;&gt; 1)
  AND (@ConCorredorp = 1
       OR (C.Corredor_Id IS NULL))
   AND (W.TipoDeWorkflow = 0)
AND (cast(R.FechaEgreso as date) &gt;= cast(@fechaDesdep as date))
AND (cast(R.FechaEgreso as date) &lt;= cast(@fechaHastap as date))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Nº_CCPP">
          <DataField>Nº CCPP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha_Descarga">
          <DataField>Fecha Descarga</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Razon_Social_Cargador_">
          <DataField>Razon Social(Cargador)</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIT_Cargador_">
          <DataField>CUIT(Cargador)</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cuenta_y_Orden_1">
          <DataField>Cuenta y Orden 1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIT_Cuenta_y_Orden_1">
          <DataField>CUIT Cuenta y Orden 1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cuenta_y_Orden_2">
          <DataField>Cuenta y Orden 2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIT_Cuenta_y_Orden_2">
          <DataField>CUIT Cuenta y Orden 2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Grano">
          <DataField>Grano</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tipo">
          <DataField>Tipo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Contrato">
          <DataField>Contrato</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Procedencia_Partido_o_Dep_">
          <DataField>Procedencia Partido o Dep.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Procedencia_Provincia">
          <DataField>Procedencia Provincia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Corredor">
          <DataField>Corredor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Representante___Entregador">
          <DataField>Representante / Entregador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Razon_Social_del_Destinatario">
          <DataField>Razon Social del Destinatario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Lugar_de_destino_de_los_granos">
          <DataField>Lugar de destino de los granos</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Kilos_Descargados">
          <DataField>Kilos Descargados</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Humedad">
          <DataField>Humedad</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Humedad_Descuento_Kg">
          <DataField>Humedad Descuento Kg</DataField>
