    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Centro.CodigoSap as CentroSap,
              Centro.Descripcion as CentroDescripcion

FROM [Centro] as Centro WITH (NOLOCK) 

WHERE Centro.Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Material">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, Descripcion AS Material
FROM            Material WITH (NOLOCK) 
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            Recorrido AS R WITH (NOLOCK) 
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @Centro))
ORDER BY Material</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Proveedores">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT DISTINCT Proveedor.Id, Proveedor.Descripcion AS Proveedor, Proveedor.CodigoSap AS CodigoSapProveedor
FROM            Proveedor  WITH (NOLOCK) 
	INNER JOIN CartaPorte  WITH (NOLOCK) ON CartaPorte.TitularCartaPorte_Id = Proveedor.Id OR CartaPorte.Intermediario_Id = Proveedor.Id OR CartaPorte.RtteComercial_Id = Proveedor.Id OR 
                         CartaPorte.Corredor_Id = Proveedor.Id OR CartaPorte.AgenteCompras_Id = Proveedor.Id OR CartaPorte.Destinatario_Id = Proveedor.Id
ORDER BY Proveedor</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Proveedor">
          <DataField>Proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CodigoSapProveedor">
          <DataField>CodigoSapProveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Proveedor">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProveedorId">
            <Value>=Parameters!Proveedor.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CodigoSap as ProveedorSap

FROM Proveedor WITH (NOLOCK) 
WHERE Proveedor.Id = @ProveedorId</CommandText>
      </Query>
      <Fields>
        <Field Name="ProveedorSap">
          <DataField>ProveedorSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
