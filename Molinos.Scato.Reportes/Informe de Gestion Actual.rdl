  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8f01a068-126b-463b-ae79-35dd7323f6e8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=join(Parameters!Material.Value,",")</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=join(Parameters!TipoComercial.Value,",")</Value>
          </QueryParameter>
          <QueryParameter Name="@Actividad">
            <Value>=join(Parameters!Etapa.Value,",")</Value>
          </QueryParameter>
          <QueryParameter Name="@Vehiculos">
            <Value>=join(Parameters!TipoVehiculo.Value,",")</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @CentroIdp int
DECLARE @Materialp table(Value nvarchar(max))
DECLARE @TipoComercialp table(Value nvarchar(max))
DECLARE @Actividadp table(Value nvarchar(max))
DECLARE @Vehiculosp table(Value nvarchar(max))

SET @CentroIdp = @CentroId

INSERT INTO @TipoComercialp select Value from [dbo].[FnSplit](@TipoComercial,',')
INSERT INTO @Actividadp select Value from [dbo].[FnSplit](@Actividad,',')
INSERT INTO @Vehiculosp select Value from [dbo].[FnSplit](@Vehiculos,',')

IF EXISTS (SELECT value FROM  [dbo].[FnSplit](@Material,',') WHERE Value = '-1') BEGIN Insert into @Materialp Select Id From [material] Where Esgrano = 1 END
IF EXISTS (SELECT value FROM [dbo].[FnSplit](@Material,',') WHERE  Value = '-2') BEGIN Insert into @Materialp Select Id From [material] Where EsGrano = 0 and EsInsumo = 0 END
IF EXISTS (SELECT value FROM  [dbo].[FnSplit](@Material,',') WHERE Value = '-3') BEGIN Insert into @Materialp Select Id From [material] Where EsInsumo = 1 END
IF EXISTS (SELECT value FROM  [dbo].[FnSplit](@Material,',') WHERE Value not in('-1','-2','-3')) BEGIN Insert into @Materialp select Value from [dbo].[FnSplit](@Material,',')  END


SELECT 
       tipocomercial.descripcion  AS TipoComercial, 
       tipocomercial.Id  AS TipoComercialId, 
       (SELECT TOP 1 actividad 
        FROM   logactividad WITH (NOLOCK)
        WHERE  logactividad.workflowinstanceid = R.instanciaworkflow 
        ORDER  BY id DESC)        AS 'Etapa',  
       material.descripcion       AS Material, 
	   material.CodigoSAP       AS MaterialCodigoSAP, 
       material.Id       AS MaterialId, 
       R.patente,
	   R.TipoVehiculo,
       COALESCE(R.PesoBruto,0) AS 'Kilos Brutos', 
       COALESCE((R.PesoBruto - R.PesoTara),0) AS 'Kilos Neto', 
       COALESCE(( CASE 
                    WHEN analisisporcaracteristica.DescuentoEnKg IS NULL THEN 
                    caladoporcaracteristica.DescuentoEnKg
                    ELSE analisisporcaracteristica.DescuentoEnKg
                  END ), 0)       AS 'Kilos Netos descontados', 
       COALESCE(( CASE 
                    WHEN analisisporcaracteristica.DescuentoEnKg IS NULL THEN 
                    (R.PesoBruto - R.PesoTara) - COALESCE( 
                    caladoporcaracteristica.DescuentoEnKg, 
                                                0) 
                    ELSE (R.PesoBruto - R.PesoTara) - COALESCE( 
                         analisisporcaracteristica.DescuentoEnKg, 0) 
                  END ), 0)       AS 'Kilos Netos con Descuento', 
       R.TipoDocumentoIngreso,
	case when R.Establecimiento_Id is null then 'NO' else 'SI' end as 'Sustentable',
	case when ((CartaPorte.TrigoEspecial = 1 and ca.id is null) or (CartaPorte.TrigoEspecial = 1 and ca.CaracteristicasNoCorrenspodenEspecial = 0)) then 'SI' else 'NO' end as 'Especial',
	case when ((CartaPorte.TrigoEspecial = 1 and ca.id is null) or (CartaPorte.TrigoEspecial = 1 and ca.CaracteristicasNoCorrenspodenEspecial = 0)) or R.Establecimiento_Id is not null then 'SI' else 'NO' end as 'SusEsp',
	variedad.Descripcion as 'Variedad'
FROM dbo.recorrido AS R WITH (NOLOCK)
	INNER JOIN [tipocomercial] WITH (NOLOCK) ON R.tipocomercial_id = [tipocomercial].id           	
    INNER JOIN [material] WITH (NOLOCK) ON R.Material_Id = [material].id
	LEFT JOIN CaracteristicasAnalizadas ca with (nolock) on r.id = ca.Recorrido_Id
	LEFT JOIN Vehiculo WITH (NOLOCK) ON R.Vehiculo_Id = Vehiculo.Id
	LEFT JOIN CartaPorte WITH (NOLOCK) ON Vehiculo.CartaPorte_Id = CartaPorte.Id
	LEFT JOIN caladoporcaracteristica WITH (NOLOCK) ON caladoporcaracteristica.calado_id = R.calado_id 
			AND EXISTS (SELECT 1 FROM   caracteristicadecalidad WITH (NOLOCK) 
						WHERE  caracteristicadecalidad.id = caladoporcaracteristica.caracteristicadecalidad_id 
							AND eshumedad = 1) 
	LEFT JOIN analisisporcaracteristica WITH (NOLOCK) ON analisisporcaracteristica.analisisdecalidad_id = R.AnalisisDeCalidad_Id 
			AND EXISTS (SELECT 1 FROM   caracteristicadecalidad WITH (NOLOCK)
						WHERE  caracteristicadecalidad.id = analisisporcaracteristica.caracteristicadecalidad_id 
							AND eshumedad = 1)  
	LEFT JOIN TipoVariedad variedad WITH (NOLOCK) ON variedad.Id = r.TipoVariedad_Id
WHERE  R.[Terminado] &lt;&gt; 1 AND R.Rechazado &lt;&gt; 1
	AND (R.Centro_Id = @CentroIdp)
	AND (R.Material_Id in (select value from @Materialp))
	AND (R.TipoComercial_Id in (select value from @TipoComercialp))
	AND ((SELECT TOP 1 actividad 
        FROM   logactividad WITH (NOLOCK)
        WHERE  logactividad.workflowinstanceid = R.instanciaworkflow 
        ORDER  BY id DESC) in (select value from @Actividadp))
	AND (R.TipoVehiculo in (select value from @Vehiculosp))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoComercialId">
          <DataField>TipoComercialId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Etapa">
          <DataField>Etapa</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaterialCodigoSAP">
          <DataField>MaterialCodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaterialId">
          <DataField>MaterialId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="patente">
          <DataField>patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoVehiculo">
          <DataField>TipoVehiculo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilos_Brutos">
          <DataField>Kilos Brutos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilos_Neto">
          <DataField>Kilos Neto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos_descontados">
          <DataField>Kilos Netos descontados</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos_con_Descuento">
          <DataField>Kilos Netos con Descuento</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TipoDocumentoIngreso">
          <DataField>TipoDocumentoIngreso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Sustentable">
          <DataField>Sustentable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Especial">
          <DataField>Especial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SusEsp">
          <DataField>SusEsp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Variedad">
          <DataField>Variedad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT Id, Descripcion FROM dbo.Centro WITH (NOLOCK)
ORDER BY Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoComercial">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, Descripcion AS TipoComercial
FROM            TipoComercial WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            WorkflowTipoComercial AS wtc WITH (NOLOCK)
                               WHERE        (TipoComercial_Id = TipoComercial.Id) AND EXISTS
                                                             (SELECT        1 AS Expr1
                                                               FROM            Workflow WITH (NOLOCK)
                                                               WHERE        (Centro_Id = @CentroId) AND (Id = wtc.Workflow_Id)))
ORDER BY TipoComercial</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Actividades">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        0 AS Id, NombreActividad
FROM            Permiso AS p WITH (NOLOCK)
WHERE        (TipoPermiso = 1) AND (ActividadWorkflow IS NOT NULL) AND (NombreActividad IS NOT NULL)
ORDER BY Id, ActividadWorkflow</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NombreActividad">
          <DataField>NombreActividad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Material">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Material, ' ' AS Ord
UNION
SELECT        -1 AS Id, 'Granos' AS Material, ' ' AS Ord
UNION
SELECT        -2 AS Id, 'No Granos' AS Material, ' ' AS Ord
UNION
SELECT        -3 AS Id, 'Insumos' AS Material, ' ' AS Ord
UNION
SELECT        Id, Descripcion AS Material, Descripcion AS Ord
FROM            Material WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            Recorrido WITH (NOLOCK)
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @CentroId))

union 

SELECT       Id, Descripcion AS Material, Descripcion AS Ord
FROM            Material WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CargaDeCupo WITH (NOLOCK)
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @CentroId))
ORDER BY Ord</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ord">
          <DataField>Ord</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Centro.CodigoSap as CentroSapp,
              Centro.Descripcion as CentroDescripcion

FROM [Centro] as Centro WITH (NOLOCK)

WHERE Centro.Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSapp">
          <DataField>CentroSapp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDs">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=join(Parameters!Material.Value,",")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @CentroIdp int
DECLARE @Materialp table(Value nvarchar(max))
SET @CentroIdp = @CentroId
INSERT INTO @Materialp select Value from [dbo].[FnSplit](@Material,',')


SELECT COUNT(*) as PendientesDeIngresar
      ,Material.Descripcion as Descripcion
      
  FROM [CargaDeCupo] INNER JOIN Material ON Material.Id = CargaDeCupo.Material_Id
  WHERE Recorrido_Id IS NULL and Centro_Id = @CentroIdp and fecha &gt; cast(getdate() as date)
  GROUP BY Material.Descripcion, Material.Id
 having (Material.Id in (select value from @Materialp))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PendientesDeIngresar">
          <DataField>PendientesDeIngresar</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoVehiculo">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT Id, Descripcion as TipoVehiculo FROM TipoVehiculo</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoVehiculo">
          <DataField>TipoVehiculo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
