  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaIngresoDesde">
            <Value>=Parameters!FechaIngresoDesde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoHasta">
            <Value>=Parameters!FechaIngresoHasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@TipoMovimiento">
            <Value>=Parameters!TipoMovimiento.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaIngresoDesdep DATETIME,
		@FechaIngresoHastap DATETIME,
		@TipoMovimientop INT,
		@CentroIdp INT

SET @FechaIngresoDesdep = @FechaIngresoDesde
SET @FechaIngresoHastap = @FechaIngresoHasta
SET @TipoMovimientop = @TipoMovimiento
SET @CentroIdp = @CentroId

SELECT
	re.FechaInicio, 
	cp.FechaCP, 
	(FORMAT(cp.Sucursal, '00000') + '-' + cp.CTG) as 'CPE', 
	cp.NroCartaPorte as 'CTG',
	REPLACE(titular.Cuil, '-', '') as 'CUITTitular',
	cp.CodEstab as 'RUCAOrigen',
	'' as 'CUITRteComercialProductor',
	'' as 'CUITRteComercialVentaPrimaria',
	'' as 'CUITRteComercialVentaSecundaria',
	'' as 'CUITRteComercialVentaSecundaria2',
	'' as 'CUITCorredorVentaPrimaria',
	'' as 'CUITCorredorVentaSecundaria',
	REPLACE(destinatario.Cuil, '-', '') as 'CUITDestinatario',
	REPLACE(destino.Cuit, '-', '') as 'CUITDestino',
	est.CodigoDeEstablecimiento as 'RUCADestino',
	ma.CodigoEspecie as 'CodigoProducto',
	REPLACE(stock.Cosecha, '-', '/') as 'Campana',
	re.PesoBruto - re.PesoTara as 'PesoNetoCarga',
	est.CodigoRENSPA as 'RENSPA',
	'' as 'CTGAsignado',
	'' as 'PesoNetoCargaUP',
	re.PesoBrutoOrigen - re.PesoTaraOrigen as 'PesoNetoDescargaUP',
	re.PesoBruto as 'PesoIngresoStock',
	'' as 'UltimoAlmacenamiento',
	(wf.TipoDeWorkflow + 1) as 'TipoMovimiento'
FROM Recorrido re
INNER JOIN Vehiculo ve ON ve.Id = re.Vehiculo_Id
INNER JOIN CartaPorte cp ON cp.Id = ve.CartaPorte_Id
LEFT JOIN Proveedor titular ON titular.Id = cp.TitularCartaPorte_Id
LEFT JOIN Proveedor destinatario ON destinatario.Id = cp.Destinatario_Id
LEFT JOIN Centro destino ON destino.Id = cp.CentroDestino_Id
LEFT JOIN Establecimiento est ON est.Id = re.Establecimiento_Id
LEFT JOIN RegistroStockEPA stock ON stock.Recorrido_Id = re.Id
INNER JOIN Material ma ON ma.Id = re.Material_Id
INNER JOIN Workflow wf ON wf.Id = re.Workflow_Id
WHERE re.Terminado = 1 AND re.Rechazado = 0
AND FechaInicio &gt;= @FechaIngresoDesdep
AND FechaInicio &lt;= @FechaIngresoHastap
AND (@TipoMovimientop = -1 OR wf.TipoDeWorkflow = @TipoMovimientop)
AND (@CentroIdp = -1 OR re.Centro_Id = @CentroIdp)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
