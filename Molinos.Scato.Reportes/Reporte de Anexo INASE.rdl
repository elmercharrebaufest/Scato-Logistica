<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d9ad5781-a30d-4b8c-a760-8a6d2a4a23dc</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaEgresoDesde">
            <Value>=Parameters!FechaEgresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaEgresoHasta">
            <Value>=Parameters!FechaEgresoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoDocumentoIngreso">
            <Value>=Parameters!TipoDocumentoLegal.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaEgresoDesdep DATETIME, 
		@FechaEgresoHastap DATETIME, 
		@Centrop INT,
		@TipoDocumentoIngresop INT

SET		@FechaEgresoDesdep =@FechaEgresoDesde 
SET		@FechaEgresoHastap = @FechaEgresoHasta
SET		@Centrop = @Centro
SET		@TipoDocumentoIngresop=  @TipoDocumentoIngreso


SELECT
	( CASE [TipoDocumentoIngreso]
           WHEN 1 THEN Cp.AcuerdoMarco
         END ) as 'Número de Contrato',
	T.[Descripcion],
	[NumeroDocumentoIngreso],
	( CASE [TipoDocumentoIngreso]
           WHEN 1 THEN Cp.CodigoAnexo
         END ) as Anexo,
	R.FechaInicio as Fecha,
	R.PesoBruto - R.PesoTara as 'Kilos Descargados',
	R.Centro_Id As CentroId
  FROM [Recorrido] as R with (nolock)

  LEFT JOIN dbo.vehiculo V with (nolock)
  ON R.vehiculo_id = V.id 
  LEFT JOIN dbo.cartaporte  as Cp with (nolock)
  ON V.cartaporte_id = Cp.id AND
R.TipoDocumentoIngreso = 1
  INNER JOIN  [TipoDocumentoIngreso] as T with (nolock)
  ON R.[TipoDocumentoIngreso] = T.Id

 Where (R.centro_id = @Centrop or @Centrop IS NULL)
and (@FechaEgresoDesdep is null or cast(@FechaEgresoDesdep as date) &lt;= cast(R.FechaInicio as date)) and 
 (@FechaEgresoHastap is null or cast(@FechaEgresoHastap as date) &gt;= cast(R.FechaInicio as date))
and (@TipoDocumentoIngresop is null or @TipoDocumentoIngresop=R.TipoDocumentoIngreso)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Número_de_Contrato">
          <DataField>Número de Contrato</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Anexo">
          <DataField>Anexo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Kilos_Descargados">
          <DataField>Kilos Descargados</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoDocumentoIngreso">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, ' Todos' AS TipoDocumentoIngreso,'' as ord
UNION
SELECT        Id, Descripcion AS TipoDocumentoIngreso,  Descripcion as ord
FROM            TipoDocumentoIngreso WITH (nolock)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoDocumentoIngreso">
          <DataField>TipoDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Centro,'' as ord
UNION
SELECT        Id, Descripcion AS Centro, Descripcion  as ord
FROM            Centro with (nolock)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CodigoSAP, Descripcion FROM Centro with (nolock) WHERE Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CodigoSAP">
          <DataField>CodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
