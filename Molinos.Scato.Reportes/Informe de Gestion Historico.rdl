  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHora_Desde">
            <Value>=Parameters!FechaHora_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHora_Hasta">
            <Value>=Parameters!FechaHora_Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=Parameters!TipoComercial.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @CentroIdp int, @FechaHora_Desdep datetime, @FechaHora_Hastap datetime

set @CentroIdp = @CentroId
set @FechaHora_Desdep = @FechaHora_Desde
set @FechaHora_Hastap = @FechaHora_Hasta

SELECT 
       tipocomercial.descripcion  AS TipoComercial, 
       tipocomercial.Id  AS TipoComercialId, 
      
       material.descripcion       AS Material, 
       material.Id       AS MaterialId, 
       
       R.patente, 
       COALESCE(R.PesoBruto,0) AS 'Kilos Brutos', 
       COALESCE((R.PesoBruto - R.PesoTara),0) AS 'Kilos Neto', 
       COALESCE(( CASE 
                    WHEN analisisporcaracteristica.DescuentoEnKg IS NULL THEN 
                    caladoporcaracteristica.DescuentoEnKg
                    ELSE analisisporcaracteristica.DescuentoEnKg
                  END ), 0)       AS 'Kilos Netos descontados', 
       COALESCE(( CASE 
                    WHEN analisisporcaracteristica.DescuentoEnKg IS NULL THEN 
                    (R.PesoBruto - R.PesoTara) - COALESCE( 
                    caladoporcaracteristica.DescuentoEnKg, 
                                                0) 
                    ELSE (R.PesoBruto - R.PesoTara) - COALESCE( 
                         analisisporcaracteristica.DescuentoEnKg, 0) 
                  END ), 0)       AS 'Kilos Netos con Descuento', 
       workflow.descripcion       AS 'Circuito' ,
       R.TipoDocumentoIngreso,
       R.FechaEgreso as Fecha
FROM   dbo.recorrido AS R WITH(NOLOCK)
	   INNER JOIN [tipocomercial] WITH(NOLOCK)
               ON R.tipocomercial_id = [tipocomercial].id 
       INNER JOIN [workflow] AS WorkFlow WITH(NOLOCK)
               ON R.workflow_id = workflow.id 
       
       INNER JOIN [material] WITH(NOLOCK)
               ON R.Material_Id = [material].id                      
       LEFT JOIN analisisdecalidad WITH(NOLOCK)
              ON analisisdecalidad.Id = R.AnalisisDeCalidad_Id 
       LEFT JOIN caladoporcaracteristica WITH(NOLOCK)
              ON caladoporcaracteristica.calado_id = R.calado_id 
                 AND EXISTS (SELECT 1 
                             FROM   caracteristicadecalidad WITH(NOLOCK)
                             WHERE  caracteristicadecalidad.id = 
caladoporcaracteristica.caracteristicadecalidad_id 
AND eshumedad = 1) 
LEFT JOIN analisisporcaracteristica WITH(NOLOCK)
ON analisisporcaracteristica.analisisdecalidad_id = analisisdecalidad.id 
AND EXISTS (SELECT 1 
FROM   caracteristicadecalidad WITH(NOLOCK)
WHERE  caracteristicadecalidad.id = 
analisisporcaracteristica.caracteristicadecalidad_id 
AND eshumedad = 1) 
WHERE  R.[Terminado] = 1 and R.Rechazado = 0
	AND (R.Centro_Id = @CentroIdp) 
	AND (R.FechaEgreso &gt;= @FechaHora_Desdep AND R.FechaEgreso&lt;= @FechaHora_Hastap)
	AND (material.Id in (@Material))
	AND (tipocomercial.id in (@TipoComercial))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoComercialId">
          <DataField>TipoComercialId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaterialId">
          <DataField>MaterialId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="patente">
          <DataField>patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Kilos_Brutos">
          <DataField>Kilos Brutos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilos_Neto">
          <DataField>Kilos Neto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos_descontados">
          <DataField>Kilos Netos descontados</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos_con_Descuento">
          <DataField>Kilos Netos con Descuento</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Circuito">
          <DataField>Circuito</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoDocumentoIngreso">
          <DataField>TipoDocumentoIngreso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT Id, Descripcion FROM dbo.Centro
ORDER BY Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoComercial">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, Descripcion AS TipoComercial
FROM            TipoComercial WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            WorkflowTipoComercial AS wtc WITH (NOLOCK)
                               WHERE        (TipoComercial_Id = TipoComercial.Id) AND EXISTS
                                                             (SELECT        1 AS Expr1
                                                               FROM            Workflow WITH (NOLOCK)
                                                               WHERE        (Centro_Id = @CentroId) AND (Id = wtc.Workflow_Id)))
ORDER BY TipoComercial</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Material">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, Descripcion AS Material
FROM            Material WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            Recorrido WITH (NOLOCK)
                               WHERE        (Material_Id = Material.Id) AND (Centro_Id = @CentroId))
ORDER BY Material</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
