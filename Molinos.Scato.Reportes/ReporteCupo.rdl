  <Code>

Public Shared Function getFirstLink() As String
	Dim loadedPage As String = String.Empty
	Dim myWebClient As New System.Net.WebClient

 	myWebClient.UseDefaultCredentials = true
 	myWebClient.Credentials = New System.Net.NetworkCredential("usuario", "password")

	loadedPage = myWebClient.DownloadString("http://bfdev260/scato.webmobile")
	Return loadedPage
                    
End Function


