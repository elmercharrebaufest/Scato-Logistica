<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>4c8e9c2c-5174-48a9-b778-bec197c0e380</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHora_Desde">
            <Value>=Parameters!FechaHora_Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHora_Hasta">
            <Value>=Parameters!FechaHora_Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Proveedor">
            <Value>=Parameters!Proveedor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Entregador">
            <Value>=Parameters!Entregador.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AgenteDeCompras">
            <Value>=Parameters!Agente_de_Compras.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Intermediario">
            <Value>=Parameters!Intermediario.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RemitenteComercial">
            <Value>=Parameters!RemitenteComercial.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Procedencia">
            <Value>=Parameters!Procedencia.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaHora_Desdep DATETIME,
		@FechaHora_Hastap DATETIME,
		@CentroIdp INT,
		@Proveedorp INT,
		@Entregadorp INT,
		@AgenteDeComprasp INT,
		@Intermediariop INT,
		@RemitenteComercialp INT,
		@Procedenciap INT,
		@Materialp INT

SET		@FechaHora_Desdep = @FechaHora_Desde
SET		@FechaHora_Hastap = @FechaHora_Hasta
SET		@CentroIdp = @CentroId
SET		@Proveedorp = @Proveedor
SET		@Entregadorp = @Entregador
SET		@AgenteDeComprasp = @AgenteDeCompras
SET		@Intermediariop = @Intermediario
SET		@RemitenteComercialp = @RemitenteComercial
SET		@Procedenciap = @Procedencia
SET		@Materialp = @Material

SELECT Centro_Id as  'CentroId'
,Id
       ,InstanciaWorkflow
      ,[NumeroDocumentoIngreso] as 'N° de Documento'
	  ,[Patente] as 'Patente'
      ,Material as 'Material'
      ,TitularDeCP as 'Titular de CP'
	  ,CUILTitularDeCP  as 'CUIL Titular de CP'
      ,Intermediario as 'Intermediario'
	  ,CUILIntermediario as 'CUIL Intermediario'
      ,RemitenteComercial as 'Remitente Comercial'
	  ,CUILRemitenteComercial as 'CUIL Remitente Comercial'
	  
	  ,RemitenteComercialProductor as 'Remitente Comercial Productor'
	  ,CUILRemitenteComercialProductor as 'CUIL Remitente Comercial Productor'
	  ,RemitenteComercialVentaSecundario as 'Remitente Comercial Venta Secundario'
	  ,CUILRemitenteComercialVentaSecundario as 'CUIL Remitente Comercial Venta Secundario'
	  ,RemitenteComercialVentaSecundario2 as 'Remitente Comercial Venta Secundario2'
	  ,CUILRemitenteComercialVentaSecundario2 as 'CUIL Remitente Comercial Venta Secundario2'
	  
      ,Destinatario as 'Destinatario'
	  ,CUILDestinatario as 'CUIL Destinatario'
      ,Corredor as 'Corredor'
	  ,CUILCorredor as 'CUIL Corredor'
      ,AgenteDeCompra as 'Agente de Compra'
	  ,CUILAgenteDeCompra as 'CUIL Agente de Compra'
      ,Entregador as 'Entregador'
	  ,CUILEntregador as 'CUIL Entregador'
      ,Procedencia as 'Procedencia'
      ,Provincia as 'Provincia'
      ,ProcedenciaNum as 'ProcendenciaNum'
      ,KilosNetosEnOrigen as 'Kilos Netos en Origen'
	  ,Estado as 'Estado'
	  ,FechaHoraingreso as 'Fecha/hora Ingreso'
	  ,Kilogramosneto as 'Kilogramos neto'
	  ,TipoDocumentoIngreso
	  ,CodEstab
	  ,Camara
	  ,[HUMEDAD] as 'Humedad'
	  ,[CHAMICO] as 'Chamico'
	  ,[CUERPOS EXTRAÑOS] as 'Cuerpos extranios'
	  ,[GRANOS VERDES] as 'Granos Verdes'
	  ,[DAÑADOS] as 'Daniados'
	  ,[GRANOS AVERIADOS o QUEMADOS] as 'Granos Averiados o Quemados'
	  ,[GRANOS COLOREADOS] as 'Granos Coloreados'
	  ,[GRANOS NEGROS] as 'Granos Negros'
	  ,[REVOLCADO] as 'Revolcado'
	  ,[OLOR] as 'Olor'
	  ,[TIERRA] as 'Tierra'
	  ,[INSECTOS VIVOS] as 'Insectos Vivos'
	  ,[INSECTOS Y ARACNIDOS] as 'Insectos y Aracnidos'
	  ,[MERMA CHAMICO] as 'Merma Chamico'
	  ,[MOHO] as 'Moho'
	  ,[QUEBRADOS]  as 'Quebrados'
	  ,[PROTEINAS]  as 'Proteinas'
	  ,[PESO HECTOLITRICO]  as 'PH'
	  ,[GRADO]  as 'Grado'
	  ,[GRANOS DAÑADOS]  as 'Granos Danados'
	  ,[GRANOS QUEBRADOS]  as 'Granos Quebrados'
	  ,[MATERIAS EXTRAÑAS]  as 'Materias Extranas'
	  ,[GRANOS ARDIDOS]  as 'Granos Ardidos'
	  ,[TOTAL DAÑADOS]  as 'Total daniados'
	  ,[GRANOS CON CARBON]  as 'Granos con Carbon'
	  ,[GRANOS PANZA BLANCA]  as 'Granos panza blanca'
	  ,Cosecha as 'Cosecha'
	  ,CEE as 'CEE'
	  ,CTG as 'CTG'
	  ,FechaCarga as 'Fecha Carga'
	  ,FechaVencimiento as 'Fecha Vencimiento'
	  ,CorredorVendedor as 'Corredor Vendedor'
	  ,CuitCorredorVendedor as 'Cuit Corredor Vendedor'
	  ,CorredorVendedorSecundario as 'Corredor Vendedor Secundario'
	  ,CuitCorredorVendedorSecundario as 'CUIT Corredor Vendedor Secundario'
	  ,Transportista as 'Transportista'
	  ,CuitTransportista as 'Cuit Transportista'
	  ,Chofer as 'Chofer'
	  ,CuitChofer as 'Cuit Chofer'
	  ,CodigoMercaderia as 'Codigo Mercaderia'
	  ,NombreMercaderia as 'Nombre Mercaderia'
	  ,BrutoPrecedencia as 'Bruto Precedencia'
	  ,TaraProcedencia as 'Tara Precedencia'
	  ,PesoNetoProcedencia as 'Neto Precedencia'
	  ,Cupo as 'Cupo'
	  ,CodigoEstablecimiento as 'Codigo Establecimiento'
	  ,KmARecorrer as 'Km a Recorrer'
	  ,Tarifa as 'Tarifa'
	  ,TarifaReferencia as 'Tarifa referencia'
	  ,PesoBrutoDestino as 'Bruto Destino'
	  ,PesoTaraDestino as 'Tara Destino'
	  ,PesoNetoDestino as 'Neto Destino'
	  ,FechaSalida as 'FechaSalida'
                    ,Observacion as 'Observciones'
FROM (

SELECT r.Centro_Id
      ,r.Id
      ,r.InstanciaWorkflow
      ,r.[NumeroDocumentoIngreso] 
	  ,r.[Patente] 
      ,m.Descripcion as Material
      ,tc.Descripcion as TitularDeCP
	  ,TC.Cuil as CUILTitularDeCP
      ,i.Descripcion as Intermediario
	  ,i.Cuil as CUILIntermediario
      ,rc.Descripcion as RemitenteComercial
	  ,rc.Cuil as CUILRemitenteComercial
	  ,rcp.Cuil as CUILRemitenteComercialProductor
	  ,rcp.Descripcion as RemitenteComercialProductor
	  ,rcvs.Cuil as CUILRemitenteComercialVentaSecundario
	  ,rcvs.Descripcion as RemitenteComercialVentaSecundario
	  ,rcvs2.Cuil as CUILRemitenteComercialVentaSecundario2
	  ,rcvs2.Descripcion as RemitenteComercialVentaSecundario2
      ,de.Descripcion as Destinatario
	  ,de.Cuil as CUILDestinatario
      ,co.Descripcion as Corredor
	  ,co.Cuil as CUILCorredor
      ,ac.Descripcion as AgenteDeCompra
	  ,ac.Cuil as CUILAgenteDeCompra
      ,en.RazonSocial as Entregador
	  ,en.Cuil as CUILEntregador
      ,loc.Descripcion as Procedencia
      ,prov.Descripcion as Provincia
      ,loc.CodigoAfip as ProcedenciaNum
      ,v.PesoNetoOrigen as KilosNetosEnOrigen
	  ,(CASE
			WHEN AnaPorCar.ValorAnalisis IS NULL 
			THEN CalPorCar.ValorCalado
			ELSE AnaPorCar.ValorAnalisis
			END) as ValorDeCalidad
	   
		,
		CDCM.Descripcion as Calidad
			
	  ,CASE WHEN R.Terminado = 1
		  THEN CASE WHEN R.Rechazado = 1 THEN 'Rechazado' ELSE 'Terminado' END
		  ELSE (SELECT TOP 1 Actividad FROM LogActividad WITH (NOLOCK) where LogActividad.WorkflowInstanceId = R.InstanciaWorkflow order by id desc)
	      END as Estado
      ,r.FechaInicio as FechaHoraingreso     
      ,ISNULL(r.PesoBruto - r.PesoTara,0) as Kilogramosneto
     ,r.TipoDocumentoIngreso
     ,cp.CodEstab
	 ,CASE WHEN meac.id is not null and R.Rechazado = 0
		  THEN 'SI'
		  ELSE 'NO'
	      END as Camara
	,cp.Cosecha as Cosecha

	,cp.CEE as CEE
	,cp.CTG as CTG
	,cp.FechaCP as FechaCarga
	,cp.FechaVto as FechaVencimiento
	,cov.Descripcion as CorredorVendedor
	,cov.Cuil as CuitCorredorVendedor
	,covsec.Descripcion as CorredorVendedorSecundario
	,covsec.Cuil as CuitCorredorVendedorSecundario
	,trs.RazonSocial as Transportista
	,trs.Cuit as CuitTransportista
	,ch.Nombre +' '+ ch.Apellido as Chofer
	,ch.Cuil as CuitChofer
	,m.CodigoONCCA as CodigoMercaderia
	,m.Descripcion as NombreMercaderia
	,r.PesoBrutoOrigen as BrutoPrecedencia
	,r.PesoTaraOrigen as TaraProcedencia
	,r.PesoBrutoOrigen - r.PesoTaraOrigen as PesoNetoProcedencia
	,cp.Cupo as Cupo
	,es.CodigoDeEstablecimiento as CodigoEstablecimiento
	,cp.KmRecorrer as KmARecorrer
	,cp.TarifaTonelada as Tarifa
	,cp.TarifaReferencia as TarifaReferencia
	,r.PesoBruto as PesoBrutoDestino
	,r.PesoTara as PesoTaraDestino
	,r.PesoBruto - r.PesoTara as PesoNetoDestino
	,r.FechaEgreso as FechaSalida
    ,cp.Observacion
	
  FROM [Recorrido] r WITH(NOLOCK) 
	inner join Centro cent WITH(NOLOCK) on cent .Id = r.Centro_Id
	inner join Material m WITH(NOLOCK) on m.Id = r.Material_Id
	left join Vehiculo v WITH(NOLOCK) on v.Id = r.Vehiculo_Id
	left join CartaPorte cp WITH(NOLOCK) on v.CartaPorte_Id =cp.Id	
	left join Proveedor tc WITH(NOLOCK) on tc.Id = cp.TitularCartaPorte_Id
  	left join Proveedor i WITH(NOLOCK) on i.Id = cp.Intermediario_Id
  	left join Proveedor rc WITH(NOLOCK) on rc.Id = cp.RtteComercial_Id
  	left join Proveedor rcp WITH(NOLOCK) on rcp.Id = cp.RtteComercialProductor_Id
  	left join Proveedor rcvp WITH(NOLOCK) on rcvp.Id = cp.RtteComercial_Id
  	left join Proveedor rcvs WITH(NOLOCK) on rcvs.Id = cp.RtteComercialVentaSecundaria_Id
  	left join Proveedor rcvs2 WITH(NOLOCK) on rcvs2.Id = cp.RtteComercialVentaSecundaria2_Id
  	left join Proveedor de WITH(NOLOCK) on de.Id = cp.Destinatario_Id
  	left join Proveedor co WITH(NOLOCK) on co.Id = cp.Corredor_Id
  	left join Proveedor covsec WITH(NOLOCK) on covsec.Id = cp.CorredorVendedorSecundario_Id
  	left join Proveedor ac WITH(NOLOCK) on ac.Id = cp.AgenteCompras_Id
  	left join Entregador en WITH(NOLOCK) on en.Id = cp.Entregador_Id
  	left join Localidad loc WITH(NOLOCK) on loc.Id = cp.Procedencia_Id
	left join Provincia prov WITH(NOLOCK) on prov.Id = loc.Provincia_Id
	left join MuestraEnvioACamara meac WITH(NOLOCK) on  r.Calado_Id = meac.Calado_Id
	
	left join Proveedor cov WITH(NOLOCK) ON cov.Id = cp.CorredorVendedor_Id
	left join Transportista trs WITH(NOLOCK) ON trs.Id = cp.Transportista_Id 
	left join Chofer ch WITH(NOLOCK) ON ch.Id = cp.Chofer_Id
	left join Establecimiento es WITH(NOLOCK) ON es.Id = r.Establecimiento_Id
	
	INNER JOIN MaterialPorCentro Mpc WITH(NOLOCK) on Mpc.Material_Id = r.material_Id and Mpc.centro_id = r.centro_id 
	LEFT JOIN CaracteristicaDeCalidad CarDeCal WITH(NOLOCK) on CarDeCal.MaterialPorCentro_id = Mpc.id and (r.calado_id is not null or r.AnalisisdeCalidad_id is not null)
	FULL OUTER JOIN CaladoPorCaracteristica CalPorCar WITH(NOLOCK) on CalPorCar.Calado_Id = R.Calado_Id and CalPorCar.CaracteristicaDeCalidad_Id = CarDeCal.id
	FULL OUTER JOIN AnalisisPorCaracteristica AnaPorCar WITH(NOLOCK) on AnaPorCar.AnalisisDeCalidad_Id = R.AnalisisDeCalidad_Id and AnaPorCar.CaracteristicaDeCalidad_Id = CarDeCal.id
	LEFT JOIN CaracteristicaDeCalidadMaestro CDCM WITH(NOLOCK) on CDCM.Id = CarDeCal.CaracteristicaDeCalidadMaestro_Id
	
WHERE(@FechaHora_Desdep &lt;= r.FechaInicio AND r.FechaInicio &lt;= @FechaHora_Hastap)AND(r.Centro_Id = @CentroIdp) AND 
	(tc.Id = @Proveedorp or de.Id = @Proveedorp or rc.Id = @Proveedorp  or i.Id = @Proveedorp  or @Proveedorp IS NULL) AND
	(en.Id = @Entregadorp or @Entregadorp IS NULL) AND
	(ac.Id = @AgenteDeComprasp or @AgenteDeComprasp IS NULL) AND
    (i.Id = @Intermediariop or @Intermediariop IS NULL) AND
    (rc.Id = @RemitenteComercialp or @RemitenteComercialp IS NULL) AND
	(loc.Id = @Procedenciap or @Procedenciap IS NULL) AND
	(m.Id = @Materialp or @Materialp = 0)

)PVT 

	PIVOT (MAX([ValorDeCalidad]) 
	FOR PVT.Calidad IN ([HUMEDAD], 
						[CHAMICO],
						[CUERPOS EXTRAÑOS], 
						[GRANOS VERDES], 
						[DAÑADOS], 
						[GRANOS AVERIADOS o QUEMADOS], 
						[GRANOS COLOREADOS],
						[GRANOS NEGROS], 
						[REVOLCADO],
						[OLOR],
						[TIERRA],
						[INSECTOS VIVOS],
						[INSECTOS Y ARACNIDOS],
						[MERMA CHAMICO],
						[MOHO],
						[QUEBRADOS],
						[PROTEINAS],
						[PESO HECTOLITRICO],
						[GRADO],
						[GRANOS DAÑADOS],
						[GRANOS QUEBRADOS],
						[MATERIAS EXTRAÑAS],
						[GRANOS ARDIDOS],
						[TOTAL DAÑADOS],
						[GRANOS CON CARBON],
						[GRANOS PANZA BLANCA]

)) AS ColumnasPivotadas</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InstanciaWorkflow">
          <DataField>InstanciaWorkflow</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="N__de_Documento">
          <DataField>N° de Documento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Titular_de_CP">
          <DataField>Titular de CP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Titular_de_CP">
          <DataField>CUIL Titular de CP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Intermediario">
          <DataField>Intermediario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Intermediario">
          <DataField>CUIL Intermediario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remitente_Comercial">
          <DataField>Remitente Comercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Remitente_Comercial">
          <DataField>CUIL Remitente Comercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remitente_Comercial_Productor">
          <DataField>Remitente Comercial Productor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Destinatario">
          <DataField>Destinatario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Remitente_Comercial_Productor">
          <DataField>CUIL Remitente Comercial Productor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Destinatario">
          <DataField>CUIL Destinatario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remitente_Comercial_Venta_Secundario">
          <DataField>Remitente Comercial Venta Secundario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Corredor">
          <DataField>Corredor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Corredor">
          <DataField>CUIL Corredor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Remitente_Comercial_Venta_Secundario">
          <DataField>CUIL Remitente Comercial Venta Secundario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remitente_Comercial_Venta_Secundario2">
          <DataField>Remitente Comercial Venta Secundario2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Agente_de_Compra">
          <DataField>Agente de Compra</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Remitente_Comercial_Venta_Secundario2">
          <DataField>CUIL Remitente Comercial Venta Secundario2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Agente_de_Compra">
          <DataField>CUIL Agente de Compra</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Entregador">
          <DataField>Entregador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUIL_Entregador">
          <DataField>CUIL Entregador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Procedencia">
          <DataField>Procedencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Provincia">
          <DataField>Provincia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProcendenciaNum">
          <DataField>ProcendenciaNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos_en_Origen">
          <DataField>Kilos Netos en Origen</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Estado">
          <DataField>Estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha_hora_Ingreso">
          <DataField>Fecha/hora Ingreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Kilogramos_neto">
          <DataField>Kilogramos neto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoDocumentoIngreso">
          <DataField>TipoDocumentoIngreso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CodEstab">
          <DataField>CodEstab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Camara">
          <DataField>Camara</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Humedad">
          <DataField>Humedad</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Chamico">
          <DataField>Chamico</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Cuerpos_extranios">
          <DataField>Cuerpos extranios</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Granos_Verdes">
          <DataField>Granos Verdes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Daniados">
          <DataField>Daniados</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Granos_Averiados_o_Quemados">
          <DataField>Granos Averiados o Quemados</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Granos_Coloreados">
          <DataField>Granos Coloreados</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Granos_Negros">
          <DataField>Granos Negros</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Revolcado">
          <DataField>Revolcado</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Olor">
          <DataField>Olor</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Tierra">
          <DataField>Tierra</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Insectos_Vivos">
          <DataField>Insectos Vivos</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
