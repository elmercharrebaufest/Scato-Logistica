    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Descripcion AS Centro, Id
FROM            Centro WITH (NOLOCK)
ORDER BY Centro</CommandText>
      </Query>
      <Fields>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Proveedor">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Proveedor, '0' AS ord
UNION
SELECT        Id, Descripcion AS Proveedor, Descripcion AS ord
FROM            Proveedor WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CartaPorte WITH (NOLOCK)
                               WHERE        (TitularCartaPorte_Id = Proveedor.Id))
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Proveedor">
          <DataField>Proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Entregadores">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Entregador, '0' AS ord
UNION
SELECT        Entregador.Id, Entregador.DescripcionCorta AS Entregador, Entregador.DescripcionCorta AS ord
FROM            Entregador WITH (NOLOCK) INNER JOIN
                         CartaPorte WITH (NOLOCK) ON CartaPorte.Entregador_Id = Entregador.Id
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Entregador">
          <DataField>Entregador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AgentesDecompras">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Proveedor, '0' AS ord
UNION
SELECT        Id, Descripcion AS Proveedor, Descripcion AS ord
FROM            Proveedor WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CartaPorte WITH (NOLOCK)
                               WHERE        (AgenteCompras_Id = Proveedor.Id))
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Proveedor">
          <DataField>Proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Intermediarios">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Intermediario, '' AS ord
UNION
SELECT DISTINCT Id, Descripcion AS Intermediario, Descripcion AS ord
FROM            Proveedor AS p WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CartaPorte WITH (NOLOCK)
                               WHERE        (Intermediario_Id = p.Id))
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Intermediario">
          <DataField>Intermediario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RemitentesComerciales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS RemitenteComercial, '0' AS ord
UNION
SELECT        Id, Descripcion AS RemitenteComercial, Descripcion AS ord
FROM            Proveedor AS p WITH (NOLOCK)
WHERE        EXISTS
                             (SELECT        1 AS Expr1
                               FROM            CartaPorte WITH (NOLOCK)
                               WHERE        (RtteComercial_Id = p.Id))
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RemitenteComercial">
          <DataField>RemitenteComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Procedencias">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS Procedencia, '0' AS ord
UNION
SELECT        Id, CodigoAfip + ' - ' + Descripcion AS Procedencia, Descripcion AS ord
FROM            Localidad AS loc WITH (NOLOCK)
WHERE        (Id IN
                             (SELECT        Procedencia_Id
                               FROM            CartaPorte WITH (NOLOCK)))
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Procedencia">
          <DataField>Procedencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        'Todos' AS Descripcion, 0 AS Id, '.' AS ord
UNION ALL
SELECT        m.Descripcion, m.Id, m.Descripcion AS ord
FROM            Material AS m WITH (NOLOCK)
Where Exists(Select 1 from Recorrido WITH (NOLOCK) where Recorrido.Material_Id = m.Id AND (Recorrido.Centro_Id = @Centro))
ORDER BY ord
</CommandText>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
