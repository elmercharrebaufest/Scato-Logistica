  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>44ffd377-21b7-4c53-a6c0-d447bfaa36b4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @FechaDesdep datetime, @FechaHastap datetime, @Patentep nvarchar(MAX)

set @FechaDesdep = @FechaDesde
set @FechaHastap = @FechaHasta
set @Patentep = @Patente

select Patente, FechaDesde, FechaHasta, NombreUsuarioResponsable, Descripcion, Motivo
from [InhabilitacionCamion]
inner join [Centro] 
On [InhabilitacionCamion].Centro_Id = [Centro].Id

where CAST(FechaDesde AS date) &gt;= CAST(@FechaDesdep AS DATE) AND
 CAST(FechaDesde AS date) &lt;= CAST(@FechaHastap AS DATE) AND
 (@Patentep = '' or @Patentep = Patente)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaDesde">
          <DataField>FechaDesde</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FechaHasta">
          <DataField>FechaHasta</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NombreUsuarioResponsable">
          <DataField>NombreUsuarioResponsable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
