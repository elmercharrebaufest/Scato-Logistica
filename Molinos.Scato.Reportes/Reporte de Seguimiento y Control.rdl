<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a5f65fad-683a-4d23-9a4a-a501594f9364</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@centroid">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@numeroDocumentoIngreso">
            <Value>=Parameters!NumeroDocumentoIngreso.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoDesde">
            <Value>=Parameters!FechaIngresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaIngresoHasta">
            <Value>=Parameters!FechaIngresoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaSalidaDesde">
            <Value>=Parameters!FechaSalidaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaSalidaHasta">
            <Value>=Parameters!FechaSalidaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Actividad">
            <Value>=Parameters!Actividad.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MostrarCamionesEnPlanta">
            <Value>=Parameters!MostrarCamionesEnPlanta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@VerificacionRangoFecha">
            <Value>=Parameters!VerificacionRangoFecha.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaIngresoDesdep DATETIME, 
		@FechaIngresoHastap DATETIME,
		@FechaSalidaDesdep DATETIME, 
		@FechaSalidaHastap DATETIME,  
		@centroidp INT,
		@patentep NVARCHAR(MAX),
		@numeroDocumentoIngresop NVARCHAR(MAX),
		@Actividadp NVARCHAR(MAX),
		@MostrarCamionesEnPlantap NVARCHAR(MAX),
		@VerificacionRangoFechap INT

SET		@FechaIngresoDesdep = @FechaIngresoDesde
SET		@FechaIngresoHastap = @FechaIngresoHasta
SET		@FechaSalidaDesdep = @FechaSalidaDesde
SET		@FechaSalidaHastap = @FechaSalidaHasta
SET		@centroidp = @centroid
SET		@patentep = @patente
SET		@numeroDocumentoIngresop = @numeroDocumentoIngreso
SET		@Actividadp = @Actividad
SET		@MostrarCamionesEnPlantap = @MostrarCamionesEnPlanta
SET		@VerificacionRangoFechap = @VerificacionRangoFecha

SELECT tdi.Descripcion AS TipoDocumentoIngreso , 
       r.NumeroDocumentoIngreso, 
       r.Patente, 
       r.Id,
      (CASE WHEN r.FechaEgreso IS NULL THEN GETDATE() ELSE r.FechaEgreso END) AS FechaEgreso,
       t.RazonSocial AS Transportista, 
       log1.Actividad, 
       (CASE WHEN log1.Fecha &lt;= log2.Fecha THEN CONVERT(VARCHAR, (log2.Fecha - log1.Fecha), 14) ELSE '00:00:00' END) AS Tiempo, 
       r.FechaInicio AS FechaInicio,
       log1.Fecha,
       r.Centro_Id AS CentroId,
       (CASE WHEN r.Terminado = 1 THEN 'SI' ELSE 'NO' END) AS Terminado,
       (CASE WHEN r.Rechazado = 1 THEN 'SI' ELSE 'NO' END) AS Rechazado
FROM   Recorrido r WITH (NOLOCK)
       LEFT JOIN Transportista t WITH (NOLOCK) ON r.Transportista_id = t.Id 
       LEFT JOIN LogActividadUnion log1 WITH (NOLOCK) ON log1.WorkflowInstanceId = r.InstanciaWorkflow
       LEFT JOIN LogActividadUnion log2 WITH (NOLOCK) ON log2.WorkflowInstanceId = r.InstanciaWorkflow
       INNER JOIN TipoDocumentoIngreso tdi WITH (NOLOCK) ON r.TipoDocumentoIngreso = tdi.Id
WHERE
log2.Id &gt; log1.Id 
AND NOT EXISTS (SELECT TOP 1 1 
                FROM   LogActividadUnion log3 WITH (NOLOCK)
                WHERE  log3.WorkflowInstanceId = r.InstanciaWorkflow 
                        AND log3.Id &gt; log1.Id 
                        AND log3.Id &lt; log2.Id)
AND (r.Centro_Id = @centroidp)
AND (r.Patente = @patentep or @patentep = '')
AND (r.NumeroDocumentoIngreso = @numeroDocumentoIngresop or @numeroDocumentoIngresop = '')

AND
(r.FechaInicio &gt;= @FechaIngresoDesdep or @FechaIngresoDesdep IS NULL)AND(r.FechaInicio &lt;= @FechaIngresoHastap or @FechaIngresoHastap IS NULL)
AND 
(((r.FechaEgreso &gt;=  @FechaSalidaDesdep or @FechaSalidaDesdep IS NULL) AND (r.FechaEgreso &lt;= @FechaSalidaHastap or @FechaSalidaHastap IS NULL)  )  or (r.FechaEgreso is null and r.Terminado = CASE (@MostrarCamionesEnPlanta) WHEN 'SI' THEN 0 END))


AND (log1.actividad = @Actividadp OR @Actividadp = 'Todas')
AND (r.Terminado = 1  or (r.Terminado = CASE (@MostrarCamionesEnPlantap) WHEN 'SI' THEN 0 END))
AND EXISTS (SELECT TOP 1 1 FROM Permiso p WITH (NOLOCK) 
			WHERE p.ActividadWorkflow = log1.ActividadXaml AND p.TipoPermiso = 1)
AND 1 = @VerificacionRangoFechap</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TipoDocumentoIngreso">
          <DataField>TipoDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FechaEgreso">
          <DataField>FechaEgreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Transportista">
          <DataField>Transportista</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Actividad">
          <DataField>Actividad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tiempo">
          <DataField>Tiempo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaInicio">
          <DataField>FechaInicio</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Terminado">
          <DataField>Terminado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Rechazado">
          <DataField>Rechazado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Actividades">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todas' AS Actividad
UNION
SELECT        0 AS Id, NombreActividad AS Actividad
FROM            Permiso AS p WITH (NOLOCK)
WHERE        (TipoPermiso = 1) AND (ActividadWorkflow IS NOT NULL) AND (NombreActividad IS NOT NULL)
ORDER BY Id,Actividad</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Actividad">
          <DataField>Actividad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CamionesEnPlanta">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select 'NO' as Valor
UNION
Select 'SI' as Valor</CommandText>
      </Query>
      <Fields>
        <Field Name="Valor">
          <DataField>Valor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP, Descripcion
FROM            Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CodigoSAP">
          <DataField>CodigoSAP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
