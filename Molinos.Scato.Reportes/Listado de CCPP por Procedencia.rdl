<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>44ffd377-21b7-4c53-a6c0-d447bfaa36b4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProcedenciaId">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare 
@FechaDesdep datetime, 
@FechaHastap datetime, 
@ProvecendiaIdp INT

set @ProvecendiaIdp = @ProcedenciaId
set @FechaDesdep = @FechaDesde
set @FechaHastap = @FechaHasta


SELECT 
CASE WHEN Recorrido.PesoBrutoFecha &gt; Recorrido.PesoTaraFecha THEN Recorrido.PesoTaraFecha ELSE Recorrido.PesoBrutoFecha  END as FechaDescarga 
,[NroCartaPorte]
,Titular.Cuil as Titular
,Destinatario.Cuil as Destinatario
,Transportista.Cuit as Transportista
,Provincia.Descripcion as Procedencia
,Centro.Descripcion as Destino
,Material.Descripcion as Material
,Recorrido.PesoBruto - Recorrido.PesoTara as 'Peso Destino'
,KmRecorrer as 'Km a Recorrer'
,TarifaReferencia as 'Tarifa Referencia'
,TarifaTonelada as 'Tarifa Tonelada'
,CTG
,CPE
,CartaPorte.Sucursal
FROM CartaPorte
inner join Localidad ON CartaPorte.Procedencia_Id = Localidad.Id
inner join Proveedor AS Titular ON CartaPorte.TitularCartaPorte_Id = Titular.Id
inner join Proveedor AS Destinatario ON CartaPorte.Destinatario_Id = Destinatario.Id
inner join Transportista ON CartaPorte.Transportista_Id = Transportista.Id
inner join Centro ON CartaPorte.CentroDestino_Id = Centro.Id
inner join Material ON CartaPorte.Material_Id = Material.Id
inner join Recorrido ON CartaPorte.NroCartaPorte = Recorrido.NumeroDocumentoIngreso
inner join Provincia ON Localidad.Provincia_Id = Provincia.Id

where (Localidad.Provincia_Id = @ProvecendiaIdp OR @ProvecendiaIdp = 0)
AND ((CAST(PesoBrutoFecha AS date) &gt;= CAST(@FechaDesdep AS DATE) AND CAST(PesoBrutoFecha AS date) &lt;= CAST(@FechaHastap AS DATE))
OR ((CAST(PesoTaraFecha AS date) &gt;= CAST(@FechaDesdep AS DATE) AND CAST(PesoTaraFecha AS date) &lt;= CAST(@FechaHastap AS DATE))))

order by FechaDescarga</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FechaDescarga">
          <DataField>FechaDescarga</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NroCartaPorte">
          <DataField>NroCartaPorte</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CTG">
          <DataField>CTG</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Titular">
          <DataField>Titular</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Destinatario">
          <DataField>Destinatario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Transportista">
          <DataField>Transportista</DataField>
