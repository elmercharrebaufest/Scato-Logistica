          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Destino">
          <DataField>Destino</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Peso_Destino">
          <DataField>Peso Destino</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Km_a_Recorrer">
          <DataField>Km a Recorrer</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Tarifa_Referencia">
          <DataField>Tarifa Referencia</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Tarifa_Tonelada">
          <DataField>Tarifa Tonelada</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CPE">
          <DataField>CPE</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="Sucursal">
          <DataField>Sucursal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Procedencias">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT  0 AS Id,'Todos' AS Procedencia, '0' AS ord
UNION
SELECT Id, Descripcion as Procedencia, Descripcion as Ord
  FROM Provincia WITH (nolock)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Procedencia">
          <DataField>Procedencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
