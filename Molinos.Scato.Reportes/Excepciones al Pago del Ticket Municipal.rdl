                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value>=FormatDateTime(Today(), DateFormat.ShortDate)</Value>
                      <Style>
                        <FontSize>8pt</FontSize>
                        <FontWeight>Bold</FontWeight>
