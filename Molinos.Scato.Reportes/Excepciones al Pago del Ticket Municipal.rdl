  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoraExcepcionDesde">
            <Value>=Parameters!FechaHoraExcepcionDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraExcepcionHasta">
            <Value>=Parameters!FechaHoraExcepcionHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraIngresoDesde">
            <Value>=Parameters!FechaHoraIngresoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHoraIngresoHasta">
            <Value>=Parameters!FechaHoraIngresoHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT LETM.Motivo, LETM.FechaIngreso, LETM.FechaExcepcion,LETM.NumeroDocumentoIngreso,LETM.Patente,M.Descripcion,C.Nombre + ' ' +C.Apellido AS Chofer, LETM.NombreUsuario, LETM.PagaTicketMunicipal
FROM LogExceptuadosTicketMunicipal LETM
INNER JOIN Material M ON LETM.Material_Id = M.Id
INNER JOIN Chofer C ON C.Id = LETM.Chofer_Id
WHERE  @FechaHoraExcepcionDesde &lt;= LETM.FechaExcepcion AND LETM.FechaExcepcion &lt;= DATEADD(day,1,@FechaHoraExcepcionHasta)
AND ((@FechaHoraIngresoDesde &lt;= LETM.FechaIngreso or @FechaHoraIngresoDesde IS NULL) AND (LETM.FechaIngreso &lt;= DATEADD(day,1,@FechaHoraIngresoHasta) OR @FechaHoraIngresoHasta IS NULL))

          UNION ALL

          SELECT rtm.MotivoExceptuado AS Motivo,
          R.FechaInicio AS FechaIngreso,
          ETM.FechaCreacionExcepcion AS FechaExcepcion,
          R.NumeroDocumentoIngreso,
          ETM.Patente,
          M.Descripcion,
          C.Nombre + ' ' + C.Apellido AS Chofer,
          ETM.NombreUsuario,
          0 AS PagaTicketMunicipal
          FROM ExceptuadosTicketMunicipal ETM
          INNER JOIN Recorrido R ON ETM.WorkflowInstanceId = R.InstanciaWorkflow
          INNER JOIN Chofer C ON C.Id = R.Chofer_Id
          INNER JOIN Material M ON M.Id = R.Material_Id
          LEFT JOIN RecorridoTasaMunicipal rtm ON rtm.Id = r.Id
          WHERE  @FechaHoraExcepcionDesde &lt;= ETM.FechaCreacionExcepcion AND ETM.FechaCreacionExcepcion &lt;= DATEADD(day,1,@FechaHoraExcepcionHasta)
          AND ((@FechaHoraIngresoDesde &lt;= R.FechaInicio or @FechaHoraIngresoDesde IS NULL) AND (R.FechaInicio &lt;= DATEADD(day,1,@FechaHoraIngresoHasta) OR @FechaHoraIngresoHasta IS NULL))
        </CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaIngreso">
          <DataField>FechaIngreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FechaExcepcion">
          <DataField>FechaExcepcion</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Chofer">
          <DataField>Chofer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombreUsuario">
          <DataField>NombreUsuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PagaTicketMunicipal">
          <DataField>PagaTicketMunicipal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CodigoSAP, Descripcion 
FROM Centro
