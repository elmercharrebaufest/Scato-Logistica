    <DataSet Name="DSDescargaCamionVagon">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;
select COALESCE(DescargaSoja, m.Descripcion) as DescargaSoja,  
COALESCE(CantCamiones, 0) as CantCamiones,
COALESCE(CantTrenes, 0) as CantTrenes,
COALESCE(ToneladasCamiones, 0) as ToneladasCamiones,
COALESCE(ToneladasTren, 0) as ToneladasTren
from AlmacenReporteDeMovimientos m
left join (
  SELECT
  ar.Descripcion as DescargaSoja,
  m.descripcion AS Material,
  count(CASE WHEN TipoVehiculo != 1 THEN 1 ELSE NULL END) AS CantCamiones,
  count(CASE WHEN TipoVehiculo = 1 THEN 1 ELSE NULL END) AS CantTrenes,
  cast(sum(cast(CASE WHEN r.TipoVehiculo != 1 THEN r.PesoBruto - r.PesoTara ELSE 0 END AS numeric(18,2))) / 1000 AS numeric(18, 2)) AS ToneladasCamiones,
  cast(sum(cast(CASE WHEN r.TipoVehiculo = 1 THEN r.PesoBruto - r.PesoTara ELSE 0 END AS numeric(18, 2))) / 1000 AS numeric(18, 2)) AS ToneladasTren
  FROM [Recorrido] AS r WITH (NOLOCK) jOIN
  Workflow AS w WITH (NOLOCK) ON r.Workflow_Id = w.Id JOIN
  Almacen AS a WITH (NOLOCK) ON a.Id = r.Almacen_Id JOIN
  Material AS m WITH (NOLOCK) ON m.Id = r.material_id right join
  AlmacenReporteDeMovimientos as ar with (nolock) on ar.Almacen = a.Descripcion or (ar.Almacen = TRIM('EPA' FROM a.Descripcion) and a.Descripcion like '%EPA')
  WHERE    w.TipoDeWorkflow = 0 AND r.Centro_Id = @CentroId AND r.Material_Id IN (4) AND terminado = 1 AND Rechazado = 0 AND r.PesoTaraFecha IS NOT NULL AND
  r.PesoTaraFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' AND r.PesoTaraFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59'
  GROUP BY  m.descripcion,ar.Descripcion) as Datos on datos.DescargaSoja = m.Descripcion



order by orden</CommandText>
      </Query>
      <Fields>
        <Field Name="DescargaSoja">
          <DataField>DescargaSoja</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantCamiones">
          <DataField>CantCamiones</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CantTrenes">
          <DataField>CantTrenes</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ToneladasCamiones">
          <DataField>ToneladasCamiones</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ToneladasTren">
          <DataField>ToneladasTren</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
