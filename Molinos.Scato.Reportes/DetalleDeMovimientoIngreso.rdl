  </am:AuthoringMetadata>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fcdac5bc-96f6-4cb6-83ee-081bfc842e2b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DSIngreso">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;

					select COALESCE(IngresoxD, m.Descripcion) as IngresoxD,
					SUM(COALESCE(CantidadxD, 0)) as CantidadxD,
					SUM(COALESCE(TonsxD, 0)) as TonsxD,
					SUM(COALESCE(CantidadxM, 0)) as CantidadxM,
					SUM(COALESCE(TonsxM, 0)) as TonsxM,
					SUM(COALESCE(CantidadxA, 0)) as CantidadxA,
					SUM(COALESCE(TonsxA, 0)) as TonsxA
					from MaterialReporteDeMovimientos m
					left join (
					--camiones
					SELECT CASE
					when m.id = 4 and estab.Id is not null and estab.EPA = 1 and alm.EPA = 1 then 'Soja EPA'
					when m.id = 4 and estab.Id is not null then 'Soja Sustentable'
					when m.id = 4 and estab.Id is null then 'Soja'
					else m.Descripcion end
					as 'IngresoxD',
					sum(case when r.PesoTaraFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoTaraFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then 1 else 0 end ) as 'CantidadxD',
					cast(((sum(case when r.PesoTaraFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoTaraFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000) as numeric(18,2)) AS 'TonsxD',
					sum(case when r.PesoTaraFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha  &lt;= @fecha + '23:59:59' then 1 else 0 end ) as 'CantidadxM',
					cast(((sum(case when r.PesoTaraFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha  &lt;= @fecha + '23:59:59' then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000) as numeric(18,2)) AS 'TonsxM',
					count(*) as 'CantidadxA',
					cast( (sum(cast(r.PesoBruto- PesoTara as numeric(18,2)))/1000) as numeric(18,2)) as 'TonsxA'
					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id
					join Material as m WITH(NOLOCK) on m.Id = r.Material_Id and r.TipoVehiculo &lt;&gt; 1
					left join Establecimiento as estab WITH(NOLOCK) on estab.Id = r.Establecimiento_Id
					inner join Almacen as alm WITH(NOLOCK) on alm.Id = r.Almacen_Id
					where w.TipoDeWorkflow = 0 and r.Centro_Id = @CentroId
					and r.PesoTaraFecha  is not null and Terminado = 1 and Rechazado = 0
					and ((MONTH(@fecha) &gt; 3 and r.PesoTaraFecha  &gt; DATEFROMPARTS(YEAR(@fecha),4,1)) OR
					(MONTH(@fecha) &lt;= 3 and r.PesoTaraFecha  &gt;= DATEFROMPARTS(YEAR(@fecha)-1,4,1)))
					and r.PesoTaraFecha  &lt;= @fecha+'23:59:59'
					UNION ALL

					SELECT CASE
					
					when m.id = 4 and Establecimiento_Id is not null and e.EPA = 0 then 'Soja Sustentable'
					when m.id = 4 and Establecimiento_Id is not null and e.EPA = 1 then 'Soja EPA'

					else m.Descripcion end
					as 'IngresoxD',
					--Cantidad D
					sum(case when r.PesoTaraFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoTaraFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then 1 else 0 end ) as 'CantidadxD',
					--Tons D
					cast(((sum(case when r.PesoTaraFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoTaraFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000) as numeric(18,2)) AS 'TonsxD',
					--Cantidad M
					sum(case when r.PesoTaraFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha  &lt;= @fecha + '23:59:59' then 1 else 0 end ) as 'CantidadxM',
					--Tons M
					cast(((sum(case when r.PesoTaraFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha  &lt;= @fecha + '23:59:59' then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000) as numeric(18,2)) AS 'TonsxM',
					--Cantidad A
					count(*) as 'CantidadxA',
					--Tons A
					cast( (sum(cast(r.PesoBruto- PesoTara as numeric(18,2)))/1000) as numeric(18,2)) as 'TonsxA'

					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id
					join Material as m WITH(NOLOCK) on m.Id = r.Material_Id and r.TipoVehiculo &lt;&gt; 1
					join Establecimiento as e WITH(NOLOCK) on r.Establecimiento_Id =  e.Id

					where w.TipoDeWorkflow = 0 and r.Centro_Id = @CentroId
					and r.PesoTaraFecha  is not null and Terminado = 1 and Rechazado = 0
					and ((MONTH(@fecha) &gt; 3 and r.PesoTaraFecha  &gt; DATEFROMPARTS(YEAR(@fecha),4,1)) OR
					(MONTH(@fecha) &lt;= 3 and r.PesoTaraFecha  &gt;= DATEFROMPARTS(YEAR(@fecha)-1,4,1)))
					and r.PesoTaraFecha  &lt;= @fecha+'23:59:59'
					group by m.Descripcion,m.Id, Establecimiento_Id, e.EPA

					group by m.Descripcion,m.Id, estab.Id, estab.EPA, alm.EPA
					UNION ALL
					--vagones
					SELECT CASE
					when m.id = 4 then 'Operativos de Vagones Soja'
					when m.id = 13 then 'Operativos de Vagones Trigo'
					when m.id = 386 then 'Operativos de Vagones Maiz'
					else m.Descripcion end
					as 'IngresoxD',
					sum(case when r.PesoTaraFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoTaraFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then 1 else 0 end ) as 'CantidadxD',
					cast(((sum(case when r.PesoTaraFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoTaraFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000) as numeric(18,2)) AS 'TonsxD',
					sum(case when r.PesoTaraFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha  &lt;= @fecha + '23:59:59' then 1 else 0 end ) as 'CantidadxM',
					cast(((sum(case when r.PesoTaraFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha  &lt;= @fecha + '23:59:59' then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000) as numeric(18,2)) AS 'TonsxM',
					count(*) as 'CantidadxA',cast( (sum(cast(r.PesoBruto- PesoTara as numeric(18,2)))/1000) as numeric(18,2)) as 'TonsxA'
					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id
					join Material as m WITH(NOLOCK) on m.Id = r.Material_Id and r.TipoVehiculo = 1 and r.Material_Id in (4,13,386)
					where w.TipoDeWorkflow = 0 and r.Centro_Id = @CentroId
					and r.PesoTaraFecha  is not null and terminado = 1 and Rechazado = 0
					and ((MONTH(@fecha) &gt; 3 and r.PesoTaraFecha  &gt; DATEFROMPARTS(YEAR(@fecha),4,1)) OR
					(MONTH(@fecha) &lt;= 3 and r.PesoTaraFecha  &gt;= DATEFROMPARTS(YEAR(@fecha)-1,4,1)))
					and r.PesoTaraFecha  &lt;= @fecha+'23:59:59'
					group by m.Descripcion,m.Id
					) as Datos on datos.IngresoxD = m.Material
					where ingreso = 1 and Descripcion not in ('Aceite Cartamo alto oleico', 'BIODIESEL RENOVA', 'Operativos de Vagones')
					group by COALESCE(IngresoxD, m.Descripcion), m.Orden
					order by m.orden</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="IngresoxD">
          <DataField>IngresoxD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantidadxD">
          <DataField>CantidadxD</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxD">
          <DataField>TonsxD</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxM">
          <DataField>CantidadxM</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxM">
          <DataField>TonsxM</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxA">
          <DataField>CantidadxA</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxA">
          <DataField>TonsxA</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSEgreso">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
					DECLARE @fecha datetime = @FechaHoy;


					select mt.Descripcion as EgresoxD,
					SUM(COALESCE(CantidadxD, 0)) as CantidadxD,
					SUM(COALESCE(TonsxD, 0)) as TonsxD,
					SUM(COALESCE(CantidadxM, 0)) as CantidadxM,
					SUM(COALESCE(TonsxM, 0)) as TonsxM,
					SUM(COALESCE(CantidadxA, 0)) as CantidadxA,
					SUM(COALESCE(TonsxA, 0)) as TonsxA
					from MaterialReporteDeMovimientos mt
					left join (
					SELECT
					case
					when r.Material_Id = 81223 and (case when w.Id != 220 then 1 else 0 end) = 0 then 'Harina High Pro Venta'
					when r.Material_Id = 81223 and (case when w.Id = 220  then 1 else 0 end) = 1 then 'Harina High Pro EXPORTACION'
					when r.Material_Id = 63750 and (case when w.Id != 220 then 0 else 1 end) = 0 then 'Pecaso Venta'
					when r.Material_Id = 63750 and (case when w.Id = 220  then 1 else 0 end) = 1 then 'Pecaso EXPORTACION'
					when r.Material_Id = 63734 and (case when w.Id != 220 then 1 else 0 end) = 0 then 'Aceite Venta a 3ros'
					when r.Material_Id = 63734 and (case when w.Id = 220  then 1 else 0 end) = 1 then 'ACEITE CRUDO DE SOJA EXPORTACION'
					when r.Material_Id = 63746 and (case when w.Id != 220 then 1 else 0 end) = 0 then 'Lecitina  de Soja Venta'
					when r.Material_Id = 63746 and (case when w.Id = 220  then 1 else 0 end) = 1 then 'Lecitina de Soja EXPORTACION'
					when r.Material_Id = 63734 and (case when w.Id = 67  then 1 else 0 end) = 1   and ocif.cliente_id = 60324 then 'Aceite Santa Clara'
					when r.Material_Id = 63734 and (case when w.Id = 67 or w.Id = 66 then 1 else 0 end) = 1   and ocif.cliente_id = 59498 then 'Aceite Soja Crudo Patagonia Bioenergia'
					when r.Material_Id = 63734 and (case when w.Id = 65  then 1 else 0 end) = 1  and ocf.Cliente_Id is not null then 'Aceite Venta a 3ros'
					when r.Material_Id = 63734 and (case when w.Id = 67  then 1 else 0 end) = 1  and ocif.cliente_id &lt;&gt; 60324 then 'Aceite Soja Crudo Retiro Fazon con 3°'
					else mt.Descripcion end
					as 'EgresoxD',
					sum(case when r.PesoBrutoFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.PesoBrutoFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then 1 else 0 end  ) as 'CantidadxD',
					cast(((sum(case when r.PesoBrutoFecha  &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.PesoBrutoFecha  &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then cast( r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000)  as numeric(18,2)) AS 'TonsxD',
					sum(case when r.PesoBrutoFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoBrutoFecha  &lt;= @fecha + '23:59:59' then 1 else 0 end  ) as 'CantidadxM',
					cast (((sum(case when r.PesoBrutoFecha  &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoBrutoFecha  &lt;=  @fecha + '23:59:59' then cast( r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000)  as numeric(18,2))AS 'TonsxM',
					count(*) as CantidadxA,
					cast( (sum(cast(r.PesoBruto- PesoTara as numeric(18,2)))/1000) as numeric(18,2)) as 'TonsxA'
					FROM [Recorrido] as r WITH(NOLOCK)
					inner join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id
					inner join Material as m WITH(NOLOCK) on m.Id = r.Material_Id
					inner join MaterialReporteDeMovimientos mt on mt.Material like '%'+m.Descripcion +'%'
					inner join TipoComercial as tc WITH(NOLOCK) on tc.Id = r.TipoComercial_Id
					left join OrdenCargaInternaFason as ocif on ocif.Recorrido_Id = r.Id
					left join OrdenCargaFas as ocf on ocf.Recorrido_Id = r.Id
					where w.TipoDeWorkflow = 1 and  r.Centro_Id = @CentroId
					and r.PesoBrutoFecha  is not null and terminado = 1 and Rechazado = 0
					and ((MONTH(@fecha) &gt; 3 and r.PesoBrutoFecha  &gt; DATEFROMPARTS(YEAR(@fecha),4,1)) OR
					(MONTH(@fecha) &lt;= 3 and r.PesoBrutoFecha  &gt; DATEFROMPARTS(YEAR(@fecha)-1,4,1)))
					and r.PesoBrutoFecha  &lt;= @fecha+'23:59:59'
					and Ingreso = 0
					group by mt.Descripcion, r.Material_Id,
					case when w.Id = 220 then 1 else 0 end,
					case when w.Id != 220 then 0 else 1 end,
					case when w.Id != 220 then 1 else 0 end,
					case when w.Id = 67  then 1 else 0 end,
					case when w.Id = 65  then 1 else 0 end,
					case when w.Id = 67 or w.Id = 66 then 1 else 0 end,
					ocif.cliente_id, ocf.Cliente_Id)as Datos on Datos.EgresoxD = mt.Descripcion
					where Ingreso = 0
					group by mt.Descripcion, mt.Orden
					order by mt.Orden
				</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EgresoxD">
          <DataField>EgresoxD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantidadxD">
          <DataField>CantidadxD</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxD">
          <DataField>TonsxD</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxM">
          <DataField>CantidadxM</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxM">
          <DataField>TonsxM</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxA">
          <DataField>CantidadxA</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxA">
          <DataField>TonsxA</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DTAlamacen">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
					DECLARE @fecha datetime = @FechaHoy;

					SELECT CASE
					WHEN m.CodigoSAP = '50866' THEN 'Cargas Harina HI-PRO'
					WHEN m.CodigoSAP = '99704' THEN 'Cargas Pecaso'
					ELSE m.Descripcion
					END as Operacion,
					isnull((
					select cast(sum(cast(r.PesoBruto-r.PesoTara as numeric(18,2)))/1000  as numeric(18,2))as Toneladas
					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id and r.Material_Id = m.Id
					join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id and a.Descripcion in ('SILO 7', 'SIL 7', 'Silo 7')
					where w.TipoDeWorkflow = 1 and r.Centro_Id = @CentroId
					and terminado = 1 and Rechazado = 0 and r.FechaEgreso is not null
					and r.FechaEgreso &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'
					and r.FechaEgreso &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
					group by a.Descripcion
					), 0) as Celda7,
					isnull((
					select cast(sum(cast(r.PesoBruto-r.PesoTara as numeric(18,2)))/1000  as numeric(18,2))as Toneladas
					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id and r.Material_Id = m.Id
					join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id and a.Descripcion in ('SILO 20')
					where w.TipoDeWorkflow = 1 and r.Centro_Id = @CentroId
					and terminado = 1 and Rechazado = 0 and r.FechaEgreso is not null
					and r.FechaEgreso &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'
					and r.FechaEgreso &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
					group by a.Descripcion
					), 0) as Celda20,
					isnull((
					select cast(sum(cast(r.PesoBruto-r.PesoTara as numeric(18,2)))/1000  as numeric(18,2))as Toneladas
					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id and r.Material_Id = m.Id
					join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id and a.Descripcion in ('SILO 23')
					where w.TipoDeWorkflow = 1 and r.Centro_Id = @CentroId
					and terminado = 1 and Rechazado = 0 and r.FechaEgreso is not null
					and r.FechaEgreso &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'
					and r.FechaEgreso &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
					group by a.Descripcion
					), 0) as Celda23,
					isnull((
					select cast(sum(cast(r.PesoBruto-r.PesoTara as numeric(18,2)))/1000  as numeric(18,2))as Toneladas
					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id and r.Material_Id = m.Id
					join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id and a.Descripcion in ('Celda 30')
					where w.TipoDeWorkflow = 1 and r.Centro_Id = @CentroId
					and terminado = 1 and Rechazado = 0 and r.FechaEgreso is not null
					and r.FechaEgreso &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'
					and r.FechaEgreso &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
					group by a.Descripcion
					), 0) as Celda30,
					isnull((
					select cast(sum(cast(r.PesoBruto-r.PesoTara as numeric(18,2)))/1000  as numeric(18,2))as Toneladas
					FROM [Recorrido] as r WITH(NOLOCK)
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id and r.Material_Id = m.Id
					join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id and a.Descripcion in ('No Productivo')
					where w.TipoDeWorkflow = 1 and r.Centro_Id = @CentroId
					and terminado = 1 and Rechazado = 0 and r.FechaEgreso is not null
					and r.FechaEgreso &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'
					and r.FechaEgreso &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
					group by a.Descripcion
					), 0) as NoProductivo
					FROM Material m
					WHERE m.CodigoSAP in ('99704', '50866')
					order by 1
				</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Operacion">
          <DataField>Operacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Celda7">
          <DataField>Celda7</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Celda20">
          <DataField>Celda20</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Celda23">
          <DataField>Celda23</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Celda30">
          <DataField>Celda30</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NoProductivo">
          <DataField>NoProductivo</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DTDescarga">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
					DECLARE @fecha datetime = @FechaHoy;


					select a.Descripcion, m.descripcion as Material,count(r.Id) as Camiones , sum(r.PesoBruto-r.PesoTara) as Kilogramos, a.Descripcion as 'Celda/Tankes' FROM [Recorrido] as r WITH(NOLOCK)
					join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id
					join Material as m WITH(NOLOCK) on m.Id = r.material_id
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id
					where w.TipoDeWorkflow = 0  and r.Centro_Id = @CentroId  and terminado = 1 and Rechazado = 0
					and r.FechaEgreso is not null and r.FechaEgreso &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.FechaEgreso &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59'
					group by a.Descripcion , m.descripcion
				</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Camiones">
          <DataField>Camiones</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilogramos">
          <DataField>Kilogramos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Celda_Tankes">
          <DataField>Celda/Tankes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DTCarga">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
					DECLARE @fecha datetime = @FechaHoy;


					select a.Descripcion, m.descripcion as Material,count(r.Id) as Camiones , sum(r.PesoBruto-r.PesoTara) as Kilogramos, a.Descripcion as 'Celda/Tankes' FROM [Recorrido] as r WITH(NOLOCK)
					join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id
					join Material as m WITH(NOLOCK) on m.Id = r.material_id
					join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id
					where w.TipoDeWorkflow = 1  and r.Centro_Id = @CentroId  and terminado = 1 and Rechazado = 0
					and r.FechaEgreso is not null and r.FechaEgreso &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.FechaEgreso &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59'
					group by a.Descripcion , m.descripcion
				</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Camiones">
          <DataField>Camiones</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilogramos">
          <DataField>Kilogramos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Celda_Tankes">
          <DataField>Celda/Tankes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSTotaldelDia">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
					DECLARE @fecha datetime = @FechaHoy;

					select count(*) as Total
					FROM [Recorrido] as r WITH(NOLOCK)
					where    r.FechaInicio &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'
					and r.FechaInicio &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59'
					and terminado = 1 and Rechazado = 0  and r.Centro_Id = @CentroId
				</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Total">
          <DataField>Total</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
					SELECT Centro.CodigoSap as CentroSapp,
					Centro.Descripcion as CentroDescripcion

					FROM [Centro] as Centro WITH (NOLOCK)

					WHERE Centro.Id = @CentroId
				</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSapp">
          <DataField>CentroSapp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
