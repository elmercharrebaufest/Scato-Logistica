<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>16352221-a5b5-4ad7-a8e9-2d90f9139957</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!Fecha_Hora_Egreso_Desde.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!Fecha_Hora_Egreso_Hasta.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Centrop INT,
		@Materialp NVARCHAR(MAX),
		@FechaDesdep DATETIME,
		@FechaHastap DATETIME

SET		@Centrop = @Centro
SET		@Materialp = @Material
SET		@FechaDesdep = @FechaDesde
SET		@FechaHastap = @FechaHasta

SELECT 
	   DISTINCT
	   [CP].NroCartaPorte AS [NroCartaPorte],
	   [CP].FechaEmision AS [Fecha],
	   [MEA].[fechadescarga]      AS [FechaDescarga], 
	   [MEA].[pesoneto]           AS [NetoPlanta], 
	   [P].Descripcion  AS [Proveedor], 
	   [P].CodigoSap AS [NProveedor], 
	   [R].FechaEgreso AS [FechaEgreso],
	   [C].Descripcion AS [Centro],
	   [C].Id AS [CentroId],
	   [M].Descripcion AS [Material],
	   '' AS [Lote]
FROM   [dbo].[muestraenvioacamara] AS [MEA] WITH (NOLOCK)
       LEFT JOIN [dbo].[cartaporte] AS [CP] WITH (NOLOCK)
                    ON [MEA].[cartaporte_id] = [CP].[id] 
       LEFT JOIN [dbo].[recorrido] AS [R] WITH (NOLOCK)
                    ON [R].NumeroDocumentoIngreso = [CP].NroCartaPorte AND [R].TipoDocumentoIngreso = 1 --CartaPorte
	   LEFT JOIN [dbo].[centro] AS [C] WITH (NOLOCK)
                    ON [C].[Id] = [R].[Centro_Id] 
	   LEFT JOIN [dbo].[material] AS [M] WITH (NOLOCK)
                    ON [M].[Id] = [R].[Material_Id] 
       LEFT JOIN [dbo].[proveedor] AS [P] WITH (NOLOCK)
                    ON [CP].[TitularCartaPorte_Id] = [P].[Id] 
WHERE  [MEA].[estadomuestra] = 0 AND [R].[FechaEgreso] IS NOT NULL
and @Centrop=C.Id and (@Materialp is null or M.id = @Materialp) and (@FechaDesdep is null or @FechaDesdep &lt;= FechaEgreso )
and (@FechaHastap is null or @FechaHastap &gt;= FechaEgreso )</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NroCartaPorte">
          <DataField>NroCartaPorte</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FechaDescarga">
          <DataField>FechaDescarga</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NetoPlanta">
          <DataField>NetoPlanta</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Proveedor">
          <DataField>Proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NProveedor">
          <DataField>NProveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FechaEgreso">
          <DataField>FechaEgreso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Lote">
          <DataField>Lote</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CodigoSAP AS CentroSap, Descripcion AS CentroDescripcion
FROM            Centro AS Centro WITH (NOLOCK)
WHERE        (Id = @CentroId)</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
