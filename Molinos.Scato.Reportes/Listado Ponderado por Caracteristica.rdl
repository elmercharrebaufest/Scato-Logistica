<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>f7b68eab-4255-4221-ae11-6d802c815bab</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MostrarSoloCalado">
            <Value>=Parameters!MostrarSoloCalado.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoVehiculo">
            <Value>=Parameters!TipoVehiculo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoReporte">
            <Value>=Parameters!TipoReporte.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BalanzaBruto">
            <Value>=Parameters!BalanzaBruto.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BalanzaTara">
            <Value>=Parameters!BalanzaTara.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoPesada">
            <Value>=Parameters!TipoPesada.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Caracteristica">
            <Value>=join(Parameters!Caracteristica.Value,",")</Value>
          </QueryParameter>
          <QueryParameter Name="@AlmacenDestino">
            <Value>=Parameters!AlmacenDestino.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Patente">
            <Value>=Parameters!Patente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TipoComercial">
            <Value>=Parameters!TipoComercial.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @Centrop int,@Materialp int,@TipoComercialp int,@MostrarSoloCaladop bit,@TipoVehiculop int, @TipoReportep nvarchar(MAX),@BalanzaBrutop int,@BalanzaTarap int,@TipoPesadap int,@AlmacenDestinop int,@Patentep nvarchar(MAX),@FechaDesdep datetime, @FechaHastap datetime
declare @Caracteristicap table(Value nvarchar(max))

set @MostrarSoloCaladop=@MostrarSoloCalado
set @TipoVehiculop=@TipoVehiculo
set @TipoReportep=@TipoReporte
set @BalanzaBrutop=@BalanzaBruto
set @BalanzaTarap=@BalanzaTara
set @TipoPesadap=@TipoPesada
set @AlmacenDestinop=@AlmacenDestino
set @Patentep=@Patente
set @Centrop= @Centro
set @Materialp=@Material
set @TipoComercialp=@TipoComercial
set @FechaDesdep =@FechaDesde
set @FechaHastap =@FechaHasta

INSERT INTO @Caracteristicap select Value from [dbo].[FnSplit](@Caracteristica,',')

SELECT * INTO #Temp FROM(
SELECT 
	R.NumeroDocumentoIngreso,
	M.[Descripcion] as 'Material',
	(CASE @MostrarSoloCaladop
		WHEN 0 THEN  R.[PesoBruto] - R.[PesoTara]
		WHEN 1 THEN (CASE 
				WHEN (R.PesoBruto IS NULL OR R.PesoTara IS NULL)THEN (R.PesoBrutoOrigen - R.PesoTaraOrigen)
				ELSE ( R.PesoBruto - R.PesoTara)
				END)
		END) AS 'Kilos Netos',
	(CASE @MostrarSoloCaladop
		WHEN 1 THEN (CASE 
				WHEN C.FechaCreacion IS NULL THEN ( NULL )
				WHEN C.FechaCreacion IS NOT NULL THEN ( C.FechaCreacion) 
			END)
		WHEN 0 THEN (CASE W.TipoDeWorkflow
				WHEN 0  THEN ( R.PesoTaraFecha)
				WHEN 1  THEN ( R.PesoBrutoFecha)
				END)
		END )as 'Fecha', 
	W.TipoDeWorkflow as 'Tipo de Workflow',	
	almacen.[Descripcion] as 'Almacén Origen',   
	almacen.[Descripcion] as 'Almacén Destino',
		 TC.Descripcion as 'Tipo Comercial',
		 ISNULL(CASE
			WHEN APC.DescuentoEnKg IS NULL 
			THEN CPC.DescuentoEnKg
			ELSE APC.DescuentoEnKg
			END,0) as 'Descuento',
		CDCM.Descripcion as 'Caracteristica',
		R.Id as 'RecorridoId',
		R.Patente as 'Patente',
		ISNULL(CASE
			WHEN APC.ValorAnalisis IS NULL 
			THEN CPC.ValorCalado
			ELSE APC.ValorAnalisis
			END,0) as 'Valor',
		CDC.UnidadDeMedida as 'Unidad',
        R.Centro_Id As CentroId,
        0 AS 'DescuentoParcial'
	
FROM Recorrido R WITH (NOLOCK)

INNER JOIN CaracteristicasAnalizadas CCA WITH(NOLOCK)
	ON CCA.Recorrido_Id = R.Id

INNER JOIN Material M WITH (NOLOCK)
	ON R.[Material_Id] = M.[Id]

INNER JOIN [Workflow] W WITH (NOLOCK)
	ON R.[Workflow_Id] = W.[Id]

INNER JOIN [TipoComercial] TC WITH (NOLOCK)
	ON R.[TipoComercial_Id] = TC.[Id]

INNER JOIN dbo.Calado C WITH (NOLOCK)
    ON C.Id = R.Calado_Id
	
LEFT JOIN Almacen WITH (NOLOCK)
	ON R.[Almacen_Id] = Almacen.[Id]

LEFT JOIN balanza AS balanzaBruto  WITH (NOLOCK)
	ON R.BalanzaBruto_Id = balanzaBruto.id
	  
LEFT JOIN balanza AS balanzaTara WITH (NOLOCK)
	ON R.BalanzaTara_Id = balanzaTara.id

LEFT JOIN dbo.vehiculo V WITH (NOLOCK)
	ON R.vehiculo_id = V.id 

INNER JOIN MaterialPorCentro Mpc WITH(NOLOCK) 
    ON Mpc.Material_Id = r.material_Id and Mpc.centro_id = r.centro_id 

LEFT JOIN CaracteristicaDeCalidad CDC WITH(NOLOCK) 
    ON CDC.MaterialPorCentro_id = Mpc.id and (r.calado_id IS NOT NULL OR r.AnalisisdeCalidad_id IS NOT NULL)

FULL OUTER JOIN CaladoPorCaracteristica CPC WITH(NOLOCK) 
    ON CPC.Calado_Id = R.Calado_Id AND CPC.CaracteristicaDeCalidad_Id = CDC.id

FULL OUTER JOIN AnalisisPorCaracteristica APC WITH(NOLOCK) 
    ON APC.AnalisisDeCalidad_Id = R.AnalisisDeCalidad_Id AND APC.CaracteristicaDeCalidad_Id = CDC.id

LEFT JOIN CaracteristicaDeCalidadMaestro CDCM WITH(NOLOCK) 
    ON CDCM.Id = CDC.CaracteristicaDeCalidadMaestro_Id
    WHERE  ((@TipoVehiculop IS NULL) OR (R.TipoVehiculo = @TipoVehiculop))

AND (@TipoReportep = 1 or @TipoReportep = 3 or ((@TipoReportep = 2 or @TipoReportep = 4) and
	(CCA.EsHumedad = 1 or 
	(SELECT 1 FROM MuestraEnvioACamara mc 
	INNER JOIN CaracteristicaDeCalidadMuestraEnvioACamara ccmec on ccmec.MuestraEnvioACamara_Id = mc.Id 
	INNER JOIN CaracteristicaDeCalidad cc on cc.Id = ccmec.CaracteristicaDeCalidad_Id WHERE mc.Calado_Id = c.Id AND cc.EsHumedad = 1) is not NULL))
	or ((@TipoReportep = 5 or @TipoReportep = 6) and
	(CCA.EsHumedad = 0 and
	(SELECT 1 FROM MuestraEnvioACamara mc 
	INNER JOIN CaracteristicaDeCalidadMuestraEnvioACamara ccmec on ccmec.MuestraEnvioACamara_Id = mc.Id 
	INNER JOIN CaracteristicaDeCalidad cc on cc.Id = ccmec.CaracteristicaDeCalidad_Id WHERE mc.Calado_Id = c.Id AND cc.EsHumedad = 1) is NULL)))
	
	
AND (@BalanzaBrutop IS NULL or R.balanzabruto_id = @BalanzaBrutop)
AND (@BalanzaTarap IS NULL or R.balanzatara_id = @BalanzaTarap)
AND (@Centrop IS NULL or R.centro_id = @Centrop)
AND (R.material_id = @Materialp)
AND (@TipoPesadap IS NULL or balanzaTara.modalidad = @TipoPesadap)
AND (@TipoComercialp IS NULL or R.TipoComercial_Id = @TipoComercialp)
AND (CDCM.Id in (select value from @Caracteristicap))
AND (@AlmacenDestinop IS NULL OR R.almacen_id = @AlmacenDestinop)
AND R.Rechazado &lt;&gt; 1 
AND 1 = CASE  
	WHEN @MostrarSoloCaladop = 1 THEN 1
	WHEN @MostrarSoloCaladop = 0 AND R.PesoBruto IS NOT NULL AND R.PesoTara IS NOT NULL THEN 1
	ELSE 0
	END
	
AND (@Patentep = '' or R.Patente = @Patentep)

AND (CASE @MostrarSoloCaladop
		WHEN 1 THEN (CASE 
				WHEN C.FechaCreacion IS NULL THEN ( NULL )
				WHEN C.FechaCreacion IS NOT NULL THEN ( C.FechaCreacion) 
			END)
		WHEN 0 THEN (CASE W.TipoDeWorkflow
				WHEN 0  THEN ( R.PesoTaraFecha)
				WHEN 1  THEN ( R.PesoBrutoFecha)
				END)
		END ) &gt;= @FechaDesdep
AND (CASE @MostrarSoloCaladop
		WHEN 1 THEN (CASE 
				WHEN C.FechaCreacion IS NULL THEN ( NULL )
				WHEN C.FechaCreacion IS NOT NULL THEN ( C.FechaCreacion) 
			END)
		WHEN 0 THEN (CASE W.TipoDeWorkflow
				WHEN 0  THEN ( R.PesoTaraFecha)
				WHEN 1  THEN ( R.PesoBrutoFecha)
				END)
		END ) &lt;= @FechaHastap) AS X



UPDATE #Temp  SET DescuentoParcial = (SELECT SUM(ROUND(b.Descuento, 0)) FROM #Temp b WHERE b.NumeroDocumentoIngreso = #Temp.NumeroDocumentoIngreso)
SELECT * from #Temp ORDER BY NumeroDocumentoIngreso</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NumeroDocumentoIngreso">
          <DataField>NumeroDocumentoIngreso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos">
          <DataField>Kilos Netos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Tipo_de_Workflow">
          <DataField>Tipo de Workflow</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Almacén_Origen">
          <DataField>Almacén Origen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Almacén_Destino">
          <DataField>Almacén Destino</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tipo_Comercial">
          <DataField>Tipo Comercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descuento">
          <DataField>Descuento</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Caracteristica">
          <DataField>Caracteristica</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecorridoId">
          <DataField>RecorridoId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Patente">
          <DataField>Patente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Valor">
          <DataField>Valor</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Unidad">
          <DataField>Unidad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilos_Netos_Calc">
          <Value>=Fields!Kilos_Netos.Value / Parameters!Caracteristica.Value.Length</Value>
        </Field>
        <Field Name="DescuentoParcial">
          <DataField>DescuentoParcial</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centros">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Id, Descripcion AS Centro
FROM            Centro WITH (NOLOCK)
order by Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Centro">
          <DataField>Centro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TiposComerciales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT NULL AS Id, 'Todos' AS TipoComercial, '0' AS ord
UNION
Select Id, Descripcion as TipoComercial, Descripcion AS ord from TipoComercial WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoComercial">
          <DataField>TipoComercial</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materiales">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Material.Id, Material.Descripcion AS Material
FROM            Material WITH (NOLOCK)
Where Exists(Select 1 from Recorrido WITH (NOLOCK) where Recorrido.Material_Id = Material.Id AND (Recorrido.Centro_Id = @Centro or @Centro is null) )
order by Material.Descripcion </CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Almacenes">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT NULL AS Id, 'Todos' AS Almacen, '0' AS ord
UNION
Select Id, Descripcion as Almacen, Descripcion AS ord
from Almacen WITH (NOLOCK)
Where Almacen.Centro_Id = @Centro or @Centro = NULL
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Almacen">
          <DataField>Almacen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoPesadas">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS TipoPesada, '0' AS ord
UNION
SELECT        Id  AS Id, Descripcion AS TipoPesada, Descripcion AS ord
FROM            TipoPesada WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoPesada">
          <DataField>TipoPesada</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Balanzas">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT NULL AS Id, 'Todos' AS Balanza, '0' AS ord
UNION
Select Id,Nombre as Balanza,Nombre AS ord
 from Balanza WITH (NOLOCK)
where Balanza.Centro_Id = @Centro or @Centro = NULL
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Balanza">
          <DataField>Balanza</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoVehiculos">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'Todos' AS TipoVehiculo, '0' AS ord
UNION
SELECT        Id, Descripcion AS TipoVehiculo, Descripcion AS ord
FROM            TipoVehiculo WITH (NOLOCK)
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TipoVehiculo">
          <DataField>TipoVehiculo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Caracteristicas">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Material">
            <Value>=Parameters!Material.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Centro">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        cdm.Id, cdm.Descripcion AS Caracteristica
FROM            CaracteristicaDeCalidad AS cd WITH (NOLOCK) INNER JOIN
                         CaracteristicaDeCalidadMaestro AS cdm WITH (NOLOCK) ON cd.CaracteristicaDeCalidadMaestro_Id = cdm.Id INNER JOIN
                         MaterialPorCentro AS MPC WITH (NOLOCK) ON MPC.Id = cd.MaterialPorCentro_Id
WHERE        (MPC.Material_Id = @Material) AND (MPC.Centro_Id = @Centro)
ORDER BY Caracteristica</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Caracteristica">
          <DataField>Caracteristica</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Centro">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!Centro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Centro.CodigoSap as CentroSap,
              Centro.Descripcion as CentroDescripcion

FROM [Centro] as Centro WITH (NOLOCK)

WHERE Centro.Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSap">
          <DataField>CentroSap</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ImagenDb">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
