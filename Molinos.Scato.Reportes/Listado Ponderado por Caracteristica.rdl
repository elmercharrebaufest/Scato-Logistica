                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=FormatNumber(Round(Fields!Kilos_Netos.Value,System.MidpointRounding.AwayFromZero) - Fields!DescuentoParcial.Value, 0)</Value>
                                  <Style>
