                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=FormatNumber(System.Math.Round(IIf(Sum(Fields!Kilos_Netos.Value) = 0, 0, Sum(Fields!Valor.Value * Fields!Kilos_Netos.Value / Sum(Fields!Kilos_Netos.Value))), 2)) &amp; " " &amp; Fields!Unidad.Value</Value>
