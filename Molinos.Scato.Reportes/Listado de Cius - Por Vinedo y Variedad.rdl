  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=bfdev226;Initial Catalog=Scato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>731bbbef-abcd-42a7-a7ad-a782b02222b9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Vinedo">
            <Value>=Parameters!Viñedo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Bodegas">
            <Value>=Parameters!Bodegas.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Vinatero">
            <Value>=Parameters!Viñatero.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaDesdep DATETIME, @FechaHastap DATETIME, @Vinedop INT, @Vinaterop INT
SET                @FechaDesdep = @FechaDesde
SET                @FechaHastap = @FechaHasta
SET                @Vinedop = @Vinedo
SET @Vinaterop = @Vinatero
                             SELECT        v.Descripcion AS Variedad, r.Centro_Id, (CASE WHEN tc.EsParaUva = 1 THEN 'P' WHEN tc.EsParaUva = 2 THEN 'T' ELSE '' END) AS Operacion, r.NumeroCiu AS CIU, r.FechaEgreso AS Fecha, 
                                                       vinedo.NumeroINV AS Vinedo, proveedor.Descripcion AS Vinatero, r.PesoBruto - r.PesoTaraBodega AS Neto, (CASE WHEN ancarAz.valoranalisis IS NOT NULL 
                                                       THEN ancarAz.valoranalisis WHEN calcarAz.valorcalado IS NOT NULL THEN calcarAz.valorcalado ELSE 0 END) AS Azucar, (CASE WHEN ancarCal.valoranalisis IS NOT NULL 
                                                       THEN ancarCal.valoranalisis WHEN calcarCal.valorcalado IS NOT NULL THEN calcarCal.valorcalado ELSE 0 END) AS Calidad, (CASE WHEN ancarEst.valoranalisis IS NOT NULL 
                                                       THEN ancarEst.valoranalisis WHEN calcarEst.valorcalado IS NOT NULL THEN calcarEst.valorcalado ELSE 0 END) AS Estado, ((CASE WHEN ancarAz.valoranalisis IS NOT NULL 
                                                       THEN ancarAz.valoranalisis WHEN calcarAz.valorcalado IS NOT NULL THEN calcarAz.valorcalado ELSE 0 END) - 1) * 0.059 AS AlcVol
                              FROM            Recorrido AS r WITH (NOLOCK) INNER JOIN
                                                       Centro AS c WITH (NOLOCK) ON r.Centro_Id = c.Id INNER JOIN
                                                       Material AS m WITH (NOLOCK) ON r.Material_Id = m.Id INNER JOIN
                                                       Variedad AS v WITH (NOLOCK) ON m.Variedad_Id = v.Id INNER JOIN
                                                       TipoComercial AS tc WITH (NOLOCK) ON r.TipoComercial_Id = tc.Id INNER JOIN
                                                       RemitoBodegaUva AS remito WITH (NOLOCK) ON r.Id = remito.Recorrido_Id INNER JOIN
                                                       Vinedo AS vinedo WITH (NOLOCK) ON remito.Vinedo_Id = vinedo.Id INNER JOIN
                                                       Proveedor AS proveedor WITH (NOLOCK) ON proveedor.Id = vinedo.Proveedor_Id LEFT OUTER JOIN
                                                       AnalisisDeCalidad WITH (NOLOCK) ON AnalisisDeCalidad.Calado_Id = r.Calado_Id LEFT OUTER JOIN
                                                       CaladoPorCaracteristica AS calcarAz WITH (NOLOCK) ON calcarAz.Calado_Id = r.Calado_Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad AS car WITH (NOLOCK)
                                                             WHERE        (Id = calcarAz.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
                                                       AnalisisPorCaracteristica AS ancarAz ON ancarAz.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad WITH (NOLOCK)
                                                             WHERE        (Id = ancarAz.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
                                                       CaladoPorCaracteristica AS calcarCal ON calcarCal.Calado_Id = r.Calado_Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad AS car WITH (NOLOCK)
                                                             WHERE        (Id = calcarCal.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN
                                                       AnalisisPorCaracteristica AS ancarCal ON ancarCal.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad WITH (NOLOCK)
                                                             WHERE        (Id = ancarCal.CaracteristicaDeCalidad_Id) AND (EsCalidadUva = 1)) LEFT OUTER JOIN
                                                       CaladoPorCaracteristica AS calcarEst ON calcarEst.Calado_Id = r.Calado_Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad AS car WITH (NOLOCK)
                                                             WHERE        (Id = calcarEst.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1)) LEFT OUTER JOIN
                                                       AnalisisPorCaracteristica AS ancarEst ON ancarEst.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad WITH (NOLOCK)
                                                             WHERE        (Id = ancarEst.CaracteristicaDeCalidad_Id) AND (EsEstadoSanitario = 1)) LEFT OUTER JOIN
                                                       CaladoPorCaracteristica AS calcar ON calcar.Calado_Id = r.Calado_Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad AS car WITH (NOLOCK)
                                                             WHERE        (Id = calcar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1)) LEFT OUTER JOIN
                                                       AnalisisPorCaracteristica AS ancar ON ancar.AnalisisDeCalidad_Id = AnalisisDeCalidad.Id AND EXISTS
                                                           (SELECT        1 AS Expr1
                                                             FROM            CaracteristicaDeCalidad WITH (NOLOCK)
                                                             WHERE        (Id = ancar.CaracteristicaDeCalidad_Id) AND (EsTenorAzucarino = 1))
                              WHERE        (r.Rechazado &lt;&gt; 1) AND (r.Terminado = 1) AND (c.NumeroINV IS NOT NULL) AND (r.FechaInicio IS NOT NULL) AND (@FechaDesdep &lt;= r.FechaEgreso) AND (@FechaHastap &gt;= r.FechaEgreso) AND 
                                                      ((@Vinedop &lt;&gt; 0 AND @Vinedop = remito.Vinedo_Id) OR
                                                       @Vinaterop = 0 OR
                                                       (@Vinedop = 0 AND remito.Vinedo_Id IN
                                                           (SELECT        Id
                                                             FROM            Vinedo WITH (nolock)
                                                             WHERE        Vinedo.Proveedor_Id = @Vinaterop))) AND (r.Centro_Id IN (@Bodegas))</CommandText>
      </Query>
      <Fields>
        <Field Name="Variedad">
          <DataField>Variedad</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Centro_Id">
          <DataField>Centro_Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Operacion">
          <DataField>Operacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CIU">
          <DataField>CIU</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Vinedo">
          <DataField>Vinedo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vinatero">
          <DataField>Vinatero</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Neto">
          <DataField>Neto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Azucar">
          <DataField>Azucar</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Calidad">
          <DataField>Calidad</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Estado">
          <DataField>Estado</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AlcVol">
          <DataField>AlcVol</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        NumeroINV + ' - ' + Descripcion AS Bodega, Id
FROM            Centro WITH (NOLOCK)
WHERE        (NumeroINV IS NOT NULL)
ORDER BY Descripcion</CommandText>
      </Query>
      <Fields>
        <Field Name="Bodega">
          <DataField>Bodega</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Viñatero">
            <Value>=Parameters!Viñatero.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Id, NumeroINV + ' - ' + Descripcion AS Descripcion, NumeroINV + ' - ' + Descripcion AS ord
FROM            Vinedo WITH (nolock)
WHERE        (Proveedor_Id = @Viñatero) OR
                         (@Viñatero = NULL)
UNION
SELECT        0 AS id, 'TODOS' AS Descripcion, '0' AS ord
ORDER BY ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet4">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>SELECT        Id, RazonSocial as Descripcion, RazonSocial as ord
FROM            Proveedor WITH (nolock)
WHERE Id in (select distinct Proveedor_Id from vinedo WITH (nolock))
UNION
SELECT        0 AS Id, 'TODOS' AS Descripcion, '0' as ord
order by ord</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ord">
          <DataField>ord</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
