<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3f6ad7e7-aac4-42c0-970e-9c78a0120835</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FechaDesdep DATETIME, 
		@FechaHastap DATETIME, 
		@CentroIdp INT
SET		@FechaDesdep =  @FechaDesde
SET		@FechaHastap = @FechaHasta
SET		@CentroIdp = @CentroId
SELECT   distinct     LTS.NumeroTarjeta AS Tarjeta, CASE WHEN LTS.NumeroTarjeta IS not NULL THEN TS.Descripcion ELSE LTS.NombreUsuario end AS Usuario, P.NombrePuesto AS Puesto, LTS.Fecha AS Fecha,
          C.Id as CentroId,
          C.CodigoSAP as CodigoSap,
          C.Descripcion as Descripcion,
          Fecha, 
          LTS.Motivo
          FROM            
		  LogTarjetaSupervisor LTS WITH (NOLOCK)
		  LEFT JOIN PuestoDeTrabajo P WITH (NOLOCK) ON LTS.PuestoDeTrabajo_Id = P.Id
		  LEFT JOIN TarjetaSupervisor TS WITH (NOLOCK) ON LTS.NumeroTarjeta = TS.Numero
		  LEFT JOIN Centro C WITH (NOLOCK) ON P.Centro_Id = C.Id

          where	
LTS.Fecha &gt;= @FechaDesdep and 
LTS.Fecha &lt; @FechaHastap and 
P.Centro_Id = @CentroIdp</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Puesto">
          <DataField>Puesto</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Tarjeta">
          <DataField>Tarjeta</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="CentroId">
          <DataField>CentroId</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="CodigoSap">
          <DataField>CodigoSap</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Motivo">
          <DataField>Motivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombreUsuario">
          <DataField>NombreUsuario</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
