<parameters>
	<parameter name="ServicioRepositorio Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='ServicioRepositorio']
                           /@address" />
	</parameter>
	<parameter name="FirmaProvider Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='FirmaProvider']
                           /@address" />
	</parameter>
	<parameter name="ServicioComandos Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='ServicioComandos']
                           /@address" />
	</parameter>
	<parameter name="ListaDeWorkflows Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='ListaDeWorkflows']
                           /@address" />
	</parameter>
	<parameter name="UrlBaseWorkflow Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='UrlBaseWorkflow']
                           /@value" />
	</parameter>
	
	<!-- ===== Azure Entra ID (Azure AD) Configuration ===== -->
	<parameter name="TenantId Config" defaultValue="790c9737-0b8e-4138-a0f4-819cdc1eb64b">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:TenantId']
                           /@value" />
	</parameter>
	<parameter name="ClientId Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:ClientId']
                           /@value" />
	</parameter>
	<parameter name="ClientSecret Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:ClientSecret']
                           /@value" />
	</parameter>
	<parameter name="RedirectUri Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:RedirectUri']
                           /@value" />
	</parameter>
	<parameter name="PostLogoutRedirectUri Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:PostLogoutRedirectUri']
                           /@value" />
	</parameter>
	<parameter name="Authority Config" defaultValue="https://login.microsoftonline.com/790c9737-0b8e-4138-a0f4-819cdc1eb64b/v2.0">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:Authority']
                           /@value" />
	</parameter>
	<parameter name="Use Https Config Login">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:UseHttps']
                           /@value" />
	</parameter>
	<parameter name="Cookie Expire Time Hours" defaultValue="120">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:CookieExpireTimeHours']
                           /@value" />
	</parameter>	
	<!-- ===== End Azure Entra ID (Azure AD) Configuration ===== -->
	

	<parameter name="ServiciosScatoBinding Security Configuration">
		<parameterEntry kind="XmlFile" scope="Web.config"
					match="/configuration/system.serviceModel/bindings/basicHttpBinding/binding[@name='ServiciosScatoBinding']
                    /security/@mode" />
	</parameter>

  <!-- Quita el Dummy de autenticacion al desplegar -->
  <parameter name="DummyAuthenticationModule" defaultValue="">
    <parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.webServer/modules/add[@name='DummyAuthenticationModule']" />
  </parameter>

  <parameter name="RollingLogFileAppenderFileValue log4net.config">
    <parameterEntry kind="XmlFile" scope="log4net.config"
					    match="/log4net/appender[@name='RollingLogFileAppender']/file/@value" />
  </parameter>

</parameters>