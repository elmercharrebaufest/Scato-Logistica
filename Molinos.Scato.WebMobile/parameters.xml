<parameters>
	<parameter name="ServicioRepositorio Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='ServicioRepositorio']
                           /@address" />
	</parameter>
	<parameter name="FirmaProvider Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='FirmaProvider']
                           /@address" />
	</parameter>
	<parameter name="ServicioComandos Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='ServicioComandos']
                           /@address" />
	</parameter>
	<parameter name="ListaDeWorkflows Service Endpoint Address">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.serviceModel/client
                           /endpoint[@name='ListaDeWorkflows']
                           /@address" />
	</parameter>
	<parameter name="UrlBaseWorkflow Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='UrlBaseWorkflow']
                           /@value" />
	</parameter>
	<parameter name="FederationMetadataLocation Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:FederationMetadataLocation']
                           /@value" />
	</parameter>
	<parameter name="Issuer Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='ida:Issuer']
                           /@value" />
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel.services/federationConfiguration/wsFederation/@issuer" />
	</parameter>
	<parameter name="IssuerTrust Identity Configuration">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel/identityConfiguration/issuerNameRegistry/authority/@name" />
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel/identityConfiguration/issuerNameRegistry/authority/validIssuers/add/@name" />
	</parameter>
	<parameter name="RealmUrl Identity Configuration">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel.services/federationConfiguration/wsFederation/@realm" />
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel.services/federationConfiguration/wsFederation/@reply" />
	</parameter>

	<parameter name="AudienceUrl Identity Configuration">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel/identityConfiguration/audienceUris/add/@value" />
	</parameter>

	<parameter name="Thumbprint Identity Configuration">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel/identityConfiguration/issuerNameRegistry/authority/keys/add/@thumbprint" />
	</parameter>

	<parameter name="ServiciosScatoBinding Security Configuration">
		<parameterEntry kind="XmlFile" scope="Web.config"
					match="/configuration/system.serviceModel/bindings/basicHttpBinding/binding[@name='ServiciosScatoBinding']
                    /security/@mode" />
	</parameter>

	<parameter name="UrlAdfsLogoff Config">
		<parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='UrlAdfsLogoff']
                           /@value" />
	</parameter>
  <parameter name="PersistentSessionLifetime Config" defaultValue="">
    <parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel.services/federationConfiguration/cookieHandler/@persistentSessionLifetime" />
  </parameter>
		
  <!-- Agrega modulo de autenticacion por ADFS para todos los entornos desplegados-->
	<!-- <add name="WSFederationAuthenticationModule" type="Molinos.Scato.WebMobile.Seguridad.FixedWsFederationAuthenticationModule, Molinos.Scato.WebMobile" preCondition="managedHandler" /> -->
  <parameter name="WSFederationAuthenticationModule" defaultValue="&lt;add name=&quot;WSFederationAuthenticationModule&quot; type=&quot;Molinos.Scato.WebMobile.Seguridad.FixedWsFederationAuthenticationModule, Molinos.Scato.WebMobile&quot; preCondition=&quot;managedHandler&quot; /&gt;">
    <parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.webServer/modules" />
  </parameter>

  <!-- Quita el Dummy de autenticacion al desplegar -->
  <parameter name="DummyAuthenticationModule" defaultValue="0:15:0">
    <parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.webServer/modules/add[@name='DummyAuthenticationModule']" />
  </parameter>

  <!-- requireSsl -->
  <parameter name="WSFederationAuthenticationRequireSsl" defaultValue="false">
    <parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/system.identityModel.services/federationConfiguration/cookieHandler/@requireSsl" />
  </parameter>

</parameters>