			<claimsAuthenticationManager type="Molinos.Scato.WebMobile.Seguridad.ScatoClaimsAuthenticationManager, Molinos.Scato.WebMobile, Version=1.0.0.0, Culture=neutral" />
			<issuerNameRegistry type="System.IdentityModel.Tokens.ValidatingIssuerNameRegistry, System.IdentityModel.Tokens.ValidatingIssuerNameRegistry">
				<authority name="http://BFDEV271.baunet.local/adfs/services/trust">
					<keys>
						<add thumbprint="fd354e82abcbe509be84560efa1a41a4060a62a4" />
					</keys>
					<validIssuers>
						<add name="http://BFDEV271.baunet.local/adfs/services/trust" />
