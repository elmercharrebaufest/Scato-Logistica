	</runtime>
	<entityFramework>
		<defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
	</entityFramework>
	<system.serviceModel>
		<serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
		<bindings>
			<basicHttpBinding>
				<binding name="ServiciosScatoBinding" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647" useDefaultWebProxy="true">
					<security mode="None" />
				</binding>
				<binding name="CommonBinding" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="200000000" maxBufferSize="200000000" maxReceivedMessageSize="200000000" useDefaultWebProxy="true">
					<security mode="None" />
				</binding>
				<binding name="OrquestadorBinding" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="200000000" maxBufferSize="200000000" maxReceivedMessageSize="200000000" useDefaultWebProxy="true">
					<security mode="TransportCredentialOnly">
						<transport clientCredentialType="Ntlm" />
					</security>
				</binding>
			</basicHttpBinding>
		</bindings>
		<client>
			<endpoint address="http://localhost/Scato.serviciosWeb/ServicioRepositorio.svc?wsdl" binding="basicHttpBinding" bindingConfiguration="ServiciosScatoBinding" contract="Molinos.Scato.Servicios.IServicioRepositorio" name="ServicioRepositorio" />
			<endpoint address="http://localhost/Scato.serviciosWeb/ServicioComandos.svc?wsdl" binding="basicHttpBinding" bindingConfiguration="ServiciosScatoBinding" contract="Molinos.Scato.Servicios.IServicioComandos" name="ServicioComandos" />
			<endpoint address="http://localhost/Scato.workflow/ListaDeWorkflows.svc?wsdl" binding="basicHttpBinding" bindingConfiguration="ServiciosScatoBinding" contract="Molinos.Scato.Actividades.Servicios.IListaDeWorkflows" name="ListaDeWorkflows" />
			<endpoint address="http://localhost/Scato.serviciosWeb/FirmaProvider.svc?wsdl" binding="basicHttpBinding" bindingConfiguration="ServiciosScatoBinding" contract="Molinos.Scato.Servicios.IFirmaProvider" name="FirmaProvider" />
			<endpoint address="http://localhost:8080/ServicioOrquestador" binding="basicHttpBinding" bindingConfiguration="OrquestadorBinding" contract="Orquestador.IServicioOrquestador" name="Orquestador" />
		</client>
		<extensions>
			<behaviorExtensions>
				<add name="wcfProfiling" type="Molinos.Scato.WebMobile.Helpers.WcfProfiling.WcfMiniProfilerClientBehavior, Molinos.Scato.WebMobile, Version=1.0.0.0, Culture=neutral" />
				<add name="internacionalizacion" type="Molinos.Scato.Servicios.Behavior.InternacionalizacionBehavior, Molinos.Scato.Servicios, Version=1.0.0.0, Culture=neutral" />
			</behaviorExtensions>
		</extensions>
		<behaviors>
			<serviceBehaviors>
				<behavior name="">
					<serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="true" />
				</behavior>
			</serviceBehaviors>
			<endpointBehaviors>
				<behavior>
					<wcfProfiling />
					<internacionalizacion />
				</behavior>
			</endpointBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>