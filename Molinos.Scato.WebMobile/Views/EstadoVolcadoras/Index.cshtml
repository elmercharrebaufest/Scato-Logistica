@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile.Helpers;
@using Molinos.Scato.Dominio.Dto;
@using Molinos.Scato.Dominio.Enums;
@model List<LlamadoAutomaticoHidraulicaDto>

@{
    ViewBag.Title = Textos.Hidraulica_Titulo;
    Layout = "~/Views/Shared/_LayoutSinMenu.cshtml";
}

<link href="@Url.Content("~/Content/cartelesVolcables.css")" rel="stylesheet" type="text/css">
<script type="text/javascript" src="@Url.Script("~/scripts/cartelesVolcables.js")"></script>

<script>
    urlHidraulicas = '@Url.Action("EstadoDeVolcadoras", "EstadoVolcadoras")';
    urlEstado = '@Url.Action("CambiarEstado", "EstadoVolcadoras")';
</script>

<div class="tittle">
    <h5><strong>@Textos.EstadoVolcadoras_Titulo</strong></h5>
</div>

<div class="row d-flex flex-row">
    @foreach (var hidraulica in Model)
    {
        <div class="col-sm-6 col-lg-3 mb-auto p-4 text-center">
            <div class="card border-secondary">
                <div id="tiempo-@hidraulica.Id" class="card-header text-white font-weight-bold"></div>

                <div class="card-body">
                    <div class="row d-flex justify-content-center">
                        <div class="col-9 col-lg-10">
                            <h6 id="nombre-@hidraulica.Id" class="card-title mb-4 font-weight-bold"></h6>
                            <h6 id="estado-@hidraulica.Id" class="card-subtitle mb-4"></h6>
                            <h6 id="patente-@hidraulica.Id" class="card-subtitle mb-5"></h6>
                            <div class="mt-3 d-flex justify-content-between">
                                <button id="habilitado-@hidraulica.Id" disabled type="button" class="btn btn-primary"
                                onclick="OpenModal(true)">Habilitar</button>
                                <button id="deshabilitado-@hidraulica.Id" disabled type="button" class="btn btn-secondary"
                                onclick="OpenModal(false)">Deshabilitar</button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <dialog id="modalConfirmarHabilitarDeshabilitar">
            <h4>@Textos.Confirmacion</h4>
            <p>
                ¿Confirma el cambio de estado?
            </p>
            <div>
                <button type="button" id="btn-confirm" onclick="CambiarEstado('@hidraulica.Id', '@hidraulica.UltimaPatenteLlamada', '@hidraulica.HidraulicaNombre')"
                class="btn btn-warning">Confirmar</button>
                <button class="btn" onclick="modalConfirmarHabilitarDeshabilitar.close()">Cerrar</button>
            </div>
        </dialog>
    }
</div>
