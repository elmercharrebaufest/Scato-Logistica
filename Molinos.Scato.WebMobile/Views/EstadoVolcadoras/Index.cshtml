@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile.Helpers;
@using Molinos.Scato.Dominio.Dto;
@using Molinos.Scato.Dominio.Enums;
@model List<LlamadoAutomaticoHidraulicaDto>

@{
    ViewBag.Title = Textos.Hidraulica_Titulo;
    Layout = "~/Views/Shared/_LayoutSinMenu.cshtml";
}

<link href="@Url.Content("~/Content/cartelesVolcables.css")" rel="stylesheet" type="text/css">
<script type="text/javascript" src="@Url.Script("~/scripts/cartelesVolcables.js")"></script>

<script>
    urlHidraulicas = '@Url.Action("EstadoDeVolcadoras", "EstadoVolcadoras")';
    urlEstado = '@Url.Action("CambiarEstado", "EstadoVolcadoras")';
</script>

<div class="hidraulicas">
    <h5 class="hidraulicas__tittle"><strong>@Textos.EstadoVolcadoras_Titulo</strong></h5>

    <div class="hidraulicas__container">
        @foreach (var hidraulica in Model)
        {
            <div class="hidraulica">
                <div id="tiempo-@hidraulica.Id" class="hidraulica__tiempo"></div>
                <h6 id="nombre-@hidraulica.Id" class="hidraulica__nombre"></h6>
                <h6 id="estado-@hidraulica.Id"></h6>
                <h6 id="patente-@hidraulica.Id"></h6>
                <div class="hidraulica__buttons">
                    <button id="habilitado-@hidraulica.Id"
                            disabled type="button"
                            class="btn btn-primary"
                            onclick="OpenModal(true, '@hidraulica.Id')">
                        Habilitar
                    </button>
                    <button id="deshabilitado-@hidraulica.Id"
                            disabled type="button"
                            class="btn btn-secondary"
                            onclick="OpenModal(false, '@hidraulica.Id')">
                        Deshabilitar
                    </button>
                </div>
            </div>

            <dialog id="modalConfirmarHabilitarDeshabilitar-@hidraulica.Id">
                <h4>@Textos.Confirmacion</h4>
                <p>
                    ¿Confirma el cambio de estado?
                </p>
                <div>
                    <button type="button" id="btn-confirm" onclick="CambiarEstado('@hidraulica.Id', '@hidraulica.HidraulicaNombre')"
                            class="btn btn-warning">
                        Confirmar
                    </button>
                    <button class="btn" onclick="modalConfirmarHabilitarDeshabilitar.close()">Cerrar</button>
                </div>
            </dialog>
        }
    </div>
</div>
