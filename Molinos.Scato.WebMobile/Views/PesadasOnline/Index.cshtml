@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile.Helpers
@model Molinos.Scato.WebMobile.ViewModel.PesadaOnlineViewModel
@{
    ViewBag.Title = Textos.AFIP_MenuTitulo_PesadasOnline;
    Layout = "~/Views/Shared/_LayoutPesadas.cshtml";
}



<div class="mx-1">
    <div style="text-align:center">
        <h1 class="titulo-center">@ViewBag.Title</h1>
    </div>
    <br />
    <div class="col-12">
        @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
        {
            <!-- Bootstrap 5 uses "d-flex" for flex utilities -->
            <div class="d-flex flex-column align-items-center form-inline"> 
                @Html.Label(@Textos.AFIP_PesadaOnline_FechaInicio)
                <div class="input-group date mb-2 disabled" readonly disabled="disabled">
                    <!-- Added "form-control" for the date input -->
                    @Html.TextBoxFor(model => model.DateNow, Model != null ? Model.DateNow.FormattedFixed() : string.Empty, new { @class = "form-control", @readonly = "readonly", aria_label = "Fecha" })
                </div>
                
                @Html.Label(@Textos.AFIP_PesadaOnline_HoraInicio)
                <div class="input-group mb-2">
                    @Html.EditorFor(model => model.BeginTime, new { htmlAttributes = new { @class = "form-control", aria_label = "Hora Inicio" } })
                </div>
                
                @Html.Label(@Textos.AFIP_PesadaOnline_HoraFin)
                <div class="input-group mb-2">
                    @Html.EditorFor(model => model.EndTime, new { htmlAttributes = new { @class = "form-control", aria_label = "Hora Fin" } })
                </div>
                
                <div class="input-group">
                    <input class="btn btn-outline-success col-12" value="@Textos.Aceptar" type="submit" />
                </div>
            </div>
        }
        <div class="mt-1" id="gridContainer">
            @Html.Partial("Listar")
        </div>
    </div>
</div>

<script type="text/javascript" src="@Url.Script("~/scripts/_timePickerRangeValidator.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/bloquearPantalla.js")"></script>
