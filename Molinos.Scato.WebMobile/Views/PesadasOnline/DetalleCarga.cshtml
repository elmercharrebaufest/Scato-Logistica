@using Molinos.Scato.WebMobile.Helpers
@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Dto
@{
    /**/

    ViewBag.Title = "Detalle de Carga";
    Layout = "~/Views/Shared/_LayoutPesadas.cshtml";

}

<div class="container-fluid">
    <div class="content form">
        <div>
            <h1 class="titulo-center">@ViewBag.Title</h1>
        </div>
        <br />
        <div id="lista">
            @Html.Partial("DetalleCargaListar")
        </div>
        <div class="d-flex justify-content-end">
            <!-- Actualización de botón para compatibilidad con Bootstrap 5 -->
            <a href="javascript:void(0);" onclick="history.go(-1);" class="ajax-editar-link btn btn-success" id="backLink">Volver</a>
        </div>
    </div>
</div>