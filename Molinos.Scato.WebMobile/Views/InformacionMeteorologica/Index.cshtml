@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Servicios.Orquestador;

@{
    ViewBag.Title = Textos.AFIP_MenuTitulo_InformacionMeteorologica;
    Layout = "~/Views/Shared/_LayoutPesadas.cshtml";
}

<div class="col-12">
<h1 class="titulo-center">@ViewBag.Title</h1>
</div>
<div id="informacionMeteorologica" class="row justify-content-center">
    <div class="span12">
        @if (ViewBag.Error != null)
        {
            <div id="resultado-peso" class="span10 resultado-prueba">
                @ViewBag.Error
            </div>
        }
        else
        {
            <div class="well">
                <div id="myCarousel">
                    <!-- Carousel items -->
                    <div>
                        @{
                            int count = 0;
                            foreach (var grupo in (MeteorologicaDto[])ViewBag.datos.Imagenes)
                            {
                                string clase = "";
                                if (count == 0)
                                {
                                    clase = "active";
                                }
                                //cambiar font y color y no se que mas
                                <div class="item @clase">
                                    <div class="row-fluid">
                                        <table border="1" cellpadding="5" style='font-family: "Segoe UI", Verdana, Helvetica, Sans-Serif;color:rgb(36,66,50);text-align:center;'>
                                            <thead>
                                                <tr>
                                                    <th colspan="100%" class="text-light panel-superminigreen">@grupo.Descripcion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <col width="350">
                                                <col width="600">
                                                <tr>
                                                    <td id="tabla" style="padding:0px;vertical-align: top;">
                                                        <table class="table table-striped table-bordered" style="width: 350px;margin:auto;">

                                                            @if (grupo.Descripcion == "HUMEDAD" || grupo.Descripcion == "TEMPERATURA")
                                                            {
                                                                for (int i = 0; i < grupo.Detalle.Length; i += 3)
                                                                {
                                                                    <tbody>
                                                                        <tr>
                                                                            <td style="font-weight:bold">@grupo.Detalle[i]</td>
                                                                            @if (i == 0)
                                                                            {
                                                                                <td colspan="2">@grupo.Detalle[i + 1]</td>
                                                                            }
                                                                            else if (i == 3)
                                                                            {
                                                                                <td style="font-weight:bold">@grupo.Detalle[i + 1]</td>
                                                                                <td style="font-weight:bold">@grupo.Detalle[i + 2]</td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td>@grupo.Detalle[i + 1]</td>
                                                                                <td>@grupo.Detalle[i + 2]</td>
                                                                            }
                                                                        </tr>
                                                                    </tbody>
                                                                }
                                                            }
                                                            else if (grupo.Descripcion == "LLUVIA")
                                                            {
                                                                for (int i = 0; i < grupo.Detalle.Length; i += 2)
                                                                {
                                                                    <tbody>
                                                                        <tr>
                                                                            <td style="font-weight:bold">@grupo.Detalle[i]</td>
                                                                            <td>@grupo.Detalle[i + 1]</td>
                                                                        </tr>
                                                                    </tbody>
                                                                }
                                                            }
                                                            else if (grupo.Descripcion == "VIENTO")
                                                            {
                                                                for (int i = 0; i < grupo.Detalle.Length; i += 2)
                                                                {
                                                                    <tbody>
                                                                        <tr>
                                                                            <td style="font-weight:bold">@grupo.Detalle[i]</td>
                                                                            @if (i == 4)
                                                                            {
                                                                                <td style="font-weight:bold">@grupo.Detalle[i + 1]</td>

                                                                            }
                                                                            else
                                                                            {
                                                                                <td>@grupo.Detalle[i + 1]</td>
                                                                            }
                                                                        </tr>
                                                                    </tbody>
                                                                }
                                                            }
                                                            else if (grupo.Descripcion == "SENSACION TERMICA")
                                                            {
                                                                for (int i = 0; i < grupo.Detalle.Length; i += 3)
                                                                {
                                                                    <thead>
                                                                        <tr>
                                                                            <th colspan="2">@grupo.Detalle[i]</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        <tr>
                                                                            <td style="font-weight:bold">@grupo.Detalle[i + 1]</td>
                                                                            <td>@grupo.Detalle[i + 2]</td>
                                                                        </tr>
                                                                    </tbody>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <tbody>
                                                                    <tr>
                                                                        <td style="font-weight:bold">@grupo.Detalle[0]</td>
                                                                        <td>@grupo.Detalle[1]</td>
                                                                    </tr>
                                                                </tbody>
                                                            }
                                                        </table>
                                                    </td>
                                                    <td id="imagenes" class="d-none d-sm-block">
                                                        <div>
                                                            @foreach (var imagen in grupo.Imagenes)
                                                            {
                                                                <img src="data:image;base64,@System.Convert.ToBase64String(@imagen)" alt="Image" id="imagen-camara" class="imagen-camara" style="padding:20px;margin:auto;" />
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div><!--/row-fluid-->
                                </div><!--/item-->
                                count++;
                            }
                        }

                    </div>
                </div>

            </div>
        }
    </div>
</div>
