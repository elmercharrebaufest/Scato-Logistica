@model CalleViewModel
@using Molinos.Scato.WebMobile.ViewModel
@using Molinos.Scato.Dominio.Recursos

<div class="modal fade" id="modalModificarPreBalanza" tabindex="-1" aria-labelledby="modalModificarPreBalanzaLabel" aria-hidden="true">
    <!-- Removed role="dialog" and aria-hidden is added for better accessibility. Bootstrap 5 no longer requires the role attribute here. -->
    
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- Removed role="document" as it's no longer required in Bootstrap 5. -->

        @using (Ajax.BeginForm("ModificarConfiguracionCallePB", null, new AjaxOptions { OnSuccess = "modificarCallePBSuccess" }, new { @class = "container" }))
        {
            <div class="modal-content">
                @Html.HiddenFor(model => model.Id)

                <div class="modal-header">
                    <h5 class="modal-title" id="modalModificarPreBalanzaLabel">Modificar Calle Pre-Balanza</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    <!-- Updated close button: Replaced old `close` class with `btn-close`, and removed the inner &times; as it is now handled by Bootstrap 5. Also changed data-dismiss to data-bs-dismiss. -->
                </div>

                <div class="modal-body">
                    <div class="container">
                        <div class="mb-3 row">
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.Descripcion)
                                @Html.TextBoxFor(model => model.Descripcion, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Descripcion)
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.Camiones)
                                @Html.TextBoxFor(model => model.Camiones, new { @class = "form-control", type = "number", min = "0", step = "1" })
                                @Html.ValidationMessageFor(model => model.Camiones)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Textos.Cancelar</button>
                    <!-- Changed data-dismiss to data-bs-dismiss for Bootstrap 5 compatibility. -->
                    <button type="submit" class="btn btn-success">@Textos.Aceptar</button>
                </div>
            </div>
        }
    </div>
</div>
