@model AutomatismoGranosViewModel
@using Molinos.Scato.WebMobile.ViewModel
@using Molinos.Scato.Dominio.Recursos
@using System.Web.Optimization

<div class="modal fade" id="modalModificarAutomatismo" tabindex="-1" aria-labelledby="modalModificarAutomatismoLabel" aria-hidden="true">
    <!-- Removed role="dialog" and aria-hidden added for better accessibility. Bootstrap 5 no longer requires the role attribute here. -->
    
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- Removed role="document" as it's no longer required in Bootstrap 5. -->

        @using (Ajax.BeginForm("Modificar", null, new AjaxOptions { OnSuccess = "modificarSuccess" }, new { @class = "container" }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalModificarAutomatismoLabel">Modificar Automatismo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    <!-- Updated close button: Replaced old `close` class with `btn-close`, and removed the inner &times; as it is now handled by Bootstrap 5. Also changed data-dismiss to data-bs-dismiss. -->
                </div>

                <div class="modal-body">
                    @Html.HiddenFor(m => m.AutomatismoGrano.Id)
                    @Html.HiddenFor(m => m.AutomatismoGrano.Activo)
                    <div class="mb-3 row mt-4">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.AutomatismoGrano.MaterialId)
                            @Html.DropDownListFor(m => m.AutomatismoGrano.MaterialId, Model.Materiales, new { @class = "form-control", disabled = true, id = "cboxMateriales", data_url = @Url.Action("ListarVariedades", "TableroComandoLogistica") })
                            @Html.ValidationMessageFor(m => m.AutomatismoGrano.MaterialId)
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.AutomatismoGrano.TipoVariedades)
                            @Html.DropDownListFor(m => m.AutomatismoGrano.TipoVariedades, Model.Variedades, new { @class = "form-control multiselect", disabled = true, multiple = "multiple" })
                            @Html.ValidationMessageFor(m => m.AutomatismoGrano.TipoVariedades)
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.CheckBoxFor(m => m.AutomatismoGrano.CamionEscalable, new { @class = "esEscalableCheck" })
                        @Html.LabelFor(m => m.AutomatismoGrano.CamionEscalable)
                        @Html.ValidationMessageFor(m => m.AutomatismoGrano.CamionEscalable)
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.AutomatismoGrano.CallePreBalanzaId)
                        @Html.DropDownListFor(m => m.AutomatismoGrano.CallePreBalanzaId, Model.CallesPreBalanza, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AutomatismoGrano.CallePreBalanzaId)
                    </div>

                    <div class="form-group">
                        @Html.CheckBoxFor(m => m.AutomatismoGrano.AplicaFiltroCalidad)
                        @Html.LabelFor(m => m.AutomatismoGrano.AplicaFiltroCalidad)
                        @Html.ValidationMessageFor(m => m.AutomatismoGrano.AplicaFiltroCalidad)
                    </div>

                    <div id="divCalidad" style="display:none" class="form-group">
                        @Html.LabelFor(m => m.AutomatismoGrano.CalidadId)
                        @Html.DropDownListFor(m => m.AutomatismoGrano.CalidadId, Model.Calidades, new { @class = "form-control", data_val_required = "El campo 'Calidad' es requerido." })
                        @Html.ValidationMessageFor(m => m.AutomatismoGrano.CalidadId)

                        <div class="mb-3 row mt-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.AutomatismoGrano.Minimo)
                                @Html.TextBox("AutomatismoGrano.Minimo", 
                                    Model.AutomatismoGrano.Minimo.HasValue ? Model.AutomatismoGrano.Minimo.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "", 
                                    new { @class = "form-control decimal-input", placeholder = "Ej: 11.44", data_val_required = "El campo 'Minimo' es requerido." })
                                @Html.ValidationMessageFor(m => m.AutomatismoGrano.Minimo)
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.AutomatismoGrano.Maximo)
                                @Html.TextBox("AutomatismoGrano.Maximo", 
                                    Model.AutomatismoGrano.Maximo.HasValue ? Model.AutomatismoGrano.Maximo.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "", 
                                    new { @class = "form-control decimal-input", placeholder = "Ej: 11.44", data_val_required = "El campo 'Maximo' es requerido." })
                                @Html.ValidationMessageFor(m => m.AutomatismoGrano.Maximo)
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.AutomatismoGrano.CallePreHidraulicaId)
                        @Html.DropDownListFor(m => m.AutomatismoGrano.CallePreHidraulicaId, Model.CallesHidraulica, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AutomatismoGrano.CallePreHidraulicaId)
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.AutomatismoGrano.Hidraulicas)
                        @Html.DropDownListFor(m => m.AutomatismoGrano.Hidraulicas, Model.Hidraulicas, new { @class = "form-control multiselect", multiple = "multiple" })
                        @Html.ValidationMessageFor(m => m.AutomatismoGrano.Hidraulicas)
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.AutomatismoGrano.AlmacenId)
                        @Html.DropDownListFor(m => m.AutomatismoGrano.AlmacenId, Model.Almacenes, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AutomatismoGrano.AlmacenId)
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Textos.Cancelar</button>
                    <!-- Changed data-dismiss to data-bs-dismiss for Bootstrap 5 compatibility. -->
                    <button type="submit" class="btn btn-success">@Textos.Aceptar</button>
                </div>
            </div>
        }
    </div>
</div>

@Scripts.Render("~/bundles/jqueryval")@Scripts.Render("~/bundles/jqueryval")