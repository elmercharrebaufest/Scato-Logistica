@using System.Web.Optimization
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile
@using Molinos.Scato.WebMobile.Helpers
@using StackExchange.Profiling

@{
    var mensaje = (string)TempData["Alerta"];
    var tipoMensaje = TempData["TipoAlerta"] as TipoAlerta?;
    var clase = string.IsNullOrEmpty(mensaje) ? "hide" : string.Empty;
    var mensajeAplicacion = (string)TempData["MensajeAplicacion"];

    if (tipoMensaje != null)
    {
        switch (tipoMensaje)
        {
            case TipoAlerta.Exito:
                clase = "alert alert-success";
                break;
            case TipoAlerta.Advertencia:
                clase = "alert alert-warning";
                break;
            case TipoAlerta.Error:
                clase = "alert alert-error";
                break;
            case TipoAlerta.Informacion:
                clase = "alert alert-info";
                break;
        }
    }
}

<!DOCTYPE html>
<html>
<head>

    <!-- link rel manifest -->
    <link rel="manifest" href="./manifest.json" crossorigin="use-credentials">
    <!--  iOS meta tags and icons -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-title" content="Scato App Mobile">
    <link rel="apple-touch-icon" href="./images/icons/icon-152x152.png">
    <!-- description  -->
    <meta name="description" content="Scato App Mobile">
    <meta name="theme-color" content="#059a0f" />
    <meta name="viewport" content="width=device-width,	initial-scale=1,	shrink-to-fit=no ,
          maximum-scale=1, user-scalable=no">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="@Html.Action("Favicon","Index")" type="image/x-icon" />
    <link rel="apple-touch-icon" src="@Html.Action("Favicon","Index")">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/bootstrap")
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/themes/base/css")

    @RenderSection("content", required: false)

    <script>
        var loadingGift = "@Url.Content("~/Content/Images/loading.gif")";
    </script>
    @Scripts.Render("~/bundles/jquery-common")
    @Scripts.Render("~/bundles/bootstrap")


    <link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/mensajeria.css")">

    <script src="@Url.Script("~/Scripts/scatocommon.js")" type="text/javascript"></script>
    @RenderSection("scripts", required: false)
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EDDB8K231H"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-EDDB8K231H');
    </script>
</head>
<body id="body">
    <div class="container-fluid">
        <div id="alertaError" data-mensaje="@Textos.Error_Generico"
             class="alert alert-error fade-message hide-message centro-pantalla alerta-box">
            <a class="close" onClick="$('#alertaError').addClass('d-none')">×</a>
            <span></span>
        </div>
        <div id="alertaAdvertencia" data-mensaje="@Textos.Error_Generico"
             class="alert alert-warning fade-message hide-message centro-pantalla alerta-box">
            <a class="close" onClick="$('#alertaAdvertencia').addClass('d-none')">×</a>
            <span></span>
        </div>
        <div id="alertaExitosa" class="alert alert-success fade-message hide-message centro-pantalla alerta-box">
            <span>@Textos.Exito_Generico</span>
        </div>
        <div id="alertaInfo" class="alert alert-info fade-message hide-message centro-pantalla alerta-box">
            <span>@Textos.Exito_Generico</span>
        </div>
        <div id="alertaCancelada" class="alert alert-success fade-message hide-message  centro-pantalla alerta-box">
            <span>@Textos.CanceladoExitoso_Generico</span>
        </div>

        <div class="alert alert-warning hide-message" id="alertaFija" role="alert">
            <i class="icon-warning-sign"></i>
            <span id="alertaFija-span">@mensajeAplicacion</span>
        </div>
        @RenderBody()
    </div>
</body>
</html>
