@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@model List<EstadoMaterialDto>
@{
    var centros = (List<CentroDto>)ViewBag.Centros;
    var centroDescripcion = ViewBag.Centro;
}
<link href="~/Content/menu.css" rel="stylesheet" />

<script type="text/javascript" src="@Url.Content("~/scripts/_menu.js")"></script>

<nav class="navbar navbar-menu navbar-light bg-light" style="gap: 1rem;">
    <div class="dropdown">
        <button class="navbar-toggler " type="button" data-toggle="dropdown" aria-expanded="false">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="dropdown-menu dropdown-menu-scato-mobile">
            @if (ViewBag.IsIndexPage)
            {
                <p class="font-weight-bold ml-2"><u>@Textos.AccesosUtiles</u></p>
                <a href="https://scatopuerto.molinosagro.com.ar/Scato.WebPuerto/login" target="_blank" class="dropdown-item">@Textos.ScatoPuerto</a>
            }
            else
            {
                @Html.ActionLink(Textos.GestionDePlayaInterna_Titulo, "Index", "EstadoPlayaInterna", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.GestionDePlayaExterna_Titulo, "Index", "EstadoDeCalle", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.GraficoDePlanta_Titulo, "Index", "GraficoDePlanta", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.TableroLogisticaAutomatismo_Titulo, "Index", "TableroComandoLogistica", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.TableroPuertoAutomatismo_Titulo, "Index", "TableroComandoPuerto", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.TituloVolcadoras, "Index", "EstadoVolcadoras", null, new { @class = "dropdown-item" })
            }
        </div>
    </div>
    <div class="d-flex align-items-center" style="gap: 1rem; flex: 1; justify-content: end;">
        <a id="logomolinos" href="@Url.Action("Index", "Index")">
            <img alt="Molinos" src="@Url.Action("Logo", "Index")" id="logoMolinos" style="width:100%;">
        </a>
        <a href="@Url.Action("SignOut", "Usuario")">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: rgba(0, 0, 0, 1);"><path d="M16 13v-2H7V8l-5 4 5 4v-3z"></path><path d="M20 3h-9c-1.103 0-2 .897-2 2v4h2V5h9v14h-9v-4H9v4c0 1.103.897 2 2 2h9c1.103 0 2-.897 2-2V5c0-1.103-.897-2-2-2z"></path></svg>
        </a>
    </div>
</nav>