@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile.Helpers
@model List<EstadoMaterialDto>
@{
    var centros = (List<CentroDto>)ViewBag.Centros;
    var centroDescripcion = ViewBag.Centro;
}
<link href="~/Content/menu.css" rel="stylesheet" />

<script type="text/javascript">
    var menu = "@Url.Action("GraficoDePlantaHead", "Menu")"
</script>

<script type="text/javascript" src="@Url.Content("~/scripts/_menu.js")"></script>



<nav class="navbar navbar-menu navbar-expand-lg navbar-light bg-light">

    <a class="navbar-brand " id="logomolinos" href="@Url.Action("Index", "Index")" sstyle="width: 100%;">
        <img alt="Molinos" src="@Url.Action("Logo", "Index")" class="img-responsive menu-centrado" id="logoMolinos" style="width:100%;">
    </a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav ml-auto">

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    @centroDescripcion
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    @foreach (var centro in centros)
                    {
                        <a>@Html.ActionLink(centro.Descripcion, "SeleccionarCentro", "Menu", new { centroId = centro.Id }, new { @class = "dropdown-item" })</a>
                    }
                </div>

            </li>
        </ul>
    </div>
    <div class="ingresoEgreso">
        <input id="mostrarIngresos" type="checkbox" checked data-toggle="toggle" data-on="Ingresos" data-off="Egresos" data-onstyle="success" data-offstyle="success">
        <input id="esGrano" type="checkbox" checked data-toggle="toggle" data-on="Granos" data-off="No Granos" data-onstyle="success" data-offstyle="success">
    </div>
</nav>

<div>
    <div id="panel">
        @Html.Partial("_GraficoDePlantaHead", Model)
    </div>

</div>
