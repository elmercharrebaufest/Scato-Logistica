@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@model List<EstadoMaterialDto>
@{
    var centros = (List<CentroDto>)ViewBag.Centros;
    var centroDescripcion = ViewBag.Centro;
}
<link href="~/Content/menu.css" rel="stylesheet" />

<script type="text/javascript" src="@Url.Content("~/scripts/_menu.js")"></script>

<nav class="navbar navbar-menu navbar-light bg-light p-2" style="gap: 1rem;">
    <div class="dropdown">
        <!-- Changed aria-expanded="false" instead of data-bs-expanded -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-expanded="false">
            <span class="navbar-toggler-icon"></span>
        </button>
        <!-- Collapsible content should be wrapped correctly -->
        <div class="collapse navbar-collapse dropdown-menu dropdown-menu-scato-mobile" id="navbarSupportedContent">
            @if (ViewBag.IsIndexPage)
            {
                <!-- Bootstrap 5 now uses fw-bold instead of font-weight-bold -->
                <p class="fw-bold ml-2"><u>@Textos.AccesosUtiles</u></p>
                <a href="https://scatopuerto.molinosagro.com.ar/Scato.WebPuerto/login" target="_blank" class="dropdown-item">@Textos.ScatoPuerto</a>
            }
            else
            {
                @Html.ActionLink(Textos.GestionDePlayaInterna_Titulo, "Index", "EstadoPlayaInterna", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.GestionDePlayaExterna_Titulo, "Index", "EstadoDeCalle", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.GraficoDePlanta_Titulo, "Index", "GraficoDePlanta", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.TableroLogisticaAutomatismo_Titulo, "Index", "TableroComandoLogistica", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.TableroPuertoAutomatismo_Titulo, "Index", "TableroComandoPuerto", null, new { @class = "dropdown-item" })
                @Html.ActionLink(Textos.TituloVolcadoras, "Index", "EstadoVolcadoras", null, new { @class = "dropdown-item" })
            }
        </div>
    </div>

    <!-- Ensure alignment of logo and sign-out button -->
    <div class="d-flex align-items-center" style="gap: 1rem; flex: 1; justify-content: end;">
        <a id="logomolinos" href="@Url.Action("Index", "Index")">
            <img alt="Molinos" src="@Url.Action("Logo", "Index")" id="logoMolinos" style="width:100%;">
        </a>
        <a href="@Url.Action("SignOut", "Usuario")">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: rgba(0, 0, 0, 1);">
                <path d="M16 13v-2H7V8l-5 4 5 4v-3z"></path>
                <path d="M20 3h-9c-1.103 0-2 .897-2 2v4h2V5h9v14h-9v-4H9v4c0 1.103.897 2 2 2h9c1.103 0 2-.897 2-2V5c0-1.103-.897-2-2-2z"></path>
            </svg>
        </a>
    </div>
</nav>

<!-- Add this script to close the menu when clicked outside -->
<script>
    // Close the navbar when clicking outside of it
    document.addEventListener('click', function (event) {
        var navbarMenu = document.getElementById('navbarSupportedContent');
        var toggleButton = document.querySelector('.navbar-toggler');

        // If the clicked element is outside the navbar or the toggle button, close the menu
        if (!navbarMenu.contains(event.target) && !toggleButton.contains(event.target)) {
            var collapseInstance = new bootstrap.Collapse(navbarMenu, { toggle: false });
            collapseInstance.hide(); // Manually hide the menu
        }
    });
</script>