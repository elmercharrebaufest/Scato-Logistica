@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.WebMobile.Helpers
@using Molinos.Scato.Dominio.Helpers;
@model List<TipoCallePlantaDto>
@{
    ViewBag.Title = Textos.EstadoDeCallePlayaInterna;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/estadoDeCalle.css")">
<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/estadoPlayaInterna.css")">
<script type="text/javascript" src="~/Scripts/estadoPlayaInterna.js"></script>

<script>
    urlEstadoDeCalles = '@Url.Action("ObtenerCalles", "EstadoPlayaInterna")';
    urlMostrarDetalleCamion = '@Url.Action("MostrarDetalleCamion", "EstadoPlayaInterna")';
    urlConfirmarCargaDescarga = '@Url.Action("ConfirmarCargaDescarga", "EstadoPlayaInterna")';
    urlLlamarFilaPrebalanza = '@Url.Action("LlamarCallePrebalanza", "EstadoPlayaInterna")';
    urlLiberarFilaPrebalanza = '@Url.Action("LiberarCallePrebalanza", "EstadoPlayaInterna")';
    urlMostrarDetalleCalle = '@Url.Action("MostrarDetalleCalle", "EstadoPlayaInterna")';
</script>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" id="tabPlayaInternaGranos">
        <a class="nav-link tabPanelEstadoPlayaInterna active" id="playaInterna-tab" data-calle="playaInterna" data-bs-toggle="tab" href="#playaInterna" role="tab" aria-controls="playaInterna" aria-selected="true">Granos</a> <!-- Updated data-toggle to data-bs-toggle and aria-selected to true -->
    </li>
    <li class="nav-item" id="tabPlayaInternaNoGranos">
        <a class="nav-link tabPanelEstadoPlayaInterna" id="plantaNoGranos-tab" data-calle="plantaNoGranos" data-bs-toggle="tab" href="#plantaNoGranos" role="tab" aria-controls="plantaNoGranos" aria-selected="false">No Granos</a> <!-- Updated data-toggle to data-bs-toggle -->
    </li>
</ul>
<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="playaInterna" role="tabpanel" aria-labelledby="playaInterna-tab">
        @Html.Partial("_CallesGranos", Model)
    </div>
    <div class="tab-pane fade" id="plantaNoGranos" role="tabpanel" aria-labelledby="plantaNoGranos-tab">
        @Html.Partial("_CallesNoGranos", Model)
    </div>
</div>
<div id="detalleCamion"></div>
<div id="detalleCalle"></div>
