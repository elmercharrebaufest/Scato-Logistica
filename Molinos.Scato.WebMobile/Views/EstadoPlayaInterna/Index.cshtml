@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.WebMobile.Helpers
@using System.Web.Optimization
@using Molinos.Scato.Dominio.Helpers;
@using Molinos.Scato.WebMobile.Seguridad
@using Molinos.Scato.Dominio.Seguridad
@model IList<CalleDto>
@{
    ViewBag.Title = Textos.EstadoDeCallePlayaInterna;
    Layout = "~/Views/Shared/_LayoutSinMenu.cshtml";
    var pestanias = new[] { TipoCalle.PlayaInterna, TipoCalle.PlantaNoGranos };
}
<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/estadoDeCalle.css")">

<script>
    urlEstadoDeCalles = '@Url.Action("EstadoDeCalle", "EstadoPlayaInterna")';
    callesJson = '@Html.Raw(Model.ToJson())';
    urlMostrarDetalleCamion = '@Url.Action("MostrarDetalleCamion", "EstadoPlayaInterna")';
</script>
<script type="text/javascript" src="~/Scripts/estadoPlayaInterna.js"></script>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" data-bind="click: Recalcular">
        <a class="nav-link active" id="playaInterna-tab" data-calle="playaInterna" data-toggle="tab" href="#playaInterna" role="tab" aria-controls="playaInterna" aria-selected="false">Granos</a>
    </li>
    <li class="nav-item" data-bind="click: Recalcular">
        <a class="nav-link" id="plantaNoGranos-tab" data-calle="plantaNoGranos" data-toggle="tab" href="#plantaNoGranos" role="tab" aria-controls="plantaNoGranos" aria-selected="false">No Granos</a>
    </li>
</ul>
<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="playaInterna" role="tabpanel" aria-labelledby="playaInterna-tab">
        @Html.Partial("Calles", TipoCalle.PlayaInterna)
    </div>
    <div class="tab-pane fade show" id="plantaNoGranos" role="tabpanel" aria-labelledby="plantaNoGranos-tab">
        @Html.Partial("Calles", TipoCalle.PlantaNoGranos)
    </div>
</div>
<div id="div-rechazo-mover"></div>
