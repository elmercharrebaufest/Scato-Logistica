@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.WebMobile.Helpers
@using System.Web.Optimization
@using Molinos.Scato.Dominio.Helpers;
@using Molinos.Scato.WebMobile.Seguridad
@using Molinos.Scato.Dominio.Seguridad
@model IList<CalleDto>
@{
    ViewBag.Title = Textos.EstadoDeCallePlayaInterna;
    Layout = "~/Views/Shared/_LayoutSinMenu.cshtml";
}
<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/estadoDeCalle.css")">

<script>
    urlEstadoDeCalles = '@Url.Action("EstadoDeCalle", "EstadoDeCalle")';
    callesJson = '@Html.Raw(Model.ToJson())';
    urlLLamarCalle = '@Url.Action("LlamarCalle", "EstadoDeCalle")';
    urlCancelarLLamarCalle = '@Url.Action("CancelarLlamarCalle", "EstadoDeCalle")';
    urlLLamarSiguienteCalle = '@Url.Action("LLamarSiguienteCalle", "EstadoDeCalle")';
    urlLLamadoAutomaticoCalle = '@Url.Action("LLamadoAutomaticoCalle", "EstadoDeCalle")';
    loadingGift = "@Url.Content("~/Content/Images/loading.gif")";
    urlMoverRechazado = '@Url.Action("MoverRechazado", "EstadoDeCalle")';
    @*urlConfirmarRechazado = '@Url.Action("ConfirmarRechazado", "EstadoDeCalle")';*@
</script>
<script type="text/javascript" src="~/Scripts/estadoPlayaInterna.js"></script>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" data-bind="click: Recalcular">
        <a class="nav-link active" id="playaInterna-tab" data-calle="playaInterna" data-toggle="tab" href="#playaInterna" role="tab" aria-controls="playaInterna" aria-selected="false">@TipoCalle.PlayaInterna.DisplayEnum()</a>
    </li>
</ul>
<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="playaInterna" role="tabpanel" aria-labelledby="playaInterna-tab">
        @Html.Partial("Calles", TipoCalle.PlayaInterna)
    </div>
</div>
<div id="div-rechazo-mover"></div>
