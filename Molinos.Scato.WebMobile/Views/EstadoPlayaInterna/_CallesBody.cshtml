<div class="content">
    <div class="container-fluid">
        <div class="row callesfiltradas" data-bind="foreach: Calles, css: {'centrarCalles' : Calles.length <= 5}">
            <div class="col" style="min-width:14ch!important; max-width:20ch!important">
                <div class="sinbordetb row row-card-no-pd" data-bind="css: { 'bg-calle-llena': Camiones.length - LimiteDeCamiones > 0}">
                    <div class="col sinbordetb">
                        <div class="card card-stats sinbordetb">
                            <div class="card-body sinbordetb">
                                <div class="row fw-bold mb-0 cart-title sinbordetb">
                                    <div class="col">
                                        <span style="width: 100%; height: 28.5px;" class="btn btn-success btn-sm calle"><strong data-bind="text: $root.TiempoEnCola($data)"></strong></span>
                                    </div>
                                </div>
                                <p class="fw-bold mb-0 cart-title sinbordetb" data-bind="style: { 'background-color': Color }" style="color:#fff;">
                                    <strong data-bind="text: CalleDesc"></strong>
                                    <small style="float: right;position:absolute" data-bind="text: Camiones.length + '/' + LimiteDeCamiones"></small>
                                </p>
                                <div class="row borde-grafico" data-bind="css: { 'bg-success': Bloqueada }">
                                    <div class="col" data-bind="foreach: Camiones">
                                        <div data-bind="style: { 'background-color': Color }" class="card text-white" style="max-width: 100%; padding-top:4px; padding-bottom:4px; color:#fff;">
                                            <div class="card-header text-center" style="padding: 0px; height: 18px;">
                                                <i data-bind="attr: {'class': obtenerClaseIcono(Rechazado, Calidad)}"></i>
                                                <strong data-bind="text: Patente, click: abrirModal"></strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>    
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>