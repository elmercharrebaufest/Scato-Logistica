<div class="content">
    <div class="container-fluid" >
        <div class="row callesfiltradas" data-bind="foreach: Calles, css: {'centrarCalles' : Calles().length <= 5}" style="margin-right: -10px; margin-left: -10px;">
            <div class="col-borde" style="min-width:18ch!important; max-width:20ch!important; margin:0px;" data-bind="css: { 'bg-primero': EsPrimero, 'bg-ultimo': EsUltimo, 'color-fondo': !EsPrimero && !EsUltimo}">
                <div class="sinbordetb row row-card-no-pd"  data-bind="css: { 'bg-calle-llena': Camiones.length - LimiteDeCamiones > 0}">
                    <div class="col sinbordetb-borde">
                        <div class="card card-stats sinbordetb">
                            <div class="card-body sinbordetb-borde">
                                <div class="row fw-bold mb-0 cart-title sinbordetb">
                                    <div class="col">
                                        <button disabled style="width: 100%; height: 28.5px;" class="btn btn-success btn-sm calle"><strong data-bind="text: $root.TiempoEnCola($data)"></strong></button>
                                    </div>
                                </div>
                                <p class="fw-bold mb-0 cart-title sinbordetb px-1" data-bind="style: { 'background-color': ColorFondo, 'color': ColorTexto }">
                                    <strong data-bind="text: CalleDesc"></strong>
                                    <sup data-bind="text: Camiones.length + '/' + LimiteDeCamiones"></sup>
                                </p>
                                <div class="row-borde borde-grafico color-fondo" data-bind="css: { 'bg-success': Bloqueada && Camiones.length > 0 }">
                                    <div class="col">
                                        <div data-bind="foreach: Camiones">
                                            <div data-bind="style: { 'background-color': ColorFondo, 'color': ColorTexto }" class="card" style="max-width: 100%; padding-top:4px; padding-bottom:4px;">
                                                <div class="card-header" style="display:flex; justify-content:center; gap: 5px; align-items:center; padding: 0 0.5rem;  cursor:pointer;" data-bind="click: abrirModal">
                                                    <i data-bind="attr: {'class': obtenerClaseEscalable(Escalable)}"></i>
                                                    <i data-bind="attr: {'class': obtenerClaseIcono(Rechazado, Calidad)}"></i>
                                                    <strong data-bind="text: Patente"></strong>
                                                </div>
                                            </div>
                                        </div>
                                        <div data-bind="foreach: new Array((LimiteDeCamiones - Camiones.length) < 0 ? 0 : (LimiteDeCamiones - Camiones.length))">
                                            <div class="card" style="max-width: 100%; padding-top: 4px; padding-bottom: 4px; background-color: #f0f0f0">
                                                <div class="card-header text-center" style="padding: 0px; height: 18px;">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>    
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
