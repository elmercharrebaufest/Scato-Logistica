@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.WebMobile.Seguridad
@using Molinos.Scato.Dominio.Seguridad
@model TipoCalle
@{
    Layout = null;
    TipoCalle calle2 = Model;

    if (Model == TipoCalle.PlantaNoGranos)
    {
        calle2 = TipoCalle.EnTransito;
    }
}
<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item ml-auto ">
        <div class="input-sm">
            <input data-bind="value: PatenteBuscada, valueUpdate: 'afterkeydown'" class="form-control" type="text" placeholder="Buscar Patente" aria-label="Buscar Patente" oninput="this.value = this.value.toUpperCase()">
        </div>
    </li>
    @if (Model != TipoCalle.PlantaNoGranos)
    {
        <li class="nav-item">
            <div class="nav-link nav-material bg-soja">Soja(<strong data-bind="text: CantidadSoja"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-maiz text-white">Maiz(<strong data-bind="text: CantidadMaiz"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-naranja text-white">Trigo(<strong data-bind="text: CantidadTrigo"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-warning text-white">Girasol(<strong data-bind="text: CantidadGirasol"></strong>)</div>
        </li>
    }
    @if (Model == TipoCalle.PlantaNoGranos)
    {
        <li class="nav-item">
            <div class="nav-link nav-material bg-EnTransito">En Tránsito(<strong data-bind="text: CantidadEnTransito"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-harina text-white">Harina(<strong data-bind="text: CantidadHarina"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-pellet text-white">Pellet S(<strong data-bind="text: CantidadPelletS"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-AceiteSj text-white">Aceite Sj(<strong data-bind="text: CantidadAceiteSj"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-AceiteG text-white">Aceite G(<strong data-bind="text: CantidadAceiteG"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-PelletG text-white">Pellet G(<strong data-bind="text: CantidadPelletG"></strong>)</div>
        </li>
        <li class="nav-item tagmaterial">
            <div class="nav-link nav-material bg-Lecitina text-white">Lecitina(<strong data-bind="text: CantidadLecitina"></strong>)</div>
        </li>
    }
</ul>
<div class="content">
    <div class="container-fluid">
        <div class="row callesfiltradas" data-bind="foreach: CallesFiltradas('@((int)Model)', '@((int)calle2)'),css: { 'centrarCalles': CallesFiltradas('@((int)Model)', '@((int)calle2)').length <= 5 }">
            <div class="col" style="min-width:14ch!important; max-width:20ch!important">
                <div class="sinbordetb row row-card-no-pd" data-bind="css: { 'bg-calle-llena': CamionesEnCalle() - CantidadDeCamiones > 0}">
                    <div class="col sinbordetb">
                        <div class="card card-stats sinbordetb">
                            <div class="card-body sinbordetb">
                                <div class="row fw-bold mb-0 cart-title sinbordetb">
                                    <div class="col">
                                        <button type="button" style="width: 100%; height: 28.5px;" class="btn btn-success btn-sm calle" disabled data-bind="visible: !Deshabilitada() && (TipoCalle == 8 || TipoCalle == 9)"><strong data-bind="text: TiempoEnCola"></strong></button>
                                        <button type="button" style="width: 100%" class="btn btn-warning btn-sm calle" data-bind="visible: Deshabilitada()" disabled><strong>Deshabilitada</strong></button>
                                    </div>
                                </div>
                                <p class="fw-bold mb-0 cart-title sinbordetb" data-bind="class: Color">
                                    <strong data-bind="text: Nombre"></strong>
                                    <small style="float: right;position:absolute" data-bind="text: CamionesEnCalle()+'/'+CantidadDeCamiones">
                                    </small>
                                </p>
                                <div class="row borde-grafico" data-bind="css: { 'bg-success': Bloqueada }">
                                    <div class="col" data-bind="foreach: Posiciones">
                                        <div class="card text-white" style="max-width: 100%; padding-top:4px; padding-bottom:4px;" data-bind="class: Color">
                                            <div class="card-header text-center" style="padding: 0px; height: 18px;">
                                                <i data-bind="attr: {'class': Icon}"></i>
                                                <strong data-bind="text: Patente, click: abrirModal"></strong>
                                            </div>
                                        </div>
                                        <div class="card bg-danger" style="max-width: 100%; padding-top:4px; padding-bottom:4px;" data-bind="visible: UltimoDeLaFila">
                                            <div class="card-header text-center" style="padding: 0px; height: 18px;">
                                                <i class="fas fa-traffic-light"></i><strong> STOP</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" data-bind="attr: { id: 'm'+Id}">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar llamado</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>