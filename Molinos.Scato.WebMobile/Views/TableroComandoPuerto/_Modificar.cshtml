@model AutomatismoNoGranoViewModel
@using Molinos.Scato.WebMobile.ViewModel
@using Molinos.Scato.Dominio.Recursos
@using System.Web.Optimization

@Scripts.Render("~/bundles/jqueryval")

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions { OnSuccess = "refreshAutomatismo" }, new { @class = "container" }))
{
    @Html.HiddenFor(model => model.AutomatismoNoGrano.Id)
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.AutomatismoNoGrano.CallePlantaId)
                @Html.DropDownListFor(m => m.AutomatismoNoGrano.CallePlantaId, Model.CallesPlanta, new { @class = "form-control", @id = "ddlCallePlanta", @disabled = "disabled" })
                @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.CallePlantaId)
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.AutomatismoNoGrano.CallePlayaInternaId)
                @Html.DropDownListFor(m => m.AutomatismoNoGrano.CallePlayaInternaId, Model.CallesPlayaInterna, new { @class = "form-control", @disabled = "disabled" })
                @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.CallePlayaInternaId)
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.AutomatismoNoGrano.PuntoDeCargaId)
                @Html.DropDownListFor(m => m.AutomatismoNoGrano.PuntoDeCargaId, Model.PuntosDeCarga, "(Punto de Carga)", new { @class = "form-control", @id = "ddlPuntosDeCarga" })
                @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.PuntoDeCargaId)
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.AutomatismoNoGrano.AlmacenId)
                @Html.DropDownListFor(m => m.AutomatismoNoGrano.AlmacenId, Model.Almacenes, "(Almacén)", new { @class = "form-control" })
                @Html.HiddenFor(m => m.AutomatismoNoGrano.AlmacenId, new { @id = "AutomatismoNoGrano_AlmacenId_hdn" })
                @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.AlmacenId)
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Textos.Cancelar</button>
        <button type="submit" class="btn btn-success">@Textos.Aceptar</button>
    </div>

}

<script>
    $(document).ready(function () {
        dllCallePlantaOnChange()
    })
</script>