@using Molinos.Scato.WebMobile.ViewModel
@using Molinos.Scato.Dominio.Recursos
@model AutomatismoNoGranoConfiguracionViewModel

@using (Ajax.BeginForm("ModificarPuntoDeCarga", "TableroComandoPuerto", null, new AjaxOptions() { HttpMethod = "POST", OnSuccess = "fnResponse", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridPuntoDeCarga" }, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.PuntoDeCarga.Id)
    <div class="row">
        <!--Primera Fila-->
        <div class="col">
            <div class="span4">
                <div class="form-group">
                    @Html.LabelFor(model => model.PuntoDeCarga.Descripcion)
                    <div class="controls">
                        @Html.TextBoxFor(model => model.PuntoDeCarga.Descripcion, new { @class = "form-control", @required = "required" })
                        @Html.ValidationMessageFor(model => model.PuntoDeCarga.Descripcion)
                    </div>
                </div>
            </div>
        </div>
    </div><!--fin Primera Fila-->
    <div class="row">
        <!--Segunda Fila-->
        <div class="col">
            <div class="span4">
                <div class="form-group">
                    @Html.LabelFor(model => model.PuntoDeCarga.CantidadMaximaDeCamiones)
                    <div class="controls">
                        @Html.TextBoxFor(model => model.PuntoDeCarga.CantidadMaximaDeCamiones, new { @class = "form-control", @required = "required" })
                        @Html.ValidationMessageFor(model => model.PuntoDeCarga.CantidadMaximaDeCamiones)
                    </div>
                </div>
            </div>
        </div>
    </div><!--fin Segunda Fila-->

    <div class="form-group">
        <button type="submit" class="btn btn-success float-right">@Textos.Guardar</button>
        <button type="button" class="btn btn-secondary float-right mr-2" data-dismiss="modal">@Textos.Cancelar</button>
    </div>
}