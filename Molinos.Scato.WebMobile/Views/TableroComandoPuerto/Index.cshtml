@model AutomatismoNoGranoViewModel
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile.ViewModel

@{
    ViewBag.Title = Textos.TableroComandoPuerto_Titulo;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/dialogModal.css")">
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/switches.css")">

<script type="text/javascript" src="@Url.Content("~/scripts/automatismoNoGrano.js")"></script>

<script>
    urlCrearAutomatismo = '@Url.Action("Crear", "TableroComandoPuerto")';
    urlModificarAutomatismo = '@Url.Action("Modificar", "TableroComandoPuerto")';
    urlEliminarAutomatismo = '@Url.Action("Eliminar", "TableroComandoPuerto")';
    urlActualizarEstadoAutomatismoGeneral = '@Url.Action("ActualizarEstadoAutomatismoGeneral", "TableroComandoPuerto")';
    urlActualizarEstadoAutomatismoNoGrano = '@Url.Action("ActualizarEstadoAutomatismoNoGrano", "TableroComandoPuerto")';
    urlActualizarEstadoLlamadoAutomatismoNoGrano = '@Url.Action("ActualizarEstadoLlamadoAutomatismoNoGrano", "TableroComandoPuerto")';
    urlListarAutomatismoNoGrano = '@Url.Action("ListarAutomatismoNoGrano", "TableroComandoPuerto")';
    urlObtenerPuntosDeCargaPorMaterialId = '@Url.Action("ObtenerPuntosDeCargaPorMaterialId", "TableroComandoPuerto")';
    urlObtenerAlmacenesCalleMaterialId = '@Url.Action("ObteneAlamacenesCalleMaterialId", "TableroComandoPuerto")';
</script>

<div class="m-2">
    <h1 class="text-center">@Textos.TableroComandoPuerto_Panel</h1>
</div>

<div class="mx-1" style="border: 1px solid #ccc;">
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs flex-column flex-sm-row">
                <!-- Panel Tab (Active) -->
                <li class="nav-item">
                    @Html.ActionLink(Textos.Panel, "Index", "TableroComandoPuerto", null, new { @class = "nav-link active" })
                </li>

                <!-- Configurations Tab -->
                <li class="nav-item">
                    @Html.ActionLink(Textos.Configuraciones, "Configuraciones", "TableroComandoPuerto", null, new { @class = "nav-link" })
                </li>

                <!-- Automatismo Switch -->
                <li class="nav-item ms-auto">
                    <label class="switch">
                        <input id="automatismoGeneral" type="checkbox" @(Model.EstadoGeneralAutomatismoNoGrano ? "checked='checked'" : "")>
                        <span class="slider round"></span>
                    </label>
                    <span class="me-2">Automatismo General</span>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content overflow-auto">
                <div class="col-12">
                    <!-- Button with float-right (Bootstrap 5 uses float-end) -->
                    <button class="btn m-2 float-end rounded-bottom btn-success" onclick="ModalCrear()">Nuevo Automatismo</button>
                </div>

                <!-- Grid Container -->
                <div id="gridContainer" class="tab-pane fade show active">
                    @Html.Partial("_Listar")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detail Div -->
<div id="detalle"></div>

<!-- Modal for creating or editing -->
<div id="partialModal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

<!-- Confirmation Dialog -->
<dialog id="modalConfirmarBorrar" class="dialogModal">
    <h4 class="dialogModal__titulo">@Textos.Confirmacion</h4>
    <input type="hidden" id="automatismoIdABorrar" />
    <div class="dialogModal__descripcion">
        <p>¿Seguro que desea eliminar este automatismo?</p>
    </div>
    <div class="dialogModal__botones">
        <button type="button" class="btn btn-secondary" onclick="modalConfirmarBorrar.close()" autofocus>Cancelar</button>
        <button type="button" id="btnConfirmarBorrar" class="btn btn-success" onclick="EliminarAutomatismoNoGrano()">Aceptar</button>
    </div>
</dialog>


<style>
    .nav-item a,
    td a,
    th a {
        color: #244232 !important;
    }

    td, th {
        text-align: center;
    }
</style>