@using Molinos.Scato.WebMobile.ViewModel
@using Molinos.Scato.Dominio.Recursos
@model AutomatismoNoGranoViewModel
    
@using (Ajax.BeginForm("Crear", "TableroComandoPuerto", null, new AjaxOptions() { HttpMethod = "POST", OnSuccess = "fnResponse", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { enctype = "multipart/form-data" }))

{
    <div class="row">
        <!--Primera Fila-->
        <div class="col">
            <div class="span4">
                <div class="form-group">
                    @Html.LabelFor(m => m.AutomatismoNoGrano.CallePlanta)
                    @Html.DropDownListFor(m => m.AutomatismoNoGrano.CallePlantaId, Model.CallesPlanta, Textos.SeleccioneOpcion, new { @class = "form-control", @required = "required", @id = "ddlCallePlanta", @onchange = "dlCallePlantaOnChange(this.value)" })
                    @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.CallePlantaId)
                </div>
            </div>
        </div>
        <div class="col">
            <div class="span4">
                <div class="form-group">
                    @Html.LabelFor(m => m.AutomatismoNoGrano.CallePlayaInterna)
                    @Html.DropDownListFor(m => m.AutomatismoNoGrano.CallePlayaInternaId, Model.CallesPlayaInterna, Textos.SeleccioneOpcion, new { @class = "form-control", @required = "required" })
                    @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.CallePlayaInternaId)
                </div>
            </div>
        </div>
    </div><!--fin Primera Fila-->
    <div class="row">
        <!--Segunda Fila-->
        <div class="col">
            <div class="span4">
                <div class="form-group">
                    @Html.LabelFor(m => m.AutomatismoNoGrano.PuntoDeCarga)
                    @Html.DropDownListFor(m => m.AutomatismoNoGrano.PuntoDeCargaId, Model.PuntosDeCarga, Textos.SeleccioneOpcion, new { @class = "form-control multiselect", @required = "required", @id = "ddlPuntosDeCarga" })
                    @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.PuntoDeCarga)
                </div>
            </div>
        </div>
        <div class="col">
            <div class="span4">
                <div class="form-group">
                    @Html.LabelFor(m => m.AutomatismoNoGrano.Almacen)
                    @Html.DropDownListFor(m => m.AutomatismoNoGrano.AlmacenId, Model.Almacenes, Textos.SeleccioneOpcion, new { @class = "form-control", @required = "required"})
                    @Html.ValidationMessageFor(m => m.AutomatismoNoGrano.PuntoDeCarga)
                </div>
            </div>
        </div>
    </div><!--Fin Segunda Fila-->
    <div class="form-group p-2">
        <button type="submit" class="btn btn-success float-right">@Textos.Guardar</button>
        <button type="button" class="btn btn-secondary float-right mr-2" data-dismiss="modal">@Textos.Cancelar</button>
    </div>
}
