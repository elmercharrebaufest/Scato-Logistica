@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.CalidadMaterialDto

@Html.ValidationSummary(true)

<div class="control-group">
    @Html.LabelFor(model => model.MaterialId, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Material, new {@class = "control input-large"})
        @Html.ValidationMessageFor(m => m.Material)
        @Html.HiddenFor(model => model.MaterialId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.Descripcion, new {@class = "control-label", @maxlength = 25})
    <div class="controls">
        @Html.TextBoxFor(m => m.Descripcion, new {@class = "input-large"})
        @Html.ValidationMessageFor(m => m.Descripcion)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.ValorDesde, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(m => m.ValorDesde, new {@class = "input-small campoNumerico"})
        @Html.ValidationMessageFor(m => m.ValorDesde)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.ValorHasta, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(m => m.ValorHasta, new {@class = "input-small campoNumerico"})
        @Html.ValidationMessageFor(m => m.ValorHasta)
    </div>
</div>
<div class="control-group">
    <label class="input-control checkbox">
        @Html.CheckBoxFor(m => m.TieneAnalisis)
        <span >@Textos.CalidadMaterial_TieneAnalisis</span>
    </label>
</div>






