@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.CiuAnuladoDto

<div class="control-group">
    @Html.LabelFor(model => model.Numero, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Numero, new {@class = "input-medium"})
        @Html.ValidationMessageFor(model => model.Numero)
    </div>
</div>
<div class="control-group Fecha">
    @Html.LabelFor(model => model.Fecha, new { @class = "control-label" })
    <div class="controls">
        @Html.EditorFor(model => model.Fecha, Model != null ? Model.Fecha.Formatted() : string.Empty)
        @Html.ValidationMessageFor(model => model.Fecha)
    </div>
</div>
