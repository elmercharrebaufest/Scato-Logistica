@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<CiuAnuladoDto>) ViewBag.Items;
}

    @Html.Grilla(items,
        grilla => grilla.Columns(
        grilla.ColumnaEliminar(Html, "CiuAnulado"),
        grilla.Columna("Numero", Textos.CiuAnulado_Numero),
        grilla.Columna("Fecha", Textos.Fecha)
        ))
