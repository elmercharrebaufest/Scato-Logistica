@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.EstablecimientoDto
@{
    var provincias = (IEnumerable<SelectListItem>)ViewBag.Provincias;
    var localidades = (IEnumerable<SelectListItem>)ViewBag.Localidades;
}
<div id="links" data-url-obtener-proveedores-sap="@Url.Action("ObtenerProveedoresSap", "Consultas")"
    data-url-buscar-proveedor="@Url.Action("BuscarProveedor", "Consultas")"
    data-url-buscar-proveedores="@Url.Action("BuscarProveedores", "Consultas")"></div>
@Html.ValidationSummary(true)

<div class="control-group">
    @Html.LabelFor(model => model.Proveedor, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Proveedor, new { @class = "control input-medium input-xlarge" })
        @Html.ValidationMessageFor(model => model.Proveedor)
        @Html.HiddenFor(model => model.ProveedorId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.NombreDeEstablecimiento, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.NombreDeEstablecimiento, new {@class = "input-xlarge", maxlength = 30})
        @Html.ValidationMessageFor(model => model.NombreDeEstablecimiento)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoDeEstablecimiento, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoDeEstablecimiento, new {@class = "input-xlarge campoNumerico", maxlength =
        6})
        @Html.ValidationMessageFor(model => model.CodigoDeEstablecimiento)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Provincia, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.ProvinciaId, provincias,Textos.Default_Provincia, new { id =
        "provinciasDropDown" })
        @Html.ValidationMessageFor(model => model.ProvinciaId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Localidad, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.LocalidadId, localidades,Textos.Default_Localidad, new { id =
        "localidadesDropDown" })
        @Html.ValidationMessageFor(model => model.LocalidadId)
        @Html.Hidden("CargarLocalidades", Url.Action("CargarLocalidades"))
        @Html.Hidden("ValorDefaultLocalidad",Textos.Default_Localidad)
        @Html.Hidden("ValorDefaultProvincia",Textos.Default_Provincia)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Domicilio, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Domicilio, new { @class = "input-xlarge" })
        @Html.ValidationMessageFor(model => model.Domicilio)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoPostal, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoPostal, new {@class = "input-xlarge", maxlength = 8})
        @Html.ValidationMessageFor(model => model.CodigoPostal)
    </div>
</div>
<div class="row">
    <div class="span3">
        <div class="control-group">
            @Html.LabelFor(model => model.Anulado, new {@class = "control-label"})
            <div class="controls">
                @Html.CheckBoxFor(model => model.Anulado)
                @Html.ValidationMessageFor(model => model.Anulado)
            </div>
        </div>
    </div>
    <div class="span3">
        <div class="control-group">
            @Html.LabelFor(model => model.EsSojaEPA, new {@class = "control-label"})
            <div class="controls">
                @Html.CheckBoxFor(model => model.EsSojaEPA)
                @Html.ValidationMessageFor(model => model.EsSojaEPA)
            </div>
        </div>
    </div>
</div>


<div id="autocompleteProv"></div>