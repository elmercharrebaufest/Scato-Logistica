@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.EstablecimientoDto
@{
    var provincias = (IEnumerable<SelectListItem>)ViewBag.Provincias;
    var localidades = (IEnumerable<SelectListItem>)ViewBag.Localidades;
    var comerciales = (IEnumerable<SelectListItem>)ViewBag.Comerciales;
}
<div id="links" data-url-obtener-proveedores-sap="@Url.Action("ObtenerProveedoresSap", "Consultas")"
     data-url-buscar-proveedor="@Url.Action("BuscarProveedor", "Consultas")"
     data-url-buscar-proveedores="@Url.Action("BuscarProveedores", "Consultas")"
     data-url-obtener-corredores-por-establecimiento-id="@Url.Action("ObtenerCorredoresPorEstablecimiento", "Consultas")"
     data-url-obtener-proveedor-por-id="@Url.Action("ObtenerProveedorPorId", "Consultas")">
</div>
<input type="hidden" id="rangoMaxEPA" value="@ViewBag.RangoMaxEPA">
<input type="hidden" id="rangoMinEPA" value="@ViewBag.RangoMinEPA">
@Html.ValidationSummary(true)
@Html.Hidden("corredores", "", new { id = "corredoresFinales" })
@Html.HiddenFor(model => model.Id)

<div class="row">
    <div class="span3">
        <div class="control-group">
            @Html.LabelFor(model => model.EsProvisorio, new { @class = "control-label" })
            <div class="controls">
                @Html.CheckBoxFor(model => model.EsProvisorio)
                @Html.ValidationMessageFor(model => model.EsProvisorio)
            </div>
        </div>
    </div>
    <div class="span3">
        <div class="control-group">
            @Html.LabelFor(model => model.EsStandard2, new { @class = "control-label" })
            <div class="controls">
                @Html.CheckBoxFor(model => model.EsStandard2)
                @Html.ValidationMessageFor(model => model.EsStandard2)
            </div>
        </div>
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Proveedor, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Proveedor, new { @class = "control input-medium input-xlarge" })
        @Html.ValidationMessageFor(model => model.Proveedor)
        @Html.HiddenFor(model => model.ProveedorId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.NombreDeEstablecimiento, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.NombreDeEstablecimiento, new { @class = "input-xlarge", maxlength = 30 })
        @Html.ValidationMessageFor(model => model.NombreDeEstablecimiento)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoDeEstablecimiento, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoDeEstablecimiento, new { @class = "input-xlarge campoNumerico", maxlength = 6 })
        @Html.ValidationMessageFor(model => model.CodigoDeEstablecimiento)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Provincia, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.ProvinciaId, provincias,Textos.Default_Provincia, new { id = "provinciasDropDown" })
        @Html.ValidationMessageFor(model => model.ProvinciaId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Localidad, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.LocalidadId, localidades, Textos.Default_Localidad, new { id = "localidadesDropDown" })
        @Html.ValidationMessageFor(model => model.LocalidadId)
        @Html.Hidden("CargarLocalidades", Url.Action("CargarLocalidades"))
        @Html.Hidden("ValorDefaultLocalidad", Textos.Default_Localidad)
        @Html.Hidden("ValorDefaultProvincia", Textos.Default_Provincia)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Comercial, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.ComercialId, comerciales, Textos.Default_Comercial, new { id = "comercialesDropDown" })
        @Html.ValidationMessageFor(model => model.ComercialId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Observaciones, new { @class = "control-label" })
    <div class="controls">
        @Html.TextAreaFor(model => model.Observaciones, new { @class = "control margin textarea-large" })
        @Html.ValidationMessageFor(model => model.Observaciones)
    </div>
</div>
<div class="inputs__container--checkbox">
    <div class="inputs__checkbox">
        @Html.LabelFor(model => model.Anulado, new { @class = "" })
        @Html.CheckBoxFor(model => model.Anulado)
        @Html.ValidationMessageFor(model => model.Anulado)
    </div>
    <div class="inputs__checkbox">
        @Html.LabelFor(model => model.EsSojaEPA, new { @class = "" })
        @Html.CheckBoxFor(model => model.EsSojaEPA)
        @Html.ValidationMessageFor(model => model.EsSojaEPA)
    </div>
    <div class="inputs__checkbox">
        @Html.LabelFor(model => model.EsEUDR, new { @class = "" })
        @Html.CheckBoxFor(model => model.EsEUDR)
        @Html.ValidationMessageFor(model => model.EsEUDR)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoRENSPA, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoRENSPA, new { @class = "input-xlarge", maxlength = 17 })
        @Html.ValidationMessageFor(model => model.CodigoRENSPA)
    </div>
</div>
<div id="autocompleteProv"></div>
<div id="autocompleteCorred"></div>
<div id="corredoresViewModel">
    <div class="control-group">
        @Html.LabelFor(model => model.Corredor, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.Corredor, new { @class = "control input-medium input-xlarge" })
            @Html.ValidationMessageFor(model => model.Corredor)
            @Html.HiddenFor(model => model.CorredorId)
        </div>
        <br />
        <button class="btn btn-primary agregar inline-display" type="button" data-bind="click: addCorredor">@Textos.Agregar</button>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@Textos.CodigoSap</th>
                <th>@Textos.RazonSocial</th>
                <th>@Textos.Eliminar</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: corredores">
            <tr>
                <td data-bind="text: CodigoSap" />
                <td data-bind="text: RazonSocial" />
                <td><a href="#" data-bind="click: $root.removeCorredor"><i class="icon-trash"></i></a></td>
            </tr>
        </tbody>
    </table>
</div>