<script type="text/javascript" src="@Url.Script("~/scripts/bocaDestino.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/sojaEpaCodigo.js")"></script>
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/cargaCorredores.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/establecimiento.CrearModificar.js")"></script>

@using (Ajax.BeginForm(Textos.Crear, null, new AjaxOptions(), new { @class = "form-horizontal", @id = "form-establecimiento", data_dialogo_titulo = Textos.Establecimiento_Crear }))
{
    @Html.Partial("_CrearModificar", Model)
}