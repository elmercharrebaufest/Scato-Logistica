@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    ViewBag.Title = Textos.ListaDeTareasAutomatizada_Titulo;
    var puestosDeTrabajo = (string)ViewBag.PuestosDeTrabajo;
    var alertarAnalisisObligatorio = (bool)ViewBag.AlertarAnalisisObligatorio;
    var materialAnalisisObligatorio = (string)ViewBag.MaterialAlertarAnalisisObligatorio;
    var url = Url.Action("IndexPorTarjeta", "Foto");
    var indice = 1;
    var mostrarAlertaPaseAutomatico = (bool)(ViewBag.MostrarValidacionEtapaAutomatica ?? false);

    var mensajeAlertaPaseAutomatico = (string)ViewBag.MensajeValidacionEtapaAutomatica;
}

@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/listaDeTareasAutomatizada.js")"></script>
<script src="@Url.Script("~/Scripts/mousetrap.js")" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/mousetrap-pause.js")" type="text/javascript"></script>
<style>
    canvas {
        margin: auto;
        display: block;
    }
</style>

@Html.Hidden("puestosDeTrabajo", puestosDeTrabajo)
@Html.Hidden("centroId", (int)ViewBag.CentroId)
@Html.Hidden("esperandoLectura", Textos.ListaDeTareasAutomatizada_EsperandoLectura)
@Html.Hidden("cargando", "")
@Html.Hidden("eliminarUltimaLectura", Url.Action("EliminarLectura"))
@Html.Hidden("sessionExpirada", Url.Action("SessionExpirada"))
@Html.Hidden("errorGenerico", Url.Action("ErrorGenerico"))
@Html.Hidden("obtenerFoto", Url.Action("ObtenerUltimaFoto", "Foto"))
@Html.Hidden("home", Url.Action("Index", "ListaDeCamiones"))
@Html.Hidden("mensajeAlertPaseAutomatico", mensajeAlertaPaseAutomatico)
@Html.Hidden("DocumentoOrigenConsultaUrl", Url.Action("DocumentoOrigenConsulta", "ListaDeTareasAutomatizada"))

@if (mostrarAlertaPaseAutomatico && !string.IsNullOrEmpty(mensajeAlertaPaseAutomatico))
{
    <script type="text/javascript">
        MostrarAlertaInfo($('#mensajeAlertPaseAutomatico').val(), 10000);
    </script>
}

<div id="mensajes" data-error-lectura="@Textos.NumeroInvalido">
</div>

<div class="container">
    <div class="span6" style="margin-left: 0px">
        <div class="titSecciones">@Textos.Menu_Administracion - @Textos.ListaDeTareasAutomatizada_Titulo</div>
    </div>
    @{
        if (alertarAnalisisObligatorio)
        {
            <span class='label label-warning'> <strong> @Textos.AnalisisObligatorio_AvisoListaTareasAutomatizadas @materialAnalisisObligatorio</strong> </span>
        }
    }
    @Html.ActionLink(Textos.ListaDeCamiones_Titulo, "Index", "ListaDeCamiones", new { venimosDeListaDeTareasAutomatizada = true }, new { @class = "btn pull-right", id = "btnListaDeTareas", tabindex = 4 })
    @if (ViewBag.PantallaPrincipal)
    {
        <a class="btn pull-right" id="btnPantallaPrincipal" tabindex="4" style="margin:0 5px;">@Textos.ListaDeCamiones_VersionTareas</a>
    }
</div>
@Html.ValidationSummary(true)
<div class="container content grillaPad">
    <div id="grilla">
        <div class="row-fluid">
            <div class="span12" style="min-height:0">
                <div class="alert alert-error hide" id="validation-patente-alert" data-error-requerido="@string.Format(Textos.Error_Requerido, new object[] { Textos.Patente })">
                    <button type="button" class="close" id="validation-patente-close">×</button>
                    <div id="validation-patente">
                    </div>
                </div>
            </div>
        </div>
        <div class="row-fluid">
            <div class="span12" style="min-height:0">
                <div class="alert alert-info hide" id="validation-patente-danger">
                    <button type="button" class="close" id="validation-danger-close">×</button>
                    <div id="validation-danger">
                    </div>
                </div>
            </div>
        </div>

        <!--ko foreach:puestosDeTrabajoGrouped-->
        <div class="row-fluid">
            <!--ko foreach:$data-->
            <div class="span6 " data-bind="css: { offset3: $root.puestosDeTrabajo().length == 1 }">
                <table class="table table-striped table-bordered">
                    <tbody>
                        <tr>
                            <td>
                                <span data-bind="text: NombrePuesto"></span>
                                <span class="label label-success" data-bind="visible: EstadoConexion()">@Textos.Conectado</span>
                                <span class="label label-important" data-bind="visible: !EstadoConexion(), attr: { title: MensajeConexion }" data-toggle="tooltip">@Textos.Desconectado</span>
                                <p data-bind="visible: Automatizado">@Textos.Automatico: <input type="checkbox" data-bind="checked: EsAutomatizado" /></p>
                            </td>
                            <td data-bind="visible: Automatico" style="width: 140px">
                                @Html.TextBox("lecturautomatica", "", new { @class = "input-small", tabindex = -1, style = "margin-bottom:0px", @readonly = "readonly", data_bind = "value: Lectura" })
                                <a href="#" data-bind="click: $root.removeLectura, visible: HayLectura"><i class="icon-remove"></i></a>
                                <a href="#" data-bind="visible: HayLectura, attr: { href: '@url/' + Lectura() }" class="ajax-popup-link"><i class="icon-picture"></i></a>
                            </td>
                            <td data-bind="visible: !Automatico" style="width: 140px">
                                @Html.TextBox("lecturaManual", "", new { @class = "filaValida input-small", tabindex = 1, placeholder = Textos.ListaDeTareasAutomatizada_IngreseLectura, style = "margin-bottom:0px", data_bind = "value: Lectura, attr: { 'id': Indice1, 'name': Indice1 }" })
                                @Html.ValidationMessage("lecturaManual", new { data_bind = "attr: { 'data-valmsg-for': Indice1 }" })
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-center">
                                @using (Ajax.BeginForm("Index", null, new AjaxOptions { OnSuccess = "respuestaForm(data)", OnFailure = "respuestaFormError(xhr,status,error)" }, new { id = "search-form", @class = "form-horizontal causaBlock", data_mensaje_espera = string.Empty }))
                                {
                                    <input type="hidden" name="puestosDeTrabajo" data-bind="value: ko.toJSON($data)" />
                                    <div>
                                        <div class="span2 offset1">
                                            @Html.Label(Textos.Patente, new { @class = "", style = "width:50px;" })
                                        </div>
                                        <div class="span4">
                                            @Html.TextBox("Patente", null, new { @class = "PatenteRequerida patente-internacional uppercase", tabindex = 2, style = "width:100%;margin:0", data_bind = "value: Patente, valueUpdate: 'afterkeydown', attr: { 'id': IndicePantente, 'name': IndicePantente }" })
                                            @Html.ValidationMessage("Patente", new { data_bind = "attr: { 'data-valmsg-for': IndicePantente }" })
                                        </div>
                                        <div class="span2 text-center">
                                            <button tabindex="3" class="btn" style="margin-left: 5px">@Textos.Aceptar</button>
                                        </div>
                                        <div class="span2 text-center">
                                            <button tabindex="3" class="btn" style="margin-left: 5px" id="consultar-vehiculo" data-bind="click: consultarPatenteVehiculo">@Textos.Consultar</button>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                        <tr data-bind="visible: HayFoto">
                            <td colspan="2" class="text-center">
                                <canvas style="border: solid" data-bind="attr: { id: 'canvas' + Id}"></canvas>
                            </td>
                        </tr>
                        <tr data-bind="visible: MostrarMensajeNoHayFoto">
                            <td colspan="2" class="text-center">
                                <div style="border: solid red;text-align:center; vertical-align:middle;min-height:400px;line-height:400px; ">
                                    <span class="icon-camera"></span> No se pudo cargar la foto tomada
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--/ko-->
        </div>
        <!--/ko-->

        <div class="row-fluid">
            <div class="span6 offset3" id="aceptarContainer">
            </div>
        </div>
    </div>
</div>