    <style>
        .span6 {
            width: 430px;
            /*border: solid 1px #c3c3c3;*/
        }

        .span3 {
            width: 200px;
            /*border: solid 1px #c3c3c3;*/
        }

        .form-horizontal .control-label {
            width: 170px;
            font-size: 12px;
        }

        .modal-body {
            padding-right: 0px !important;
        }

        div.modal .control-group {
            margin-bottom: 5px;
            padding-left: 10px;
            font-size: 12px;
        }

        label.checkbox {
            font-size: 12px;
        }

        .tablaDatos label {
            margin-bottom: 0;
        }

        .control-label2 {
            width: auto;
            display: inline;
            font-size: 12px;
        }

        .help-inline {
            padding-left: 0;
        }

        .modal-body {
            max-height: 440px !important;
            width: 905px !important;
        }

        .span6 {
            width: 400px;
        }
    </style>
    
    <div class="row" style="height: auto;">
