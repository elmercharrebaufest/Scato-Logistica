<div class="modal fade hide" id="dialogo-almat">
    <div class="modal-header">
        <button type="button" class="close dialogo-almat-cancelar" aria-hidden="true">&times;</button>
        <h4>Agregar Almacen por Material</h4>
    </div>
    <div class="modal-body" id="dialogo-almat-body" data-almacenes="@almacenesList" data-almacenes-sin-asignar="@almacenesTodos" data-default-almacen="@defaultAlmacen" data-error-predeterminado="@Textos.Error_EliminarPredeterminado">
        <div class="control-group form-inline">
            <select data-bind=" options: almacenesSinAsignar,
    optionsText: function (item) { return item.Descripcion + ' (' + item.CodigoSAP + ')' },
    value: selectedItem,
    optionsCaption: defaultAlmacen">
            </select>
            <button data-bind="click: $root.botonAgregarAlmacen, enable: selectedItem != null" class="btn-small">Agregar Almacen</button>
        </div>
        <div class="control-group">
            <table class="tablaDatos span4">
                <thead>
                    <tr>
                        <th>@Textos.Descripcion</th>
                        <th>@Textos.Almacen_CodigoSAP</th>
                        <th>@Textos.Eliminar</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: almacenes">
                    <tr>
                        <td data-bind="text: Descripcion" />
                        <td data-bind="text: CodigoSAP" />
                        <td><a href="#" data-bind="click: $root.removerAlmacen"><i class="icon-trash"></i></a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <input type="hidden" id="almacenesList" name="almacenes" data-bind="value: ko.toJSON(almacenes)" />
        <input type="hidden" id="almacenesEliminados" name="almacenesEliminados" data-bind="value: ko.toJSON(almacenesEliminados)" />
        <button id="dialogo-almat-aceptar" class="btn btn-warning dialogo-almat-cancelar">@Textos.Aceptar</button>
    </div>
</div>
