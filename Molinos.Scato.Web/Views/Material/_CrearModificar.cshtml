@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.MaterialDto

@{
    ViewBag.Title = Textos.Modificar;
    Layout = null;
    // var almacenes = (IEnumerable<SelectListItem>) ViewBag.Almacenes;
    var almacenesList = Json.Encode((AlmacenDto[])ViewBag.AlmacenesList);
    var almacenesTodos = Json.Encode((AlmacenDto[])ViewBag.AlmacenesTodos);
    var defaultAlmacen = Textos.Default_Almacen;

    var analisisInterno = (int?)ViewBag.AnalisisInterno;
    var muestraAuditoria = (decimal?)ViewBag.MuestraAuditoria;
    var almacenPredId = (int?)ViewBag.AlmacenPredId;
    var correspondeDescarga = (bool)ViewBag.CorrespondeDescarga;
    var requiereTecnologia = (bool)ViewBag.RequiereTecnologia;
    var materialDeTerceros = (bool)ViewBag.MaterialDeTerceros;
    var imprimeReciboMunicipal = (bool)ViewBag.ImprimeReciboMunicipal;
    var mostrarEnWebMobile = (bool)ViewBag.MostrarEnWebMobile;
    var descripcionWebMobile = (string)ViewBag.DescripcionWebMobile;
    var noValidaCG = (bool)ViewBag.NoValidaCG;
    var epaStockPorCorte = (int?)ViewBag.EpaStockPorCorte;
    var ignoraContingencia = (bool)ViewBag.IgnoraContingencia;
    var orden = (int?)ViewBag.Orden;
    var variedades = (IEnumerable<SelectListItem>)ViewBag.Variedades;
}

@using (Ajax.BeginForm("Modificar", "Material", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Material_Modificar, data_dialogo_extraclass = "dialog-grande", id = "formEditar" }))
