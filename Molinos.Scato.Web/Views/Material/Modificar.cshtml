@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.MaterialDto
@{
    ViewBag.Title = Textos.Material_Modificar;
    Layout = null;
}

@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script src="@Url.Script("~/Scripts/materiales.Modificar.js")" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/validarFechas.js")" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/materialAlmacen.js")" type="text/javascript"></script>

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Material_Modificar }))
{
    @Html.Partial("_CrearModificar", Model)
}
