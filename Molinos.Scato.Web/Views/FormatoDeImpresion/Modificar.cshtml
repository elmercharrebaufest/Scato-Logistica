@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.FormatoDeImpresionDto
@{
    ViewBag.Title = Textos.FormatoDeImpresion_Modificar;
    Layout = null;
}

@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script src="@Url.Script("~/scripts/formatoDeImpresion.js")"  type="text/javascript"></script>
@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.FormatoDeImpresion_Modificar }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)           
}
