@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.InhabilitacionChoferDto
@using Molinos.Scato.Dominio.Dto
@{
    var tiposDocumentoIdentidad = (IEnumerable<SelectListItem>)ViewBag.TiposDocumentoIdentidad;
    var tipoDocumentoIdentidad = (string)ViewBag.tipoDocumentoIdentidad;
}


@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@{var adjuntos = (List<AdjuntoDto>)ViewBag.Adjuntos;}


@Html.Hidden("archivosAdjuntos", "", new { id = "adjuntosFinales" })
@if (Model != null && Model.Id != 0)
{
    @Html.HiddenFor(model => model.TipoDocumentoIdentidadId);
    @Html.HiddenFor(model => model.NumeroDeDocumento);


    <div class="control-group">
        @Html.LabelFor(model => model.TipoDocumentoIdentidadId, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBox(tipoDocumentoIdentidad, tipoDocumentoIdentidad, new { @class = "input-xlarge", @readonly = "readonly" })
            @Html.ValidationMessageFor(model => model.TipoDocumentoIdentidadId)
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(model => model.NumeroDeDocumento, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.NumeroDeDocumento, new { @class = "input-xlarge", @readonly = "readonly" })
            @Html.ValidationMessageFor(model => model.NumeroDeDocumento)
        </div>
    </div>
    <div class="control-group FechaDesde">
        @Html.LabelFor(model => model.FechaDesde, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.FechaDesde, Model != null ? Model.FechaDesde.Formatted() : string.Empty, new { @readonly = "readonly", style = "width:90px" })
            @Html.ValidationMessageFor(model => model.FechaDesde)
        </div>
    </div>
}
else
{
    <div class="control-group">
        @Html.LabelFor(model => model.TipoDocumentoIdentidadId, new { @class = "control-label" })
        <div class="controls">
            @Html.DropDownListFor(model => model.TipoDocumentoIdentidadId, tiposDocumentoIdentidad)
            @Html.ValidationMessageFor(model => model.TipoDocumentoIdentidadId)
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(model => model.NumeroDeDocumento, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.NumeroDeDocumento, new { @class = "input-xlarge" })
            @Html.ValidationMessageFor(model => model.NumeroDeDocumento)
        </div>
    </div>
    <div class="control-group FechaDesde">
        @Html.LabelFor(model => model.FechaDesde, new { @class = "control-label" })
        <div class="controls">
            @Html.EditorFor(model => model.FechaDesde, Model != null ? Model.FechaDesde.Formatted() : string.Empty)
            @Html.ValidationMessageFor(model => model.FechaDesde)
        </div>
    </div>
}

<div class="control-group FechaHasta">
    @Html.LabelFor(model => model.FechaHasta, new { @class = "control-label" })
    <div class="controls">
        @Html.EditorFor(model => model.FechaHasta, Model != null ? Model.FechaHasta.Formatted() : string.Empty)
        @Html.ValidationMessageFor(model => model.FechaHasta)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Motivo, new { @class = "control-label" })
    <div class="controls">
        @Html.TextAreaFor(model => model.Motivo, new { @class = "input-xlarge" })
        @Html.ValidationMessageFor(model => model.Motivo)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Comentario, new { @class = "control-label" })
    <div class="controls">
        @Html.TextAreaFor(model => model.Comentario, new { @class = "input-xlarge" })
        @Html.ValidationMessageFor(model => model.Comentario)
    </div>
</div>

<div id="adjuntos">
    <div class="control-group">
        @Html.Label("Adjuntos", new { @class = "control-label" })
        <div class="controls">
            <input data-bind="event: {change: $root.fileUpload}" type="file" id="adjunto" accept="image/*" class="control input-large" />
            @Html.ValidationMessageFor(model => model.ArchivoAdjunto)
        </div>
    </div>
</div>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Textos.Descripcion</th>
            <th>@Textos.Eliminar</th>
            <th>@Textos.Descargar_Adjunto</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: adjuntos">
        <tr>
            <td data-bind="text: Descripcion" />
            <td><a href="#" data-bind="click: $root.removeAdjunto"><i class="icon-trash"></i></a></td>
            <td><a id="descargarArchivo" data-bind="attr:{href:'InhabilitacionChofer\\DescargarArchivos?id=' + Id }" target="_blank" type="button" class="btn btn-primary boton-descargar" tabindex="2">Descargar</a></td>
        </tr>
    </tbody>
</table>
