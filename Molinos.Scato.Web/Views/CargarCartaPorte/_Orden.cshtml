@using System.Configuration
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.CartaPorteDto
@{
    var tiposComerciales = (IEnumerable<SelectListItem>)ViewBag.TiposComerciales;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
    var tiposDocumentos = (IEnumerable<SelectListItem>)ViewBag.TiposDocumentos;
    var bocasDestino = (IEnumerable<SelectListItem>)ViewBag.BocasDestino;
    var tecnologias = (IEnumerable<SelectListItem>)ViewBag.Tecnologias;
    var tipoVehiculo = new List<SelectListItem>();

    var tiposCategorias = (IEnumerable<SelectListItem>)ViewBag.TiposCategorias;
    var deshabilitarTitular = (bool)(ViewBag.DeshabilitarTitular ?? false);
    var deshabilitarEntregador = (bool)(ViewBag.DeshabilitarEntregador ?? false);
    var deshabilitarDestinatario = (bool)(ViewBag.DeshabilitarDestinatario ?? false);
    var deshabilitarTransportista = (bool)(ViewBag.DeshabilitarTransportista ?? false);
    var deshabilitarPatentes = (bool)(ViewBag.DeshabilitarPatentes ?? false);
    var fechaVtoVacia = (bool)(ViewBag.VaciarFechaVto ?? false);
    var requiereCupo = (bool)(ViewBag.RequiereCupo ?? false);
    var validarCupo = (bool)(ViewBag.ValidarCupo ?? false);
    var descargaCartaPortePorCtg = (bool)(ViewBag.DescargaCartaPortePorCtg ?? false);
    var habilitarSiemprePeso = (bool)(ViewBag.HabilitarSiemprePeso ?? false);
    var habilitarSiempreProcedencia = (bool)(ViewBag.HabilitarSiempreProcedencia ?? false);
    var habilitarSiempreCTG = (bool)(ViewBag.HabilitarSiempreCTG ?? false);
    var requiereNumeroAduana = (bool)(ViewBag.RequiereNumeroAduana ?? false);
    var aceptaPendiente = (bool)(ViewBag.AceptaPendiente ?? false);
    var aceptaRechazar = (bool)(ViewBag.AceptaRechazar ?? false);
    var esIngreso = (bool)(ViewBag.EsIngreso ?? false);
    var controlarTiempoPorCTG = (bool)(ViewBag.ControlarTiempoPorCTG ?? false);
    var esSanLorenzo = (bool)(ViewBag.EsSanLorenzo ?? false);
    var listaRamalFerroviario = (IEnumerable<SelectListItem>)ViewBag.ListaRamalFerroviario;

    var workflow = (string)ViewBag.Workflow;
    var ListaMateriales = (Molinos.Scato.Dominio.Dto.MaterialPorWorkflowDto[])ViewBag.ListaMateriales;

    var tabIndexFechaCp = esIngreso ? 0 : -1;
    var tabIndexCTG = esIngreso ? 0 : -1;
    var dias = Double.Parse(ConfigurationManager.AppSettings["DiasAntiguedadFechaCP"]);

    if (tiposComerciales.Count() == 1)
    {
        Model.TipoComercialId = Convert.ToInt32(tiposComerciales.First().Value);
    }

    if (ViewBag.SoloLectura == null)
    {
        ViewBag.SoloLectura = false;
    }
    bool soloLectura = ViewBag.SoloLectura;
    var ocultar = Model.TomarFotoEnMesa ? "" : "display: none;";
    var leerCpDeFoto = Model.LeerCPDeFoto ? "" : "display: none;";
    var IdCartaPorte = Model.Id;
    var fechaCPIni = Model.FechaCP.Formatted();
    var fechaVTOcp = Model.FechaVto.Formatted();
    var vehiculoJsonModel = Model.VehiculoJson;
    var cupo = Model.Cupo;
    var tipoVehi = Model.TipoVehiculoInt;
    var esEgreso = (bool)(ViewBag.EsEgreso ?? false);
    var tipoAlertaEnumLayout = ViewBag.TipoDeAlertaTasaMunicipal as TipoAlerta?;
}

<style>
    #alertaTasaMunicipalExitosa {
        text-align: center !important;
        font-weight: bold !important;
    }

    #alertaTasaMunicipalError {
        text-align: center !important;
        font-weight: bold !important;
    }
</style>

@if (!string.IsNullOrEmpty(ViewBag.MensajeAlertaTasaMunicipal) && @tipoAlertaEnumLayout == TipoAlerta.Exito)
{
    <script type="text/javascript">MostrarAlertaExitosaTasaMunicipal('@ViewBag.MensajeAlertaTasaMunicipal', 10000);</script>
}

@if (!string.IsNullOrEmpty(ViewBag.MensajeAlertaTasaMunicipal) && @tipoAlertaEnumLayout == TipoAlerta.Error)
{
    <script type="text/javascript">MostrarAlertaAdvertenciaTasaMunicipal('@ViewBag.MensajeAlertaTasaMunicipal', 10000);</script>
}

