<div id="grilla">
    <div class="span10">
        <div class="row-fluid">
            @Html.Hidden("descuentosPostBack", descuentos)
            <input type="hidden" name="descuentos" id="descuentos" data-bind="value: ko.toJSON(descuentos)" />
            <div class="bordeGris">
                @Textos.Descuento_ValorDesde :
                <input type="text" data-bind="value: newValorDesde" id="valorDesde" class="input-mini campoDesdeVacio campoNumerico" disabled data-error-vacio="@string.Format(Textos.Error_Requerido, Textos.Descuento_ValorDesde)" />
                @*@Html.ValidationMessage("valorDesde", new {@class = "validaDesde help-block"})*@
                @Textos.Descuento_ValorHasta :
                <input type="text" data-bind="value: newValorHasta, event: { keyup: $root.actualizarNewValorDesde }" id="valorHasta" class="input-mini campoHastaVacio campoNumerico" data-error-vacio="@string.Format(Textos.Error_Requerido, Textos.Descuento_ValorHasta)" />
                @*@Html.ValidationMessage("valorHasta", new {@class = "validaHasta help-block"})*@
                @Textos.Descuento_PorcentajeDescuento :
                <input type="text" data-bind="value: $root.newPorcentajeDescuento" id="porcentajeDescuento" class="input-mini campoPorcentVacio campoNumerico" data-error-vacio="@string.Format(Textos.Error_Requerido, Textos.Descuento_PorcentajeDescuento)" />
                @Textos.Descuento_PorcentajeAuditoriaCamara :
                <input type="text" data-bind="value: $root.newPorcentajeEnvioCamaraAuditoria" id="porcentajeEnvioCamaraAuditoria" class="input-mini campoPorcentVacio campoNumerico" data-error-vacio="@string.Format(Textos.Error_Requerido, Textos.Descuento_PorcentajeAuditoriaCamara)" />
                @Textos.Descuento_MercadoATermino :
                <input type="checkbox" data-bind="checked: $root.newMercadoATermino" />
                @*@Html.ValidationMessage("porcentajeDescuento", new {@class = "validaPorcentaje help-block"})*@
                <button id="botonCrearDescuento" data-bind="click: botonCrearDescuento" class="btn" data-obtener-descuentos="@Url.Action("ObtenerDescuentos", "CaracteristicaDeCalidad")">@Textos.Crear</button>
            </div>
        </div>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th>% Desc</th>
                    <th>% Audit</th>
                    <th>@Textos.Eliminar</th>
                </tr>
            </thead>
            <tbody data-bind="foreach: descuentos">
                <tr>
                    <td data-bind="text: ValorDesde" />
                    <td data-bind="text: ValorHasta" />
                    <td data-bind="text: PorcentajeDescuento" />
                    <td>
                        <span data-bind="text: PorcentajeEnvioCamaraAuditoria"></span>
                        <span data-bind="text: MercadoATermino"></span>
                    </td>

                    <td><a href="#" data-bind="click: $root.removeDescuento"><i class="icon-trash"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#ValorProteina").prop("disabled", true);
        $("#TipoCaracteristica").change(function () {
            if ($("#TipoCaracteristica").val() == "EsProteina") {
                $("#ValorProteina").css({
                    'background-color': '#fff'
                });
                $("#ValorProteina").prop("disabled", false);
            } else {
                $($($($('#ValorProteina').parent()).children()[1]).children()[0]).remove();
                $("#ValorProteina").css({
                    'width': '206px',
                    'background-color': '#eee',
                    'border': '1px solid #cccccc',
                });
                $("label[for=ValorProteina]").css({
                    'color': '#333'
                });
                $("#ValorProteina").val("");
                $("#ValorProteina").prop("disabled", true);
            }
        });
    });
</script>