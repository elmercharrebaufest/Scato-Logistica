@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Seguridad
@using Molinos.Scato.Web.Seguridad
@model Molinos.Scato.Web.Models.Pesada
@{
    Layout = null;
    var actividad = (PermisosScato)ViewBag.Etapa;
}
<div class="row-fluid row-fluid-ie7" id="peso-bruto-columna">
    <div id="peso-bruto" class="span12 margin-top border text-center @(actividad != PermisosScato.ActividadPesadaBruto ? "disabled-div" : "")" @(actividad != PermisosScato.ActividadPesadaBruto ? "readonly" : "")>
        <table class="full-width">
            <thead>
                <tr>
                    <td colspan="4">
                        <div class="grey-background">
                            <p class="text-center margin-top bold-text"><span class="titulo">Peso Bruto</span></p>
                        </div>
                        <div id="balanza" style="padding-bottom: 0; margin-left:15px;margi-rigth:15px; margin-left:15px;margin-right:15px; background-color: @Model.Color">
                            @Model.Balanza
                            @if (PermisosHelper.Is(PermisosScato.ActividadPesadaBruto))
                            {
                                <button id="btnACeroBruto" type="button" class="btn hide" tabindex="1" style="margin-left: 15px">@Textos.BalanzaACero_Titulo</button>
                            }
                        </div>
                    </td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>&nbsp;</td>
                    <td colspan="2">
                        <div class="control-group">
                            <div class="controls tomarpeso-container">
                                <div class="input-append">
                                    @if (PermisosHelper.Is(PermisosScato.ActividadPesadaBruto))
                                    {
                                        <button id="tomarPesoBruto" class="btn" type="button" tabIndex="1" data-mensaje-esperar="@Textos.Pesada_Espere">@Textos.TomarPeso</button>
                                    }
                                    else
                                    {
                                        <span class="inline-display labelPeso">Peso Bruto</span>
                                    }
                                </div>
                                <div class="input-append">
                                    @Html.TextBoxFor(model => model.Peso, new { @class = "control input-small peso1", @readonly = "readonly", tabIndex = "-10", data_peso_url = Url.Action("TomarPeso", Model.ActividadXaml), style = "margin-right:10px" })
                                </div>
                                @Html.ValidationMessageFor(model => model.Peso)
                            </div>
                        </div>
                    </td>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <td>&nbsp;</td>
                    <td colspan="2">
                        <div id="bruto-group" class="control-group">
                            <span id="btnpesoneto" class="inline-display labelPeso">Peso Neto</span>
                            <div class="controls inline-display">
                                @Html.TextBox("PesoNeto", null, new { @class = "control input-small", @readonly = "readonly", tabIndex = -10 })
                            </div>
                        </div>
                    </td>
                    <td>&nbsp;</td>
                </tr>
            </tbody>
        </table>
        <div class="boton-carga-container">
            @if (PermisosHelper.Is(PermisosScato.ActividadPesadaBruto))
            {
                <button type="submit" id="boton-finalizado-bruto" class="btn">
                    <span class="boton-carga">Finalizar Pesaje</span>
                </button>
            }
            else if (actividad == PermisosScato.ActividadPesadaBruto || actividad == PermisosScato.ActividadConfirmacionDeCargaDescarga)
            {
                if (actividad == PermisosScato.ActividadPesadaBruto)
                {
                    <div class="alert alert-info" style="text-align:center; margin-bottom:0">
                        <strong>Esperando Pesada...</strong>
                    </div>
                }
                
                <script type="text/javascript">
                    setTimeout(function () {
                        $.get(pesadaBrutoUrl, function (data) {
                            $('#pesadaBrutoDiv').html(data);
                        });
                    }, 1500)
                </script>
            }
            else if(actividad != PermisosScato.ActividadPesadaTara && actividad != PermisosScato.ActividadPesadaBruto && actividad != PermisosScato.ActividadConfirmacionDeCargaDescarga)
            {
                <script type="text/javascript">
                    window.location = $("#ListaDeCamionesUrl").val() + "?evitarRedireccion=true";
                </script>
            }
        </div>
    </div>
</div>