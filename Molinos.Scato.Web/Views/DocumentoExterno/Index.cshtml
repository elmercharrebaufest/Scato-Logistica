@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.DocumentoExternoDto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    ViewBag.Title = "";
    var tiposDocumentoIdentidad = (IEnumerable<SelectListItem>)ViewBag.TiposDocumentoIdentidad;
}

@Html.ValidationSummary(true)

@Scripts.Render("~/bundles/jqueryval")

@if (ViewBag.success != null && ViewContext.ViewData.ModelState.IsValid)
{
    <script>MostrarAlertaExitosa();</script>
}
<link href="~/Content/bulma.min.css" rel="stylesheet" />
<style>

    .file.is-info .file-cta {
        background-color: #0044cc !important;
    }

    .barcodeCanvas {
        cursor: move;
    }

    .hasNroCp,
    .hasNotNroCp {
        position: absolute;
        top: 0px;
        bottom: 0;
        left: 0px;
        min-width: 162px;
        right: 0;
        background-color: rgba(0,255,0,0.4);
        border-radius: 4px;
    }

    .hasNotNroCp {
        background-color: rgba(255,0,0,0.4);
    }

    #dialogo-cp {
        left: 35% !important;
    }

    .imglist {
        list-style-type: none;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        text-align: left;
        justify-content: flex-start;
    }

        .imglist li {
            width: 150px;
            padding: 20px;
            display: inline-block;
            position: relative;
        }

    @@media (min-width: 768px) {
        .imglist li {
            width: 33.3%;
        }
    }

    @@media (min-width: 992px) {
        .imglist li {
            width: 150px;
        }
    }

    .imglist li a img {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 5px;
        width: 150px;
    }

    .imglist li a div:hover {
        box-shadow: 0 0 2px 1px rgba(0, 140, 186, 0.5);
    }

    .imglist li a i {
        position: absolute;
        cursor: pointer;
        bottom: 5px;
        right: 0px;
    }
</style>
<script src="~/Scripts/interact.min.js"></script>
<script src="~/Scripts/draggable_background.js"></script>
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="~/Scripts/tiff.min.js"></script>
<script src="~/Scripts/documentoExterno.js"></script>

<div class="container-fluid">
    <div class="titSecciones">@Textos.DocumentoExterno_Titulo</div>
</div>

@using (Html.BeginForm("Index", "DocumentoExterno", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form-documento-externo" }))
{
    <div class="container-fluid grillaPad">
        <div class="row-fluid">
            <div class="span12">
                <fieldset class="grupo-carta-porte">
                    Ingresar Cartas de porte
                    <div class="row row-carta-porte">
                        <div class="field span4" id="file-js-example" style="margin-top: 3px;">
                            <div class="file is-info has-name">
                                <label class="file-label" style="margin:0">
                                    <input class="file-input" multiple="multiple" type="file" name="resume">
                                    <span class="file-cta" style="width:123px; height:19px">
                                        <span class="file-label">
                                            Seleccione Archivo
                                        </span>
                                    </span>
                                    <span class="file-name" style="color: gray; width:197px; height:19px">
                                        Ningún Archivo Seleccionado
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>

                </fieldset>

            </div>
        </div>
    </div>
}

<div class="container-fluid grillaPad" id="cpsContainer">
    <div class="form-search">
        <div class="row-fluid" style="margin-bottom: 10px;">
            Ver:
            <div class="btn-group">
                <button class="btn btn-danger" title="Ver Fallidos" data-bind="css: {active: showFallidos()}, click: function(data, event) { showFallidos(!showFallidos()); }"><i class="fas fa-times"></i> (<span data-bind="text: cantFallidos()"></span>)</button>
                <button class="btn btn-success active" title="Ver Correctos" data-bind="css: {active: showCorrectos()}, click: function(data, event) { showCorrectos(!showCorrectos()); }"><i class="fas fa-check"></i> (<span data-bind="text: cantCorrectos()"></span>)</button>
            </div>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: useFilename" /> Usar nombre de archivo
            </label>
            <button class="btn btn-primary pull-right" style="background-color: #0044cc !important" data-bind="click: guardarCps">Guardar Cartas de Porte</button>
        </div>
        <div class="well well-small" style="max-height: 500px; overflow-y:auto">
            <ul class="imglist" data-bind="foreach: cpsShow">
                <li class="" style="text-align: center; padding-right: 0px; padding-left: 0px; padding-bottom: 0px; padding-top: 0px; margin-right: 20px; margin-bottom: 10px; ">
                    <span type="text" readonly="readonly" data-bind="text: nroCp()"></span>
                    <a href="#" data-bind="click: $parent.showPopup">
                        <div data-bind="css: { 'hasNroCp' : nroCp().length > 0, 'hasNotNroCp': nroCp().length == 0}">  </div>
                        <img data-bind="attr:{ src: image }">
                        <i class="icon-trash" data-bind="click: $parent.quitarCp, css: {'icon-white': nroCp().length == 0}"></i>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
                @Html.Label("Filtrar por Número de Documento")
                <input type="text" name="filtro" class="input-large" />
                <button type="submit" class="btn">@Textos.Filtrar</button>
            }
        </div>
    </div>

    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
        @Html.Partial("Listar")
    </div>
</div>

<div class="modal hide" id="dialogo-cp" data-backdrop="static">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h5 data-bind="text: filename"></h5>
    </div>
    <div class="modal-body">
        <div style="max-height: 500px; max-width:900px;">
            <img data-bind="attr:{ src: image }" style="max-width:900px;">
        </div>
    </div>
    <div class="modal-footer">
        <input type="text" id="cp-nro" placeholder="Ingrese el nro de carta de porte" data-bind="value: nroCp, valueUpdate: 'afterkeydown'" class="pull-left" style="width:80%" />
        <button id="cp-cerrar" data-dismiss="modal" class="btn btn-success">Aceptar</button>
    </div>
</div>

<div class="modal hide" id="dialogo-cps-errores">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h5>Cartas de porte no guardadas</h5>
    </div>
    <div class="modal-body">
        <div data-bind="foreach: logErrores">
            <div data-bind="text: $data" style="margin-top: 5px; color: red"></div>
        </div>
    </div>
    <div class="modal-footer">
        <button data-dismiss="modal" class="btn">@Textos.Aceptar</button>
    </div>
</div>

