@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.DocumentoExternoDto
@{
    ViewBag.Title = Textos.DocumentoExterno_Modificar;
    Layout = null;
}

@Scripts.Render("~/bundles/jqueryval")

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.DocumentoExterno_Modificar }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)
}

