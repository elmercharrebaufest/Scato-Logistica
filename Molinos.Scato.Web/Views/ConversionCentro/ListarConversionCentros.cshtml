@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    Layout = null;
    var items = (ListaPaginada<ConversionCentroDto>)ViewBag.Items;
}

@Html.Grilla(items,
            grid => grid.Columns(
            grid.ColumnaEliminar(Html, "ConversionCentro"),
            grid.Columna("Centro.Descripcion", Textos.Centro, x => x.CentroDesc),
            grid.Columna("CodigoCamara",  Textos.TablaConversion_CodigoCamara)))
