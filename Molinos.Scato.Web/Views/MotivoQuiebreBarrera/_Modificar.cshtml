@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.MotivoQuiebreBarreraDto
@{
}

<div id="mensajeInvalido" data-invalido="@Textos.Error_Invalido"/>
    
<div class="control-group">
    @Html.LabelFor(model => model.PuestoTrabajo, new {@class = "control-label"})
    <div class="controls">
        @Html.DisplayFor(model => model.PuestoTrabajo, new {@class = "input-medium"})
        @Html.HiddenFor(model => model.PuestoTrabajoId)
        @Html.HiddenFor(model => model.PuestoTrabajo)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Fecha, new {@class = "control-label"})
    <div class="controls">
        @Html.DisplayFor(model => model.Fecha, new {@class = "input-medium"})
        @Html.HiddenFor(model => model.Fecha)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Hora, new {@class = "control-label"})
    <div class="controls">
        @Html.DisplayFor(model => model.Hora, new {@class = "input-medium"})
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Motivo, new {@class = "control-label"})
    <div class="controls">
        @Html.TextAreaFor(model => model.Motivo, new {@class = "input-large"})
        @Html.ValidationMessageFor(model => model.Motivo)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Patente, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Patente, new { @class = "control input-large patente-internacional validaCamion uppercase", data_toggle="tooltip", title=@Textos.Atencion_PantenteInvalida, data_placement="right"})
        @Html.ValidationMessageFor(model => model.Patente)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Transportista, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Transportista, new {@class = "control input-large "})
        @Html.ValidationMessageFor(model => model.Transportista)
        @Html.HiddenFor(model => model.TransportistaId)
    </div>
</div>


<script src="@Url.Script("~/Scripts/motivoQuiebreBarrera.js")" type="text/javascript"></script>
