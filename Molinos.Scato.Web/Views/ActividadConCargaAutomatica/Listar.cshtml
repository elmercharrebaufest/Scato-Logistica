@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    Layout = null;
    var items = (ListaPaginada<ActividadConCargaAutomaticaDto>)ViewBag.Items;
}

@Html.Grilla(items,
    grilla => grilla.Columns(
    grilla.ColumnaEliminarModificar(Html, "ActividadConCargaAutomatica"),
    grilla.Columna("Workflow.Descripcion", Textos.Workflow_Nombre, x => x.WorkflowDescripcion),
    grilla.Columna("Actividad", Textos.Actividad, x => Textos.ResourceManager.GetString("Act" + x.Actividad) ?? x.Actividad)
    ))

