@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ActividadConCargaAutomaticaDto
@{
    Layout = null;
    ViewBag.Title = Textos.ActividadPorDispositivo_Crear;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="@Url.Script("~/Scripts/actividadConCargaAutomatica.js")" type="text/javascript"></script>

@using (Ajax.BeginForm("Crear", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.ActividadConCargaAutomatica_Crear }))
{
    @Html.HiddenFor(model => model.CentroId)
    @Html.Partial("_CrearModificar", Model)
}
