@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@model Molinos.Scato.Dominio.Dto.NotificacionAplicacionDto

<script type="text/javascript">
    var urlActivarMensaje = "@Url.Action("ActivarMensaje")";
    var activarMensaje = false;
    var aceptaMotivo = false;
    var cambioUsuario = true;
    var idMensaje = @Html.Raw(Model.TipoAccion != "Baja" ? Model.Id : 0);
    var estadoActual = "@Html.Raw(Model.TipoAccion)";
</script>

<link href="@Url.Content("~/Content/bootstrap-datetimepicker.css")" rel="stylesheet" type="text/css">
<script src="@Url.Script("~/Scripts/bootstrap-datetimepicker.js")" type="text/javascript"></script>
<link href="~/Content/bootstrap-toggle.min.css" rel="stylesheet" />
<script src="~/Scripts/bootstrap-toggle.min.js"></script>
<script src="@Url.Script("~/Scripts/notificacionAplicacion.js")" type="text/javascript"></script>

<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/columna.css")">

<style>

    div.modal {
        width: 300px
    }
    /*div.modal .control-group {display: inline-block !important}*/
    /*.form-horizontal .control-label {
        padding-top: 0
    }*/
</style>

<div class="titSecciones">@Textos.NotificacionAplicacion</div>

<div class="container content">
    <div class="row well well-small">
        <div class="col-xs-4">
            <input id="activarMensaje" type="checkbox" @Html.Raw(Model.TipoAccion == "Alta" || Model.TipoAccion == "Modificacion" ? "checked" : string.Empty) data-toggle="toggle" data-on="Mensaje Activo" data-off="Sin Mensaje" data-onstyle="success">
        </div>
        <div class="col-xs-8" id="notificaiconActiva">
            @Html.Partial("~/Views/NotificacionAplicacion/_NotificacionActiva.cshtml", Model)
        </div>
    </div>

    <div class="row" id="mensajeActual">
        @Html.Partial("_Listar")
    </div>
</div>
