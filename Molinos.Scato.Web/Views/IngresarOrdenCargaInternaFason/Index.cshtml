@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    ViewBag.Title = Textos.OrdenCargaInternaFason_Titulo;
    var workflow = (string)ViewBag.Workflow;
}

<input id="ErrorAfip" type="hidden" name="ErrorAfip" value="@(ViewBag.ErrorAfip != null ? ViewBag.ErrorAfip.ToString() : string.Empty)" />
<script type="text/javascript">
    $(document).ready(function () {
        if ($("#ErrorAfip").val() != '') {
            MostrarAlertaError($("#ErrorAfip").val());
            $(".btnValidacionCTG").removeAttr("disabled");

        }
    })
</script>

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>

    <script>
    const textoVariasOrdenes = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Textos.OrdenesFasonOperApiVarias))';
    const patenteNoEncontrada = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Textos.PatenteNoEncontradaApiOpera))';
    let hayError = '@Html.Raw(ViewBag.HasErrors)';
    let noCargar = true;
    </script>
}
<link href="~/Styles/area/shared/dialogModal.css" rel="stylesheet" />
<div class="container-fluid">
    <div class="titSecciones" style="margin-bottom:10px;">@Textos.Workflow_Nombre - @Textos.OrdenCargaInternaFason_Titulo</div>
</div>

@using (Html.BeginForm("Index", "IngresarOrdenCargaInternaFason", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content container causaBlock", id = "ordenCargaInternaFason-form", data_mensaje_espera = Textos.ActIngresarOrdenDeCargaInternaFason }))
{
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
    {
        <div class="alert alert-error">
            @Html.ValidationSummary(true)
        </div>
    }
    @Html.Partial("_Orden")

    <div class="control-group paddingRight cajaButtons">
        @*<button class="btn btn-warning btnValidacionR" type="button" onclick="$('#dialogo-rechazar-fason').modal('show')" disabled>@Textos.Rechazar</button>*@
        <button class="btn btn-warning btnValidacionD" type="button" onclick="$('#dialogo-demorar-fason').modal('show')" >@Textos.Demorar</button>
        <button class="btn btn-primary" type="submit">@Textos.Aceptar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
    </div>
}

<div class="modal hide fade" id="dialogo-rechazar-fason">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4>@Textos.Rechazado</h4>
    </div>
    <div class="modal-body form-horizontal">
        <p>¿Está seguro que desea rechazar el camión?</p>
        <div class="controls-small">
            <label for="MotivoRechazo">@Textos.Motivo:</label>
            @Html.TextArea("MotivoRechazoTexto", new { @class = "form-control", style = "width:410px", rows = "2" })
            <span id="error-rechazo-requerido" style="color:rgb(185, 74, 72); display:none;">@string.Format(Textos.Error_Requerido, "Motivo")</span>
            <span id="error-rechazo-largo" style="color:rgb(185, 74, 72); display:none;">@string.Format(Textos.Error_LargoMensaje, "Motivo", "10")</span>
        </div>
    </div>
    <div class="modal-footer">
        <button id="dialogo-rechazar-fason-confirmar" type="button" class="btn">@Textos.Aceptar</button>
        <button id="dialogo-rechazar-fason-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
    </div>
</div>

<div class="modal hide fade" id="dialogo-demorar-fason">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4>@Textos.Demorar</h4>
        <span id="error-demorado-patenteFormato" style="color:rgb(185, 74, 72); display:none;">@Textos.Patente_FormatoError</span>
    </div>
    <div class="modal-body form-horizontal" id="dialogo-confirmar-body">
        @Textos.Material:
        <div class="controls-small">
            @Html.DropDownList("MaterialDemorado", (IEnumerable<SelectListItem>)ViewBag.Materiales, "(materiales)", new { @class = "form-control", style = "width:100%", @disabled = true })
            <span id="error-material" style="color:rgb(185, 74, 72); display:none;">@string.Format(Textos.Error_Requerido, "MaterialDemorado")</span>
        </div>
    </div>
    <div class="modal-body form-horizontal" id="dialogo-confirmar-body">
        @Textos.Motivo:
        <div class="controls-small">
            <textarea id="MotivoDemoraTexto" name="MotivoDemoraTexto" class="form-control" style="width:410px" rows="2"></textarea>
            <span id="error-demorado-requerido" style="color:rgb(185, 74, 72); display:none;">@string.Format(Textos.Error_Requerido, "Motivo")</span>
            <span id="error-demorado-largo" style="color:rgb(185, 74, 72); display:none;">@string.Format(Textos.Error_LargoMensaje, "Motivo", "10")</span>
        </div>
    </div>
    <div class="modal-footer">
        <button id="dialogo-demorar-fason-confirmar" type="button" class="btn">@Textos.Aceptar</button>
        <button id="dialogo-demorar-fason-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
    </div>
</div>

<div class="modal hide fade" id="dialogo-advertir">
    <div class="modal-header alert-danger">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4>@Textos.Advertencia</h4>
    </div>
    <div class="modal-body" id="dialogo-advertir-body">
    </div>
    <div class="modal-footer">
        <button id="dialogo-advertir-cancelar" class="btn btn-warning" data-dismiss="modal" aria-hidden="true">@Textos.Aceptar</button>

    </div>
</div>