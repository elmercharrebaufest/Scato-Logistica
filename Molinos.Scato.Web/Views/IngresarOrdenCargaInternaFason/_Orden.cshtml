     data-url-obtener-domicilios-derivado-granario-por-cliente="@Url.Action("ObtenerDomiciliosDG", "Consultas")"
     data-url-obtener-almacenes-por-material="@Url.Action("ObtenerAlmacenesPorMaterial", "IngresarOrdenCargaInterna")"
     data-url-obtener-mensaje="@Url.Action("MostrarMensajeRecorridoAnterior", "IngresarOrdenCargaInternaFason")"
     data-url-obtener-orden-de-carga-operaciones-por-patente="@Url.Action("ObtenerOrdenDeCargaOperacionesPorPatente","IngresarOrdenCargaInternaFason")"
