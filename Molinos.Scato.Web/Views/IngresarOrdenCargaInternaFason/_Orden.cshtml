<div class="row-fluid row-fluid-ie7">
    <fieldset class="grupo-carta-porte">
        <div class="span6">
            <div class="control">
                @Html.LabelFor(model => model.NumeroOrden, new { @class = "control-label small margin10" })
                <div class="">
                    @Html.TextBoxFor(model => model.NumeroOrden, new { @class = "control ", autocomplete = "off", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.NumeroOrden)
                </div>
            </div>
            <div class="control derivadoGranario @(Model.DerivadoGranarioHabilitado ? "" : "hidden")">
                @Html.LabelFor(model => model.NumeroCTG, new { @class = "control-label small margin10" })
                <div class="">
                    @Html.TextBoxFor(model => model.NumeroCTG, new { @class = "control", autocomplete = "off", @readonly = "readonly" })
                </div>
            </div>
        </div>
        <div class="span6">
            <div class="control paddingRight">
                @Html.LabelFor(model => model.FechaEmision, new { @class = "control-label small", style = "margin-left:15%" })
                <div class="">
                    @Html.TextBoxFor(model => model.FechaEmision, new { @Value = Model != null ? Model.FechaEmision.FormattedFixed() : string.Empty, @class = "", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.FechaEmision)
                </div>
            </div>
            <div class="control paddingRight derivadoGranario @(Model.DerivadoGranarioHabilitado ? "" : "hidden")">
                @Html.LabelFor(model => model.NumeroCPE, new { @class = "control-label small", style = "margin-left:15%" })
                <div class="">
                    @Html.TextBoxFor(model => model.NumeroCPE, new { @class = "control", autocomplete = "off", @readonly = "readonly" })
                </div>
            </div>
        </div>
