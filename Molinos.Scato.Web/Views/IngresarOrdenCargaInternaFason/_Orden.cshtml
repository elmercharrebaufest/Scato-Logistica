            }



            <div class="control">
                @Html.LabelFor(model => model.TipoComercialId, new { @class = "control-label small margin10" })
                <div class="" id="tiposComerciales" data-alta-rapida='@Html.Raw(Json.Encode(((IEnumerable<string>)ViewBag.TiposComercialesTransportista).Select(x => x)))'>
                    @Html.DropDownListFor(model => model.TipoComercialId, tiposComerciales, Textos.Default_TipoComercial, new { @class = "control ", @disabled = "disabled" })
