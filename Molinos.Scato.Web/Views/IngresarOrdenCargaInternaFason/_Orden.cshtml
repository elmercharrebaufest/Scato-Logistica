                    {
                        @Html.TextBoxFor(model => model.NumeroOrdenExterno, new { @class = "control", @readonly = "readonly" })
                        @Html.ValidationMessageFor(model => model.NumeroOrdenExterno)
                    }
                    else
                    {
                        @Html.DropDownListFor(model => model.NumeroOrdenExterno, emptySelectListItem, new { @class = "control ", autocomplete = "off", @onchange = "seleccionarOrdenDeCargaOperaciones()", data_selected_value = Model.NumeroOrdenExterno })
