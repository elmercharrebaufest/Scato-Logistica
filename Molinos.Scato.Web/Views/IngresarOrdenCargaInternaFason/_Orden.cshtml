@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.OrdenCargaInternaFasonDto
@{
    var tiposComerciales =(IEnumerable<SelectListItem>)ViewBag.TiposComerciales;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
    var tiposDocumentos = (IEnumerable<SelectListItem>)ViewBag.TiposDocumentos;
    var kmdropdown = new List<SelectListItem>();
    var tiposVehiculo = (IEnumerable<SelectListItem>)ViewBag.TiposVehiculo;
    var emptySelectListItem = new List<SelectListItem>();
    var plantasDG = new List<SelectListItem>();
    var domiciliosDG = new List<SelectListItem>();
    var listaMaterialesDerivadoGranario = (List<int>)ViewBag.MaterialesDerivadoGranario;
    string WorkflowDescripcion = ViewBag.WorkflowDescripcion;

    tiposComerciales = WorkflowDescripcion.Contains("Sin Flete") ? tiposComerciales.Where(c=> c.Text.Contains("SALIDA")).ToList() : tiposComerciales.Where(c => c.Text.Contains("EGRESO")).ToList();

    string url = Request.Url.AbsoluteUri;
}

<div id="links"
     data-url-obtener-proveedores-sap="@Url.Action("ObtenerProveedoresSap", "Consultas")"
