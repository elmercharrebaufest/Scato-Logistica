            </div>

            @if (url.Contains("IngresarOrdenCargaInternaFason"))
            {
                <div class="control">
                    @Html.LabelFor(model => model.TipoVehiculo, new { @class = "control-label small margin10" })
                    <div class="">
                        @Html.DropDownListFor(model => model.TipoVehiculo, tiposVehiculo, new { @class = "control ", autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.TipoVehiculo)
                    </div>
                </div>
            }
            else
            {
                <div class="control">
                    @Html.LabelFor(model => model.TipoVehiculo, new { @class = "control-label small margin10" })
                    <div class="">
                        @Html.DropDownListFor(model => model.TipoVehiculoLectura, tiposVehiculo, new { @class = "control ", autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.TipoVehiculo)
                    </div>
