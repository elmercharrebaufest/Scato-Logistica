                    {
                        @Html.TextBoxFor(Model => Model.LocalidadDestinoDescripcion, new { @id = "LocalidadDescripcion", @disabled = "disabled" })
                    }
                    else
                    {
                        @Html.TextBox("LocalidadDescripcion", "", new { @id = "LocalidadDescripcion", @disabled = "disabled" })
                    }
                    <span class="field-validation-valid help-block"></span>
                    @Html.HiddenFor(model => model.LocalidadDestinoId)
                    @Html.HiddenFor(model => model.LocalidadDestinoDescripcion)
