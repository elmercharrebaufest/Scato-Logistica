@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    ViewBag.Title = Textos.IngresoBinSalida_Titulo;
    var tipoBin = (IEnumerable<SelectListItem>)ViewBag.TipoBin;
    var binesIngreso = (IEnumerable<DescargaDeBinesDto>) ViewBag.BinesIngreso;
}


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/ingresoBinSalida.js")"></script>
<script src="~/scripts/jquery.maskedinput.js"></script>
<script type="text/javascript">
    var tiposBines = @Html.Raw(ViewBag.TipoBinJson);
    var remitoId = @ViewBag.RemitoId;
    var kgBinesIngreso = @Html.Raw(ViewBag.KilosBinesIngreso);
</script>

<style>
    .validation-summary-errors {
        color: #b94a48;
        font-size: 15px;
    }
</style>

<div class="container-fluid">
    <div class="titSecciones">@Textos.IngresoBinSalida_Titulo</div>
</div>
<div>
    <div class="row-fluid row-fluid-ie7">
        <div class="span4">
            <div>@Textos.IngresoBinSalida_IngresoPlanta</div>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>@Textos.CantidadDeBines</th>
                        <th>@Textos.TipoDeBin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var binIngreso in binesIngreso)
                    {
                        <tr>
                            <td>@binIngreso.CantidadBines</td>
                            <td>@binIngreso.Tipo</td>
                        </tr>  
                    }
                </tbody>
            </table>
        </div>
        <div class="span8">
            <div>@Textos.IngresoBinSalida_SalidaPlanta</div>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>@Textos.CantidadDeBines</th>
                        <th>@Textos.TipoDeBin</th>
                        <th>@Textos.Eliminar</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: egresos">
                    <tr>
                        <td data-bind="text: CantidadBines" />
                        <td data-bind="text: Tipo" />
                        <td><a href="#" data-bind="click: $root.removeEgreso"><i class="icon-trash"></i></a></td>
                    </tr>
                </tbody>
            </table>

            <div class="row-fluid row-fluid-ie7">
                <fieldset class="grupo-carta-porte form-horizontal">
                    <div id="binesSalida" class="span9">
                        <div class="control-group">
                            <label for="cantidad" class="control-label">@Textos.CantidadDeBines</label>
                            <div class="controls">
                                <input id="cantidad" name="cantidad" type="text" class="control campoCantidad" data-bind="value: newCantidad" maxlength="3"/>
                            </div>
                        </div>
                        <div class="control-group">
                            <label for="tipoBin" class="control-label">@Textos.TipoDeBin</label>
                            <div class="controls">
                                <select id="tipoBin" name="tipoBin" class="control input-large" 
                                        data-bind="options: tiposBines, optionsText: 'Descripcion', value: newTipoBin">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="span2">
                        <button class="btn btn-primary" type="button" id="botonAgregarBin" data-bind="click: addBin">@Textos.Agregar</button>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>
    <div class="row-fluid row-fluid-ie7">
        <div class="span4">
            <fieldset class="grupo-carta-porte form-horizontal">
                <div>@Textos.IngresoBinSalida_Resumen</div>
                <div class="control-group">
                    <label class="control-label small">@Textos.KgBinesBruto</label>
                    <div class="controls">
                        <span class="strong">@ViewBag.KilosBinesIngreso</span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label small">@Textos.KgBinesTara</label>
                    <div class="controls">
                        <span data-bind="text: kgBinesTara" class="strong"></span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label small">@Textos.NetoBines</label>
                    <div class="controls">
                        <span data-bind="text: netoBines" class="strong"></span>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="span8">
            <fieldset class="grupo-carta-porte">
                <div class="control-group control-group-no-bottom">
                    <label for="observacion" class="control-label">@Textos.Observaciones</label>
                    <div class="control-group">
                        <textarea id="observacion" class="control margin textarea-xlarge" data-bind="value: observacion"></textarea>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
    
    <div class="hidden">
        <p id="errorTipoBinExistente">@Textos.IngresoBinSalida_TipoBinExistente</p>
    </div>

    <div class="hidden">
        <p id="errorTipoBinVacio">@Textos.IngresoBinSalida_TipoBinVacio</p>
    </div>

    <div class="hidden">
        <p id="errorNumerico">@Textos.IngresoBinSalida_CantidadNoNumerico</p>
    </div>

    @using (Html.BeginForm("Index", "IngresoBinSalida", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActIngresoBinSalida }))
    {
        @Html.ValidationSummary()
        <input type="hidden" name="workflowDefinicionId" value="@ViewBag.WorkflowDefinicionId"/>
        <input type="hidden" name="guid" id="guid" value="@ViewBag.Guid"/>
        <input type="hidden" name="workflow" value="@ViewBag.Workflow"/>
        <input type="hidden" name="binesSalida" data-bind="value: ko.toJSON(egresos)" />
        <input type="hidden" name="observacion" data-bind="value: observacion" />
        
        <div class="row right">
            <button type="submit" name="aceptar" id="aceptar" class="btn btn-primary aceptar">@Textos.Aceptar</button>
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
        </div>
    }

</div>

<div id="mensajeRechazar">
</div>
