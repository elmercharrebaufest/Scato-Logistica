@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers


@{
    Layout = null;
    var items = (ListaPaginada<CategoriaVehiculoDto>) ViewBag.Items;
}

@Html.Grilla(items,
    grilla => grilla.Columns(
    grilla.ColumnaEliminarModificar(Html, "CategoriaCamiones"),
    grilla.Columna("Patente", Textos.CategoriaCamiones_Patente),
    grilla.Columna("PatenteAcoplado", Textos.CategoriaCamiones_PatenteAcoplado),
    grilla.Columna("PatenteAcoplado2", Textos.CategoriaCamiones_PatenteAcoplado2),
    grilla.Columna("TipoVehiculoDescripcion", Textos.CategoriaCamiones_TipoVehiculo)
    ))

