@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.OrdenDeDescargaFasonDto
@{
    ViewBag.Title = Textos.ControlDeIngreso_Titulo;
    var workflow = ViewBag.Workflow;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
    <script src="@Url.Script("~/Scripts/ordenDeDescargaFason.index.js")" type="text/javascript"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/validarCuil.js")"></script>
    <script src="@Url.Script("~/Scripts/validarFechas.js")" type="text/javascript"></script>
    <script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
    <script src="~/scripts/knockout.simpleGrid.1.3.js"  type="text/javascript"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/rechazarCamion.js")"></script>
}

<style>
 .content { padding-top: 20px;}

</style>
<div class ="container">
    <div class="titSecciones">@Textos.ControlDeIngreso_Titulo</div>
</div>

@using (Html.BeginForm("OrdenDeDescargaFason", "ControlDeIngreso", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content container causaBlock", id = "orden-form", data_mensaje_espera = Textos.ControlDeIngreso_MensajeDeEspera }))
{
    @Html.ValidationSummary(true)
    
    <input type="hidden" name="guid" id="guid" value="@ViewBag.Guid"/>
    <input type="hidden" name="docId" id="docId" value="@ViewBag.DocId"/>
    
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
     {
         <div class="alert alert-error">
             @Html.ValidationSummary(true)
         </div>
     }
    @Html.Partial("~/Views/CargarOrdenDeDescargaFason/_Orden.cshtml",Model)
    @Html.ActionLink(Textos.ExcesoDePeso_Rechazar, "Rechazar", "ControlDeIngreso", new {codigoWf = ViewBag.Workflow, workflowDefinicionId= ViewBag.WorkflowDefinicionId, instanceId = ViewBag.Guid }, new{@class = "rechazar rechazar-boton btn btn-primary pull-right"})
}

<div id ="mensajeRechazar">
    
</div>