@model Molinos.Scato.Dominio.Dto.ConfiguracionCalleHidraulicaDto
@{
    var sensoresBajada = (IEnumerable<SelectListItem>)ViewBag.SensoresBajada;
    var calles = (IEnumerable<SelectListItem>)ViewBag.Calles;
    var carteles = (IEnumerable<SelectListItem>)ViewBag.Carteles;
    var camaras = (IEnumerable<SelectListItem>)ViewBag.Camaras;
}

<div class="control-group">
    @Html.LabelFor(model => model.CalleId, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.CalleId, calles, new { @class = "control input-medium" })
        @Html.ValidationMessageFor(m => m.CalleId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoCartel, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.CodigoCartel, carteles, string.Empty)
        @Html.ValidationMessageFor(model => model.CodigoCartel)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoSensorCamaraALPR, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.CodigoSensorCamaraALPR, sensoresBajada, string.Empty)
        @Html.ValidationMessageFor(model => model.CodigoSensorCamaraALPR)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoSensorCirculacion, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.CodigoSensorCirculacion, sensoresBajada, string.Empty)
        @Html.ValidationMessageFor(model => model.CodigoSensorCirculacion)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoCamaraALPR, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.CodigoCamaraALPR, camaras, string.Empty)
        @Html.ValidationMessageFor(model => model.CodigoCamaraALPR)
    </div>
</div>