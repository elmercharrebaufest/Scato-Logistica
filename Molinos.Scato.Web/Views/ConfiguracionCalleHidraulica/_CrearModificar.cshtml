@model Molinos.Scato.Dominio.Dto.ConfiguracionCalleHidraulicaDto
@{
    var puestosDeTrabajo = (IEnumerable<SelectListItem>)ViewBag.PuestosDeTrabajo;
    var sensoresBajada = (IEnumerable<SelectListItem>)ViewBag.SensoresBajada;
}

<div class="control-group">
    @Html.LabelFor(model => model.Nombre, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Nombre, new {@class = "input-large"})
        @Html.ValidationMessageFor(model => model.Nombre)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.PuestoDeTrabajoId, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.PuestoDeTrabajoId, puestosDeTrabajo, new {@class = "input-large"})
        @Html.ValidationMessageFor(model => model.PuestoDeTrabajoId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoSensorBajada, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.CodigoSensorBajada, sensoresBajada, string.Empty)
        @Html.ValidationMessageFor(model => model.CodigoSensorBajada)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.EsSojaSustentable, new {@class = "control-label"})
    <div class="controls">
        @Html.CheckBoxFor(m => m.EsSojaSustentable, new {@class = "control"})
        @Html.ValidationMessageFor(m => m.EsSojaSustentable)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.EsEspecial, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(m => m.EsEspecial, new { @class = "control" })
        @Html.ValidationMessageFor(m => m.EsEspecial)
    </div>
</div>