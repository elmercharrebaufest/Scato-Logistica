@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.ConfiguracionCalleHidraulicaDto
@{
    Layout = null;
    ViewBag.Title = Textos.Hidraulica_Modificar;
}

@Scripts.Render("~/bundles/jqueryval")

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Hidraulica_Modificar }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    <div class="control-group">
        @Html.LabelFor(model => model.CalleNombre, new {@class = "control-label"})
        <div class="controls">
            @Html.TextBoxFor(model => model.CalleNombre, new {@class = "input-medium", @readonly = "readonly"})
            @Html.ValidationMessageFor(model => model.CalleNombre)
        </div>
    </div>
    @Html.Partial("_CrearModificar", Model)
}