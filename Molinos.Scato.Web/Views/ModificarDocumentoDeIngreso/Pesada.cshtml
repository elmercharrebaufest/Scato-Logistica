@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.RecorridoDto
  
@{
    string balanzaBruto = ViewBag.BalanzaBruto;
    string balanzaTara = ViewBag.BalanzaTara;
    string actividad = ViewBag.Actividad;
    string lotes = ViewBag.Lotes;
    string docSap = ViewBag.DocSap;
    int recorridoId = ViewBag.RecorridoId;
    bool esRechazado = ViewBag.Rechazado;
    var fechaBruto = Model.PesoBrutoFecha.FormattedNullableTime();
    var fechaTara = Model.PesoTaraFecha.FormattedNullableTime();
    var fechaInicio = Model.FechaInicio.FormattedTime();
    var fechaSalida = Model.FechaEgreso.FormattedNullableTime();
    var fechaCalado = ViewBag.FechaCalado != null ? ((DateTime?)ViewBag.FechaCalado).FormattedNullableTime() : "";
    string tipoDocumento = ViewBag.TipoDocumentoString;
    string patente = ViewBag.Patente;
    string numeroDoc = ViewBag.NumeroDocumento;
    bool tieneDatosExportacion = ViewBag.TieneDatosExportacion;
}
    <div class="container-fluid">
        @{
            <div class="titSecciones">@Textos.ConsultarDocumentoDeIngreso_Titulo</div>
            <br />
            <div class="row">
                <div class="span2 negrita">@Textos.Workflow_TipoDocumentoDeIngreso</div>
                <label class="span2" style="margin-left:-14px">@tipoDocumento</label>
                <div class="span2 negrita">@Textos.NumeroDocumentoIngreso</div>
                <label class="span2" style="margin-left:-53px">@numeroDoc</label>
                <div class="span2 negrita" style="">@Textos.Patente</div>
                <label class="span2" style="margin-left:-43px">@patente</label>
                <div class="right">
                    @Html.ActionLink(Textos.Volver, "Index", "ModificarDocumentoDeIngreso", new { soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, new { @class = "btn" })

                </div>
            </div>
           

        }

    </div>
<div id="pesada">
    <div class ="container-fluid" >
        <ul class="nav nav-tabs">
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_DatosDeOrigen, "DocumentoOrigen", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = ViewBag.TipoDoc, numeroDoc = ViewBag.NumeroDoc, patente = ViewBag.Patente, soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li class="active">
                @Html.ActionLink(Textos.Pesada, "Pesada", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = ViewBag.TipoDoc, numeroDoc = ViewBag.NumeroDoc, patente = ViewBag.Patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AnalisisDeCalidad, "AnalisisDeCalidad", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = ViewBag.TipoDoc, numeroDoc = ViewBag.NumeroDoc, patente = ViewBag.Patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AsignacionDeRuta, "AsignacionDeRuta", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = ViewBag.TipoDoc, numeroDoc = ViewBag.NumeroDoc, patente = ViewBag.Patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_Fotos, "Fotos", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = ViewBag.TipoDoc, numeroDoc = ViewBag.NumeroDoc, patente = ViewBag.Patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado, tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.Recorrido, "Recorrido", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = ViewBag.TipoDoc, numeroDoc = ViewBag.NumeroDoc, patente = ViewBag.Patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado, tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            @if (tieneDatosExportacion)
            {
                <li>
                    @Html.ActionLink(Textos.DatosExportacion, "DatosExportacion", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = ViewBag.NumeroDoc, patente = patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado, tieneDatosExportacion = tieneDatosExportacion }, null)
                </li>
            }
            @if (esRechazado)
            {
                <label class="text-right " style="color: #FF0000; font-size: 13pt ;position: relative; display: inline-block; float:right; top: 10px">@Textos.Rechazado</label>
            }
        </ul>

    </div>

    

    @using (Html.BeginForm("Pesada", "ModificarDocumentoDeIngreso", null, FormMethod.Post, new { @class = "form-horizontal content container-fluid causaBlock", id = "orden-form"}))
    {
        if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
        {
            <div class="alert alert-error">
                @Html.ValidationSummary(true)
            </div>
        }
     
        <div class="row-fluid row-fluid-ie7">
            <div class="span6">
                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.LabelFor(model => model.BalanzaBrutoId, new { @class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => balanzaBruto, new { @class = "control input-large"})
                        </div>
                    </div>
                </div>
                
                <br/>
        
                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.LabelFor(model => model.BalanzaTaraId, new { @class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => balanzaTara, new { @class = "control input-large"})
                        </div>
                    </div>
                </div>
            
                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.LabelFor(model => model.Almacen, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => model.Almacen.Descripcion, new { @class = "control"})
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.Actividad, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => actividad, new { @class = "control"})
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.ConsultarDocumentoDeIngreso_Lote, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => lotes, new { @class = "control"})
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.ConsultarDocumentoDeIngreso_DocSap, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => docSap, new { @class = "control"})
                        </div>
                    </div>
                </div>

            </div>

            <div class="span6">
                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.PesoBrutoFecha, new { @class = "control-label" })
                        <div class="controls">
                            @Html.DisplayFor(model => fechaBruto, new { @class = "control"})
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.PesoTaraFecha, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => fechaTara, new {@class = "control"})
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.FechaInicio, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => fechaInicio, new {@class = "control"})
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.FechaEgreso, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => fechaSalida, new {@class = "control"})
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row row-carta-porte">
                    <div class="control-group control-group-no-bottom">
                        @Html.Label(Textos.Workflow_FechaCalado, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DisplayFor(model => fechaCalado, new {@class = "control"})
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <br/>
        <br/>

        <div class="row-fluid row-fluid-ie7">
            <fieldset class="grupo-carta-porte">
                <div class="span6">
                    @Textos.PesoOrigen
                    <div class="row row-carta-porte">
                        <div class="control-group control-group-no-bottom">
                            @Html.LabelFor(model => model.PesoBrutoOrigen, new {@class = "control-label"})
                            <div class="controls-small">
                                @Html.DisplayFor(model => model.PesoBrutoOrigen, new {@class = "control"})
                            </div>
                        </div>
                    </div>     
    
                    <br/>

                    <div class="row row-carta-porte">
                        <div class="control-group control-group-no-bottom">
                            @Html.LabelFor(model => model.PesoTaraOrigen, new {@class = "control-label"})
                            <div class="controls-small">
                                @Html.DisplayFor(model => model.PesoTaraOrigen, new {@class = "control"})
                            </div>
                        </div>
                    </div>

                    <br/>

                    <div class="row row-carta-porte">
                        <div class="control-group control-group-no-bottom">
                            @Html.LabelFor(model => model.PesoNetoOrigen, new {@class = "control-label"})
                            <div class="controls-small">
                                @Html.DisplayFor(model => model.PesoNetoOrigen, new {@class = "control"})
                            </div>
                        </div>
                    </div>

                </div>

                <div class="span6">
                    @Textos.PesoPlanta    
                    <div class="row row-carta-porte">
                        <div class="control-group control-group-no-bottom">
                            @Html.LabelFor(model => model.PesoBruto, new {@class = "control-label"})
                            <div class="controls-small">
                                @Html.DisplayFor(model => model.PesoBruto, new {@class = "control"})
                            </div>
                        </div>
                    </div>
                
                    <br/>

                    <div class="row row-carta-porte">
                        <div class="control-group control-group-no-bottom">
                            @Html.LabelFor(model => model.PesoTara, new {@class = "control-label"})
                            <div class="controls-small">
                                @Html.DisplayFor(model => model.PesoTara, new {@class = "control"})
                            </div>
                        </div>
                    </div>
                
                    <br/>

                    <div class="row row-carta-porte">
                        <div class="control-group control-group-no-bottom">
                            @Html.LabelFor(model => model.PesoNeto, new {@class = "control-label"})
                            <div class="controls-small">
                                @Html.DisplayFor(model => model.PesoNeto, new {@class = "control"})
                            </div>
                        </div>
                    </div>
                
                    <br/>

                    <div class="row row-carta-porte">
                        <div class="control-group control-group-no-bottom">
                            @Html.LabelFor(model => model.PesoDiferencia, new {@class = "control-label"})
                            <div class="controls-small">
                                @Html.DisplayFor(model => model.PesoDiferencia, new {@class = "control"})
                            </div>
                        </div>
                    </div>

                </div>
            </fieldset>
        </div>

        <br/>

        <div class="row-fluid row-fluid-ie7">
            <div class="span4">
                <div class="row row-carta-porte">
                </div>
            </div>
            <div class="span4">
                <div class="row row-carta-porte">
                </div>
            </div>
           
        </div>
    }
</div>