@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.OrdenDeDescargaFasonDto
@{
    if (ViewBag.esDocumentoDeOrigen != null && ViewBag.esDocumentoDeOrigen)
    {
        Layout = null;
    }
    if (ViewBag.SoloLectura == null)
    {
        ViewBag.SoloLectura = false;
    }
    ViewBag.Title = Textos.OrdenDeDescargaFason_Titulo;
    bool soloLectura = ViewBag.SoloLectura;
    string workflow = ViewBag.Workflow;
    int recorridoId = ViewBag.RecorridoId;
    bool esRechazado = ViewBag.Rechazado;
    string patente = ViewBag.Patente;
    string tipoDocumento = ViewBag.TipoDocumentoString;
    string numeroDoc = ViewBag.NumeroDocumento;
}

@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script src="@Url.Script("~/Scripts/ordenDeDescargaFason.index.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/validarCuil.js")"></script>
<script src="@Url.Script("~/Scripts/validarFechas.js")" type="text/javascript"></script>
<style>
    .content { padding-top: 20px;}
</style>

@if (!soloLectura)
{
    <script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
    <script src="~/scripts/knockout.simpleGrid.1.3.js"  type="text/javascript"></script>    
}
<script>
    $(document).ready(function () {
        if ($('#soloLectura').val() == "True") {
            $('input').attr("disabled", "disabled");
            $('select').attr("disabled", "disabled");
            $("#aceptar").attr("style", "visibility: hidden");
        }
        $('#tipoVehiculoDropdown').attr("readonly", "readonly");
        $('#tipoVehiculoDropdown').attr("disabled", "disabled");
        $('#EsTransportista').val(true);
    });
</script>

<style>
    .content { padding-top: 20px;}

</style>

<div class="container-fluid">
    @{
        if (soloLectura)
        {
            <div class="titSecciones">@Textos.ConsultarDocumentoDeIngreso_Titulo</div>
            <br />
            <div class="row">
                <div class="span2 negrita">@Textos.Workflow_TipoDocumentoDeIngreso</div>
                <label class="span2" style="margin-left:-14px">@tipoDocumento</label>
                <div class="span2 negrita">@Textos.NumeroDocumentoIngreso</div>
                <label class="span2" style="margin-left:-53px">@numeroDoc</label>
                <div class="span2 negrita" style="">@Textos.Patente</div>
                <label class="span2" style="margin-left:-43px">@patente</label>
                <div class="right">
                    @Html.ActionLink(Textos.Volver, "Index", "ModificarDocumentoDeIngreso", new { soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, new { @class = "btn" })
                </div>
            </div>


        }
        else
        {
            <div class="titSecciones">@Textos.ModificarDocumentoDeIngreso_Titulo</div>
            <br />
            <div class="row">
                <div class="span2 negrita">@Textos.Workflow_TipoDocumentoDeIngreso</div>
                <label class="span2" style="margin-left:-14px">@tipoDocumento</label>
                <div class="span2 negrita">@Textos.NumeroDocumentoIngreso</div>
                <label class="span2" style="margin-left:-53px">@numeroDoc</label>
                <div class="span2 negrita" style="">@Textos.Patente</div>
                <label class="span2" style="margin-left:-43px">@patente</label>
                <div class="right">
                    @Html.ActionLink(Textos.Volver, "Index", "ModificarDocumentoDeIngreso", new { soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, new { @class = "btn" })
                </div>
            </div>
        }
    }
</div>

@if (soloLectura && (ViewBag.esDocumentoDeOrigen == null || !ViewBag.esDocumentoDeOrigen))
{
    <div class ="container">
        <ul class="nav nav-tabs">
            <li class="active">
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_DatosDeOrigen, "DocumentoOrigen", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenDeDescargaFason, numeroDoc = Model.Numero, patente = Model.PatenteCamion, soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.Pesada, "Pesada", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenDeDescargaFason, numeroDoc = Model.Numero, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AnalisisDeCalidad, "AnalisisDeCalidad", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenDeDescargaFason, numeroDoc = Model.Numero, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AsignacionDeRuta, "AsignacionDeRuta", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenDeDescargaFason, numeroDoc = Model.Numero, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_Fotos, "Fotos", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenDeDescargaFason, numeroDoc = Model.Numero, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.Recorrido, "Recorrido", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenDeDescargaFason, numeroDoc = Model.Numero, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado }, null)
            </li>
            @if (esRechazado)
            {
                <label class="text-right " style="color: #FF0000; font-size: 13pt ;position: relative; display: inline-block; float:right; top: 10px">@Textos.Rechazado</label>
}
        </ul>
    </div>    
}


@Html.Hidden("SoloLectura", (bool)ViewBag.SoloLectura, new { id = "soloLectura" })
@using (Html.BeginForm("OrdenDeDescargaFason", "ModificarDocumentoDeIngreso", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content container causaBlock", id = "orden-form", data_mensaje_espera = Textos.OrdenDeDescarga_MensajeDeEspera }))
{
    @Html.Hidden("CentroId",(int)ViewBag.CentroId)
    @Html.HiddenFor(model => model.Id)
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
    {
         <div class="alert alert-error">
             @Html.ValidationSummary(true)
         </div>
    }
    @Html.Partial("~/Views/CargarOrdenDeDescargaFason/_Orden.cshtml", Model)
   
}