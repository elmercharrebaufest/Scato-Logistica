@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.CartaPorteDto

@{
    if (ViewBag.esDocumentoDeOrigen != null && ViewBag.esDocumentoDeOrigen)
    {
        Layout = null;
    }
    if (ViewBag.SoloLectura == null)
    {
        ViewBag.SoloLectura = false;
    }

    var modelo = @Html.Raw(Json.Encode(Model));
    string workflow = ViewBag.Workflow;
    bool soloLectura = ViewBag.SoloLectura;
    int recorridoId = ViewBag.RecorridoId;
    string patente = ViewBag.Patente;
    bool esRechazado = ViewBag.Rechazado;
    string tipoDocumento = ViewBag.TipoDocumentoString;
    string numeroDoc = ViewBag.NumeroDocumento;
    bool tieneDatosExportacion = ViewBag.TieneDatosExportacion;
}

@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script src="~/scripts/jquery.elevatezoom.js" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/cartaporte.cargar.js")" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/cartaporte.index.js")" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/modificarCartaporte.index.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/validarCuil.js")"></script>
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
@if (!soloLectura)
{
    <script src="~/scripts/knockout.simpleGrid.1.3.js" type="text/javascript"></script>
}

<style>
    .content {
        padding-top: 20px;
    }

    .small {
        width: 107px !important;
    }
</style>


<div class="container-fluid">
    @{
        if (soloLectura)
        {
            <div class="titSecciones">@Textos.ConsultarDocumentoDeIngreso_Titulo</div>
            <br />
            <div class="row">
                <div class="span2 negrita">@Textos.Workflow_TipoDocumentoDeIngreso</div>
                <label class="span2" style="margin-left:-14px">@tipoDocumento</label>
                <div class="span2 negrita">@Textos.NumeroDocumentoIngreso</div>
                <label class="span2" style="margin-left:-53px">@numeroDoc</label>
                <div class="span2 negrita" style="">@Textos.Patente</div>
                <label class="span2" style="margin-left:-43px">@patente</label>
                <div class="right">
                    @Html.ActionLink(Textos.Volver, "Index", "ModificarDocumentoDeIngreso", new { soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, new { @class = "btn" })
                </div>
            </div>


        }
        else
        {
            <div class="titSecciones">@Textos.ModificarDocumentoDeIngreso_Titulo</div>
            <br />
            <div class="row">
                <div class="span2 negrita">@Textos.Workflow_TipoDocumentoDeIngreso</div>
                <label class="span2" style="margin-left:-14px">@tipoDocumento</label>
                <div class="span2 negrita">@Textos.NumeroDocumentoIngreso</div>
                <label class="span2" style="margin-left:-53px">@numeroDoc</label>
                <div class="span2 negrita" style="">@Textos.Patente</div>
                <label class="span2" style="margin-left:-53px">@patente</label>
                <div class="right">
                    @Html.ActionLink(Textos.Volver, "Index", "ModificarDocumentoDeIngreso", new { soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, new { @class = "btn" })
                </div>
            </div>
        }
    }
</div>

@if (soloLectura && (ViewBag.esDocumentoDeOrigen == null || !ViewBag.esDocumentoDeOrigen))
{
    <div class="container-fluid">
        <ul class="nav nav-tabs">
            <li class="active">
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_DatosDeOrigen, "DocumentoOrigen", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = Model.NroCartaPorte, patente = patente, soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.Pesada, "Pesada", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = Model.NroCartaPorte, patente = patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AnalisisDeCalidad, "AnalisisDeCalidad", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = Model.NroCartaPorte, patente = patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AsignacionDeRuta, "AsignacionDeRuta", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = Model.NroCartaPorte, patente = patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_Fotos, "Fotos", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = Model.NroCartaPorte, patente = patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado, tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.Recorrido, "Recorrido", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = Model.NroCartaPorte, patente = patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado, tieneDatosExportacion = tieneDatosExportacion }, null)
            </li>
            @if (tieneDatosExportacion)
            {
                <li>
                    @Html.ActionLink(Textos.DatosExportacion, "DatosExportacion", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.CartaPorte, numeroDoc = Model.NroCartaPorte, patente = patente, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado, tieneDatosExportacion = tieneDatosExportacion }, null)
                </li>
            }
            @if (esRechazado)
            {
                <label class="text-right " style="color: #FF0000; font-size: 13pt ;position: relative; display: inline-block; float:right; top: 10px">@Textos.Rechazado</label>
            }
        </ul>
    </div>
}



@Html.Hidden("Modelo", modelo)
@Html.Hidden("EsModificacion", true)
@Html.Hidden("SoloLectura", (bool)ViewBag.SoloLectura, new { id = "soloLectura" })

@using (Html.BeginForm("CartaPorte", "ModificarDocumentoDeIngreso", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content causaBlock", id = "orden-form", data_mensaje_espera = Textos.CartaPorte_MensajeDeEspera }))
{
    @Html.Hidden("CentroId", (int)ViewBag.CentroId)
    @Html.HiddenFor(m => m.TipoVehiculo, new { id = "tipoVehiculoHidden" })

    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
    {
        <div class="alert alert-error">
            @Html.ValidationSummary(true)
        </div>
    }
    @Html.Partial("~/Views/CargarCartaPorte/_Orden.cshtml", Model)
}