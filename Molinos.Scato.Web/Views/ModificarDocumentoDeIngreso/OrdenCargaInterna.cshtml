@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.OrdenCargaInternaDto
@{
    bool soloLectura = (bool?)ViewBag.SoloLectura ?? false;
    string workflow = ViewBag.Workflow;
    int recorridoId = ViewBag.RecorridoId;
    bool esRechazado = ViewBag.Rechazado;
    string tipoDocumento = ViewBag.TipoDocumentoString;
    string patente = ViewBag.Patente;
    string numeroDoc = ViewBag.NumeroDocumento;
}

<link rel="stylesheet" href="~/Styles/area/shared/form.css" />

@Html.Hidden("SoloLectura", (bool)ViewBag.SoloLectura, new { id = "soloLectura" })
<div class="container">
    @{
        if (soloLectura)
        {
            <div class="titSecciones">@Textos.ConsultarDocumentoDeIngreso_Titulo</div>
        }
        else
        {
            <div class="titSecciones">@Textos.ModificarDocumentoDeIngreso_Titulo</div>
        }

        <br />
        <div class="row">
            <strong class="span2">@Textos.Workflow_TipoDocumentoDeIngreso</strong>
            <label class="span2" style="margin-left:-14px">@tipoDocumento</label>
            <strong class="span2">@Textos.NumeroDocumentoIngreso</strong>
            <label class="span2" style="margin-left:-53px">@numeroDoc</label>
            <strong class="span2" style="">@Textos.Patente</strong>
            <label class="span2" style="margin-left:-43px">@patente</label>
            <div class="right">
                @Html.ActionLink(Textos.Volver, "Index", "ModificarDocumentoDeIngreso", new { soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, new { @class = "btn" })
            </div>
        </div>
    }
</div>

@if (soloLectura)
{
    <div class="container">
        <ul class="nav nav-tabs">
            <li class="active">
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_DatosDeOrigen, "DocumentoOrigen", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenCargaInterna, numeroDoc = Model.NumeroOrden, patente = Model.PatenteCamion, soloLectura = true, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.Pesada, "Pesada", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenCargaInterna, numeroDoc = Model.NumeroOrden, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AnalisisDeCalidad, "AnalisisDeCalidad", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenCargaInterna, numeroDoc = Model.NumeroOrden, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_AsignacionDeRuta, "AsignacionDeRuta", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenCargaInterna, numeroDoc = Model.NumeroOrden, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false) }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.ConsultarDocumentoDeIngreso_Fotos, "Fotos", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenCargaInterna, numeroDoc = Model.NumeroOrden, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado }, null)
            </li>
            <li>
                @Html.ActionLink(Textos.Recorrido, "Recorrido", "ModificarDocumentoDeIngreso", new { recorridoId = recorridoId, tipoDoc = TipoDocumentoIngreso.OrdenCargaInterna, numeroDoc = Model.NumeroOrden, patente = Model.PatenteCamion, filtrarPorTarjeta = (bool)(ViewBag.FiltrarPorTarjeta ?? false), rechazado = esRechazado }, null)
            </li>
            @if (esRechazado)
            {
                <li>
                    <label class="text-right" style="color: #FF0000; font-size: 13pt; position: relative; display: inline-block; float:right; top: 10px;">@Textos.Rechazado</label>
                </li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm("OrdenCargaInterna", "ModificarDocumentoDeIngreso", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content container causaBlock", id = "orden-form", data_mensaje_espera = Textos.ActIngresarOrdenDeCargaInterna }))
{
    @Html.Hidden("CentroId", (int)ViewBag.CentroId)
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
    {
        <div class="alert alert-error">
            @Html.ValidationSummary(true)
        </div>
    }
    @Html.Partial("~/Views/ModificarDocumentoDeIngreso/_OrdenCargaInternaDetalle.cshtml", Model)

    if (!soloLectura)
    {
        <div class="control-group paddingRight cajaButtons">
            <button class="btn btn-primary" type="submit">@Textos.Aceptar</button>
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
        </div>
    }
}