@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Seguridad
@{
    ViewBag.Title = Textos.AdministracionDistancia_Titulo;
}

<div class ="container-fluid">
    <div class="titSecciones">@Textos.AdministracionDistancia_Titulo</div>
</div>

<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
                @Html.Label(Textos.Filtrar)
                <input type="text" name="filtro" class="input-large" />
                <button type="submit" class="btn">@Textos.Filtrar_Distancias</button>
                
            }
        </div>
        @Html.ActionLink(Textos.Distancia_Nuevo, "Crear", "KmPorProveedor", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })
    </div>
    
    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
        @Html.Partial("Listar")
    </div>
</div>

