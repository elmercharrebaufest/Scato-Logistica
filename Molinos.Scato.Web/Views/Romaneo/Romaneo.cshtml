@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.RomaneoDto
@{
    Layout = null;
    var itemsvalidos = Model != null && Model.RomaneoItems != null ? Model.RomaneoItems.Where(x => !x.Rechazado) : null;
    var brutoAcum = itemsvalidos != null ? itemsvalidos.Sum(s => s.PesoBruto) : null;
    var taraAcum = itemsvalidos != null ? itemsvalidos.Sum(s => s.PesoTara) : null;
    var netoAcum = itemsvalidos != null ? itemsvalidos.Sum(s => s.PesoNeto) : null;    
}
<script type="text/javascript" src="@Url.Script("~/scripts/jquery.maskedinput.js")"></script>

<script src="@Url.Script("~/Scripts/romaneo.romaneo.js")" type="text/javascript"></script>
<div class ="container" id="romaneoContainer" data-index-url="@Url.Action("CargarRomaneo","Romaneo")">
    <div class="container content grillaPad">
        @Html.ValidationSummary(true)
        @Html.Hidden("RomaneoDescargar_ProximoItem", Textos.RomaneoDescargar_ProximoItem)
        @Html.Hidden("Aceptar", Textos.Aceptar)
        @Html.Hidden("EstadoFinalizado", EstadoRomaneo.Finalizado)

        <div class="row">
            <table class="tablaDatos span12">
                <thead>
                    <tr>
                        <th>@Html.Label(Textos.OrdenDeDescarga, new { @class = "control-label" })</th>
                        <th>@Html.LabelFor(model => model.NroPedido, new { @class = "control-label" })</th>
                        <th>@Html.Label(Textos.Camion_Patente, new { @class = "control-label" })</th>
                        <th>@Html.Label(Textos.Romaneo_FechaIngreso, new { @class = "control-label" })</th>
                        <th>@Html.Label(Textos.Proveedor, new { @class = "control-label" })</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>@ViewBag.NumeroOrdenDeDescarga</b></td>
                        <td><b>@Html.TextBoxFor(model => model.NroPedido, new { @class = "input-medium" ,id = "numeroPedidoSap" ,data_cargar_pedido_url = Url.Action("CargarPedido","Romaneo"), data_buscando_pedido = Textos.ActRomaneo })</b></td>
                        <td><b>@ViewBag.Patente</b></td>
                        <td><b>@ViewBag.FechaIngreso</b></td>
                        <td><b id ="ProveedorDescripcion" class ="label" data-warning ="@Textos.Romaneo_DiscrepanciaProveedor">@Html.DisplayFor(m => m.ProveedorDescripcion)</b></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        @using (Ajax.BeginForm("RechazarItem", "Romaneo", new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { @class = "causaBlock", data_mensaje_espera = Textos.Romaneo_RechazandoItems }))
        {
            @Html.HiddenFor(model => model.WorkflowInstanceId)
            @Html.HiddenFor(model => model.Numero)
            <div class="row">
                <div class="span12">
                    <h5>Items Descargados</h5>
                </div>
                <div style="text-align: right" class="span6 pull-right">
                    <button class="btn btn-warning" id="btnRechazar" style="margin-bottom: 5px;">@Textos.Romaneo_RechazarItem</button>
                    @Html.ActionLink(Textos.Romaneo_DescargarItems, "DescargarItem", "Romaneo", new {romaneoId = Model.Numero}, new {id = "descargarBoton", @class = "btn btn-primary ajax-editar-link", @style = "margin-bottom: 5px;"})
                </div>
            </div>
            @Html.Partial("ListarItems", Model)
        <div class="row">
            <div class="span12search bordeGris form-horizontal"  style="border-bottom-style: solid; margin-bottom: 15px;">@Textos.Romaneo_PesoAcumulado
                <div class="row-carta-porte">
                    <div class="span3">
                        <label class="control-label xsmall">@Textos.Bruto: </label>
                        <div class="controls-xsmall control-text">
                            @brutoAcum &nbsp;
                        </div>
                    </div>
                    <div class="span3">
                        <label class="control-label xsmall">@Textos.Tara: </label>
                        <div class="controls-xsmall control-text">
                            @taraAcum &nbsp;
                        </div>
                    </div>
                    <div class="span3">
                        <label class="control-label xsmall">@Textos.Neto: </label>
                        <div class="controls-xsmall control-text">
                            @netoAcum &nbsp;
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br/>
        <div class="row">
            <div class="span6">
                <div class="control-group">
                    @Html.LabelFor(model => model.Observaciones, new { @class = "control-label" })
                    <div class="controls">
                        @Html.TextAreaFor(model => model.Observaciones, new { @class = "input-large" })
                    </div>
                </div>
            </div>
            <div class="span6">
                <div class="control-group">
                    <label class="control-label">@Textos.Romaneo_Estado:</label>
                    <div class="controls control-text">
                        @Html.EnumDisplayTextFor(model => model.Estado).ToString().ToUpper()
                        @Html.HiddenFor(m => m.Estado)
                    </div>
                </div>
            </div>
        </div>
        }            
        <div class="row">
            <div class="span3 pull-left">
                <button class="btn btn-primary confirmar-boton" type="submit" id="btnTerminar" data-accion="TerminarRomaneo" data-mensaje="@Textos.Romaneo_Confirmacion">@Textos.TerminarRomaneo</button>
            </div>
            <div class="span3 pull-left">
                <button class="btn btn-primary confirmar-boton" type="submit" id="btnTerminarVehiculo" data-accion="TerminarVehiculo" data-mensaje="@String.Format(Textos.ConfirmacionGenerica,Textos.Terminar,Textos.Vehiculo)">@Textos.Romaneo_TerminarVehiculo</button>
            </div>
            <div class="span6 pull-right" style="text-align:right">
                 @Html.ActionLink(Textos.Aceptar, "Aceptar", "Romaneo", null, new {@class = "btn"})
            </div>
        </div>
    </div>
</div>
