@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.RomaneoDto
@{
    Layout = null;
}


    <div style="max-height:170px;overflow:auto;margin-bottom: 3px">
    <script>$('#btnRechazar').prop('disabled', true)</script>
    <table class="table table-striped table-bordered">
        <thead> 
            <tr>
                <th>@Textos.Rechazar</th>
                <th>@Textos.Romaneo_ItemNro</th>
                <th>@Textos.Romaneo_RemitoNro</th>
                <th>@Textos.AñoSap</th>
                <th>@Textos.NroMovimientoSap</th>
                <th>@Textos.PesoBruto</th>
                <th>@Textos.PesoTara</th>
                <th>@Textos.PesoNeto</th>
                <th>@Textos.Material</th>
                <th>@Textos.Almacen</th>
                <th>@Textos.Romaneo_LoteTropa</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.RomaneoItems.Count; i++)
            {
                @Html.HiddenFor(m => m.RomaneoItems[i].Id)
                @Html.HiddenFor(m => m.RomaneoItems[i].ItemNro)
                if (!Model.RomaneoItems[i].Rechazado)
                {
                    <script>$('#btnRechazar').prop('disabled', false)</script>
                    <tr>
                        <td>@Html.CheckBoxFor(m => m.RomaneoItems[i].Rechazado)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].ItemNro)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].RemitoNro)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].EjercicioDocMaterial)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].DocMaterial)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].PesoBruto)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].PesoTara)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].PesoNeto)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].Material)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].Almacen)</td>
                        <td>@Html.DisplayFor(m => m.RomaneoItems[i].LoteProveedor)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
 
