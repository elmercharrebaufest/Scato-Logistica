@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Web.Seguridad
@using Molinos.Scato.Dominio.Seguridad
@model Molinos.Scato.Dominio.Dto.RecorridoDto

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="@Url.Script("~/Scripts/area/enEsperaHB4/index.js")" type="text/javascript"></script>

<link href="~/Styles/area/enEsperaHB4/index.css" rel="stylesheet" />
<link href="~/Styles/area/shared/dialogModal.css" rel="stylesheet" />

@Html.Hidden("ConfirmarPendienteHB4Url", Url.Action("Index"))
@Html.Hidden("Redirect", Url.Action("Index", "ListaDeCamiones"))

<div class="titSecciones">@Textos.ActEnEsperaHB4</div>
<br />

<div class="contenidoCentrado">
    @Html.HiddenFor(model => model.InstanciaWorkflow)
    @Html.HiddenFor(model => model.WorkflowDefinicionId)
    <div class="grilla">
        <div class="grilla__group">
            <span class="grilla__cell grilla__cell--header">Patente</span>
            <span class="grilla__cell">@Model.Patente</span>
        </div>
        <div class="grilla__group">
            <span class="grilla__cell grilla__cell--header">Carta de Porte</span>
            <span class="grilla__cell">@Model.NumeroDocumentoIngreso</span>
        </div>
        <div class="grilla__group">
            <span class="grilla__cell grilla__cell--header">Material</span>
            <span class="grilla__cell">@Model.Material.Descripcion</span>
        </div>
    </div>
</div>

<div class="contenidoCentrado">
    @if (PermisosHelper.Is(PermisosScato.EnEsperaHB4))
    {
        <div>¿Deseas avanzar el camión?</div>
    }
    else
    {
        <div>No tienes permiso para avanzar el camión</div>
    }
    <div>
        @if (PermisosHelper.Is(PermisosScato.EnEsperaHB4))
        {
            <button class="btn btn-primary" onclick="modalConfirmarPendienteHB4.showModal()">@Textos.Aceptar</button>
        }
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
    </div>
</div>

<dialog id="modalConfirmarPendienteHB4" class="dialogModal">
    <h4 class="dialogModal__titulo">@Textos.Confirmacion</h4>
    <p class="dialogModal__descripcion">
        ¿Está seguro que desea Aceptar este Análisis de Calidad ?
    </p>
    <div class="dialogModal__botones">
        <button id="btnConfirmarpendienteHB4" class="btn btn-warning">Confirmar</button>
        <button class="btn" onclick="modalConfirmarPendienteHB4.close()">Cerrar</button>
    </div>
</dialog>