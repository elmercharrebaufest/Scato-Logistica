@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.FiltroDashboardCardlessDto
@{
    ViewBag.Title = Textos.DashboardCardless_Titulo;
}

<script src="~/scripts/Chart.min.js" type="text/javascript"></script>
<script src="~/Scripts/Chart.bundle.js"></script>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
<link href="~/Content/dashboardCardless.css" rel="stylesheet" />

<div id="dashboard-cardless-links"
     data-url-camiones="@Url.Action("ObtenerCamionesPorDia")"
     data-url-camara="@Url.Action("ObtenerPatentePorCamara")"
     data-url-diasemana="@Url.Action("ObtenerReconocimientoPorDiaSemana")"
     data-url-vehiculo="@Url.Action("ObtenerVehiculoPorDia")"
     data-url-proveedor="@Url.Action("ObtenerReconocimientoPorProveedor")"
     data-url-promedio="@Url.Action("ObtenerPromedioIntentos")"
     data-url-galeria="@Url.Action("ObtenerCapturasFallidas")"
     data-url-descarga="@Url.Action("DescargarCapturasFallidas")"
     data-url-imagen="@Url.Action("ObtenerImagen")"
     data-url-img-fallback="@Url.Content("~/Content/images/pageError.png")">
</div>


<div class="dc-wrapper">

    <!-- Header -->
    <div class="dc-header">
        <h1 class="dc-title">@Textos.DashboardCardless_Titulo</h1>
        <button type="button" class="dc-btn-galeria" id="btn-abrir-galeria">
            <span class="material-icons-round" style="font-size:17px">photo_library</span>
            @Textos.DashboardCardless_VerFotosFallidas
        </button>
    </div>

    <!-- Barra de filtros -->
    <div class="dc-filter-bar">
        <div class="dc-filter-group">
            <span class="dc-filter-label">@Textos.DashboardCardless_FiltroPuestoDeTrabajo</span>
            @Html.DropDownList("PuestoDeTrabajoId",
                (SelectList)ViewBag.Puestos,
                Textos.DashboardCardless_FiltroTodos,
                new { @class = "form-control", id = "filtro-puesto" })
        </div>
        <div class="dc-filter-group">
            <span class="dc-filter-label">@Textos.DashboardCardless_FiltroFechaDesde</span>
            <input type="date" class="form-control"
                   id="filtro-fecha-desde"
                   value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
        </div>
        <div class="dc-filter-group">
            <span class="dc-filter-label">@Textos.DashboardCardless_FiltroFechaHasta</span>
            <input type="date" class="form-control"
                   id="filtro-fecha-hasta"
                   value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
        </div>
        <div class="dc-filter-group">
            <button type="button" id="btn-filtrar" class="dc-btn-filter">
                <span class="material-icons-round" style="font-size:16px">filter_list</span>
                @Textos.DashboardCardless_FiltrarDatos
            </button>
            <span class="dc-filter-label" style="visibility:hidden; height: 3px !important;">&nbsp;</span>
        </div>
    </div>

    <!-- Fila 1: Camiones (sin acumulado) + Proveedor -->
    <div class="dc-grid-row dc-grid-row-top">
        <div class="dc-card">
            <div class="dc-card-header">
                <h2 class="dc-card-title">
                    <span class="material-icons-round">local_shipping</span>
                    @Textos.DashboardCardless_CamionesPorDia
                </h2>
                <button type="button" class="dc-btn-expand" data-chart-key="camiones" data-chart-title="@Textos.DashboardCardless_CamionesPorDia" title="Ampliar">
                    <span class="material-icons-round">open_in_full</span>
                </button>
            </div>
            <p class="dc-card-subtitle">@Textos.DashboardCardless_SubtituloCamionesPorDia</p>
            <canvas id="chart-camiones-por-dia"></canvas>
            <div id="camiones-sin-datos" class="dc-empty">@Textos.DashboardCardless_SinDatos</div>
        </div>

        <div class="dc-card">
            <div class="dc-card-header">
                <h2 class="dc-card-title">
                    <span class="material-icons-round">speed</span>
                    @Textos.DashboardCardless_ReconocimientoPorProveedor
                </h2>
                <button type="button" class="dc-btn-expand" data-chart-key="proveedor" data-chart-title="@Textos.DashboardCardless_ReconocimientoPorProveedor" title="Ampliar">
                    <span class="material-icons-round">open_in_full</span>
                </button>
            </div>
            <p class="dc-card-subtitle">@Textos.DashboardCardless_SubtituloReconocimientoPorProveedor</p>
            <canvas id="chart-reconocimiento-proveedor"></canvas>
            <div id="proveedor-sin-datos" class="dc-empty">@Textos.DashboardCardless_SinDatos</div>
        </div>
    </div>

    <!-- Fila 2: Torta cámaras + Reconocimiento patentes -->
    <div class="dc-grid-row dc-grid-row-mid">
        <div class="dc-card">
            <div class="dc-card-header">
                <h2 class="dc-card-title">
                    <span class="material-icons-round">videocam</span>
                    @Textos.DashboardCardless_PatentePorCamara
                </h2>
                <button type="button" class="dc-btn-expand" data-chart-key="camara" data-chart-title="@Textos.DashboardCardless_PatentePorCamara" title="Ampliar">
                    <span class="material-icons-round">open_in_full</span>
                </button>
            </div>
            <p class="dc-card-subtitle">@Textos.DashboardCardless_SubtituloPatentePorCamara</p>
            <canvas id="chart-patente-por-camara"></canvas>
            <div id="camara-sin-datos" class="dc-empty">@Textos.DashboardCardless_SinDatos</div>
        </div>

        <div class="dc-card">
            <div class="dc-card-header">
                <h2 class="dc-card-title">
                    <span class="material-icons-round">grid_view</span>
                    @Textos.DashboardCardless_ReconocimientoPorDiaSemana
                </h2>
                <button type="button" class="dc-btn-expand" data-chart-key="diasemana" data-chart-title="@Textos.DashboardCardless_ReconocimientoPorDiaSemana" title="Ampliar">
                    <span class="material-icons-round">open_in_full</span>
                </button>
            </div>
            <p class="dc-card-subtitle">@Textos.DashboardCardless_SubtituloReconocimientoPorDiaSemana</p>
            <canvas id="chart-reconocimiento-diasemana"></canvas>
            <div id="diasemana-sin-datos" class="dc-empty">@Textos.DashboardCardless_SinDatos</div>
        </div>
    </div>

    <!-- Fila 3: Vehículo + Promedio de intentos -->
    <div class="dc-grid-row dc-grid-row-bot">
        <div class="dc-card">
            <div class="dc-card-header">
                <h2 class="dc-card-title">
                    <span class="material-icons-round">directions_car</span>
                    @Textos.DashboardCardless_VehiculoPorDia
                </h2>
                <button type="button" class="dc-btn-expand" data-chart-key="vehiculo" data-chart-title="@Textos.DashboardCardless_VehiculoPorDia" title="Ampliar">
                    <span class="material-icons-round">open_in_full</span>
                </button>
            </div>
            <p class="dc-card-subtitle">@Textos.DashboardCardless_SubtituloVehiculoPorDia</p>
            <canvas id="chart-vehiculo-por-dia"></canvas>
            <div id="vehiculo-sin-datos" class="dc-empty">@Textos.DashboardCardless_SinDatos</div>
        </div>

        <div class="dc-card">
            <div class="dc-card-header">
                <h2 class="dc-card-title">
                    <span class="material-icons-round">autorenew</span>
                    @Textos.DashboardCardless_PromedioIntentos
                </h2>
                <button type="button" class="dc-btn-expand" data-chart-key="promedio" data-chart-title="@Textos.DashboardCardless_PromedioIntentos" title="Ampliar">
                    <span class="material-icons-round">open_in_full</span>
                </button>
            </div>
            <p class="dc-card-subtitle">@Textos.DashboardCardless_SubtituloPromedioIntentos</p>
            <div class="dc-kpi-row" id="kpis-promedio">
                <div class="dc-kpi-box">
                    <div class="dc-kpi-label">@Textos.DashboardCardless_PromedioGeneral</div>
                    <div class="dc-kpi-value" id="kpi-promedio-general">—</div>
                    <div class="dc-kpi-unit">@Textos.DashboardCardless_Intentos</div>
                </div>
                <div class="dc-kpi-box">
                    <div class="dc-kpi-label">@Textos.DashboardCardless_MaxHoy</div>
                    <div class="dc-kpi-value dc-kpi-value-red" id="kpi-max-hoy">—</div>
                    <div class="dc-kpi-unit">@Textos.DashboardCardless_Intentos</div>
                </div>
            </div>
            <canvas id="chart-promedio-intentos"></canvas>
            <div id="promedio-sin-datos" class="dc-empty">@Textos.DashboardCardless_SinDatos</div>
        </div>
    </div>

    </div>

<!-- Modal Galería de Capturas Fallidas -->
<div class="dc-modal-overlay" id="modal-galeria">
    <div class="dc-modal-box">
        <button class="dc-modal-close" id="btn-cerrar-galeria" title="Cerrar">
            <span class="material-icons-round">close</span>
        </button>
        <h2 class="dc-card-title" style="margin-bottom:20px">
            <span class="material-icons-round">photo_library</span>
            @Textos.DashboardCardless_GaleriaFallidas
        </h2>

        <div class="form-inline" style="margin-bottom:16px; display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
            <div class="dc-filter-group">
                <span class="dc-filter-label">@Textos.DashboardCardless_PuestoDeTrabajo</span>
                @Html.DropDownList("galeria-puesto",
                    (SelectList)ViewBag.Puestos,
                    Textos.DashboardCardless_FiltroTodos,
                    new { @class = "form-control", id = "galeria-puesto", style = "min-width:180px" })
            </div>
            <div class="dc-filter-group">
                <span class="dc-filter-label">@Textos.DashboardCardless_GaleriaDesde</span>
                <input type="date" class="form-control" id="galeria-fecha-desde" style="width:145px" />
            </div>
            <div class="dc-filter-group">
                <span class="dc-filter-label">@Textos.DashboardCardless_GaleriaHasta</span>
                <input type="date" class="form-control" id="galeria-fecha-hasta" style="width:145px" />
            </div>
            <button type="button" id="btn-buscar-galeria" class="dc-btn-filter">
                <span class="material-icons-round" style="font-size:16px">search</span>
                @Textos.DashboardCardless_BuscarGaleria
            </button>
            <button type="button" id="btn-descargar-galeria" class="dc-btn-galeria" style="height:38px">
                <span class="material-icons-round" style="font-size:16px">download</span>
                @Textos.DashboardCardless_DescargarTodo
            </button>
        </div>

        <div id="galeria-grid">
            <div id="galeria-sin-datos" class="dc-empty" style="display:none">
                @Textos.DashboardCardless_SinCapturasFallidas
            </div>
            <div class="galeria-grid-inner" id="galeria-grid-inner"></div>
        </div>
        <div id="galeria-paginacion"></div>
    </div>
</div>

<!-- Lightbox imagen -->
<div class="galeria-lightbox" id="galeria-lightbox">
    <div class="galeria-lightbox-inner">
        <button class="galeria-lightbox-close" id="galeria-lb-close">
            <span class="material-icons-round">close</span>
        </button>
        <img id="galeria-lb-img" src="" alt="" />
        <div class="galeria-lightbox-caption" id="galeria-lb-caption"></div>
    </div>
</div>

<!-- Modal Ampliar Gráfico -->
<div class="dc-chart-expand-overlay" id="dc-chart-expand-overlay">
    <div class="dc-chart-expand-box">
        <div class="dc-chart-expand-header">
            <h2 class="dc-chart-expand-title" id="dc-chart-expand-title-text"></h2>
            <button class="dc-modal-close" id="btn-cerrar-expand" title="Cerrar">
                <span class="material-icons-round">close</span>
            </button>
        </div>
        <div class="dc-chart-expand-canvas-wrap">
            <canvas id="chart-expand-canvas"></canvas>
        </div>
    </div>
</div>

<script type="text/javascript" src="@Url.Script("~/Scripts/dashboardCardless.js")"></script>
<script type="text/javascript">
    $(function () {
        dashboardCardless.init();

        // Modal galería
        $('#btn-abrir-galeria').on('click', function () {
            $('#galeria-puesto').val($('#filtro-puesto').val());
            $('#modal-galeria').addClass('dc-modal-open');
        });

        $('#btn-cerrar-galeria').on('click', function () {
            $('#modal-galeria').removeClass('dc-modal-open');
        });

        $('#modal-galeria').on('click', function (e) {
            if ($(e.target).is('#modal-galeria')) {
                $(this).removeClass('dc-modal-open');
            }
        });
    });
</script>
