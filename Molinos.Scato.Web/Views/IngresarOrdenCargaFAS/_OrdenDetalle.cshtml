@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.OrdenCargaFasDto
@{
    var tiposComerciales = (IEnumerable<SelectListItem>)ViewBag.TiposComerciales;
    var tiposDocumentos = (IEnumerable<SelectListItem>)ViewBag.TiposDocumentos;
    var kmdropdown = new List<SelectListItem>();
    var plantasDG = new List<SelectListItem>();
    var domiciliosDG = new List<SelectListItem>();
    var listaMaterialesDerivadoGranario = (List<int>)ViewBag.MaterialesDerivadoGranario;
}

@Html.Hidden("EsModificacion", "True")
<style>
    .paddingRight {
        display: inline-block;
    }
</style>
<div id="links"
     data-url-buscar-choferes="@Url.Action("BuscarChoferes", "Consultas")"
     data-url-buscar-chofer-unico="@Url.Action("BuscarChoferUnico", "Consultas")"
     data-url-buscar-kmporproveedor="@Url.Action("BuscarKmPorProveedor", "Consultas")"
     data-url-obtener-clientes-sap="@Url.Action("ObtenerClientesSap", "Consultas")"
     data-url-buscar-clientes="@Url.Action("BuscarClientes", "Consultas")"
     data-url-buscar-cliente-unico="@Url.Action("BuscarCliente", "Consultas")"
     data-url-obtener-plantas-por-cliente="@Url.Action("ObtenerPlantasDGPorClienteId", "Consultas")"
     data-url-obtener-domicilios-derivado-granario-por-cliente="@Url.Action("ObtenerDomiciliosDG", "Consultas")">
</div>
@Html.Hidden("ListaMaterialesDerivadoGranario", Json.Encode(listaMaterialesDerivadoGranario))
@Html.Hidden("DerivadoGranarioHabilitado", Model.DerivadoGranarioHabilitado)
@Html.Hidden("PlantaSeleccionada", Model.PlantaDGDestino)
@Html.Hidden("LocalidadSeleccionada", Model.LocalidadDestinoId)

@Html.HiddenFor(model => model.OrdenDomicilioDestino)
@Html.HiddenFor(model => model.TipoDomicilioDestino)
@Html.HiddenFor(model => model.RecorridoId)

<div class="row-fluid row-fluid-ie7">
    <div class="span6">
        <div class="control paddingRight derivadoGranario @(Model.DerivadoGranarioHabilitado ? "" : "hidden")">
            @Html.LabelFor(model => model.NumeroCTG, new { @class = "control-label" })
            <div class="controls">
                @Html.DisplayFor(model => model.NumeroCTG)
            </div>
        </div>
        <div class="control paddingRight derivadoGranario @(Model.DerivadoGranarioHabilitado ? "" : "hidden")">
            @Html.LabelFor(model => model.NumeroCPE, new { @class = "control-label" })
            <div class="controls">
                @Html.DisplayFor(model => model.NumeroCPE)
            </div>
        </div>
    </div>
</div>

