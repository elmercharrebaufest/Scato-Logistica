
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Web.Helpers

@{
    var noMostrarBoton = (bool?)ViewBag.NoReemplazarCp ?? false;
    var camaras = (List<VideoCamaraDto>)ViewBag.Camaras;
    var filas = Convert.ToInt32(Math.Sqrt(camaras.Count()));
    var colSinRedondear = Decimal.Divide(camaras.Count(), filas);
    var columnas = decimal.ToInt32(colSinRedondear);
    if (colSinRedondear > columnas)
    {
        columnas++;
    }
}
<link href="@Url.Css("~/Content/fotos.css")" rel="stylesheet" type="text/css">
<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/columna.css")">

<div id="links"
     data-url-obtener-foto-mesa="@Url.Action("TomarFotoMesaDigitalizacion", "CargarCartaPorte")"
     data-url-agregar-foto="@Url.Action("AgregarFotoARecorrido", "Foto")"
</div>
<style>
    img {
        width: 100%;
        height: 100%;
    }

    body {
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .codigo-camara {
        position: absolute;
        top: 8px;
        left: 8px;
        background-color: wheat;
    }

    .matriz-camaras {
        display: grid;
        grid-template-columns: repeat(@columnas, 1fr);
        grid-template-rows: repeat(@filas, 1fr);
    }

    .camara {
        position: relative;
    }
</style>

<head>
    <link rel="shortcut icon" href="@Html.Action("Favicon", "Firma")" type="image/x-icon" />
    <title>|Camaras</title>
</head>

<div style="height: 100vh" class="matriz-camaras">
    @foreach (var camara in camaras)
    {
        <div class="camara" style="order: @camara.Posicion">
            <img src="@camara.Directorio" />
            @if (ViewBag.MostrarNombre)
            {
                <div class="codigo-camara">@camara.Codigo</div>
            }
        </div>
    }
</div>

