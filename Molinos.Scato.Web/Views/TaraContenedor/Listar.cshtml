@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<TaraContenedorDto>) ViewBag.Items;
}

    @Html.Grilla(items,
        grilla => grilla.Columns(
        grilla.ColumnaEliminarModificar(Html, "TaraContenedor"),
        grilla.Columna("CodigoContenedor", Textos.Codigo),
        grilla.Columna("Descripcion", Textos.Descripcion)
        ))
