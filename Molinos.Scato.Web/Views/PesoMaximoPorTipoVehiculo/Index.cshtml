@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = Textos.TiposDeVehiculos;
}

<div class ="container-fluid">
    <div class="titSecciones">@Textos.Administracion_TiposDeVehiculos</div>
</div>
<div class="container-fluid grillaPad">
    <div class="row">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form" ,@class = "form-search" }))
            {
                
            }
            

        @Html.ActionLink(Textos.TiposDeVehiculos_Nuevo, "Crear", "PesoMaximoPorTipoVehiculo", null , new {@class = "ajax-editar-link btn btn-primary pull-right"})
    </div>
    
    <div id="gridContainer">
        @Html.Partial("Listar")
    </div>
</div>