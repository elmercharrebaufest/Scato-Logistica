@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers


@{
    Layout = null;
    var items = (ListaPaginada<ChoferDto>) ViewBag.Items;
}

@Html.Grilla(items,
    grilla => grilla.Columns(
    grilla.ColumnaEliminarModificar(Html, "Chofer"),
    grilla.Columna("Nombre", Textos.Chofer_Nombre),
    grilla.Columna("Apellido", Textos.Chofer_Apellido),
    grilla.Columna("TipoDocumentoIdentidad.DescripcionCorta", Textos.Chofer_TipoDocumentoIdentidad, c => c.DescripcionCorta),
    grilla.Columna("NumeroDeDocumento", Textos.Chofer_NumeroDocumentoIdentidad)
    ))

