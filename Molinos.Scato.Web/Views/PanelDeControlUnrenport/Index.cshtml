@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.FiltroPanelDeBajaCtgDefinitivaDto
@{
    ViewBag.Title = Textos.PanelDeControlUnrenport_Titulo;
}

@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script src="@Url.Script("~/Scripts/accordion.icon.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/panelControlBajaCtg.index.js")"></script>
<style>
    .date {
        width: 70px;
    }

    .formatoHora {
        width: 50px;
    }
</style>
<div class="container-fluid"> 
    <div class="titSecciones">@Textos.PanelDeControlUnrenport_Titulo</div>
</div>

<div class="container-fluid content grillaPad">
    @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "transmisiones-form", @class = "form-search", data_mensaje_espera = Textos.PanelBajaCtgDefinitiva }))
    {
        @Html.HiddenFor(model => model.TipoDeServicio)
        <div class="accordion row-fluid">
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseOne">
                        <i class="icon-chevron-down"></i>
                        @Textos.Busqueda
                    </a>
                </div>
                <div id="collapseOne" class="accordion-body in collapse">
                    <div class="accordion-inner">
                        <div class="row-fluid">
                            @Html.ValidationSummary(true)
                            <div class="span1">
                                @Html.LabelFor(model => model.EstadoTransmisionASap, new { @class = "control-label" })
                            </div>
                                <div class="span2">
                                    @Html.EnumDropDownListFor(model => model.EstadoTransmisionASap, Textos.Default_Transmision,new {@style="width:100%;" })
                                </div>
                            
                                <div class="span2 FechaDesde" style="text-align:right;">
                                    @Html.LabelFor(model => model.FechaDesde, new { @class = "control-label" })
                                </div>
                                <div class="span3 sinBorde">
                                    @Html.EditorFor(model => model.FechaDesde, Model != null ? Model.FechaDesde.FormattedFixed() : string.Empty)
                                    @Html.TextBoxFor(model => model.HoraDesde, new { @class = "input-xsmall formatoHora " })
                                    @Html.ValidationMessageFor(model => model.FechaDesde)
                                </div>
                            
                                <div class="span4 FechaHasta" style="margin-left:-4px;">
                                    @Html.LabelFor(model => model.FechaHasta, new { @class = "control-label" })
                                
                                    @Html.EditorFor(model => model.FechaHasta, Model != null ? Model.FechaHasta.FormattedFixed() : string.Empty)
                                    @Html.TextBoxFor(model => model.HoraHasta, new { @class = "input-xsmall formatoHora " })
                                    @Html.ValidationMessageFor(model => model.FechaHasta)
                                </div> 
                        </div>
                        <div class="row-fluid">
                            <div class="span1">
                                @Html.LabelFor(model => model.NumeroDocumentoIngreso, new { @class = "control-label" })
                            </div>
                            <div class="span3 sinBorde">
                                @Html.TextBoxFor(model => model.NumeroDocumentoIngreso, new { @class = "input-medium " })
                            </div>                           
                            <div class="span2"style="margin-left:-17px;">
                                @Html.LabelFor(model => model.Patente, new { @class = "control-label" })
                            </div>
                            <div class="span3 sinBorde">
                                @Html.TextBoxFor(model => model.Patente, new { @class = "input-medium  margenIzquierdo" })
                            </div>
                             <div class="controls cajaButtons" style="padding-top: 0 !important">
                             <button id="btnBuscar" type="submit" class="btn btn-primary"  style="margin-right:104px;">@Textos.Buscar</button>
                              </div>
                              
                            </div>
                       
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("transmisiones")
    }
    
    <div id="gridContainer" style="clear:both;" data-grid-url="@Url.Action("Index", "PanelDeControlBajaCtgDefinitiva")">
        @Html.Partial("Listar")
    </div>
    <div class="row-fluid">
        <div class="span2">
            <input id="btnTransmitir" type="button" data-url="@Url.Action("Transmitir")" value="@Textos.PanelDeControlTransSAP_Transmitir" class="btn acciones transmitir"/>
        </div>
        <div class="span4 acciones">
            <div id="cantidad" class="checkbox"></div> @Textos.PanelDeControlTransSAP_ElementosSeleccionados
        </div>
        <div class="span2">
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones",null, new {@class="btn pull-right acciones"})
        </div>
    </div>
</div>