@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Web.Models.ResumenDeRecepcionModel
@{
    ViewBag.Title = Textos.ReporteResumenDeRecepcion;
    var tipos = (IEnumerable<SelectListItem>)ViewBag.TiposDeReporte;
    
    
}
@Scripts.Render("~/bundles/jqueryval")
<style>
    .validation-summary-errors {
        color: #ff0000;
    }
</style>
<script src="@Url.Content("~/Scripts/accordion.icon.js")" type="text/javascript"></script>
<script src="@Url.Content("~/scripts/jquery.maskedinput.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/LibroDeMovimientosYExistenciaDeGranos.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/validarFechas.js")"></script>
<div id ="links" 
     data-url-buscar-material ="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales = "@Url.Action("BuscarMateriales", "Consultas")"
    />
<div class ="container">
    <div class="titSecciones">@Textos.ReporteResumenDeRecepcion</div>
    <br/>
</div>

<div class="container content grillaPad">
    @using (Html.BeginForm("Index", null, FormMethod.Post, new { @class = "causaBlock", id = "orden-form", data_mensaje_espera = Textos.Impresion }))
    {
        @Html.ValidationSummary(true)
        <div class="row-fluid">
            <div class="span4">
                <div class="control-group">
                    @Html.LabelFor(m => m.NroPedido, new { @class = "control-label" })
                    <div class="controls">
                        @Html.TextBoxFor(model => model.NroPedido, new { @class = "control input-medium", maxlength = "10" })
                        @Html.ValidationMessageFor(m => m.NroPedido)
                    </div>
                </div>
            </div>
            <div class="span2">
                <div class="control-group">
                    @Html.LabelFor(m => m.TipoDocumento, new { @class = "control-label" })
                    <div class="controls">
                        @Html.DropDownListFor(model => model.TipoDocumento, tipos)
                    </div>
                </div>
            </div>
            <div class="span4">
                <div class="control-group">
                    <div class="controls cajaButtons">
                        <button type="submit" class="btn">@Textos.Imprimir</button>
                    </div>
                </div>
            </div>
            <div class="span4">
                <div class="control-group">
                    &nbsp;
                </div>
            </div>
      </div>

    }
</div>