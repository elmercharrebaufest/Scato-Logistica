@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = Textos.AsignacionDeRecorrido_Titulo;
}
<div id ="links"
        data-url-buscar-material ="@Url.Action("BuscarMaterialPorCentro", "Consultas")"
        data-url-buscar-materiales = "@Url.Action("BuscarMaterialesPorCentro", "Consultas")" />

<div class ="container-fluid">
    <div class="titSecciones">@Textos.Administracion_AsignacionDeRecorrido</div>
</div>

<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
                @Html.Label(Textos.Filtrar_AsignacionRecorridos)
                <input type="text" name="filtro" class="input-large" />
                <button type="submit" class="btn">@Textos.Filtrar</button>               
            }
            
        </div>
        @Html.ActionLink(Textos.AsignacionDeRecorrido_Nuevo, "Crear", "AsignacionDeRecorrido", null, new { @class = "ajax-editar-link btn btn-primary pull-right"})
    </div>

    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
        @Html.Partial("Listar")
    </div>
</div>

