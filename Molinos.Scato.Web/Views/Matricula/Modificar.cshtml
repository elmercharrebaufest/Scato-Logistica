@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.UsuarioMatriculaDto
@{
    ViewBag.Title = Textos.Usuario_Modificar;
    Layout = null;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="@Url.Script("~/scripts/bootstrap-filestyle.min.js")" type="text/javascript" ></script>
<script src="@Url.Script("~/scripts/matricula.Modificar.js")" type="text/javascript" ></script>


@using (Ajax.BeginForm("Modificar", null, new AjaxOptions() { HttpMethod = "POST" }, new { id = "formMatricula", @class = "form-horizontal", enctype = "multipart/form-data", data_dialogo_titulo = Textos.Usuario_Modificar }))
{
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)        
}
