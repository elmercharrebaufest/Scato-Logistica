@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.AutorizacionTiempoEnTransitoDto

@{
    ViewBag.Title = Textos.ExcesoDeTiempo_Titulo;
    string workflow = ViewBag.Workflow;
    Model.Comentario = string.Format(Textos.ExcesoDeTiempo_Detalle, ViewBag.TiempoAceptado, ViewBag.Tiempo);
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="@Url.Script("~/Scripts/controlTiempoDeTransito.js")" type="text/javascript"></script>

<div class="container-fluid">
        <div class="titSecciones">@Textos.ExcesoDeTiempo_Titulo</div>
</div>
@using (Html.BeginForm("Index", "AutorizarTiempoEnTransito", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActAutorizarTiempoEnTransito }))
{
    @Html.HiddenFor(model => model.WorkflowInstanceId)
    @Html.HiddenFor(model => model.NombreUsuario)
    @Html.HiddenFor(model => model.Actividad)
    @Html.HiddenFor(model => model.Decision, new { @class = "valorDecision" })
    @Html.HiddenFor(model => model.DocumentoIngreso)
    @Html.HiddenFor(model => model.Patente)
    @Html.HiddenFor(model => model.NroDocumentoIngreso)
    @Html.HiddenFor(model => model.Material)
    @Html.HiddenFor(model => model.Actividad1)
    @Html.HiddenFor(model => model.FechaActividad1)
    @Html.HiddenFor(model => model.Actividad2)
    @Html.HiddenFor(model => model.FechaActividad2)

    @Html.HiddenFor(model => model.TiempoEnTransito)
    @Html.HiddenFor(model => model.TiempoAceptado)
    @Html.HiddenFor(model => model.DiferenciaTiempo)

    @Html.Hidden("workflow", workflow)
    @Html.Hidden("workflowDefinicionId", (int)ViewBag.WorkflowDefinicionId)
    <div class="centered" style="width: 700px; margin: auto">
        <div class="row">
            @if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
            {
                <div class="alert alert-error">
                    @Html.ValidationSummary(true)
                </div>
            }
            else
            {
                <span>
                    @string.Format(Textos.ExcesoDeTiempo_Detalle, ViewBag.TiempoAceptado, ViewBag.Tiempo)
                </span>
            }
        </div>

        <div class="row left-align">
            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.DocumentoIngreso, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.DocumentoIngreso, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.Patente, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.Patente, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.NroDocumentoIngreso, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.NroDocumentoIngreso, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.Material, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.Material, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.Actividad1, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.Actividad1, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.FechaActividad1, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.FechaActividad1, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.Actividad2, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.Actividad2, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.FechaActividad2, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.FechaActividad2, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.TiempoEnTransito, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.TiempoEnTransito, new { @class = "control-label" })
                </div>
            </div>

            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.TiempoAceptado, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.TiempoAceptado, new { @class = "control-label" })
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="span3">
                    @Html.LabelFor(model => model.DiferenciaTiempo, new { @class = "control-label", @style = "font-weight: bold;" })
                </div>
                <div class="span3">
                    @Html.DisplayFor(model => model.DiferenciaTiempo, new { @class = "control-label" })
                </div>
            </div>
            <div class="row">
                <div class="span6">
                    @Html.TextAreaFor(model => model.Comentario, new { rows = "5", maxlength = "400", placeholder = "Comentarios...", @style = "margin-top:20px;width:100%" })
                    @Html.ValidationMessageFor(model => model.Comentario)
                </div>
            </div>
        </div>
        <div class="row">
            <button type="submit" data-accion="Autorizar" class="btn btn-primary autorizar">@Textos.Autorizar</button>
            <button type="submit" data-accion="Rechazar" class="btn btn-primary rechazar">@Textos.Rechazar</button>
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn btn-primary" })
        </div>

    </div>
}
