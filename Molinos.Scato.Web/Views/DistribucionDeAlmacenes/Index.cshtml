@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.DistribucionDeAlmacenesDto

@{
    ViewBag.Title = Textos.DistribucionDeAlmacenes_Titulo;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/distribucionDeAlmacenes.js")" type="text/javascript"></script>

<div class="container-fluid">
    <div class="titSecciones">@Textos.DistribucionDeAlmacenes_Titulo</div>
</div>

@using (Html.BeginForm("Index", "DistribucionDeAlmacenes", FormMethod.Post, new { @class = "form-horizontal causaBlock", data_mensaje_espera = Textos.ActDistribucionDeAlmacenes }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.NombreDeUsuario)
    @Html.HiddenFor(model => model.InstanceId)
    @Html.HiddenFor(model => model.Workflow)
    @Html.HiddenFor(model => model.WorkflowDefinicionId)
    @Html.HiddenFor(model => model.MaterialId)
    @Html.HiddenFor(m => m.PesoNetoBodegaEnLitros)
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>@Html.LabelFor(model => model.Centro, new { @class = "control-label" })</th>
                <th> <label class="control-label">@Textos.RemitoBodegaTerceros</label></th>
                <th>@Html.LabelFor(model => model.Patente, new { @class = "control-label" })</th>
                <th>@Html.LabelFor(model => model.PesoNetoBodegaEnLitros, new { @class = "control-label" })</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><b>@Html.DisplayFor(model => model.Centro, new { @class = "control-label" })</b></td>
                <td><b>@Html.DisplayFor(model => model.NumeroDeDocumentoDeIngreso, new { @class = "control-label" })</b></td>
                <td><b>@Html.DisplayFor(model => model.Patente, new { @class = "control-label" })</b></td>
                <td><b><span data-bind="text: litrosRestantes"></span></b></td>
            </tr>
        </tbody>
    </table>

    <br/>
    <div id="grilla">
        <div class="centered">
            <div class="bordeGris">
                @Html.Hidden("distribucionesDeAlmacenesJsonPostBack", (string)ViewBag.DistribucionesDeAlmacenesJsonPostBack)
                @Html.HiddenFor(model => model.DistribucionesDeAlmacenesJson, new { data_bind = "value: ko.toJSON(distribucionesDeAlmacenes)" })

                <div class="row-fluid">
                    <div class="span6 control-group" style="margin-top: 10px; margin-bottom: 0px">
                        @Textos.Almacen : 
                        @Html.DropDownList("almacen", (IEnumerable<SelectListItem>)ViewBag.Almacenes, Textos.Default_Almacen, new {id = "almacenDropDown", @class = "almacenRequerido" ,data_error_requerido =String.Format(Textos.Error_Requerido, Textos.Almacen)})
                        @Html.ValidationMessage("almacen")
                    </div>
                    <div class="span6 control-group" style="margin-top: 10px; margin-bottom: 0px">
                        @Textos.Litros :
                        @Html.TextBox("litros","",new{ @class = "input-small campoLitrosInt litrosValidos litrosValidos2", data_error_invalido =Textos.Error_LitrosInvalidos,data_error_requerido =String.Format(Textos.Error_Requerido, Textos.Litros)})
                        <button id="botonCrearCuartel" data-bind="click: botonAgregar" class="btn">@Textos.Agregar</button>
                        @Html.ValidationMessage("litros")
                    </div>
                </div>
            </div>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>@Textos.Almacen</th>
                        <th>@Textos.Litros</th>
                        <th>@Textos.Eliminar</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: distribucionesDeAlmacenes">
                    <tr>
                        <td data-bind="text: Almacen" />
                        <td data-bind="text: Litros" />
                        <td><a href="#" data-bind="click: $root.removeDistribucion"><i class="icon-trash"></i></a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <br/>
    <div class="right span12">
        <button type="submit" class="btn btn-primary">@Textos.Aceptar</button>    
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn btn-primary" })
    </div>
}
