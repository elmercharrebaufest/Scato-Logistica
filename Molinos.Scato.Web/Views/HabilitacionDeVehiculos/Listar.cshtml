@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<PesoMaximoPorTipoVehiculoDto>)ViewBag.Items;
}
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Textos.TiposDeVehiculos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vehiculos in items)
        {
        <tr>
            <td>@vehiculos.TipoVehiculo</td>
            <td>@Html.CheckBox("Activo", vehiculos.Activo, new { vehiculos.Id })</td>

        </tr>
        }
    </tbody>
</table>