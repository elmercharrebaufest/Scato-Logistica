@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    Layout = null;
    var items = (ListaPaginada<ConversionGrupoDto>)ViewBag.Items;
}

@Html.Grilla(items,
            grid => grid.Columns(
