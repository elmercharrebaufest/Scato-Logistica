@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.ConversionGrupoDto
@{
    Layout = null;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
}
@Html.ValidationSummary(true)
<div class="control-group">
    @Html.LabelFor(m => m.MaterialDesc, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.MaterialId, materiales, Textos.Default_Material, new { id = "materialesDropDown" })
        @Html.ValidationMessageFor(m => m.MaterialId)
        @Html.Hidden("SetearMaterialesPorCamara", Url.Action("SetearMaterialesPorCamara","ConversionCaracteristica"))
        @Html.Hidden("valorDefault",Textos.Default_Material, new {id = "valorDefault"})
        @Html.Hidden("ConsultarConversionPorCamara", Url.Action("Indexa"))
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.CodigoSegunCamara, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoSegunCamara, new {@class = "control input-large"})
        @Html.ValidationMessageFor(m => m.CodigoSegunCamara)
    </div>
</div>
<div class="botones-carta-porte centered">
    <button class="btn btn-primary" type="submit">@Textos.Agregar</button>
</div>
