@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ReasignacionDeTarjetaDto

@{
    ViewBag.Title = Textos.ReasignacionDeTarjetas_Titulo;
    var tiposDocumentoIngreso = (IEnumerable<SelectListItem>)ViewBag.Motivos;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
<style>
    .field-validation-error {
        color: #b94a48;
        font-size: 10px;
    }
</style>
<script src="@Url.Script("~/Scripts/reasignacionDeTarjeta.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/jquery.maskedinput.js")"></script>

@using (Html.BeginForm("Index", "ReasignacionDeTarjeta", FormMethod.Post, new { @class = "form-horizontal", id = "orden-form", data_dialogo_titulo = Textos.ReasignacionDeTarjetas_Crear }))
{
    @Html.ValidationSummary(true)
    @Html.Hidden("MensajeImprimiendo", Textos.Impresion)
    <div class ="container-fluid">
        <div class="titSecciones">@Textos.ReasignacionDeTarjetas_Titulo</div>
    </div>
    <br/>
    <div class="span10" style="margin-bottom: 10px;">
        <div style="float: left;">
            @Html.LabelFor(model => model.TipoDocumentoIngreso, new { @class = "control-label" })
            <div class="controls" style="margin-left:160px; }">
                @Html.EnumDropDownListFor(model => model.TipoDocumentoIngreso, new {@class = "control input-large"})
                @Html.ValidationMessageFor(model => model.TipoDocumentoIngreso)
            </div>
        </div>
        <div style="float: left; margin-left: 30px;">
            @Html.LabelFor(m => m.NumeroDocumentoIngreso, new {@class = "control-label"})
            <div class="controls" style="margin-left:160px;">
                @Html.TextBoxFor(model => model.NumeroDocumentoIngreso, new {data_numero_url = Url.Action("ObtenerTarjetaRfid", "ReasignacionDeTarjeta")})
                @Html.ValidationMessageFor(m => m.NumeroDocumentoIngreso)
            </div>
        </div>
    </div>
    <fieldset style="border: solid 1px #cccccc; padding: 7px; border-radius: 5px; margin-top: 10px; width: 100%; float: left; margin-bottom: 5px;">
        <div class="control-group">
            @Html.Label(@Textos.Motivo, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownListFor(model => model.Motivo, (IEnumerable<SelectListItem>)ViewBag.Motivos, new { @class = "input-large" })
                @Html.ValidationMessageFor(model => model.Motivo)
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(model => model.NroTarjetaRfidAsignada, new { @class = "control-label", @style = "width: 161px;" })
            <div class="controls">
                @Html.TextBoxFor(model => model.NroTarjetaRfidAsignada, new { tabindex = 7, @class = "control input-large" })
                @Html.ValidationMessageFor(model => model.NroTarjetaRfidAsignada)
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(model => model.NroTarjetaRfidNueva, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(model => model.NroTarjetaRfidNueva, new { @class = "control input-large" })
                &nbsp;<input class="btn btn-primary" type="button" id="btnImprimir" value="@Textos.Imprimir" data-imprimir-url="@Url.Action("ImprimirTarjetaDeAcceso")" />
                @Html.ValidationMessageFor(model => model.NroTarjetaRfidNueva)
            </div>
        </div>
    </fieldset>
    <div class="control-group paddingRight cajaButtons">
        <button class="btn btn-primary" type="submit" id="btnAceptar">@Textos.Aceptar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones",null, new {@class="btn"})
    </div>
}
