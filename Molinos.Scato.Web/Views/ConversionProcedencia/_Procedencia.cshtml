<div class="control-group">
    @Html.LabelFor(m => m.ProcedenciaDesc, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.ProcedenciaId, localidades, Textos.Default_Localidad, new { id = "localidadesDropDown" })
        @Html.Hidden("ConsultarConversionPorCamara", Url.Action("Indexa"))
        @Html.ValidationMessageFor(m => m.ProcedenciaId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.CodigoCamara, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoCamara, new {@class = "control input-large"})
        @Html.ValidationMessageFor(m => m.CodigoCamara)
    </div>
</div>

<div class="botones-carta-porte centered">
    <button class="btn btn-primary" type="submit">@Textos.Agregar</button>
</div>
