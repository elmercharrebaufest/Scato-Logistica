@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.GraficoEficienciaHidraulicasDto
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    Layout = null;
    var materiales = (List<SelectListItem>)ViewBag.Materiales;
    var hidraulicas = (MultiSelectList)ViewBag.Hidraulicas;
}

<script type="text/javascript" src="@Url.Script("~/scripts/graficoToneladasPorDia.js")"></script>
<script type="text/javascript">
    var textoToneladasPorDia = "@Textos.ToneladasPorDia"
</script>

<style>
    .checkboxesToneladas,
    .checkboxesToneladas div {
        display: inline-block;
    }
</style>

<div id="graficoToneladasPorDia">
    <div class="row">
        <div class="col-lg-12 bordeGris">
            <div class="form-inline col-lg-offset-1" style="padding: 5px; margin-top: 10px;margin-bottom: 10px;">
                @Html.LabelFor(model => model.MaterialDescripcion)
                @Html.DropDownList("MaterialId", materiales, "Todos", new { @id = "materialIdToneladasPorDia" })

                &nbsp;&nbsp;
                @Html.LabelFor(model => model.FechaHoraDesde)
                @Html.TextBox("FechaDesdeToneladas", Model != null ? Model.FechaHoraDesde.ToString("dd/MM/yyyy HH:mm") : string.Empty, new { @class = "control", @tabindex = "-1" })

                &nbsp;&nbsp;
                @Html.LabelFor(model => model.FechaHoraHasta)
                @Html.TextBox("FechaHastaToneladas", Model != null ? Model.FechaHoraHasta.ToString("dd/MM/yyyy HH:mm") : string.Empty, new { @class = "control", @tabindex = "-1" })
                &nbsp;&nbsp;
                <button class="btn" data-bind="click: generarGraficoToneldasPorDia">@Textos.Generar</button>
                <span class="alert-danger" id="errorSummaryToneladas"></span>
            </div>
            <div class="form-inline col-lg-offset-1" style="padding: 5px; margin-top: 5px; margin-bottom: 10px;">
                <span style="display:inline-block">Hidráulicas &nbsp;&nbsp;</span>
                @Html.CheckBoxListFor(model => model.HidraulicasCodes, hidraulicas, new { @class = "checkboxesToneladas", @tabindex = "-1" }, "HidraulicasCodesToneladas")
            </div>
        </div>
    </div>
    <div class="row" id="partialContainerToneladasPorDia">
        @Html.Partial("_GraficoToneladasPorDia", Model)
    </div>
</div>
<div id="autocompleteCorr"></div>