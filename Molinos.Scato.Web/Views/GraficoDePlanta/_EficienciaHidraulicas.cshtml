@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.GraficoEficienciaHidraulicasDto
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    Layout = null;
    var materiales = (List<SelectListItem>)ViewBag.Materiales;
    var hidraulicas = (MultiSelectList)ViewBag.Hidraulicas;
}

<script type="text/javascript" src="@Url.Script("~/scripts/graficoEficienciaHidraulicas.js")"></script>
<script type="text/javascript">
    var textoHidraulicas = "@Textos.CantidadCamionesPorHidraulicaJavascript"
</script>

<style>
    .checkboxes,
    .checkboxes div {
        display: inline-block;
    }
</style>

<div id="graficoeficienciahidraulica">
    <div class="row">
        <div class="col-lg-12 bordeGris">
            <div class="form-inline col-lg-offset-1" style="padding: 5px; margin-top: 10px; margin-bottom: 10px;">
                @Html.LabelFor(model => model.MaterialDescripcion)
                @Html.DropDownList("MaterialId", materiales, "Todos", new { @id = "materialIdHidraulica" })

                &nbsp;&nbsp;
                @Html.LabelFor(model => model.FechaHoraDesde)
                @Html.TextBox("FechaDesdeCamiones", Model != null ? Model.FechaHoraDesde.ToString("dd/MM/yyyy HH:mm") : string.Empty, new { @class = "control", @tabindex = "-1" })

                &nbsp;&nbsp;
                @Html.LabelFor(model => model.FechaHoraHasta)
                @Html.TextBox("FechaHastaCamiones", Model != null ? Model.FechaHoraHasta.ToString("dd/MM/yyyy HH:mm") : string.Empty, new { @class = "control", @tabindex = "-1" })

                &nbsp;&nbsp;
                <button class="btn" data-bind="click: generarGrafico">@Textos.Generar</button>
                <span class="alert-danger" id="errorSummaryCamiones"></span>
            </div>
            <div class="form-inline col-lg-offset-1" style="padding: 5px; margin-top: 5px; margin-bottom: 10px;">
                <span style="display:inline-block">Hidráulicas &nbsp;&nbsp;</span>
                @Html.CheckBoxListFor(model => model.HidraulicasCodes, hidraulicas, new { @class = "checkboxes", @tabindex = "-1" })
            </div>
        </div>
    </div>
    <div class="row" id="partialContainerHidraulica">
        @Html.Partial("_GraficoEficienciaHidraulicas", Model)
    </div>
</div>
<div id="autocompleteCorr"></div>