@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model List<EstadoMaterialDto>
@{

    Layout = null;
}

<style>
    body {
        color: white;
        width:1920px;
    }

    .titulo {
        font-size: 29px;
        font-weight: bolder;
        font-family: "Roboto", Arial, Tahoma, sans-serif;
        text-transform: uppercase;
        margin-top: 7px;
        text-align: center;
        width: 100%;
        display: block;
        height: 60px;
    }

    table {
        color: white;
        width:1920px;
        border-spacing: 1px;
        border-collapse: separate;
        font-size: 26px;
    }

    td {
        width: 380px;
        border-radius: 5px;
    }

    .td1 {
        background-color: #244232;
        border-color: #244232;
    }

    .td2 {
        background-color: #36634b;
        border-color: #36634b;
    }

    .td3 {
        background-color: #488464;
        border-color: #488464;
    }

    .td4 {
        background-color: #5ba47d;
        border-color: #5ba47d;
    }

    .td5 {
        background-color: #5ba47d;
        border-color: #5ba47d;
    }
    
    .linea {
        display: block;
        width: 100%;
    }
    .material {
        width:260px;display: inline-block;padding-left: 20px;
    }
    .valor {
        width:87px; display: inline-block;font-weight: bolder;
    }
    .valor2 {
        width:43px; display: inline-block;font-weight: bolder;
    }
    .valor3 {
        width:43px; display: inline-block;font-weight: bolder;
    }
</style>

<table>
    <tr>
        <td class="td1">
            <span class="titulo td1">
                @Textos.GraficoDePlanta_CamionesEnCircuito
            </span>
            @foreach (var material in Model)
            {
                <div class="linea">
                    <span class="material"> @material.Material</span>
                    <span class="valor"> @material.CamionesEnPlanta</span>
                </div>
            }
            <div class="linea">
                <span class="material"> &nbsp;</span>
                <span class="valor"> &nbsp;</span>
            </div>
            @for (var i = Model.Count; i < 4; i++)
            {
                <div><br> </div>
            }
        </td>
        <td class="td2">
            <span class="titulo td2">
                @Textos.GraficoDePlanta_CamionesDescargados
            </span>
            @foreach (var material in Model)
            {
                <div class="linea ">
                    <span class="material"> @material.Material</span>
                    <span class="valor2"> @material.Peso.ToStringAbreviado()</span>
                    <span class="valor3"> @material.CamionesEnElDia</span>
                </div>
            }
            <div class="linea">
                <span class="material"> &nbsp;</span>
                <span class="valor"> &nbsp;</span>
            </div>
            @for (var i = Model.Count; i < 4; i++)
            {
                <div class="col-xs-12"><br> </div>
            }
        </td>
        <td class="td3">
            <span class="titulo td3">
                @Textos.GraficoDePlanta_TotalEnElDia <br />
            </span>
            @foreach (var material in Model)
            {
                <div class="linea ">
                    <span class="material"> @material.Material</span>
                    <span class="valor"> @material.TotalIngresosEnElDia</span>
                </div>
            }
            <div class="linea">
                <span class="material"> &nbsp;</span>
                <span class="valor"> &nbsp;</span>
            </div>
            @for (var i = Model.Count; i < 4; i++)
            {
                <div><br> </div>
            }
        </td>
        <td class="td4">
            <span class="titulo td4">
                @Textos.GraficoDePlanta_CamionesRechazados
            </span>
            @foreach (var material in Model)
            {
                <div class="linea ">
                    <span class="material"> @material.Material</span>
                    <span class="valor"> @material.Rechazados</span>
                </div>
            }
            <div class="linea">
                <span class="material"> &nbsp;</span>
                <span class="valor"> &nbsp;</span>
            </div>
            @for (var i = Model.Count; i < 4; i++)
            {
                <div><br> </div>
            }
        </td>
        <td class="td5">
            <span class="titulo td5">
                @Textos.Cupos
            </span>
            <div class="linea ">
                <span class="material"> @Textos.Cupos_Del_Día</span>
                <span class="valor"> @ViewBag.Cupeados</span>
            </div>
            <div class="linea ">
                <span class="material"> @Textos.CuposDelDía_En_SAP</span>
                <span class="valor"> @ViewBag.Arribados</span>
            </div>
            <div class="linea ">
                <span class="material"> @Textos.Cupos_Etapa_Tara</span>
                <span class="valor"> @ViewBag.Descargados</span>
            </div>
            <div class="linea ">
                <span class="material"> Cumplimiento</span>
                <span class="valor"> @ViewBag.Cumplimiento%</span>
            </div>
        </td>
        
    </tr>
</table>