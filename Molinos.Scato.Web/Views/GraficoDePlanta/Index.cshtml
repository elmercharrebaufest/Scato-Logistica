@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model List<EstadoMaterialDto>
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    var materialId = (int)ViewBag.MaterialId;
    var materialDesc = ViewBag.MaterialDescripcion;
}
<script type="text/javascript">
    var urlCabezera = "@Url.Action("RetornoPartialDelIndex")";
</script>
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="~/scripts/Chart.min.js" type="text/javascript"></script>
<script src="~/Scripts/Chart.bundle.js"></script>
<script src="~/Scripts/chartjs-plugin-annotation.min.js"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/graficoDePlantaCabezera.js")"></script>

<link href="@Url.Content("~/Content/bootstrap-datetimepicker.css")" rel="stylesheet" type="text/css">
<script src="@Url.Script("~/Scripts/bootstrap-datetimepicker.js")" type="text/javascript"></script>

<div id="links"
     data-url-buscar-material="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales="@Url.Action("BuscarMaterialesConTodos", "Consultas")"
     data-url-cabezera="@Url.Action("RetornoPartialDelIndex", "GraficoDePlanta")">
</div>
<link href="~/Content/bootstrap-toggle.min.css" rel="stylesheet" />
<script src="~/Scripts/bootstrap-toggle.min.js"></script>
<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/panels.less")">
<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/columna.css")">
<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/graficoDePlanta.css")">

<div class="container-fluid">
    <div class="titSecciones">
        <div style="padding-top:15px; float:left">
            <span>@Textos.GraficoDePlanta_Titulo</span>
        </div>
        <div style="float:right;">
            <input id="mostrarIngresos" type="checkbox" checked data-toggle="toggle" data-on="Ingresos" data-off="Egresos" data-onstyle="success" data-offstyle="success">
            <input id="esGrano" type="checkbox" checked data-toggle="toggle" data-on="Granos" data-off="No Granos" data-onstyle="success" data-offstyle="success">
        </div>
    </div>
</div>



<div class="container-fluid content">
    <div class="row-fluid" id="graficodeplantahead">
        @Html.Partial("~/Views/GraficoDePlanta/_GraficoDePlantaCabezera.cshtml", Model)
    </div>

    <div class="row-fluid">
        <div class="tabbable tabs-left">
            <ul class="nav nav-tabs">
                <li class="active">
                    <a href="#lA" data-toggle="tab">@Textos.CamionesPorHora</a>
                </li>
                <li class="">
                    <a href="#lB" data-toggle="tab">@Textos.CamionesDia</a>
                </li>
                <li class="">
                    <a href="#lC" data-toggle="tab">@Textos.EficienciaHidraulicas</a>
                </li>
                <li class="">
                    <a href="#lD" data-toggle="tab">@Textos.EstadoPlanta</a>
                </li>
            </ul>
            <div class="tab-content graficos">
                <div class="tab-pane active" id="lA">
                    @Html.Partial("_CamionesPorHora", new GraficoCamionesHoraDto { MaterialId = materialId, MaterialDescripcion = materialDesc, FechaVieja = DateTime.Today.AddYears(-1) })
                </div>
                <div class="tab-pane" id="lB">
                    @Html.Partial("_CamionesPorDia", new GraficoCamionesDiaDto { MaterialId = materialId, MaterialDescripcion = materialDesc })
                </div>
                <div class="tab-pane" id="lC">
                    @Html.Partial("_EficienciaHidraulicas", new GraficoEficienciaHidraulicasDto { MaterialId = materialId, MaterialDescripcion = materialDesc, FechaHoraDesde = DateTime.Today, FechaHoraHasta = DateTime.Now })

                    @Html.Partial("_ToneladasPorDia", new GraficoEficienciaHidraulicasDto { MaterialId = materialId, MaterialDescripcion = materialDesc, FechaHoraDesde = DateTime.Today, FechaHoraHasta = DateTime.Now })

                    @Html.Partial("_ToneladasPorRangoDeDia", new GraficoToneladasRangoDeDiasDto { MaterialId = materialId, MaterialDescripcion = materialDesc, FechaDesde = DateTime.Today.AddDays(-1), FechaHasta = DateTime.Today })
                </div>
                <div class="tab-pane" id="lD">
                    @Html.Partial("_GraficoDePlanta")
                </div>
            </div>
        </div>
    </div>
</div>
