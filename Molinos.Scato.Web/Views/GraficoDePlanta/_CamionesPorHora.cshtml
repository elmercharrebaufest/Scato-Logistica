@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.GraficoCamionesHoraDto
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    Layout = null;
}
<script type="text/javascript" src="@Url.Script("~/scripts/graficoCamionesHora.js")"></script>
<script type="text/javascript">
    var textoHistorico = "@Textos.CamionesFechaComparacion"
    var textoActual = "@Textos.CamionesFechaActual"
</script>
<div id="graficocamioneshora">
    <div class="row">
        <div class="col-lg-12 bordeGris">
            <div class="form-inline col-lg-offset-1" style="padding: 5px">
                @Html.LabelFor(model => model.MaterialDescripcion)
                @Html.TextBoxFor(model => model.MaterialDescripcion, new {@class = "input-medium", @id = "materialDescripcionHora"})
              
                @Html.HiddenFor(model => model.MaterialId, new {@id = "materialIdHora"})
                &nbsp;&nbsp;
                @Html.LabelFor(model => model.FechaVieja)
                @Html.EditorFor(model => model.FechaVieja, Model != null ? Model.FechaVieja.FormattedFixed() : string.Empty)
                
                &nbsp;&nbsp;
                <button class="btn" data-bind="click: generarGraficoHora">@Textos.Generar</button>
            </div>
        </div>
    </div>
    <div class="row" id="partialContainerHora">
        @Html.Partial("_GraficoCamionesPorHora", Model)
    </div>
</div>
<div id="autocompleteCorr"></div>