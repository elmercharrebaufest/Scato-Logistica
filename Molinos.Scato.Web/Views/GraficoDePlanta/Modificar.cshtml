@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.GraficoDePlantaDto
@{
    Layout = null;
    ViewBag.Title = Textos.Modificar;

    var actividad = (string)ViewBag.NombreActividad;
    var centroId = (int)ViewBag.CentroId;
}
@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/jquery.colorPicker.js" type="text/javascript"></script>
<script>
    jQuery(document).ready(function ($) {
        $('#Color').colorPicker({ showHexField: false });

    });

</script>

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Modificar + " " + actividad }))
{
    @Html.Hidden("CentroId", centroId)
    @Html.Hidden("NombreActividad", actividad)
    @Html.HiddenFor(model => model.Id)

    <div class="control-group">
        @Html.LabelFor(model => model.Rango, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.Rango, new { @class = "input-mini " })
            @Html.ValidationMessageFor(model => model.Rango)
        </div>
    </div>
    
    <div class="control-group">
        @Html.LabelFor(m => m.Color, new { @class = "control-label" })
        <div class="controls">
            @if (Model == null)
            {
                <input id="Color" type="text" name="Color" alt="Cambiar color" data-text="Cambiar Color" value="#000000" style="visibility: hidden; position: absolute;" />
            }
            else
            {
                <input id="Color" type="text" name="Color" alt="Cambiar color" data-text="Cambiar Color" value="@Model.Color" style="visibility: hidden; position: absolute;" />
            }

            @Html.ValidationMessageFor(m => m.Color)
        </div>
    </div>
}
