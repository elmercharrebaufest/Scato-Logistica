@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.GraficoCamionesDiaDto
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    Layout = null;
}
<script type="text/javascript" src="@Url.Script("~/scripts/graficoCamionesDia.js")"></script>
<script type="text/javascript">
    var camionesDia = "@Textos.CamionesDiaJavascript"
</script>
<div id="graficocamionesdia">
    <div class="row">
        <div class="col-lg-12 bordeGris">
            <div class="form-inline col-lg-offset-1" style="padding: 5px">
                @Html.LabelFor(model => model.MaterialDescripcion)
                @Html.TextBoxFor(model => model.MaterialDescripcion, new {@class = "input-medium", @id = "materialDescripcionDia"})
               
                @Html.HiddenFor(model => model.MaterialId, new {@id = "materialIdDia"})
                &nbsp;&nbsp;
                <button class="btn" data-bind="click: generarGrafico">@Textos.Generar</button>
            </div>
        </div>
    </div>
    <div class="row" id="partialContainerDia">
        @Html.Partial("_GraficoCamionesPorDia", Model)
    </div>
</div>
<div id="autocompleteCorr"></div>