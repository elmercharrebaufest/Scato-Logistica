@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    ViewBag.Title = "VerCola";
    var cola = (List<ColaImpresionDto>)ViewBag.ColaImpresion;
    var impresoraId = (int)ViewBag.ImpresoraId;
}

<script src="@Url.Script("~/Scripts/impresora.listarCola.js")" type="text/javascript"></script>

@Html.Hidden("verColaUrl",@Url.Action("VerCola",new {id = impresoraId }))
@Html.ValidationSummary(true)
<div class ="container">
<div class="titSecciones">@Textos.Impresora_ListaCola</div>
    </div>
    <table class="table table-striped table-bordered" id="tablaJobs">
        <thead>
            <tr>
                <th style="width: 70px"><button id="refrescarColaBtn" class="btn " name="refrescar" value="">@Textos.Refrescar</button></th>
                <th>Servidor</th>
                <th>Nombre Documento</th>
                <th>Estado</th>
                <th>Paginas</th>
                <th>Tamaño (KB)</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody >
            @foreach (var impresion in cola)
            {          
                <tr>                  
                    <td><a title="Resumir" href="@Url.Action("AccionImpresionCola", new { impresoraId = impresion.ImpresoraId ,jobId = impresion.JobId, servidor = impresion.ServidorUrl, opcion = AccionColaImpresion.Resumir })"><i class="icon-play" ></i></a>
                        <a title="Pausar" href="@Url.Action("AccionImpresionCola", new { impresoraId = impresion.ImpresoraId ,jobId = impresion.JobId, servidor = impresion.ServidorUrl, opcion = AccionColaImpresion.Pausar})"><i class="icon-pause" ></i></a>
                        <a title="Reiniciar" href="@Url.Action("AccionImpresionCola", new { impresoraId = impresion.ImpresoraId ,jobId = impresion.JobId, servidor = impresion.ServidorUrl, opcion = AccionColaImpresion.Reiniciar })"><i class="icon-refresh" ></i></a>
                        <a title="Cancelar" href="@Url.Action("AccionImpresionCola", new { impresoraId = impresion.ImpresoraId ,jobId = impresion.JobId, servidor = impresion.ServidorUrl, opcion = AccionColaImpresion.Cancelar})"><i class="icon-remove" ></i></a></td>
                    <td>@impresion.Servidor</td>
                    <td>@impresion.Documento</td>
                    <td>@impresion.Estado</td>
                    <td>@impresion.Paginas</td>
                    <td>@impresion.Tamanio</td>
                    <td>@impresion.Fecha</td>                  
                </tr>          
            }
        </tbody>

    </table>