@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    ViewBag.Title = Textos.Impresoras_Titulo;
    var serversLista = (IEnumerable<SelectListItem>)ViewBag.Servers;
}
<style>
    .modal {
        left: 30%;
    }
</style>
<div class ="container-fluid">
    <div class="titSecciones">@Textos.Administracion_Impresoras</div>
</div>
<script src="@Url.Script("~/Scripts/Impresora.index.js")" type="text/javascript"></script>
<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width: auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions {HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer"}, new {id = "search-form", @class = "form-search"}))
            {
                @Html.Label(Textos.Filtrar_Impresoras)
                <input type="text" name="filtro" class="input-large"/>
                <button type="submit" class="btn">@Textos.Filtrar</button>

            }
        </div>
        @Html.ActionLink(Textos.Impresora_Nuevo, "Crear", "Impresora", null, new {@class = "ajax-editar-link btn btn-primary pull-right"})
    </div>
    <div id="gridContainer">
        @Html.Partial("Listar")
    </div>
</div>

<div id="diag-imprimir" data-imprimir-url="@Url.Action("Imprimir", "Impresora")">
    <div class="modal fade hide" id="dialogo-imprimir">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h5>@Textos.SeleccionarServidor_Titulo</h5>
        </div>
        <div class="modal-body" id="dialogo-imprimir-body">
            @Textos.Servidor:
            <h5>@Html.DropDownList("servidorNombre", serversLista, new { @class = "control-small", id = "serversLista", Style = "margin-bottom: 0px;" })</h5>
        </div>
        <div class="modal-footer">
            <button id="dialogo-imprimir-imprimir" class="btn">@Textos.Imprimir</button>
            <button id="dialogo-imprimir-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
        </div>
    </div>
</div>
