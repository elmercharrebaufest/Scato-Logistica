@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Dominio.Enums
@model Molinos.Scato.Dominio.Dto.CargaDeCupoDto
@{
    Layout = null;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
    var avanzaAutomatico = (bool)ViewBag.AvanzaAutomatico;

    var imageSrc = !string.IsNullOrEmpty(Model.ImagenCartaPorteSustentable) ? "data:image/jpg;base64," + Model.ImagenCartaPorteSustentable
        : !string.IsNullOrEmpty(Model.ImagenCartaPorte) ? "data:image/jpg;base64," + Model.ImagenCartaPorte
        : "";
}

<style>
    #patenteALPR {
        position: absolute;
        top: 130px;
        padding-left: 34px;
        color: #00ff00;
        background-color: black;
    }

    .alerta-box {
        text-align: left !important;
    }

    #alertaExitosa {
        text-align: center !important;
        font-weight: bold !important;
        font-size: 26px;
    }

    #alertaTasaMunicipalExitosa {
        text-align: center !important;
        font-weight: bold !important;
    }

    #alertaTasaMunicipalError {
        text-align: center !important;
        font-weight: bold !important;
    }

    .control-group.sinMargen {
        margin-bottom: 0px;
    }

    .control-label.menosAncho {
        width: auto;
    }

    .controls.menosAncho {
        margin-left: 100px;
    }

    .span5.fotopatente {
        margin-left: 0px;
    }

    .row-fluid .span3 {
        border: none;
    }

    .validation-summary-errors {
        color: #b94a48;
    }

    .alerta-box {
        font-weight: 400;
    }

    .control-label.inline {
        width: auto;
        padding-right: 15px;
    }

    .contenedor-barrera {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 55%;
        margin-left: auto;
    }

    .bar-ico {
        font-size: 80px;
    }

    .apertura {
        color: #07c35f !important;
    }

    .cierre {
        color: #ea1f1f !important;
    }

    .botones-barrera {
        margin: 20px 0;
    }
</style>

@Html.HiddenFor(x => x.CPE)
@Html.Hidden("AvanceCpe", avanzaAutomatico)
@Html.HiddenFor(x => x.FotoRutaDestino)

<div class="row-fluid" style="margin-bottom:5px;">
    <div class="span8">
        <div class="row-fluid">
            <div class="span4">
                <div class="container-fluid">
                    <div class="titSecciones">@Textos.CargaDeCupo</div>
                </div>
                <br />
                <div class="control-group sinMargen">
                    <div style="width: 260px; display: inline-flex;">
                        <div style="width: 160px;">
                            @Html.Label(@Textos.CircuitoGranos, new { @class = "control-label inline" })
                            @Html.CheckBoxFor(x => x.CircuitoNoGranos, new { id = "circuitoNoGranos" })
                        </div>
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.LabelFor(model => model.Numero, Textos.AsignacionTarjetaDeAcceso_NTarj + ":", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.Numero,
                            new
                            {
                                @readonly = "readonly",
                                placeholder = Textos.ListaDeTareasAutomatizada_EsperandoLectura,
                                @class = "control input-medium",
                                @type = "number"
                            })
                        @Html.ValidationMessageFor(model => model.Numero)
                        @Html.HiddenFor(model => model.PuestoDeTrabajoId)
                        @Html.HiddenFor(model => model.ImprimeCartaPorte)
                        @Html.HiddenFor(model => model.ImprimeTarjetaDeAcceso)
                        @Html.HiddenFor(model => model.NoAsignaCalleEnGaritaEntrada)
                        @Html.HiddenFor(model => model.SinFotoCartaPorte)
                        <span class="label label-success hidden" id="labelConectado">@Textos.Conectado</span>
                        <span class="label label-important hidden" id="labelDesconectado">@Textos.Desconectado</span>
                    </div>
                </div>
                <div class="control-group sinMargen" style="padding-top: 7px;">
                    @Html.LabelFor(model => model.CTG, Textos.CTG + ":", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.CTG, new { @class = "control input-medium", @type = "number" })
                        <button type="button" id="btnActualizarCpe" class="btn btn-mini" title="@Textos.ActualizarCpe">
                            <i class="icon-refresh"></i>
                        </button>
                        @Html.ValidationMessageFor(model => model.CTG)
                        @Html.HiddenFor(model => model.CodEstab)
                        @Html.HiddenFor(model => model.RtteComercialCodigoSap)
                        @Html.HiddenFor(model => model.TitularCartaPorteCodigoSap)
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.LabelFor(model => model.NumeroCartaPorte, new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.NumeroCartaPorte, new { @class = "control input-medium", @disabled = "disabled" })
                        @Html.ValidationMessageFor(model => model.NumeroCartaPorte)
                        @Html.HiddenFor(model => model.RtteComercialVentaSecundariaCuit)
                        @Html.HiddenFor(model => model.CodigoRENSPA)
                        @Html.HiddenFor(model => model.Cosecha)
                        @Html.HiddenFor(model => model.PesoNetoOrigen)
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.LabelFor(model => model.Cupo, @Textos.CartaPorte_Cupo + ":", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.Cupo,
                            new
                            {
                                autocomplete = "off",
                                @class = "control input-medium",
                            })
                        @Html.ValidationMessageFor(model => model.Cupo, null, new { id = "cupoValidation" })
                        @Html.HiddenFor(model => model.RespuestaSap)
                        @Html.HiddenFor(model => model.Especial)
                        @Html.HiddenFor(model => model.FechaSap)
                        @Html.HiddenFor(model => model.Camara)
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.LabelFor(model => model.Patente, new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.Patente,
                            new
                                 {
                                maxlength = 10,
                                required = "required",
                                pattern = "[A-Za-z]{3}\\d{3}|[A-Za-z]{2}\\d{3}[A-Za-z]{2}",
                                @class = "control input-medium uppercase",
                            })
                        @Html.ValidationMessageFor(model => model.Patente)
                        @Html.HiddenFor(model => model.PatenteAcoplado)
                    </div>
                </div>

                <div class="control-group sinMargen">
                    @Html.Label("Material", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.DropDownListFor(model => model.MaterialId, materiales, Textos.Default_Material, new { @class = "control input-medium" })
                        @Html.ValidationMessageFor(model => model.MaterialId)
                        @Html.HiddenFor(model => model.HayVariosMateriales)
                        @Html.HiddenFor(model => model.TipoOrdenCargaNoGranos)
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.Label(@Textos.SinValidacionDeCupo, new { @class = "control-label" })
                    <div class="controls">
                        @Html.CheckBoxFor(x => x.SinCupo, new { id = "checkSinCupo" })
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.Label("Ingreso Automático", new { @class = "control-label" })
                    <div class="controls" style="margin-bottom: 20px;">
                        <input id="checkvalidarPatente" type="checkbox">
                    </div>
                </div>
            </div>
            <div class="span8 fotopatente">
                <div class="row-fluid">
                    <div class="bordeGrisCompleto" id="marco-patente" style="height:300px; width:530px;margin:auto">
                        <h3 id="patenteALPR"></h3>
                        <img id="imagen-patente" src="" alt="Foto frontal del camión&#10&#13Cargando..." style="max-height: 100%; max-width: 100%;height:300px" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row-fluid" style="margin-top:20px">
            <div class="row-fluid">
                <div class="span12 alert hide" id="validation-alert-cargaDeCupo">
                    <button type="button" class="close" id="validation-alert-cargaDeCupo-close">×</button>
                    <div id="validation-alert-cargaDeCupo-message"></div>
                </div>
            </div>

            <!--Alertas generales-->
            <div class="row-fluid">
                <div class="span12 alert alert-error hide" id="validation-error-alert">
                    <button type="button" class="close" id="validation-error-close">×</button>
                    <div id="validation-error-message"></div>
                </div>
            </div>
            <div class="row-fluid">
                <div class="span12 alert hide" id="validation-advertencia-alert">
                    <button type="button" class="close" id="validation-advertencia-close">×</button>
                    <div id="validation-advertencia-message"></div>
                </div>
            </div>
            <div class="row-fluid">
                <div class="span12 alert alert-info hide" id="validation-informativo-alert">
                    <button type="button" class="close" id="validation-informativo-close">×</button>
                    <div id="validation-informativo-message"></div>
                </div>
            </div>

            <!--Mensajes para granos-->
            <div class="row-fluid">
                @*se muestran errores de patentes*@
                <div class="span12 alert alert-info hide" id="validation-patente-danger">
                    <button type="button" class="close" id="validation-danger-close">×</button>
                    <div id="validation-patente-danger-message"></div>
                </div>
            </div>

            <div class="row-fluid">
                @*se muestran errores de tarjetas*@
                <div class="span12 alert alert-error hide" id="validation-tarjeta-alert">
                    <button type="button" class="close" id="validation-tarjeta-close">×</button>
                    <div id="validation-tarjeta"></div>
                </div>
            </div>
            <div class="row-fluid">
                <div class="span12 alert alert-error hide" id="validation-ctg-alert">
                    <button type="button" class="close" id="validation-ctg-close">×</button>
                    <div id="validation-ctg"></div>
                </div>
            </div>
            <div class="control-group">
                <div class="text-center">
                    <button type="submit" class="btn btn-primary confirmar-boton" id="btnAceptar">@Textos.Aceptar</button>
                    @Html.ActionLink(Textos.Cancelar, "Index", "CargaDeCupo", null, new { @class = "btn" })
                </div>
            </div>
        </div>
    </div>
    <div class="span4">
        <div class="row-fluid" id="listaCupos"></div>

        <div class="row-fluid divFotoCP">
            <div class="bordeGrisCompleto" id="marco-cp" style="height:560px; width:367px;margin:auto">
                @Html.HiddenFor(x => x.ImagenCartaPorte)
                @Html.HiddenFor(x => x.ImagenCartaPorteSustentable)

                <a id="" href="#" class="btn tomarFoto1" style="display: none; position: absolute; float:left; z-index:1000">
                    <i class="fa fa-camera"></i>
                </a>

                <img id="imagen-cp"
                     src="@imageSrc"
                     alt="Carta de porte"
                     style="max-height: 100%; max-width: 100%;height:560px" />
            </div>
        </div>
    </div>
</div>

<dialog id="dialogo-confirmar" class="dialogModal">
    <h4 class="dialogModal__titulo">@Textos.Confirmacion</h4>
    <div class="dialogModal__descripcion" id="dialogo-confirmar-body"></div>
    <div class="dialogModal__botones">
        <button id="dialogo-confirmar-confirmar" type="button" class="btn btn-primary">@Textos.Aceptar</button>
        <button id="dialogo-confirmar-cancelar" type="button" class="btn" onclick="document.getElementById('dialogo-confirmar').close()">@Textos.Cancelar</button>
    </div>
</dialog>

<dialog id="dialogo-error" class="dialogModal">
    <h4 class="dialogModal__titulo">@Textos.Error</h4>
    <div class="dialogModal__descripcion" id="dialogo-error-body"></div>
    <div class="dialogModal__botones">
        <button id="dialogo-error-confirmar" type="button" class="btn btn-danger" onclick="location.href='@Url.Action("Index", "CargaDeCupo")'">@Textos.Aceptar</button>
    </div>
</dialog>