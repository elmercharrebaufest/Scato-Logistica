@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.CargaDeCupoDto
@{
    Layout = null;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
    var fila = ViewBag.FilaAsignadaNombre ?? "";
    var mostrarAlertaExitosa = (bool)(ViewBag.MostrarAlertaExitosa ?? false);
    var disponibilidad = ViewBag.Disponibilidad;
    var esCircuitoNoGranos = ViewBag.EsCircuitoNoGranosSinMaterial;
}
<script src="@Url.Script("~/Scripts/cargaDeCupo.form.js")" type="text/javascript"></script>

<style>
    #patenteALPR {
        position: absolute;
        top: 130px;
        padding-left: 34px;
        color: #00ff00;
        background-color: black;
    }

    .alerta-box {
        text-align: left !important;
    }

    #alertaExitosa {
        text-align: center !important;
        font-weight: bold !important;
    }

    .control-group.sinMargen {
        margin-bottom: 0px;
    }

    .control-label.menosAncho {
        width: auto;
    }

    .controls.menosAncho {
        margin-left: 100px;
    }

    .span5.fotopatente {
        margin-left: 0px;
    }

    .row-fluid .span3 {
        border: none;
    }

    .validation-summary-errors {
        color: #b94a48;
    }

    .alerta-box {
        font-weight: 400;
    }

    .control-label.inline {
        width: auto;
        padding-right: 15px;
    }

    .contenedor-barrera {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 55%;
        margin-left: auto;
    }

    .bar-ico {
        font-size: 80px;
    }

    .apertura {
        color: #07c35f !important;
    }

    .cierre {
        color: #ea1f1f !important;
    }

    .botones-barrera {
        margin: 20px 0;
    }
</style>

@if (mostrarAlertaExitosa && string.IsNullOrEmpty(fila) && esCircuitoNoGranos)
{
    <script type="text/javascript">
        MostrarAlertaExitosa('Carga Exitosa, Camión debe dirigirse a Mesa FAS.', 10000);
    </script>
}
else if (mostrarAlertaExitosa && !string.IsNullOrEmpty(fila))
{
    <style>
        #alertaExitosa {
            font-size: 26px;
        }
    </style>
    <script type="text/javascript">
            MostrarAlertaExitosa('Carga Exitosa, se asignó @fila', 10000);
    </script>
}

@if (!string.IsNullOrEmpty(ViewBag.FilaAsignadaNombre) && disponibilidad <= 5 && disponibilidad > 0)
{
    <script type="text/javascript">
    MostrarAlertaExitosa('Carga Exitosa, se asignó @fila, <br> ESPACIO DISPONIBLE: @disponibilidad camiones', 1000);
    </script>
}

@if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
{
    <script type="text/javascript">
    var message = "<strong>Error al guardar el cupo!, intente nuevamente.</strong>";
    message += @Html.Raw(Json.Encode(((@Html.ValidationSummary()==null)?"":@Html.ValidationSummary().ToHtmlString())));
    MostrarAlertaError(message);
    </script>
}
@if (ViewData.ModelState["warning"] != null && ViewData.ModelState["warning"].Errors.Any() && !Model.CircuitoNoGranos)
{
    <script type="text/javascript">
    var message = "<strong>Error al asignar una fila de pre calado!</strong>";
    message += @Html.Raw(Json.Encode(((@Html.ValidationSummary()==null)?"":@Html.ValidationSummary().ToHtmlString())));
        MostrarAlertaAdvertencia(message);
    </script>
}
@if (ViewData.ModelState["warning"] != null && ViewData.ModelState["warning"].Errors.Any() && Model.CircuitoNoGranos)
{
    <script type="text/javascript">
    var message = "<strong>Error al asignar una fila de NoGranos!</strong>";
    message += @Html.Raw(Json.Encode(((@Html.ValidationSummary()==null)?"":@Html.ValidationSummary().ToHtmlString())));
        MostrarAlertaAdvertencia(message);
    </script>
}
@if (ViewData.ModelState["PuestoDeTrabajoId"] != null && ViewData.ModelState["PuestoDeTrabajoId"].Errors.Any())
{
    <div class="alert alert-error">
        <span>@Html.ViewData.ModelState["PuestoDeTrabajoId"].Errors.FirstOrDefault().ErrorMessage</span>
    </div>
}

<div class="row-fluid" style="margin-bottom:5px;">
    <div class="span8">
        <div class="row-fluid">
            <div class="span4">
                <div class="container-fluid">
                    <div class="titSecciones">@Textos.CargaDeCupo</div>
                </div>
                <br />
                <div class="control-group sinMargen" >
                    <div style="width: 260px; display: inline-flex;">
                        @*Esto es de no granos. Se comenta por el momento*@
                        <div style="width: 160px;">
                                @Html.Label(@Textos.CircuitoGranos, new { @class = "control-label inline" })
                                @Html.CheckBoxFor(x => x.CircuitoNoGranos, new { id = "circuitoNoGranos" })
                            </div>
                        <div style="width: 100px; display: none">
                            @Html.Label(@Textos.CPE, new { @class = "control-label inline" })
                            @Html.CheckBoxFor(x => x.CPE, new { id = "cpe" })
                        </div>
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.Label(Textos.AsignacionTarjetaDeAcceso_NTarj + ":", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.Numero, new { @class = "control input-medium", maxlength = 10, @readonly = "readonly", placeholder = Textos.ListaDeTareasAutomatizada_EsperandoLectura })
                        @Html.HiddenFor(model => model.PuestoDeTrabajoId)
                        @Html.HiddenFor(model => model.ImprimeCartaPorte)
                        @Html.HiddenFor(model => model.ImprimeTarjetaDeAcceso)
                        @Html.HiddenFor(model => model.NoAsignaCalleEnGaritaEntrada)
                        @Html.HiddenFor(model => model.SinFotoCartaPorte)
                        <span class="label label-success hidden" id="labelConectado">@Textos.Conectado</span>
                        <span class="label label-important hidden" id="labelDesconectado">@Textos.Desconectado</span>
                        @*@Html.ValidationMessageFor(model => model.Numero)*@
                    </div>
                </div>
                <div class="control-group sinMargen" style="padding-top: 7px;">
                    @Html.Label(Textos.CTG + ":", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.CTG, new { @class = "control input-medium", @readonly = "readonly", @onkeypress = "return isNumberKey(event)" })
                        @Html.ValidationMessageFor(model => model.CTG)
                    </div>
                </div>
                <div class="control-group sinMargen" style = "display: none;">
                    @Html.Label(Textos.CUIT_Solicitante + ":", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.CUITSolicitante, new { @class = "control input-medium", @readonly = "readonly" })
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.LabelFor(model => model.NumeroCartaPorte, new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.NumeroCartaPorte, new { @class = "control input-medium uppercase ctgRequerido", data_toggle = "tooltip", maxlength = 12 })
                        @Html.ValidationMessageFor(model => model.NumeroCartaPorte)

                        @Html.HiddenFor(model => model.CTG)
                        @Html.HiddenFor(model => model.CodEstab)
                        @Html.HiddenFor(model => model.RtteComercialCodigoSap)
                        @Html.HiddenFor(model => model.TitularCartaPorteCodigoSap)

                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.Label(@Textos.CartaPorte_Cupo + ":", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.Cupo, new { @class = "control input-medium cupoValidacion", autocomplete = "off", maxlength = 16, data_error = string.Format(Textos.Error_Requerido, new[] { Textos.CartaPorte_Cupo }) })
                        @Html.ValidationMessageFor(model => model.Cupo, null, new { id = "cupoValidation" })
                        @*@Html.HiddenFor(model => model.MaterialId)*@
                        @Html.HiddenFor(model => model.RespuestaSap)
                        @Html.HiddenFor(model => model.Especial)
                        @Html.HiddenFor(model => model.FechaSap)
                        @Html.HiddenFor(model => model.Camara)
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.LabelFor(model => model.Patente, new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.TextBoxFor(model => model.Patente, new
                        {
                            @class = "control input-medium uppercase",
                            @readonly = "readonly",
                            data_toggle = "tooltip",
                            maxlength = 10,
                       data_numero_url = Url.Action("ObtenerDatosDeSap", "CargaDeCupo")
                   })
                        @Html.ValidationMessageFor(model => model.Patente)
                    </div>
                </div>

                <div class="control-group sinMargen">
                    @Html.Label("Material", new { @class = "control-label menosAncho" })
                    <div class="controls menosAncho">
                        @Html.DropDownListFor(model => model.MaterialId, materiales, Textos.Default_Material, new { @class = "control input-medium" })
                        @Html.HiddenFor(model => model.MaterialId, new { @id="matId" })
                        @Html.ValidationMessageFor(model => model.MaterialId)
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.Label(@Textos.SinValidacionDeCupo, new { @class = "control-label" })
                    <div class="controls">
                        @Html.CheckBoxFor(x => x.SinCupo, new { id = "checkSinCupo" })
                    </div>
                </div>
                <div class="control-group sinMargen">
                    @Html.Label("Validar patente", new { @class = "control-label" })
                    <div class="controls" style="margin-bottom: 20px;">
                        <input id="checkvalidarPatente" type="checkbox">
                    </div>
                </div>
            </div>
            <div class="span8 fotopatente">
                <div class="row-fluid">
                    <div class="bordeGrisCompleto" id="marco-patente" style="height:300px; width:530px;margin:auto">
                        <h3 id="patenteALPR"></h3>
                        <img id="imagen-patente" src="" alt="Foto frontal del camión&#10&#13Cargando..." style="max-height: 100%; max-width: 100%;height:300px" />
                    </div>
                </div>

                @*<div class="contenedor-barrera">
                    <span>Estado de barrera: </span>
                    <span class="bar-ico icon-barrera-cerrada" id="barreraCargaCupo"></span>
                    <div class="botones-barrera">
                        <a class="btn tarjetaMaestro apertura" data-puesto-id="@ViewBag.PuestoId" data-id="@ViewBag.CodigoBarrera" ><i class="fa fa-unlock"> </i> </a>
                        <a class="btn tarjetaMaestro cierre" data-puesto-id="@ViewBag.PuestoId" data-id="@ViewBag.CodigoBarrera" ><i class="fa fa-lock"> </i> </a>
                    </div>
                </div>*@
            </div>
        </div>
        <div class="row-fluid" style="margin-top:20px">
            <div class="row-fluid">
                @*se muestran errores de patentes*@
                <div class="span12 alert alert-info hide" id="validation-patente-danger">
                    <button type="button" class="close" id="validation-danger-close">×</button>
                    <div id="validation-danger">

                    </div>
                </div>
            </div>
            <div class="row-fluid">
                @*se muestran error de validacion con venta Fas*@
                <div class="span12 alert alert-error hide" id="validation-ventaFas-error">
                    <button type="button" class="close" id="validation-ventaFas-close">×</button>
                    <div id="validation-ventaFas">
                    </div>
                </div>
            </div>
            <div class="row-fluid">
                @*se muestran errores de tarjetas*@
                <div class="span12 alert alert-error hide" id="validation-patente-alert">
                    <button type="button" class="close" id="validation-patente-close">×</button>
                    <div id="validation-patente">

                    </div>
                </div>
            </div>
            <div class="row-fluid">
                <div class="span12 alert alert-error hide" id="validation-ctg-alert">
                    <button type="button" class="close" id="validation-ctg-close">×</button>
                    <div id="validation-ctg">

                    </div>
                </div>
            </div>
            <div class="row-fluid">
                <div class="span12">
                    <div class="alert alert-error hide" id="validation-cupo">
                        <button type="button" class="close" id="validation-cupo-close">×</button>
                        <div id="validation-cupo-body">

                        </div>
                    </div>
                </div>
            </div>
            @*@Html.ValidationMessage("Imp")*@
            <div class="control-group">
                <div class="text-center">
                    <button type="submit" class="btn btn-primary confirmar-boton" id="btnAceptar">@Textos.Aceptar</button>
                    @Html.ActionLink(Textos.Cancelar, "Index", "CargaDeCupo", null, new { @class = "btn" })
                </div>
            </div>
        </div>
    </div>
    <div class="span4">
        <div class="row-fluid" id="listaCupos">

        </div>
        <div class="row-fluid divFotoCP">
            <div class="bordeGrisCompleto" id="marco-cp" style="height:560px; width:367px;margin:auto">
                @Html.HiddenFor(x => x.ImagenCartaPorte)
                @Html.HiddenFor(x => x.FotoRutaDestino)
                <a id="" href="#" class="btn tomarFoto1" style="display: none; position: absolute;float:left;z-index:1000">
                    <i class="fa fa-camera"></i>
                </a>
                <img id="imagen-cp" src="" alt="Carta de porte&#10&#13Ingrese el numero de Carta de porte para que se tome la foto..." style="max-height: 100%; max-width: 100%;height:560px" />
            </div>
        </div>
    </div>

</div>

<div class="modal hide fade" id="dialogo-confirmar">
    <div class="modal-header alert-danger">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4>@Textos.Confirmacion</h4>
    </div>
    <div class="modal-body" id="dialogo-confirmar-body">
    </div>
    <div class="modal-footer">
        <button id="dialogo-confirmar-confirmar" type="submit" class="btn ">@Textos.Aceptar</button>
        <button id="dialogo-confirmar-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
    </div>
</div>