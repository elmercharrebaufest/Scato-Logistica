@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.CargaDeCupoDto
@{
    var puestoDeTrabajo = (string)ViewBag.PuestoDeTrabajo;
    ViewBag.Title = Textos.CargaDeCupo;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
    <script src="~/Scripts/jquery.inputmask.bundle.js"></script>
    <script src="~/scripts/jquery.elevatezoom.js" type="text/javascript"></script>
    <script src="@Url.Script("~/Scripts/cargaDeCupo.core.js")" type="text/javascript"></script>
    <script src="@Url.Script("~/Scripts/cargaDeCupo.api.js")" type="text/javascript"></script>
    <script src="@Url.Script("~/Scripts/cargaDeCupo.ui.js")" type="text/javascript"></script>
    <script src="@Url.Script("~/Scripts/cargaDeCupo.app.js")" type="text/javascript"></script>
}

<link href="~/Styles/area/shared/dialogModal.css" rel="stylesheet" />

<div id="links"
     data-url-listar="@Url.Action("Listar", "CargaDeCupo")"
     data-url-obtener-carta-porte-ctg="@Url.Action("ObtenerCupoCtg", "CargaDeCupo")"
     data-url-obtener-patente="@Url.Action("ObtenerFoto", "CargaDeCupo")"
     data-url-obtener-material="@Url.Action("ObtenerMaterial", "CargaDeCupo")"
     data-url-obtener-cpe="@Url.Action("ObtenerCPE", "CargaDeCupo")"
     data-url-obtener-cpe-por-patente="@Url.Action("ObtenerCPEPorPatente", "CargaDeCupo")"
     data-url-obtener-ordenes-insumos="@Url.Action("ObtenerOrdenesFasonInsumos", "CargaDeCupo")"
     data-url-validar-cupo-sap="@Url.Action("ValidarCupoEnSap")"></div>

@Html.Hidden("puestoDeTrabajo", puestoDeTrabajo)
@Html.Hidden("centroId", (int)ViewBag.CentroId)
@Html.Hidden("CodigoCamaraPatente", (string)ViewBag.CodigoCamaraPatente)
@Html.Hidden("CodigoCamaraPatenteDir", (string)ViewBag.CodigoCamaraPatenteDir)
@Html.Hidden("CodigoCamaraCP", (string)ViewBag.CodigoCamaraCP)
@Html.Hidden("CodigoCamaraCPDir", (string)ViewBag.CodigoCamaraCPDir)

@using (Html.BeginForm("Index", "CargaDeCupo", FormMethod.Post, new { @class = "form-horizontal", data_mensaje_espera = Textos.CargaDeCupo, id = "formCargaDeCupo" }))
{
    <div id="formContainer">
        @Html.Partial("Form")
    </div>
}