@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@using System.Collections.Generic
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums



@if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#FechaDesde').click(function () {
                $('#errorMensaje').hide();
            });
            $('#FechaHasta').click(function () {
                $('#errorMensaje').hide();
            });
        });
    </script>
    <div class="row-fluid">
        <div class="span12" style="line-height: 30px">
            <div class="alert alert-danger" id="errorMensaje">
                <div id="validation-danger">
                    @ViewData.ModelState[""].Errors.First().ErrorMessage
                </div>
            </div>
        </div>
    </div>

}

@{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    Layout = null;

    var items = (IList<LogValidacionAccesoStopBandasHorariasDto>)ViewBag.Items;
    var camiones = items != null && items.Any() ? items.GroupBy(g => new { g.FechaIngreso }) : null;

}

@if (items != null && items.Any())
{
    <style>
        table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
        }

        th, td {
            padding: 8px;
            text-align: left;
        }

        thead {
            background-color: #2e7d32; /* verde oscuro */
            color: white;
        }

        tbody tr:nth-child(odd) {
            background-color: #f9f9f9; /* claro */
        }

        tbody tr:nth-child(even) {
            background-color: #e8f5e9; /* verde muy suave */
        }

        tbody tr:hover {
            background-color: #c8e6c9; /* hover verde */
        }
    </style>
    <table style="width:100%; table-layout: fixed;">
        <colgroup>
            <col style="width:20%">
            <col style="width:20%">
            <col style="width:20%">
            <col style="width:40%">
        </colgroup>

        <thead>
            <tr>
                <th>CTG</th>
                <th>Patente</th>
                <th>Fecha Ingreso</th>
                <th>Mensaje</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.CTG</td>
                    <td>@item.Patente</td>
                    <td>@item.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Mensaje</td>
                </tr>
            }
        </tbody>
    </table>

    <a href="@Url.Action("ExportarExcelMoaStop", "ReporteMoaStop", new {
        fechaDesde = Request["FechaDesde"],
        fechaHasta = Request["FechaHasta"],
        patente = Request["patente"],
        mensaje = Request["mensaje"]
    })"
       class="btn btn-success">
        Exportar a Excel
    </a>
    <div style="margin-top:20px; text-align:center;">

        @if (ViewBag.Page > 1)
        {
            <a href="#" class="btn btn-default page-link" data-page="@(ViewBag.Page - 1)">
                Anterior
            </a>
        }

    <span style="margin: 0 15px; font-weight:bold;">
        P&aacute;gina @(ViewBag.Page) de @(ViewBag.TotalPages)
    </span>

        @if (ViewBag.Page < ViewBag.TotalPages)
        {
            <a href="#" class="btn btn-default page-link" data-page="@(ViewBag.Page + 1)">
                Siguiente
            </a>
        }

    </div>


}
else
{
    <div>
        No hay datos para mostrar.
    </div>
}

@if (items != null && items.Any())
{

    var itemsTotales = (IList<LogValidacionAccesoStopBandasHorariasDto>)ViewBag.ItemsTotales;

    var agrupado = itemsTotales
    .GroupBy(x => new { x.Mensaje, x.Semaforo })
    .Select(g => new
    {
        Mensaje = g.Key.Mensaje,
        Semaforo = g.Key.Semaforo,
        Cantidad = g.Count()
    })
    .ToList();


    <div style="width: 100%; margin-top: 20px;">
        <canvas id="barChart"></canvas>
    </div>

    <script type="text/javascript">
        var labels = [
            @Html.Raw(string.Join(",", agrupado.Select(x => "'" + x.Mensaje + "'")))
        ];

        var data = [
            @string.Join(",", agrupado.Select(x => x.Cantidad))
        ];


        var backgroundColors = [
            @Html.Raw(string.Join(",", agrupado.Select(x =>
            (x.Semaforo ?? "").ToUpper() == "VERDE" ? "'#4caf50'" :
            (x.Semaforo ?? "").ToUpper() == "AMARILLO" ? "'#ffeb3b'" :
            (x.Semaforo ?? "").ToUpper() == "ROJO" ? "'#f44336'" :
            (x.Semaforo ?? "").ToUpper() == "BLANCO" ? "'#ffffff'" :
            "'#ffffff'"
            )))
        ];

        var ctx = document.getElementById('barChart').getContext('2d');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: backgroundColors,
                    borderColor: '#333',
                    borderWidth: 1,
                    barThickness: 60,
                    maxBarThickness: 60
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

    </script>
}