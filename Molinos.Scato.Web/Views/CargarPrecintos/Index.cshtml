@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    ViewBag.Title = Textos.Precinto_Titulo;
}


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/precinto.CargarPrecintos.js")"></script>

<div class="row">
    <div class="span4">
            @(((TipoDocumentoIngreso)ViewBag.TipoDocumentoIngreso).DisplayEnum()): @ViewBag.NumeroDocumentoIngreso
            <input type="hidden" value="@ViewBag.TipoDocumentoIngreso" id="tipoDoc" name="tipoDoc"/>
            <input type="hidden" value="@ViewBag.NumeroDocumentoIngreso" id="numDoc" name="numDoc"/>
    </div>
    <div class="span4">
            @Textos.Precinto_Patente: @ViewBag.Patente
            <input type="hidden" value="@ViewBag.Patente" id="patente" name="patente"/>
    </div>
</div>

<br/>
<br/>

<form id="precintos" data-bind="submit: addPrecinto">
    @Textos.Precinto_CodigoPrecinto: <input data-bind="value: newPrecintoTexto" name="numeroPrecinto" class="numeroPrecintoInvalido" id="numeroPrecinto" data-error-precinto-invalido = "@string.Format(Textos.Error_Requerido, Textos.Precinto_CodigoPrecinto)" maxlength="12" />
    @Textos.Precinto_Detalle: <input data-bind="value: newPrecintoDetalle" id="detallePrecinto" maxlength="20"/>
    <button class="btn btn-primary agregar" type="submit">@Textos.Agregar</button>
    <div class="control-group">@Html.ValidationMessage("numeroPrecinto", new {@class = "validaPrecinto help-block"})</div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Textos.Precinto</th><th>@Textos.Precinto_Detalle</th><th>@Textos.Eliminar</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: precintos">
        <tr>
            <td data-bind="text: NumeroPrecinto"/>
            <td data-bind="text: Detalle" />
            <td><a href="#" data-bind="click: $root.removePrecinto"><i class="icon-trash"></i></a></td>
        </tr>    
    </tbody>
</table> 

@using (Html.BeginForm("CargarPrecintos", "CargarPrecintos", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActCargarPrecintos }))
{
    <input type="hidden" name="precintos" data-bind="value: ko.toJSON(precintos)" />
    <input type="hidden" name="workflow" value="@ViewBag.Workflow"/>
    <input type="hidden" name="guid" id="guid" value="@ViewBag.Guid"/>
    <input type="hidden" name="workflowDefinicionId" value="@ViewBag.WorkflowDefinicionId"/>
    <button type="submit" class="btn btn-primary">@Textos.Aceptar</button>
    @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn btn-primary" })
}

<div class="hidden">
    <p id="error">@Textos.Precinto_NumeroPrecintoExistente</p>
</div>