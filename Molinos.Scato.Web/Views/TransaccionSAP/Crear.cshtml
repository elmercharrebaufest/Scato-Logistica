@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.TransaccionSAPDto

@{
    Layout = null;
    ViewBag.Title = Textos.TransaccionSAP_Crear;
    var centros = (IEnumerable<SelectListItem>) ViewBag.Centros;
    var centrosDestino = (IEnumerable<SelectListItem>)ViewBag.CentrosDestino;
    centrosDestino.ToList().Insert(0, new SelectListItem { Value = null, Text = null });
    
}
@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/transaccionASap.js")"></script>
<div id ="links" 
     data-url-buscar-material ="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales = "@Url.Action("BuscarMateriales", "Consultas")"
    ></div>
@using (Ajax.BeginForm("Crear", null, new AjaxOptions(), new { @class = "form-horizontal", id = "orden-form", data_dialogo_titulo = Textos.TransaccionSAP_Crear }))
{
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
     {
         <div class="alert alert-error">
             @Html.ValidationSummary(true)
         </div>
     }
    <div class="control-group">
        @Html.LabelFor(m => m.DescripcionCorta, new {@class = "control-label"})
        <div class="controls">
            @Html.TextBoxFor(m => m.DescripcionCorta, new {@class = "control input-small"})
            @Html.ValidationMessageFor(m => m.DescripcionCorta)
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.TipoComercialId, new {@class = "control-label"})
        <div class="controls">
            @Html.DropDownListFor(t => t.TipoComercialId, (IEnumerable<SelectListItem>) ViewBag.TiposComerciales, new {id = "tipoComercial"})
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.CentroOrigenId, new {@class = "control-label"})
        <div class="controls">
            @Html.DropDownListFor(t => t.CentroOrigenId, centros, new {id = "centroOrigen"})
            @Html.ValidationMessageFor(t => t.CentroOrigenId)
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.MaterialDesc, new {@class = "control-label"})
        <div class="controls">
           @Html.TextBoxFor(model => model.MaterialDesc, new {@class = "control input-large"})
           @Html.ValidationMessageFor(m => m.MaterialDesc)
           @Html.HiddenFor(model => model.MaterialId)
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.FuncionSAP, new {@class = "control-label"})
        <div class="controls">
            @Html.EnumDropDownListFor(t => t.FuncionSAP)
        </div>
    </div>
}
