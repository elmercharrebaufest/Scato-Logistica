@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<TipoComercialDto>) ViewBag.Items;
}

    @Html.Grilla(items,
        grilla => grilla.Columns(
        grilla.ColumnaEliminarModificar(Html, "TipoComercial"),
        grilla.Columna("CodigoSap", Textos.TipoComercial_CodigoSap),
        grilla.Columna("Descripcion", Textos.Descripcion),
        grilla.Columna("Sentido", Textos.TipoComercial_Sentido),
        grilla.Columna("PesoEsperado", Textos.TipoComercial_PesoEsperado),
        grilla.Columna("ToleranciaDifPesoE", Textos.TipoComercial_ToleranciaDifPeso),
        grilla.Columna("UsaBinPallet", Textos.Material_BinPallet, m => ((bool)m.UsaBinPallet).Formatted()),
        grilla.Columna("ValidaPatente", Textos.TipoComercial_ValidaPatente, m => ((bool)m.ValidaPatente).Formatted()))
        )
