@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ExistePedidoDeTrasladoDto
@{
    ViewBag.Title = Textos.ExistePedidoDeTraslado_Titulo;
}
<script type="text/javascript" src="@Url.Script("~/scripts/autorizarTransportistaInhabilitado.js")"></script>

<div class ="container">
    <div class="titSecciones">@Textos.ExistePedidoDeTraslado_Error</div>
</div>
<style>
    .field-validation-error {
        color: #ff0000;
    }
</style>

@* ReSharper disable Mvc.ActionNotResolved *@
@using (Html.BeginForm("Action", "ExistePedidoDeTraslado", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActExistePedidoDeTraslado }))
{
@* ReSharper restore Mvc.ActionNotResolved *@
        <div>
            <h4>@Textos.ExistePedidoDeTraslado_Titulo</h4>
        </div>
    <div class="modal-body">
        @Html.HiddenFor(model => model.WorkflowCodigo)
        @Html.HiddenFor(model => model.WorkflowId)
        @Html.Hidden("workflowDefinicionId", (int)ViewBag.WorkflowDefinicionId)
        @Html.ValidationMessageFor(model => model.WorkflowId)
    </div>
        <div class="modal-footer">
            <button id="dialogo-reintentar" class="confirmar-boton btn " data-accion="Reintentar" data-mensaje="@string.Format(Textos.ConfirmacionGenerica,Textos.Reintentar,Textos.Pedido)">@Textos.Reintentar</button>
            <button id="dialogo-rechazar" class="confirmar-boton btn " data-accion="Rechazar" data-mensaje="@string.Format(Textos.ConfirmacionGenerica,Textos.Rechazar,Textos.Pedido)">@Textos.Rechazar</button>
            <button id="dialogo-cancelar" class="btn btn-warning" type="submit" value="Cancelar" name="submitAction">@Textos.Cancelar</button>
        </div>
        


    <div class="modal hide fade" id="dialogo-confirmar">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4>@Textos.Confirmacion</h4>
        </div>
        <div class="modal-body" id="dialogo-confirmar-body">
        </div>
        <div class="modal-footer">
            <button id="dialogo-confirmar-confirmar" type="submit" class="btn " name="submitAction" value="">@Textos.Aceptar</button>
            <button id="dialogo-confirmar-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
        </div>
    </div>
}