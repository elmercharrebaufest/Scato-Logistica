@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Seguridad
@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Web.Seguridad
@model Molinos.Scato.Dominio.Dto.LoteDto

@{  
    ViewBag.Title = Textos.Lote_EnviarACamara + " - " + Textos.Lote_Titulo;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
    <script src="@Url.Script("~/Scripts/lote.index.js")" type="text/javascript"></script>
}
<div class ="container-fluid">
    <ul class="nav nav-tabs">
        @if (PermisosHelper.Is(PermisosScato.ArmarLote))
        {
            <li class="active">
                @Html.ActionLink(Textos.Lote_Titulo, "Index", "Lote")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.BuscarLote))
        {
            <li>
                @Html.ActionLink(Textos.BuscarLote_Titulo, "BuscarLote", "Lote")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.TablaConversionMaterial))
        {
            <li>
                @Html.ActionLink(Textos.TablaConversion, "Index", "ConversionMaterial")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.ArmarLoteBiotecnologia))
        {
            <li>
                @Html.ActionLink(Textos.ArmarLoteBiotecnologia, "Index", "LoteBiotecnologia")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.ArmarLoteBiotecnologia))
        {
            <li>
                @Html.ActionLink(Textos.BuscarLoteBiotecnologia, "BuscarLote", "LoteBiotecnologia")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.ArmarLoteAuditoria))
        {
            <li>
                @Html.ActionLink(Textos.BuscarLoteAuditoria, "BuscarLote", "LoteAuditoria")
            </li>
        }
    </ul>
    
    <div class ="container-fluid">
    <div class="titSecciones">@Textos.Lote_LoteACrear</div>
</div>

    <div class="container-fluid content grillaPad"> 
        @using (Html.BeginForm("ArmarLote", "Lote", null, FormMethod.Post ,new { @class = "form-horizontal form-search", id = "lote-form", onsubmit = "AceptarFormulario()", data_mensaje_espera = Textos.Lote_Armar }))
        {
            if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
            {
                <div class="alert alert-error">
                    @Html.ValidationSummary(true)
                </div>
            }
            @Html.Hidden("ObtenerMuestra", Url.Action("ObtenerMuestra"))
            @Html.HiddenFor(m => m.Muestras, new { data_bind = "value: ko.toJSON(muestrasLista)" })
            @Html.Hidden("ErrorNoHayMuestras", Textos.Lote_NoHayMuestras)
            @Html.Hidden("soloImprimir")
            <div class="row">
                <div class="span4">
                    <div class="control-group">
                        @Html.LabelFor(model => model.NumeroDeLote, new { @class = "control-label"})
                        <div class="controls">
                            @Html.TextBoxFor(model => model.NumeroDeLote, new { @class = "control", @readonly ="readonly"})
                            @Html.ValidationMessageFor(model => model.NumeroDeLote)
                        </div>
                    </div>
                    <div class="control-group">
                        @Html.LabelFor(model => model.CamaraDesc, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DropDownListFor(model => model.CamaraId, (IEnumerable<SelectListItem>) ViewBag.Camaras, new {@class = "control"})
                            @Html.Hidden("CamaraIdAnterior", "0")
                            @Html.ValidationMessageFor(model => model.CamaraId)
                        </div>
                    </div>
                </div>
                <div class="span2"></div>
                <div class="span4">
                                       
                    <div class="control-group">
                        <label class="checkbox">
                            @Html.CheckBoxFor(m => m.EnviarArchivoAutomaticamente)
                            <span>&nbsp;@Textos.Lote_EnviarArchivoAutomaticamente</span>
                        </label>
                    </div>  
                </div>
            </div>      
            <br />
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>@Textos.Material</th>
                        <th>@Textos.Lote_Vendedor</th>
                        <th>@Textos.CartaPorte_Corredor</th>
                        <th>@Textos.Lote_FechaDescarga</th>
                        <th>@Textos.Lote_NetoPlanta</th>
                        <th>@Textos.Centro_Localidad</th>
                        <th>@Textos.Camion_Patente</th>
                        <th>@Textos.Lote_NumeroMuestra</th>
                        <th>@Textos.Lote_NroMuestraTerceros</th>
                        <th>@Textos.Eliminar</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: muestrasLista">
                    <tr class="muestraRow">
                        <td data-bind="text: Material"/>
                        <td data-bind="text: Vendedor"/>
                        <td data-bind="text: Corredor"/>
                        <td data-bind="text: FechaDescargaFormateada" />
                        <td data-bind="text: PesoNeto" />
                        <td data-bind="text: Localidad" />                        
                        <td data-bind="text: Patente" />
                        <td data-bind="text: NroMuestra" />
                        <td data-bind="text: NroMuestraTerceros" />
                        <td><a href="#" data-bind="click: $root.removeMuestra" ><i class="icon-trash"></i></a></td>
                    </tr>    
                </tbody>
            </table>  
            <div class="row">
                <div class="span12">
                    <div class="pull-left">
                        <div id="agregarMuestraDiv">
                            @Html.Label(Textos.Lote_NumeroMuestra + ":")
                            @Html.TextBox("numeroDeMuestra", null, new { @class = "control habilitado validarHayMuestras ingresoMuestra",  autocomplete = "off", maxlength = 15 })
                            @Html.Label("  ")
                            @Html.Label(Textos.Lote_NroMuestraTerceros+ ":")
                            @Html.TextBox("numeroMuestraTerceros", null, new { @class = "control habilitado ingresoMuestra",  autocomplete = "off", maxlength = 15 })
                            <input id="agregarMuestra"   class="btn btn-warning habilitado" type="button" data-bind="click: addMuestra" data-muestra-url ="@Url.Action("ObtenerMuestra")" value="@Textos.Lote_Agregar"/>
                            <br/>
                            @Html.ValidationMessage("numeroDeMuestra", new {id="validarMuestras", @class="hide"})
                        </div>
                    </div>
                </div>
            </div>
            <br/>
            <br/>
            <div class="row right">
                <button class="btn btn-primary habilitado" type="submit" id="btnArmarLote" onclick="javascript:Imprimir(false);">@Textos.Lote_Armar</button>
                @Html.ActionLink(Textos.Lote_ListadoPendientes, "ListarPendientes", "Lote", null, new { @class = "btn btn-primary" })
                <button class="btn btn-primary habilitado" type="submit" id="btnListadoDetalle" onclick="javascript:Imprimir(true);">@Textos.Lote_ListadoDetalle</button>
            </div>
        }
    </div>
</div>

@Html.Hidden("errorExistente",Textos.Lote_MuestraExistente)
@Html.Hidden("errorInexistente",Textos.Lote_MuestraInexistente)
@Html.Hidden("errorInvalida",Textos.Lote_MuestraInvalida)
@Html.Hidden("errorCamara",Textos.Lote_ErrorCamara)
@Html.Hidden("errorCamionEnPlanta",Textos.Lote_CamionEnPlanta)
@Html.Hidden("errorCamionRechazado",Textos.Lote_CamionRechazado)
<div class="modal hide fade" id="dialogo-confirmar">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4>@Textos.Confirmacion</h4>
    </div>
    <div class="modal-body">
        <h4>@Textos.Lote_ConfirmarCambiarCamara</h4>
    </div>
    <div class="modal-footer">
        <input id="dialogo-confirmar-confirmar" type="button" class="btn btn-warning" value="@Textos.Lote_CambiarCamara"/>
        <input id="dialogo-confirmar-cancelar" type="button" class="btn" value="@Textos.Cancelar"/>
    </div>
</div>