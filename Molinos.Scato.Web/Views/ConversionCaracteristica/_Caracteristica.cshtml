@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.ConversionCaracteristicaDto
@{
    Layout = null;
    var caracteristicas = (IEnumerable<SelectListItem>)ViewBag.Caracteristicas;
    var camaras = (IEnumerable<SelectListItem>)ViewBag.Camaras;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
}

@Html.ValidationSummary(true)
@Html.Hidden("ConsultarConversionPorCamara", Url.Action("Indexa"))
