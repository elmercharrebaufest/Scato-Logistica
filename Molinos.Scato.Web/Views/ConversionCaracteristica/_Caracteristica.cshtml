<div class="control-group">
    @Html.LabelFor(m => m.MaterialDesc, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.MaterialId, materiales, Textos.Default_Material, new { id = "materialesDropDown" })
        @Html.ValidationMessageFor(m => m.MaterialId)
        @Html.Hidden("SetearMaterialesPorCamara", Url.Action("SetearMaterialesPorCamara"))
        @Html.Hidden("valorDefault",Textos.Default_Material, new {id = "valorDefault"})
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.CaracteristicaDesc, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.CaracteristicaId, caracteristicas, Textos.Default_Caracteristica, new { id = "caracteristicasDropDown" })
        @Html.ValidationMessageFor(m => m.CaracteristicaId)
        @Html.Hidden("SetearCaracteristicasPorMaterial", Url.Action("SetearCaracteristicasPorMaterial"))
        @Html.Hidden("valorDefaultCaracteristica",Textos.Default_Caracteristica, new {id = "valorDefaultCaracteristica"})
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.CodigoCamara, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoCamara, new {@class = "control input-large"})
        @Html.ValidationMessageFor(m => m.CodigoCamara)
    </div>
</div>

<div class="botones-carta-porte centered">
    <button class="btn btn-primary" type="submit">@Textos.Agregar</button>
</div>
