@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ConsultaCasilleroMuestraDto
@{
    
}
@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script src="@Url.Script("~/Scripts/accordion.icon.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script type="text/javascript" src="@Url.Script("~/Scripts/consultaCasillero.Muestra.index.js")"></script>

<div class="container-fluid">
    <div class="titSecciones">@Textos.ConsultaCasillero</div>
</div>

<ul class="nav nav-tabs">
    <li>
        @Html.ActionLink(Textos.ConsultaCasillero_Antiguedad, "Antiguedad", "ConsultaCasillero")
    </li>
    <li>
        @Html.ActionLink(Textos.ConsultaCasillero_Casilleros, "Casillero", "ConsultaCasillero")
    </li>
    <li class="active">
        @Html.ActionLink(Textos.ConsultaCasillero_Muestras, "Muestra", "ConsultaCasillero")
    </li>
</ul>

<div id ="links" 
     data-url-buscar-centros = "@Url.Action("BuscarCentros", "Consultas")"
     data-url-buscar-centro-unico = "@Url.Action("BuscarCentroUnico", "Consultas")">
</div>

<div class="container-fluid content grillaPad">
    @using (Ajax.BeginForm("ListarMuestra", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "consultaCasilleroMuestra-form", @class = "form-search ", data_mensaje_espera = Textos.ConsultaCasilleroPorMuestra }))
    {
        @Html.ValidationSummary(true)
        <div class="accordion row-fluid">
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseOne">
                        <i class="icon-chevron-down"></i>
                        @Textos.Busqueda
                    </a>
                </div>
                <div id="collapseOne" class="accordion-body in collapse">
                    <div class="accordion-inner">
                        <div class="span4">
                            <div class="control-group">
                                @Html.LabelFor(model => model.Centro, new { @class = "control-label" })
                                <div class="controls">
                                    @Html.TextBoxFor(model => model.Centro, new { @class = "control input-large" })
                                    @Html.ValidationMessageFor(model => model.Centro)
                                    @Html.HiddenFor(model => model.CentroId)
                                </div>
                            </div>
                            <div class="control-group">
                                @Html.LabelFor(model => model.TipoDocumento, new { @class = "control-label" })
                                <div class="controls">
                                    @Html.EnumDropDownListFor(model => model.TipoDocumento, Textos.Default_Documento)
                                    @Html.ValidationMessageFor(model => model.TipoDocumento)
                                </div>
                            </div>
                        </div>
                        <div class="span4">
                            <div class="control-group">
                                @Html.LabelFor(model => model.NumeroDocumento, new { @class = "control-label" })
                                <div class="controls">
                                    @Html.TextBoxFor(model => model.NumeroDocumento, new { @class = "input-medium" })
                                    @Html.ValidationMessageFor(model => model.NumeroDocumento)
                                </div>
                            </div>
                            <div class="control-group">
                                @Html.LabelFor(model => model.Patente, new { @class = "control-label" })
                                <div class="controls">
                                    @Html.TextBoxFor(model => model.Patente, new { @class = "input-medium" })
                                    @Html.ValidationMessageFor(model => model.Patente)
                                </div>
                            </div>
                        </div>
                        <div class="span4"  style="margin-top:97px; margin-left:-30px">
                            <div class="control-group">
                                <div class="controls">
                                    <button id="btnBuscar" type="submit" class="btn btn-primary">@Textos.Buscar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

        <div id="gridContainer" style="clear:both;" data-grid-url="@Url.Action("Muestra", "ConsultaCasillero")">
        @Html.Partial("ListarMuestra")
    </div>
</div>
