@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ConsultaCasilleroDto
@{
    
}
@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/consultaCasillero.Casillero.index.js")"></script>

<div class="container-fluid">
    <div class="titSecciones">@Textos.ConsultaCasillero</div>
</div>

<ul class="nav nav-tabs">
    <li>
        @Html.ActionLink(Textos.ConsultaCasillero_Antiguedad, "Antiguedad", "ConsultaCasillero")
    </li>
    <li class="active">
        @Html.ActionLink(Textos.ConsultaCasillero_Casilleros, "Casillero", "ConsultaCasillero")
    </li>
    <li>
        @Html.ActionLink(Textos.ConsultaCasillero_Muestras, "Muestra", "ConsultaCasillero")
    </li>
</ul>

<div class="container-fluid content grillaPad">
    @using (Ajax.BeginForm("ListarCasillero", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "consultaCasilleros-form", @class = "form-search", data_mensaje_espera = Textos.ConsultaCasilleroPorCasillero }))
    {
        <div class="span3">
            @Html.Label(Textos.ConsultaCasillero_NDeCasillero + ":", new { @class = "control-label" })
        </div>
        <div class="span3" style="margin-left:-40px">
            <div class="control-group">
              @Html.LabelFor(model => model.Desde, new {@class = "control-label"})
                <div class="controls">
                    @Html.TextBoxFor(model => model.Desde, new { @class = "input-medium" })
                </div>
            </div>
        </div>
        <div class="span3">
            <div class="control-group">
              @Html.LabelFor(model => model.Hasta, new {@class = "control-label"})
                <div class="controls">
                    @Html.TextBoxFor(model => model.Hasta, new { @class = "input-medium" })
                </div>
            </div>
        </div>
        <div class="span1" style="margin-top:23px">
            <div class="control-group">
                <div class="controls">
                    <button id="btnBuscarCasillero" type="submit" class="btn btn-primary">@Textos.Buscar</button>
                </div>
            </div>
        </div>
    }

    <div id="gridContainer" style="clear:both;" data-grid-url="@Url.Action("Casillero", "ConsultaCasillero")">
        @Html.Partial("ListarCasillero")
    </div>

    <div class="span12 centered">
        <div class="control-group">
            <div class="controls">
                <button id="btnImprimir" type="submit" class="btn btn-primary">@Textos.Imprimir</button>
            </div>
        </div>
    </div>
</div>
