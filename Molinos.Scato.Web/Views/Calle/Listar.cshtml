@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<CalleDto>) ViewBag.Items;
}

    @Html.Grilla(items,
        grilla => grilla.Columns(
        grilla.ColumnaEliminarModificar(Html, "Calle"),
        grilla.Columna("Codigo", Textos.Codigo),
        grilla.Columna("Nombre", Textos.Descripcion),
        grilla.Columna("TipoCalle", "Tipo Calle"),
        grilla.Columna("Material.Descripcion", Textos.Material, c => c.MaterialDesc),
        grilla.Columna("TipoCalidad", "Calidad"),
        grilla.Columna("CaracteristicaDeCalidadDesc", Textos.CaracteristicaDeCalidad),
        grilla.Columna("RangoCaracteristicaCalidadMinimo", Textos.RangoMinimo),
        grilla.Columna("RangoCaracteristicaCalidadMaximo", Textos.RangoMaximo),


        grilla.Columna("CantidadDeCamiones", "Cant. Camiones")
        ))
