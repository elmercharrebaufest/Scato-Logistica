@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@model Molinos.Scato.Dominio.Dto.CalleDto
@{
    Layout = null;
    ViewBag.Title = Textos.Calle_Modificar;
}
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script type="text/javascript" src="@Url.Script("~/Scripts/calle.js")"></script>
@Scripts.Render("~/bundles/jqueryval")

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Calle_Modificar }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)
}