@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.EmbarqueLiquidosDto
    @{
        Layout = null;
        ViewBag.Title = Textos.OperacionesPuerto_Titulo;
    }

    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="~/scripts/bootstrap-datetimepicker.js"></script>
    <link rel="stylesheet" href="~/Content/bootstrap-datetimepicker.css" />
    @using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.BalanzaPuerto_Modificar }))
    {
        @Html.Partial("_CrearModificar")
    }