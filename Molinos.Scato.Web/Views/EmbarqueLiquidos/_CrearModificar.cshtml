@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.EmbarqueLiquidosDto
@{
    /**/

    var BalanzasAdministrativas = (IEnumerable<SelectListItem>)ViewBag.BalanzasAdministrativas;
}

<div class="control-group">
    @Html.LabelFor(m => m.NumeroBalanza, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.NumeroBalanza, BalanzasAdministrativas)
        @Html.ValidationMessageFor(m => m.NumeroBalanza)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.Vapor, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Vapor, new { @class = "control input-large" })
        @Html.ValidationMessageFor(model => model.Vapor)
        @Html.HiddenFor(model => model.VaporId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.Bodega, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Bodega, new { @class = "control input-large" })
        @Html.ValidationMessageFor(model => model.Bodega)
        @Html.HiddenFor(model => model.BodegaId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.Exportador, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Exportador, new { @class = "control input-large" })
        @Html.ValidationMessageFor(model => model.Exportador)
        @Html.HiddenFor(model => model.ExportadorId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.Destino, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Destino, new { @class = "control input-large" })
        @Html.ValidationMessageFor(model => model.Destino)
        @Html.HiddenFor(model => model.DestinoId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.Material, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Material, new { @class = "control input-large" })
        @Html.ValidationMessageFor(model => model.Material)
        @Html.HiddenFor(model => model.MaterialId)
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(m => m.Peso, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(m => m.Peso, new { @class = "control input-large" })
        @Html.ValidationMessageFor(m => m.Peso)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Fecha, new { @class = "control-label" })
    <div class="controls">
        <input type="datetime" id="Fecha" name="Fecha" class="control input-large" data-val="true" value="@string.Format("{0:dd/MM/yyyy HH:mm}", Model.Fecha)">
        @Html.ValidationMessageFor(model => model.Fecha)
    </div>
</div>
@Html.ValidationMessage("EnvioASAPFallido")
@Html.ValidationMessage("NoExisteCarga")
