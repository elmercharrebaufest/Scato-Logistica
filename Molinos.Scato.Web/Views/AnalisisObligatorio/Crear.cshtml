@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.AnalisisObligatorioDto
@{
    Layout = null;
    ViewBag.Title = Textos.Crear;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="~/Scripts/autocompletar.js"></script>
<script src="@Url.Script("~/Scripts/analisisObligatorio.CrearModificar.js")"></script>
<div id="links"
     data-url-buscar-material="@Url.Action("BuscarMaterial", "ListadoDeCalidades")"
     data-url-buscar-materiales="@Url.Action("BuscarMateriales", "ListadoDeCalidades")"
</div>

@using (Ajax.BeginForm("Crear", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Crear }))
{
    @Html.Hidden("Id", 0, new { id = "Id" })
    @Html.Partial("_CrearModificar", Model)
}