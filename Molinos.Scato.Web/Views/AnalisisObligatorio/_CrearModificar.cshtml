@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.AnalisisObligatorioDto

<style>

    div.modal {
        width: 600px
    }
    /*div.modal .control-group {display: inline-block !important}*/
    .form-horizontal .control-label {
        padding-top: 0
    }
</style>

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@Html.Hidden("puestosDeTrabajo", "", new { id = "puestosFinales" })
@Html.HiddenFor(model => model.UltimoAnalisis)

@if (Model != null && Model.Id != 0)
{
    @Html.HiddenFor(m => m.CentroId)
}

<div class="control-group">
    @Html.LabelFor(m => m.MaterialId, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(m => m.MaterialDescripcion, new { @class = "input-large" })
        @Html.HiddenFor(model => model.MaterialId)
        @Html.ValidationMessageFor(m => m.MaterialId)
        @Html.ValidationMessageFor(m => m.MaterialDescripcion)

    </div>
</div>

<div class="control-group">
    @Html.LabelFor(m => m.IntervaloDeAnalisis, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(m => m.IntervaloDeAnalisis, new { @class = "input-large" })
        @Html.ValidationMessageFor(m => m.IntervaloDeAnalisis)
    </div>
</div>

<div id="roles">
    <div class="control-group">
        @Html.Label(Textos.PuestoDeTrabajo, new { @class = "control-label" })
        <div class="controls">
            @Html.DropDownList("Puestos", (IEnumerable<SelectListItem>)ViewBag.PuestosDeTrabajo, new { id = "puesto", @class = "control input-large" })
            @Html.ValidationMessageFor(m => m.PuestosDeTrabajoAsociados)
            <button class="btn btn-primary agregar" type="button" data-bind="click: addPuesto">@Textos.Agregar</button>
        </div>
    </div>
</div>

<div class="control-group">
    @Html.Label(Textos.AnalisisObligatorio_AlertarIntervalo, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(m => m.AlertarAnalisisIntervalo, new { @class = "input-large" })
        @Html.ValidationMessageFor(m => m.AlertarAnalisisIntervalo)
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Textos.Descripcion</th>
            <th>@Textos.Eliminar</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: puestos">
        <tr>
            <td data-bind="text: NombrePuesto" />
            <td><a href="#" data-bind="click: $root.removePuesto"><i class="icon-trash"></i></a></td>
        </tr>
    </tbody>
</table>