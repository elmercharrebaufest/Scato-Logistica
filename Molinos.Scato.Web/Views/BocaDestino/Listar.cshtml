@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<BocaDestinoDto>)ViewBag.Items;
}

<div class="controls">
    @Html.Grilla(items,
        grilla => grilla.Columns(
        grilla.ColumnaEliminarModificar(Html, "BocaDestino"),
        grilla.Columna("Proveedor.Descripcion", Textos.BocaDestino_Entregador, c => c.Proveedor),
        grilla.Columna("NombreBocaDeDestino", Textos.BocaDestino_Nombre),
        grilla.Columna("Domicilio", Textos.Transportista_Domicilio),
        grilla.Columna("CodigoPostal", Textos.BocaDestino_CodigoPostal),
        grilla.Columna("Localidad.Descripcion", Textos.Transportista_Localidad, c => c.Localidad),
        grilla.Columna("Provincia.Descripcion", Textos.Transportista_Provincia, c => c.Provincia),
        grilla.Columna("CodigoONCCA", Textos.Material_CodigoONCCA)
        ))
</div>
