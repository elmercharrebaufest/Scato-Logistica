@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ReciboMunicipalDto

@{
    ViewBag.Title = Textos.ReciboMunicipal_Titulo;
    string esNuevo = ViewBag.Nuevo;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Script("~/Scripts/reciboMunicipal.js")" type="text/javascript"></script>
}

<style>
    .field-validation-error {
        color: #ff0000;
    }
</style>

<div class ="container">
    <div class="titSecciones">@Textos.ReciboMunicipal_Titulo</div>
</div>
<br/>

@using (Html.BeginForm("Index", "ReciboMunicipal", FormMethod.Post, new { @class = "form-horizontal", id = "orden-form", data_dialogo_titulo = Textos.ReciboMunicipal_Titulo }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.CentroId)
    @Html.Hidden("esNuevo", esNuevo, new {id = "esNuevo"})
    
    <div class="control-group">
        @Html.LabelFor(model => model.Monto, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.Monto, new { @class = "control input-medium numero"})
            @Html.ValidationMessageFor(model => model.Monto)
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(model => model.Ordenanza, new {@class = "control-label"})
        <div class="controls">
            @Html.TextBoxFor(model => model.Ordenanza, new {@class = "control input-large"})
            @Html.ValidationMessageFor(model => model.Ordenanza)
        </div>
    </div>

    <div class="control-group paddingRight cajaButtons">
        <button class="btn btn-primary" type="submit" id="btnAceptar">@Textos.Aceptar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones",null, new {@class="btn"})
    </div>
}