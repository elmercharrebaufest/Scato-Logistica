@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ValoresPagarConMercadoPagoDto
@{
    var puestoDeTrabajo = (int)ViewBag.PuestoDeTrabajoId;
    var puestoDeTrabajoEf = (int)ViewBag.PuestoDeTrabajoIdEf;
    var garita = (string)ViewBag.Garita;
    ViewBag.Title = @Textos.CobroImpuestoMunicipal_Titulo;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Script("~/Scripts/pagoDeReciboMunicipal.js")" type="text/javascript"></script>
}

<div id="links"
     data-url-pago="@Url.Action("PagarConMercadoPago", "PagoDeReciboMunicipal")"
     data-url-datos="@Url.Action("ObtenerDatos", "PagoDeReciboMunicipal")"
     data-url-pagoconfectivo="@Url.Action("PagarConEfectivo", "PagoDeReciboMunicipal")"></div>



<style>
    .loader {
        border: 5px solid #f3f3f3; /* Light grey */
        border-top: 5px solid green; /* Blue */
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 2s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .contenedor-barrera {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin-left: auto;
    }

    .bar-ico {
        font-size: 80px;
        margin: 20px;
    }

    .apertura {
        color: #07c35f !important;
    }

    .cierre {
        color: #ea1f1f !important;
    }

    .botones-barrera {
        margin: 20px;
    }

    #pagoManual.modal {
        position: fixed;
        top: 50%;
        left: 50%;
        width: 450px;
        transform: translate(-50%, -50%);
        margin: 0; /* Elimina márgenes conflictivos */
    }
</style>

@Html.Hidden("puestoDeTrabajo", puestoDeTrabajo)
@Html.Hidden("puestoDeTrabajoEf", puestoDeTrabajoEf)
@Html.Hidden("garita", garita)
@Html.Hidden("centroId", (int)ViewBag.CentroId)
@Html.Hidden("montoCobrado", null, new { @id = "montoCobrado", @class = " input-medium uppercase", @readonly = "readonly" })
@Html.Hidden("RecorridoId", null, new { @id = "RecorridoId", @class = " input-medium uppercase", @readonly = "readonly" })
@Html.Hidden("medioDePago", null, new { @id = "medioDePago", @class = " input-medium uppercase", @readonly = "readonly" })

<span class="label label-success hidden" id="labelConectado">@Textos.Conectado</span>
<span class="label label-important hidden" id="labelDesconectado">@Textos.Desconectado</span>

<div class="row-fluid" style="margin:0px">
    <div class="row-fluid">
        @*se muestran errores de patentes*@
        <div class="span12 alert alert-info hide" id="validation-patente-danger">
            @*<button type="button" class="close" id="validation-danger-close">×</button>*@
            <div id="validation-danger">

            </div>
        </div>
    </div>
    <div class="row-fluid">
        @*se muestran errores de tarjetas*@
        <div class="span12 alert alert-error hide" id="validation-patente-alert">
            @*<button type="button" class="close" id="validation-patente-close">×</button>*@
            <div id="validation-patente">
            </div>
        </div>
    </div>
</div>

<div class="container centered" style="padding:3%;">
    <div class="titSecciones">@Textos.CobroImpuestoMunicipal_Titulo</div>
</div>

<div class=" container text-center center content form-horizontal">
    <div class="control-group  sinMargen">
        <div class="controls menosAncho" style="max-width: 400px; margin-left: 32%;">
            @Html.Label("N° Tarjeta:", new { @class = " control-label menosAncho" })
            @Html.TextBox("numTarjeta", "esperando...", new { @id = "numTarjeta", @class = "col-sm-10 control input-medium lowercase", @readonly = "readonly", data_toggle = "tooltip", @style = " cursor: pointer; " })
        </div>
    </div>
    <div class="control-group sinMargen">

        <div class="controls menosAncho" style="max-width: 400px; margin-left: 32%;">
            @Html.Label("Patente:", new { @class = "control-label menosAncho" })
            @Html.TextBox("patente", "esperando...", new { @id = "patente", @class = "control input-medium lowercase", @readonly = "readonly", data_toggle = "tooltip", @style = " cursor: pointer; " })
        </div>
    </div>
    <div class="control-group sinMargen">

        <div class="controls menosAncho" style="max-width: 400px; margin-left: 32%;">
            @Html.Label("N° Carta de Porte:", new { @class = "control-label menosAncho" })
            @Html.TextBox("numCartaPorte", "esperando...", new { @id = "numCartaPorte", @class = "control input-medium lowercase", @readonly = "readonly", data_toggle = "tooltip", @style = " cursor: pointer; " })
        </div>
    </div>
    <div class="control-group sinMargen">

        <div class="controls menosAncho" style="max-width: 400px; margin-left: 32%;">
            @Html.Label("Transportista:", new { @class = "control-label menosAncho" })
            @Html.TextBox("transportista", "esperando...", new { @id = "transportista", @class = "control input-medium lowercase", @readonly = "readonly", data_toggle = "tooltip", @style = " cursor: pointer; " })
        </div>
    </div>

    @*<div class="contenedor-barrera">
            <span>Estado de barrera: </span>
            <span class="bar-ico icon-barrera-cerrada" id="barreraCargaCupo"></span>
            <div class="botones-barrera">
                <a class="btn tarjetaMaestro apertura btnBarrera" data-puesto-id="@ViewBag.PuestoDeTrabajoId" data-id="@ViewBag.CodigoBarrera"><i class="fa fa-unlock"> </i> </a>
                <a class="btn tarjetaMaestro cierre btnBarrera" data-puesto-id="@ViewBag.PuestoDeTrabajoId" data-id="@ViewBag.CodigoBarrera"><i class="fa fa-lock"> </i> </a>
            </div>
        </div>*@
    <div class="control-group sinMargen">
        <div class="controls menosAncho" style="max-width: 400px; margin-left: 32%;">
            <div id="alertaPago" class="alert alert-success alert-dismissible fade hide alerta-box-custom" style="--width: 40%; --height: auto; --tAlign: center; --fWeight: bold; --zIndex:10000; display: none; " role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        </div>
    </div>

    <div id="pagoManual" class="modal" style="display: none;"
         data-backdrop="static" data-keyboard="false">

        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                &times;
            </button>
            <h4>Tasa municipal adeudada</h4>
        </div>

        <div class="modal-body form-horizontal">
            <h5>¿Desea abonar de forma manual?</h5>
        </div>

        <div class="modal-footer">
            <button id="btnCancelarPagoMunicipal" class="btn btn-outline-primary small" onclick="cerrarModal()">No</button>
            <button id="btnAceptarPagoMunicipal" class="btn btn-primary focus small" onclick="avanzarDeEtapa()">Si</button>
        </div>
    </div>
