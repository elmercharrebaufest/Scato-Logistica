@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.OrdenDeDescargaDto
@{
    ViewBag.Title = Textos.OrdenDeDescarga_Titulo;
    var workflow = (string) ViewBag.Workflow;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/Scripts/ordenDeDescarga.index.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/validarCuil.js")"></script>
    <script src="@Url.Script("~/Scripts/validarFechas.js")" type="text/javascript"></script>
    <script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
    <script src="~/scripts/knockout.simpleGrid.1.3.js"  type="text/javascript"></script>
}
<style>
 .content { padding-top: 20px;}

</style>
<div class ="container-fluid">
    <div class="titSecciones">@Textos.Workflow_Nombre - @Textos.OrdenDeDescarga_Titulo</div>
</div>

@using (Html.BeginForm("Index", "CargarOrdenDeDescarga", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content container causaBlock", id = "orden-form", data_mensaje_espera = Textos.OrdenDeDescarga_MensajeDeEspera }))
{
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
     {
         <div class="alert alert-error">
             @Html.ValidationSummary(true)
         </div>
     }
    @Html.Partial("_Orden",Model)
}