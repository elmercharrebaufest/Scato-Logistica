@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos

@if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any()) 
    { 
        <script type="text/javascript">
            $(document).ready(function () {
                $('#FechaDesde').click(function () {
                    $('#errorMensaje').hide();
                });
                $('#FechaHasta').click(function () {
                    $('#errorMensaje').hide();
                });
            });
        </script>
    <div class="row-fluid">
        <div class="span12" style="line-height: 30px">
            <div class="alert alert-danger" id="errorMensaje">
                <div id="validation-danger">
                     @ViewData.ModelState[""].Errors.First().ErrorMessage
                </div>
            </div>
        </div>
    </div>

    }
@{
    Layout = null;
    var items = (IList<ControlDeBalanzaPesadaDto>) ViewBag.Items;
    var camiones = items != null && items.Any() ?  items.GroupBy(g => new {g.Patente,g.TipoDocumentoIngreso, g.NumeroDocumentoIngreso}) : null;
}
<br/>

@if (camiones != null)
{
    //ITERO POR CAMIÓN
    foreach (var camion in camiones)
    {
        var pesosBruto = new List<int?>();
        var pesosTara = new List<int?>();
        var pesosNeto = new List<int?>();
        var diferenciasPesoBruto = new List<int?>();
        var diferenciasPesoTara = new List<int?>();
        var diferenciasPesoNeto = new List<int?>();
        var diferencias = new List<string>();
        var balanzas = camion.OrderBy(o => o.Fecha).Select(s => s.BalanzaNombre).Distinct().ToList();
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col" style="border-bottom: 0">
                        &nbsp;
                    </th>
                    <th scope="col" colspan="@(balanzas.Count()*(balanzas.Count()-1))">
                        <span>
                            @camion.Key.TipoDocumentoIngreso.DisplayEnum() N°: @camion.Key.NumeroDocumentoIngreso
                        </span>
                        <span style="margin-left: 60px">
                            @Textos.Patente: @camion.Key.Patente
                        </span>
                    </th>
                </tr>
                <tr>
                    <th style="border-top: 0">
                        &nbsp;
                    </th>
                    @{
                        
                        foreach (var b in balanzas)
                        {
                            <th style="text-align: center">
                                @b
                            </th>
                            var peso = camion.Where(f => f.BalanzaNombre == b && f.TipoPesada == TipoPesada.Bruto).Select(s => (int?)s.Peso).FirstOrDefault();
                            pesosBruto.Add(peso);
                            peso = camion.Where(f => f.BalanzaNombre == b && f.TipoPesada == TipoPesada.Tara).Select(s => (int?)s.Peso).FirstOrDefault();
                            pesosTara.Add(peso);
                            pesosNeto.Add((pesosBruto.Last() ?? 0) - (pesosTara.Last() ?? 0));
                        }
                        foreach (var b1 in balanzas)
                        {
                            foreach (var b2 in balanzas)
                            {
                                if (b1 != b2 && !diferencias.Exists(e => e == b2 + b1))
                                {
                                    <th style="text-align: center">
                                        @b1 - @b2
                                    </th>
                                    diferencias.Add(b1 + b2);
                                    var peso1 = camion.Where(f => f.BalanzaNombre == b1 && f.TipoPesada == TipoPesada.Bruto).Select(s => (int?)s.Peso).FirstOrDefault();
                                    var peso2 = camion.Where(f => f.BalanzaNombre == b2 && f.TipoPesada == TipoPesada.Bruto).Select(s => (int?)s.Peso).FirstOrDefault();
                                    diferenciasPesoBruto.Add(peso1.HasValue && peso2.HasValue ? peso1 - peso2 : null);
                                    peso1 = camion.Where(f => f.BalanzaNombre == b1 && f.TipoPesada == TipoPesada.Tara).Select(s => (int?)s.Peso).FirstOrDefault();
                                    peso2 = camion.Where(f => f.BalanzaNombre == b2 && f.TipoPesada == TipoPesada.Tara).Select(s => (int?)s.Peso).FirstOrDefault();
                                    diferenciasPesoTara.Add(peso1.HasValue && peso2.HasValue ? peso1 - peso2 : null);
                                    diferenciasPesoNeto.Add((diferenciasPesoBruto.Last() ?? 0) - (diferenciasPesoTara.Last() ?? 0));
                                }
                            }
                        }  
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <b> @Textos.Bruto </b>
                    </td>
                    @foreach (var peso in pesosBruto)
                    {
                        <td style="text-align: center">
                            @(peso != null ? peso.ToString() : string.Empty)
                        </td>
                    }
                    @foreach (var peso in diferenciasPesoBruto)
                    {
                        <td style="text-align: center">
                            @(peso != null ? peso.ToString() : string.Empty)
                        </td>
                    }
                </tr>
                <tr>
                    <td>
                        <b> @Textos.Tara </b>
                    </td>
                    @foreach (var peso in pesosTara)
                    {
                        <td style="text-align: center">
                            @(peso != null ? peso.ToString() : string.Empty)
                        </td>
                    }
                    @foreach (var peso in diferenciasPesoTara)
                    {
                        <td style="text-align: center">
                            @(peso != null ? peso.ToString() : string.Empty)
                        </td>
                    }
                </tr>
                <tr>
                    <td>
                        <b> @Textos.Neto </b>
                    </td>
                    @foreach (var peso in pesosNeto)
                    {
                        <td style="text-align: center">
                            @(peso != null ? peso.ToString() : string.Empty)
                        </td>
                    }
                    @foreach (var peso in diferenciasPesoNeto)
                    {
                        <td style="text-align: center">
                            @(peso != null ? peso.ToString() : string.Empty)
                        </td>
                    }
                </tr>
                <tr>
                    <td colspan="@(balanzas.Count()*(balanzas.Count()-1) + 2)">
                       <b> @Textos.Observaciones:</b> <br/>
                        @{
                            var obs1 = camion.Where(w => w.TipoPesada == TipoPesada.Bruto).Select(s => s.Observacion).FirstOrDefault();
                            var obs2 = camion.Where(w => w.TipoPesada == TipoPesada.Tara).Select(s => s.Observacion).FirstOrDefault();
                            if (!string.IsNullOrEmpty(obs1))
                            {
                                <span>@obs1</span><br/>
                            }
                            if (!string.IsNullOrEmpty(obs2))
                            {
                                <span>@obs2</span><br/>
                            }
                        }
                    </td>
                </tr>
                
                

            </tbody>
        </table>
    }     
}




