@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.VisualizacionBarreraDto
@{
    Layout = null;
    ViewBag.Title = Textos.Barrera_Modificar;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script src="@Url.Script("~/scripts/barrera.js")" type="text/javascript"></script>
@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Barrera_Modificar, id = "orden-form", data_dialogo_extraclass = "dialog-grande" }))
{
    @Html.Partial("_CrearModificar", Model)
}