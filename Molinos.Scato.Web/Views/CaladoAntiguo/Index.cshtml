@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    ViewBag.Title = Textos.Calado_Titulo;
    var patenteOriginal = (string) ViewBag.PatenteOriginal;
    var obligatorias = (string) ViewBag.CaracteristicasObligatorias;
    var esEgreso = (bool)ViewBag.EsEgreso;
}


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
    <script src="@Url.Script("~/Scripts/calado.js")" type="text/javascript"></script>
    <script src="~/scripts/jquery.maskedinput.js" type="text/javascript"></script>
}

<style>
    .validation-summary-errors { color: #b94a48; font-size: 15px;}

</style>
<div class ="container">
    <div class="titSecciones">@Textos.Calado_Titulo</div>
</div>

<div id="sinHumedad" class="validation-summary-errors hidden">@Textos.NoExisteHumedad</div>

<div id="calado">
    <div class="row">
        <div class="span12 control-group">
            @Html.Hidden("caracteristicasObligatorias", obligatorias, new {id = "caracteristicasObligatorias"})
            @Html.Hidden("patenteOriginal", patenteOriginal, new { @class = "patenteOriginal" })
            @Html.Hidden("tipoVehiculo", (int)ViewBag.TipoVehiculo)
            @Html.Label(Textos.Precinto_Patente + ":",new { style= "display:inline"})
            @if (ViewBag.Patente != null)
            {
                @Html.TextBox("patente", (string)ViewBag.Patente, new { @class = "control input-small patente-argentina uppercase patente", @readonly = "readonly", autocomplete = "off" })
            }
            else
            {
                @Html.TextBox("patente", string.Empty, new { @class = "control input-small patente-argentina uppercase patente", data_patente_url = Url.Action("ValidarPatente"), autocomplete = "off" })
            }
            @if ((bool)ViewBag.Rechazado)
            {
            <span class="label label-important pull-right"><h4 style="margin-top: 0;margin-bottom: 0">@Textos.RechazadoMayus</h4></span>
            }
        </div>
    </div>

    <div class="row">
        <table class="tablaDatos span12search">
            <tr>
                <th>@Html.Label(Textos.TipoComercial + ":")</th>
                <th>@Html.Label(Textos.Material + ":")</th>
                <th>@Html.Label(Textos.Calado_Ciclo + ":")</th>
                <th>@Html.Label(((TipoDocumentoIngreso)ViewBag.TipoDocumentoIngreso).DisplayEnum() + ":")</th>
                <th>@Html.Label(Textos.Calado_NumeroDeOrden + ":")</th>
            </tr>
            <tr>
                <td>@ViewBag.TipoComercial</td>
                <td>@ViewBag.Material</td>
                <td>@ViewBag.CicloDeCalado</td>
                <td>@ViewBag.NumeroDocumentoIngreso</td>
                <td>@ViewBag.NumeroDeOrden</td>
            </tr>
        </table>  
    </div>

    <br/>
    <br/>

    <button class="btn btn-primary agregar pull-right" style="margin-bottom: 10px;" type="button">@Textos.Rubro_Nuevo</button>
    @Html.Hidden("caladoObligatorio", false, new { id = "caladoObligatorio" })
    @Html.Hidden("valorMin", 0, new { id = "valorMin" })
    @Html.Hidden("valorMax", 0, new { id = "valorMax" })

    <div class="modal hide fade form-horizontal" id="dialogo-editar">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true" >&times;</button>
            <h4 id="dialogo-editar-title">@Textos.Rubro_Nuevo</h4>
        </div>
        <div class="modal-body" id ="dialogo-editar-body">
            <form id="caladosPorCaracteristica" data-bind="submit: addCaladoPorCaracteristica">
                <div class="control-group">
                    @Html.Label(Textos.Calado_Caracteristica, new { @class = "control-label" })
                    <div class="controls">
                        @Html.DropDownList("caracteristica", (IEnumerable<SelectListItem>)ViewBag.Caracteristicas, new { id = "caracteristica", @class = "control input-xlarge", data_bind = "value: newCaracteristicaId", data_caracteristica_url = Url.Action("ObtenerCaracteristica") })
                    </div>
                </div>
                @if (!esEgreso)
                {
                    <div class="control-group">
                        @Html.Label(Textos.Calado_AnalisisPreliminar, new { @class = "control-label" })
                        <div class="controls">
                            <input type="checkbox" data-bind="checked: newAnalisisPreliminar" id="analisisPreliminar"/>
                        </div>
                    </div>
                    <div class="control-group">
                        @Html.Label(Textos.Calado_EnvioACamara, new { @class = "control-label" })
                        <div class="controls">
                            <input type="checkbox" data-bind="checked: newEnvioACamara" id="envioACamara"/>
                        </div>
                    </div> 
                }
                <div class="control-group">
                    @Html.Label(Textos.Calado_Valor, new { @class = "control-label" })
                    <div class="controls">
                        <input data-bind="value: newValorCalado" id="valorCalado" name="valorCalado" class="valorCaladoVacio input-small campoNumerico" data-error-numerico = "@string.Format(Textos.Error_NumericoYRango, Textos.Calado_Valor)"/>
                    </div>
                    <div class="control-group">@Html.ValidationMessage("valorCalado", new { @class = "validaValorCaladoVacio help-block" })</div>
                </div>
                <div class="control-group">
                    @Html.Label(Textos.Calado_Unidad, new { @class = "control-label" })
                    <div class="controls">
                        <input data-bind="value: newUnidad" id="unidad" readonly="readonly"/>
                    </div>
                </div>
                <div class="control-group">
                    @Html.Label(Textos.Calado_Rango, new { @class = "control-label" })
                    <div class="controls">
                        <input data-bind="value: newRango" id="rango" readonly="readonly"/>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <input id="dialogo-editar-guardar" type="button" class="btn btn-primary" value="@Textos.Guardar"/>
            <input id="dialogo-editar-cancelar" type="button" class="btn" value="@Textos.Cancelar"/>
        </div>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@Textos.Calado_Caracteristica</th>
                @if (!esEgreso)
                {
                    <th>@Textos.Calado_AnalisisPreliminar</th>
                    <th>@Textos.Calado_EnvioACamara</th>
                }
                <th>@Textos.Calado_Valor</th>
                <th>@Textos.Calado_Unidad</th>
                <th>@Textos.Calado_Rango</th>
                <th>@Textos.Eliminar</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: caladosPorCaracteristica">
            <tr>
                <td data-bind="text: Caracteristica"/>
                @if (!esEgreso)
                {
                    <td data-bind="formattedBoolean: AnalisisPreliminar" />
                    <td data-bind="formattedBoolean: EnvioACamara"/>
                }
                <td data-bind="formattedFloat: ValorCalado" />
                <td data-bind="text: Unidad"/>
                <td data-bind="text: Rango" />
                <td><a href="#" data-bind="click: $root.removeCaladoPorCaracteristica"><i class="icon-trash"></i></a></td>
            </tr>    
        </tbody>
    </table> 

    @using (Html.BeginForm("Calado", "CaladoAntiguo", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActCalado }))
    {
        @Html.ValidationSummary()
        <input type="hidden" name="calaldosPorCaracteristicas" data-bind="value: ko.toJSON(caladosPorCaracteristica)" />
        <input type="hidden" name="ciclo" value="@ViewBag.CicloDeCalado"/>
        <input type="hidden" name="orden" value="@ViewBag.NumeroDeOrden"/>
        <input type="hidden" name="workflow" value="@ViewBag.Workflow"/>
        <input type="hidden" name="guid" id="guid" value="@ViewBag.Guid"/>
        <input type="hidden" name="muestraElegida" id="muestraElegida" value=""/>
        <input type="hidden" name="muestras" id="muestrasTomadas" value="[]" />
        <input type="hidden" name="workflowDefinicionId" value="@ViewBag.WorkflowDefinicionId"/>
        <div class="row">
            <div class="span6 form-horizontal">
                <div class="control-group">
                    @Html.Label(Textos.Calado_MuestraConjunto, new { @class = "control-label" })
                    <div class="controls">
                        <input type="text" name="muestraConjunto" id="CaladoObligatorias" class="CaladoObligatorias" data-error-obligatorias="@Textos.Calado_FaltanObligatorias"/>
                    </div>
                </div>                
            </div>
            <div class="span6 right">
                <button type="button" class="btn btn right tomarHumedad" style="margin-left: 10px;">@Textos.Calado_TomarHumedad</button>
            </div>
        </div>

        <br/>

        <div class="row right">
            <button type="submit" name="aceptar" id="aceptar" class="btn btn-primary aceptar">@Textos.Aceptar</button>
            @if (!ViewBag.NoRechazaEnCalado)
            {
                @Html.ActionLink(Textos.ExcesoDePeso_Rechazar, "Rechazar", "CaladoAntiguo", new { codigoWf = ViewBag.Workflow, workflowDefinicionId = ViewBag.WorkflowDefinicionId, instanceId = ViewBag.Guid }, new { @class = "rechazar rechazar-boton btn btn-primary pull-right", @style = "margin-left: 4px;" })
            }
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
        </div>
    }

    <div class="hidden">
        <p id="error">@Textos.Calado_CaracteristicaExistente</p>
    </div>

</div>
    
<div id ="mensajeRechazar">
    
</div>

<div id="muestrasDeHumedad">
    
    @Html.DropDownList("humedimetro", (IEnumerable<SelectListItem>)ViewBag.Humedimetros, new { @class = "control input-xlarge centered humedimetro", data_humedimetro_url = Url.Action("ObtenerHumedimetro") })
    @Html.Hidden("modalidad", Modalidad.Manual, new { id = "modalidad" })
    @Html.Hidden("maxVal", 0, new { id = "maxVal" })
    @Html.Hidden("humedadId", (int)ViewBag.HumedadId, new { id = "humedadId" })
    @Html.Hidden("humedadDescripcion", (string)ViewBag.HumedadDescripcion, new { id = "humedadDescripcion" })
    @Html.Hidden("humedadRango", (string)ViewBag.HumedadRango, new { id = "humedadRango" })
    @Html.Hidden("humedadUnidad", (string)ViewBag.HumedadUnidad, new { id = "humedadUnidad" })
    @Html.Hidden("ErrorRangoValor", Textos.Calado_FueraDeRango + " (" + (string)ViewBag.HumedadRango + ")")
    <button class="btn btn-primary agregarMuestra pull-right" type="button" data-humedad-url = "@Url.Action("TomarHumedad")" data-mensaje-esperar="@Textos.Pesada_Espere">@Textos.MuestraDeHumedad_Nuevo</button>

    <div class="modal hide fade form-horizontal" id="dialogo-editar-muestras">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true" >&times;</button>
            <h4 id="dialogo-editar-muestras-title">@Textos.MuestraDeHumedad_Nuevo</h4>
        </div>
        <div class="modal-body" id ="dialogo-editar-muestras-body">
            <form id="muestras" data-bind="submit: addMuestra">
                <div class="control-group">
                    @Html.Label(Textos.Calado_Valor, new { @class = "control-label" })
                    <div class="controls">
                        <input data-bind="value: newValor" id="valor" name="valor" class="valorVacio input-small campoNumerico" data-error-numerico = "@string.Format(Textos.Error_SoloNumerico, Textos.Calado_Valor)"/>
                    </div>
                    <div class="control-group">@Html.ValidationMessage("valor", new { @class = "validaValorVacio help-block" })</div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <input id="dialogo-editar-muestras-guardar" type="button" class="btn btn-primary" value="@Textos.Guardar"/>
            <input id="dialogo-editar-muestras-cancelar" type="button" class="btn" value="@Textos.Cancelar"/>
        </div>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@Textos.MuestraDeHumedad_Numero</th>
                <th>@Textos.Calado_Valor</th>
                <th>@Textos.Fecha</th>
                <th>@Textos.Humedimetro</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: muestras">
            <tr>
                <td data-bind="text: NumeroMuestra"/>
                <td data-bind="formattedFloat: Valor, attr: { id: ValorId, name: ValorId }" />
                <td data-bind="text: FechaFormateada"/>
                <td data-bind="text: NombreHumedimetro" />
            </tr>    
        </tbody>
    </table> 

    @using (Html.BeginForm("ConfirmarMuestra", "CaladoAntiguo", FormMethod.Post, new { id = "form-muestras", @class = "causaBlock", data_mensaje_espera = Textos.ActCalado }))
    {
        @*<input type="hidden" name="muestras" data-bind="value: ko.toJSON(muestras)" />
        <input type="hidden" name="guid" value="@ViewBag.Guid"/>*@
        
        <div class="row">
            <div class="span6 form-horizontal pull-left">
                <div class="control-group">
                    @Html.Label(Textos.MuestraDeHumedad_Seleccionada, new { @class = "control-label" })
                    <div class="controls">
                        <input name="numeroSeleccionada" class="numeroSeleccionadaVacio input-small validarRango" id="numeroSeleccionada" data-error-numero-seleccionada-vacio = "@string.Format(Textos.Error_Requerido, Textos.MuestraDeHumedad_Seleccionada)" data-error-rango = "@string.Format(Textos.MuestraDeHumedad_SeleccionadaRangoIncorrecto)"/>
                        <div class="control-group">@Html.ValidationMessage("numeroSeleccionada", new { @class = "validaSeleccionadaVacio help-block" })</div>
                    </div>
                </div>
            </div>
            <div class="span6 right">
                <button type="button" class="btn btn-primary aceptar-muestra">@Textos.Aceptar</button>
                <button type="button" class="btn cancelar">@Textos.Volver</button>
            </div>
        </div>
    }       
</div>


