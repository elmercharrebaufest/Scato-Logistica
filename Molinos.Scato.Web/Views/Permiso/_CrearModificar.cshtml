@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.PermisoDto

@{
    var codigos = (IEnumerable<SelectListItem>)ViewBag.Codigos;
    var actividades = (IEnumerable<SelectListItem>)ViewBag.Actividades;
}

@Html.ValidationSummary(true)


@Html.Hidden("PermisoActividad", TipoPermiso.Actividad)
@Html.Hidden("ErrorActividadObligatoria", Textos.Permiso_ActividadRequerida)

<div class="control-group">
    @Html.LabelFor(model => model.TipoPermiso, new { @class = "control-label" })
    <div class="controls">
        @Html.EnumDropDownListFor(model => model.TipoPermiso)
        @Html.ValidationMessageFor(m => m.TipoPermiso)
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(model => model.Descripcion, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Descripcion, new {@class = "input-xlarge"})
        @Html.ValidationMessageFor(model => model.Descripcion)
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(model => model.Codigo, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.Codigo, codigos, new { id = "codigosDropDown" })
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(model => model.ActividadWorkflow, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.ActividadWorkflow, actividades, new { id = "actividades", @class= "actividadObligatoria" })
        @Html.ValidationMessageFor(model => model.ActividadWorkflow)
    </div>
</div>