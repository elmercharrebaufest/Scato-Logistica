@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Dominio.Seguridad;
@using Molinos.Scato.Web.Seguridad;
@model Molinos.Scato.Dominio.Dto.ControlRecorridoDto

@{
    ViewBag.Title = Textos.VerificacionCamionRechazado_Titulo;
    string workflow = ViewBag.Workflow;

}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="@Url.Script("~/Scripts/verificacionCamionRechazado.js")" type="text/javascript"></script>

<div class="centered">@Html.Breadcrumb(Textos.VerificacionCamionRechazado_Titulo)</div>

@using (Html.BeginForm("Index", "VerificacionCamionRechazado", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActVerificacionCamionRechazado }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.WorkflowInstanceId)
    @Html.HiddenFor(model => model.NombreUsuario)
    @Html.HiddenFor(model => model.Actividad)
    @Html.HiddenFor(model => model.ActividadXaml)
    @Html.HiddenFor(model => model.PuestoDeTrabajoId)
    @Html.HiddenFor(model => model.Decision, new { @class = "valorDecision" })
    @Html.HiddenFor(model => model.RevierteRechazo, new { @class = "RevierteRechazo" })
    @Html.Hidden("workflow", workflow)
    @Html.Hidden("workflowDefinicionId", (int)ViewBag.WorkflowDefinicionId)

    <div class="centered">
        @Textos.VerificacionCamionRechazado_VehiculoRechazado

        <br />
        <br />

        @Textos.ExcesoDePeso_Motivo : @Html.DropDownListFor(model => model.Mensaje, (IEnumerable<SelectListItem>)ViewBag.Motivos, new { @class = "input-xlarge" })

        <br />
        <br />

        @Textos.VerificacionCamionRechazado_Comentario : @Html.TextAreaFor(model => model.Comentario, new { @class = "input-xlarge textarea-large" })

        <br />
        <br />

        @if (PermisosHelper.Is(PermisosScato.Administradores))
        {
            if (ViewBag.TipoVehiculo == "Tren")
            {
                <button type="submit" class="btn btn-warning no-rechazar">@Textos.VerificacionCamionRechazado_NoRechazar</button>
            }
        }
        <button type="submit" class="btn btn-primary rechazar">@Textos.ExcesoDePeso_Rechazar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
    </div>
}
