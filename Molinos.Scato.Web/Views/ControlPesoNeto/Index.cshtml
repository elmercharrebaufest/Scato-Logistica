@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ControlRecorridoDto

@{
    ViewBag.Title = Textos.ControlPesoNetoRomaneo_Titulo;
    string workflow = ViewBag.Workflow;
    int pesoNetoBalanza = ViewBag.PesoNetoBalanza ?? 0;
    decimal pesoNetoRomaneo = ViewBag.PesoNetoRomaneo ?? 0;
    var diferencia = pesoNetoBalanza - pesoNetoRomaneo;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="@Url.Script("~/Scripts/controlDePesoEsperado.js")" type="text/javascript"></script>
<div class="container-fluid">
    <div class="titSecciones" style="margin-bottom:10px;">@Textos.DiferenciaDePesoNeto_Titulo</div>
</div>

@using (Html.BeginForm("Index", "ControlPesoNeto", FormMethod.Post, new { @class = "form-horizontal causaBlock", data_mensaje_espera = Textos.ActControlPesoNeto }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.WorkflowInstanceId)
    @Html.HiddenFor(model => model.NombreUsuario)
    @Html.HiddenFor(model => model.Actividad)
    @Html.HiddenFor(model => model.ActividadXaml)
    @Html.HiddenFor(model => model.PuestoDeTrabajoId)
    @Html.HiddenFor(model => model.Decision, new {@class = "valorDecision"})
    @Html.Hidden("workflow", workflow)
     @Html.Hidden("workflowDefinicionId", (int)ViewBag.WorkflowDefinicionId)
    <div class="row-fluid row-fluid-ie7">

        <div class="span6">
            <div class="control-group">
                <div class="control-label"><strong>@(((TipoDocumentoIngreso)ViewBag.TipoDocumentoIngreso).DisplayEnum()):</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.NumeroDocumentoIngreso</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"><strong>@Textos.Camion_Patente:</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.Patente</div>
                </div>
            </div>
@*            <div class="control-group">
                <div class="control-label">@Textos.NumeroRomaneo:</div>
                <div class="controls">
                    <div class="control margin">@ViewBag.NumeroRomaneo</div>
                </div>
            </div>*@
        </div>
        <div class="span6">
            <div class="control-group">
                <div class="control-label"><strong>@Textos.TipoComercial:</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.TipoComercial</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"><strong>@Textos.Material:</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.Material</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"><strong>@Textos.Calado_NumeroDeOrden:</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.NumeroDeOrden</div>
                </div>
            </div>
        </div>
    </div>
    
    <br/>
    
    <div class="table-bordered centered">
        <div class="control-group">
            <div class="control-label"><strong> @Textos.PesoNetoCentro:</strong></div>
            <div class="controls">
                <div class="control margin">@pesoNetoBalanza</div>
            </div>
        </div>
        <div class="control-group">
            <div class="control-label"><strong> @Textos.PesoNetoRomaneo:</strong></div>
            <div class="controls">
                <div class="control margin">@pesoNetoRomaneo</div>
            </div>
        </div>
        <br/>
        <div class="control-group">
            <div class="control-label"><strong>@Textos.DiferenciaDePeso_Diferencia</strong></div>
            <div class="controls">
                <div class="control margin">@diferencia</div>
            </div>
        </div>
    </div>
    
    <br/>
    <br/>
    
    <div class="centered">
        <button type="submit" class="btn btn-primary repesar confirmar-boton" data-accion="Index" data-mensaje="@string.Format(Textos.ConfirmacionGenerica,Textos.Aceptar,Textos.Transportista_min)">@Textos.Aprobar</button>    
        <button type="submit" class="btn btn-primary acpetar confirmar-boton" data-accion="Index" data-mensaje="@string.Format(Textos.ConfirmacionGenerica,Textos.Rechazar,Textos.Transportista_min)">@Textos.Rechazar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn btn-primary" })
    </div>
    
    <div class="modal hide fade" id="dialogo-confirmar">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4>@Textos.Confirmacion</h4>
        </div>
        <div class="modal-body">
            <div>
                <div id="dialogo-confirmar-body"></div>
                <br/>
                <br/>
                
                @Textos.Motivo : @Html.DropDownListFor(model => model.Mensaje, (IEnumerable<SelectListItem>) ViewBag.Motivos, new {@class = "input-xlarge pull-right"})
        
                <br/>
                <br/>

                @Textos.VerificacionCamionRechazado_Comentario : @Html.TextAreaFor(model => model.Comentario, new {@class = "input-xlarge textarea-large pull-right"})
        
                <br/>
                <br/>
            
            </div>
        </div>
        <div class="modal-footer">
            <button id="dialogo-confirmar-confirmar" type="submit" class="btn " name="submitAction" value="">@Textos.Aceptar</button>
            <button id="dialogo-confirmar-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
        </div>
    </div>
}
