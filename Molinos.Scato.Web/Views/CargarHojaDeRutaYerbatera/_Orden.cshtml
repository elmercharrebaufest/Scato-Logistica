@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.HojaDeRutaYerbateraDto
@{
    var tiposComerciales = (IEnumerable<SelectListItem>) ViewBag.TiposComerciales;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
    var tiposDocumentos = (IEnumerable<SelectListItem>)ViewBag.TiposDocumentos;
    var tipoVehiculo = new List<SelectListItem>();
    
    var esIngreso = (bool) (ViewBag.EsIngreso ?? false);
    var workflow = (string)ViewBag.Workflow;
    if (ViewBag.SoloLectura == null)
    {
        ViewBag.SoloLectura = false;
    }
    bool soloLectura = ViewBag.SoloLectura;
}

@Html.Hidden("esIngreso", esIngreso, new {id = "esIngreso"})
@Html.Hidden("workflow", workflow, new {id = "workflow"})

<div id ="links" 
     data-url-obtener-proveedores-sap ="@Url.Action("ObtenerProveedoresSap", "Consultas")"
     data-url-buscar-proveedor ="@Url.Action("BuscarProveedor", "Consultas")"
     data-url-buscar-proveedores = "@Url.Action("BuscarProveedores", "Consultas")"

     data-url-buscar-centros = "@Url.Action("BuscarCentros", "Consultas")"
     data-url-buscar-centro-unico = "@Url.Action("BuscarCentroUnico", "Consultas")"

     data-url-buscar-transportistas = "@Url.Action("BuscarTransportistas", "Consultas")"
     data-url-buscar-transportista-unico = "@Url.Action("BuscarTransportista", "Consultas")"

     data-url-buscar-procedencias = "@Url.Action("BuscarProcedencias", "Consultas")"
     data-url-buscar-procedencia-unica = "@Url.Action("BuscarProcedenciaUnica", "Consultas")"

     data-url-buscar-choferes = "@Url.Action("BuscarChoferes", "Consultas")"
     data-url-buscar-chofer-unico = "@Url.Action("BuscarChoferUnico", "Consultas")"
     data-url-obtenertiposvehiculo ="@Url.Action("ObtenerTiposVehiculo", "Consultas")"

></div>
@Html.HiddenFor(m => m.TipoDeWorkflow)
@Html.HiddenFor(model => model.Id)
<div id="mensajeInvalido" data-invalido="@Textos.Error_Invalido"/>
<div class="row-fluid row-fluid-ie7">
    <div class="span6">
        <fieldset class="grupo-carta-porte">
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.TipoComercialId, new { @class = "control-label small" })
                <div class="" id ="tiposComerciales" data-alta-rapida='@Html.Raw(Json.Encode(((IEnumerable<string>)ViewBag.TiposComercialesTransportista).Select(x => x)))'>
                    @Html.DropDownListFor(model => model.TipoComercialId, tiposComerciales, new { @class = "control input-large" })
                    @Html.ValidationMessageFor(model => model.TipoComercialId)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.NroHojaDeRutaYerbatera, new { @class = "control-label small"})
                <div class="">
                    @Html.TextBoxFor(model => model.NroHojaDeRutaYerbatera, new { @class = "control input-xlarge", autocomplete = "off", maxlength = 13, data_error_existente = Textos.HojaDeRutaYerbatera_Existente})
                    @Html.ValidationMessageFor(model => model.NroHojaDeRutaYerbatera, null, new { @class = "nroCP" })
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.ProveedorId, new {@class = "control-label small"})
                <div class="">
                    @Html.TextBoxFor(model => model.Proveedor, new {@class = "control input-xlarge"})
                    @Html.ValidationMessageFor(model => model.Proveedor)
                    @Html.HiddenFor(model => model.ProveedorId)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.ProcedenciaId, new { @class = "control-label small" })
                <div class="">
                    @Html.TextBoxFor(model => model.Procedencia, new { @class = "control input-xlarge" })
                    @Html.ValidationMessageFor(model => model.Procedencia)
                    @Html.HiddenFor(model => model.ProcedenciaId)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.DestinatarioId, new {@class = "control-label small"})
                <div class="">
                    @Html.TextBoxFor(model => model.Destinatario, new {@class = "control input-xlarge"})
                    @Html.ValidationMessageFor(model => model.Destinatario)
                    @Html.HiddenFor(model => model.DestinatarioId)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.CentroDestinoId, new {@class = "control-label small"})
                <div class="">
                    @Html.TextBoxFor(model => model.CentroDestino, new {@class = "control input-xlarge "})
                    @Html.ValidationMessageFor(model => model.CentroDestino)
                    @Html.HiddenFor(model => model.CentroDestinoId)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.TransportistaId, new {@class = "control-label small"})
                <div class="">
                    @Html.TextBoxFor(model => model.Transportista, new {@class = "control input-xlarge ", data_error_requerido= String.Format(Textos.Error_Requerido,Textos.Transportista) })
                    @Html.ValidationMessageFor(model => model.Transportista)
                    @Html.HiddenFor(model => model.TransportistaId)
                    @Html.HiddenFor(model => model.EsTransportista)
                </div>
            </div>
            <br />
            @Textos.CartaPorte_DatosChofer
            <div class="row row-carta-porte">
                <div id="divSpan6" class="span8 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.Cuil, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Chofer.Cuil, new { @class = "control input-medium cuilValido", data_error_cuil_invalido = string.Format(Textos.CuilInvalido) })
                        @Html.TextBox("sinCuil", null, new { @disabled = "disabled", style = "display:none", @class = "control input-medium" })

                        @Html.ValidationMessageFor(model => model.Chofer.Cuil)
                    </div>
                </div>
                <div class="span4 control-group control-group-no-bottom">
                    <label class="control-label xsmall-label">Extranjero</label>
                    <div class="controls-small">
                        @Html.CheckBoxFor(model => model.EsExtranjero, new { @class = "input-small", @id = "esExtranjero", @name = "esExtranjero" })
                    </div>
                </div>
            </div>
            <div class="row row-carta-porte">
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model =>  model.Chofer.TipoDocumentoIdentidadId, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.DropDownListFor(model => model.Chofer.TipoDocumentoIdentidadId, tiposDocumentos, new {@class = "control  input-small", autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.Chofer.TipoDocumentoIdentidadId)
                    </div>
                </div>
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model =>  model.Chofer.NumeroDeDocumento, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Chofer.NumeroDeDocumento, new {@class = "control input-small ", maxlength = 10 })
                        @Html.ValidationMessageFor(model => model.Chofer.NumeroDeDocumento)
                    </div>
                </div>
            </div>
            <div class="row row-carta-porte">
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.Nombre, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.HiddenFor(model => model.Chofer.Id)
                        @Html.TextBoxFor(model => model.Chofer.Nombre, new {@class = "control input-small ", data_url_buscar_choferes = Url.Action("BuscarChoferes", "Consultas", new { campo = "Nombre" })})
                        @Html.ValidationMessageFor(model => model.Chofer.Nombre)
                    </div>
                </div>
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.Apellido, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Chofer.Apellido, new {@class = "control input-small ", data_url_buscar_choferes = Url.Action("BuscarChoferes", "Consultas", new { campo = "Apellido" })})
                        @Html.ValidationMessageFor(model => model.Chofer.Apellido)
                    </div>
                </div>               
            </div>
        </fieldset>
    </div>
    <div class="span6">
        <div>
            <fieldset class="grupo-carta-porte">
                <div class="control-group control-group-no-bottom FechaCarga">
                    @Html.LabelFor(model => model.FechaCarga, new {@class = "control-label small"})
                    <div class="">
                        @Html.TextBox("FechaCarga", Model.FechaCarga.Formatted(), new { @class = "control input-small", @tabindex = "-1"})
                        @Html.ValidationMessageFor(model => model.FechaCarga)
                    </div>
                </div>
                <div class="control-group control-group-no-bottom FechaEmision">
                    @Html.LabelFor(model => model.FechaEmision, new {@class = "control-label small"})
                    <div class="">
                        @Html.TextBox("FechaEmision", Model.FechaEmision.Formatted(), new { @class = "date control input-small FechaEmisionValidacion", data_error = string.Format(Textos.Error_FechaMenor + "<br/>" + Textos.FechaCarga, new[] { Textos.OrdenCargaInterna_FechaEmision }) })
                        @Html.ValidationMessageFor(model => model.FechaEmision)
                    </div>
                </div>
                <div class="control-group control-group-no-bottom FechaVencimiento">
                    @Html.LabelFor(model => model.FechaVencimiento, new {@class = "control-label small"})
                    <div class="">
                        @Html.TextBox("FechaVencimiento", Model.FechaVencimiento.Formatted(), new { @class = "date control input-small FechaVtoValidacion FechaVtoValidacionMaxima", @tabindex = "-1", data_error = string.Format(Textos.Error_FechaMayor + "<br/>" +  Textos.FechaCarga, new[] { Textos.CartaPorte_FechaVto}), data_error_maxima = string.Format(Textos.Error_FechaVto + "<br/>" +  Textos.FechaCarga)})
                        @Html.ValidationMessageFor(model => model.FechaVencimiento)
                    </div>
                </div>
                <div class="control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.MaterialId, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.DropDownListFor(model => model.MaterialId, materiales, new {@class = "control input-large"})
                        @Html.ValidationMessageFor(model => model.MaterialId)
                    </div>
                </div>
                <div class="control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.TipoVehiculo, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.DropDownListFor(model => model.TipoVehiculo, tipoVehiculo, new {@id="tipoVehiculoDropdown" ,@class = "control input-small", autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.TipoVehiculo)
                        @Html.HiddenFor(model => model.TipoVehiculoInt)
                    </div>
                </div>
                <div class="control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Patente, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Patente, new { @class = "control input-small patente-internacional validaCamion uppercase"})
                        @Html.ValidationMessageFor(model => model.Patente)
                    </div>
                </div>
                <div class="control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.PatenteAcoplado, new {@class = "control-label small"})
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.PatenteAcoplado, new { @class = "control input-small patente-internacional uppercase"})
                        @Html.ValidationMessageFor(model => model.PatenteAcoplado)
                    </div>
                </div>
                <fieldset class="grupo-carta-porte">@Textos.PesoOrigen
                    <div class="row row-carta-porte"  style="margin-top: 14px">
                    <div class="span4 control-group control-group-no-bottom">
                        <label class="control-label xsmall">@Textos.CartaPorte_PesoBrutoOrigen</label>
                        <div class="controls-xsmall">
                            @Html.TextBoxFor(model => model.PesoBrutoOrigen, new { @class = "control input-xsmall pesoNetoMaximoEjecutar", maxlength = 5,
                                                            data_error_numerico = string.Format(Textos.Error_SoloNumerico, new object[] { Textos.CartaPorte_PesoBrutoOrigen }),
                                                            data_error_positivo = string.Format(Textos.Error_SoloPositivo, new object[] { Textos.CartaPorte_PesoBrutoOrigen }) })
                            @Html.ValidationMessageFor(model => model.PesoBrutoOrigen)
                        </div>
                    </div>
                    <div class="span4 control-group control-group-no-bottom">
                        <label class="control-label xsmall">@Textos.CartaPorte_PesoTaraOrigen</label>
                        <div class="controls-xsmall">
                            @Html.TextBoxFor(model => model.PesoTaraOrigen, new { @class = "control input-xsmall pesoNetoMaximoEjecutar",maxlength = 5,
                                                            data_error_numerico = string.Format(Textos.Error_SoloNumerico, new object[] { Textos.CartaPorte_PesoTaraOrigen }),
                                                            data_error_positivo = string.Format(Textos.Error_SoloPositivo, new object[] { Textos.CartaPorte_PesoTaraOrigen })})
                            @Html.ValidationMessageFor(model => model.PesoTaraOrigen)
                        </div>
                    </div>
                    <div class="span4 control-group control-group-no-bottom">
                        <label class="control-label xsmall">@Textos.CartaPorte_PesoNetoOrigen</label>
                        <div class="controls-xsmall">
                            @Html.TextBoxFor(model => model.PesoNetoOrigen, new { @class = "control input-xsmall pesoNetoMaximo", @readonly = "readonly",
                                data_error_positivo = string.Format(Textos.Error_SoloPositivo, new object[] { Textos.CartaPorte_PesoNetoOrigen }),
                                data_error_pesonetomaximo=string.Format(Textos.Error_NetoMaximo, new object[] { Textos.CartaPorte_PesoNetoOrigen })
                            })
                            @Html.ValidationMessageFor(model => model.PesoNetoOrigen)
                        </div>
                    </div>
                        </div>
                </fieldset>
            </fieldset>
        </div>
    </div>
</div>

<div id="autocompleteProv"></div>
<div id="autocompleteProc"></div>
<div id="autocompleteDestino"></div>
<div id="autocompleteDest"></div>
<div id="autocompleteTran"></div>
