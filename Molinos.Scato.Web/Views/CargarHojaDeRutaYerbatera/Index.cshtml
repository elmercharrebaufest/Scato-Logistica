@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.HojaDeRutaYerbateraDto
@{
    ViewBag.Title = Textos.HojaDeRutaYerbatera_Titulo;
    var workflow = (string) ViewBag.Workflow;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
    <script src="@Url.Script("~/Scripts/hojaDeRutaYerbatera.index.js")" type="text/javascript"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/validarCuil.js")"></script>
    <script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
    <script src="~/scripts/knockout.simpleGrid.1.3.js"  type="text/javascript"></script>
}
<style>
 .content { padding-top: 20px;}

</style>
<div class ="container">
    <div class="titSecciones">@Textos.Workflow_Nombre - @Textos.HojaDeRutaYerbatera_Titulo</div>
</div>

@using (Html.BeginForm("Index", "CargarHojaDeRutaYerbatera", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content container causaBlock", id = "orden-form", data_mensaje_espera = Textos.HojaDeRutaYerbatera_MensajeDeEspera}))
{
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
     {
         <div class="alert alert-error">
             @Html.ValidationSummary(true)
         </div>
     }
    @Html.Partial("_Orden",Model)
    
    <div class="control-group paddingRight cajaButtons">
        <button class="btn btn-primary aceptar" type="submit">@Textos.Aceptar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones",null, new {@class="btn"})
    </div> 
}