@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Seguridad
@using Molinos.Scato.Web.Seguridad

@{
    ViewBag.Title = Textos.TarjetaBloqueada_Titulo;
}

<div class ="container-fluid">
    <ul class="nav nav-tabs">
        @if (PermisosHelper.Is(PermisosScato.AbmTarjetaBloqueada))
        {
            <li>
                @Html.ActionLink(Textos.TarjetaRango_Rango, "Index", "TarjetaRango")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.AbmTarjetaBloqueada))
        {
            <li class="active">
                @Html.ActionLink(Textos.TarjetaBloqueada_Bloqueadas, "Index", "TarjetaBloqueada")
            </li>
        }
         @if (PermisosHelper.Is(PermisosScato.AbmTarjetaSupervisor))
        {
            <li>
                @Html.ActionLink(Textos.TarjetaSupervisor_Supervisor, "Index", "TarjetaSupervisor")
            </li>
        }
    </ul>
</div>

<div class ="container-fluid">
    <div class="titSecciones">@Textos.TarjetaBloqueada_Titulo</div>
</div>

<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form" ,@class = "form-search" }))
            {
                @Html.Label(Textos.Filtrar_TarjetasBloqueadas)
                <input type="text" name="filtro" class="input-large"/>
                <button type="submit" class="btn">@Textos.Filtrar</button>
                
            }
        </div>
        @Html.ActionLink(Textos.TarjetaBloqueada_Nuevo, "Bloquear", "TarjetaBloqueada", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })
    </div>

    <div id="gridContainer">
        @Html.Partial("Listar")
    </div>
</div>