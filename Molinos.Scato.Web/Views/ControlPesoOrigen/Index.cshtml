@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ControlRecorridoDto

@{
    ViewBag.Title = Textos.ControlPesoOrigen_Titulo;
    string workflow = ViewBag.Workflow;
    int pesoPlanta = ViewBag.PesoPlanta ?? 0;
    int pesoOrigen = ViewBag.PesoOrigen ?? 0;
    int diferencia = pesoOrigen - pesoPlanta;
    Model.Mensaje = Textos.DiferenciaDePeso_Titulo;
    Model.Comentario = Textos.DiferenciaDePeso_Diferencia + ": " + diferencia;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="@Url.Script("~/Scripts/controlDePesoEsperado.js")" type="text/javascript"></script>

<div class="container-fluid">
    <div class="titSecciones" style="margin-bottom:10px;">@Textos.ControlPesoOrigen_Titulo</div>
</div>

@using (Html.BeginForm("Index", "ControlPesoOrigen", FormMethod.Post, new { @class = "form-horizontal causaBlock", data_mensaje_espera = Textos.ActControlPesoOrigen }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.WorkflowInstanceId)
    @Html.HiddenFor(model => model.NombreUsuario)
    @Html.HiddenFor(model => model.Actividad)
    @Html.HiddenFor(model => model.ActividadXaml)
    @Html.HiddenFor(model => model.PuestoDeTrabajoId)
    @Html.HiddenFor(model => model.Decision, new {@class = "valorDecision"})
    @Html.HiddenFor(model => model.Mensaje)
    @Html.HiddenFor(model => model.Comentario)
    @Html.Hidden("workflow", workflow)
    @Html.Hidden("workflowDefinicionId", (int)ViewBag.WorkflowDefinicionId)
    <div class="row-fluid row-fluid-ie7">
        
        <div class="span6">    
            <div class="control-group">
                <div class="control-label"> <strong>@(((TipoDocumentoIngreso)ViewBag.TipoDocumentoIngreso).DisplayEnum()):</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.NumeroDocumentoIngreso</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"><strong> @Textos.Proveedor:</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.Proveedor</div>
                </div>
            </div>
        </div>
        <div class="span6">    
            <div class="control-group">
                <div class="control-label"><strong> @Textos.TipoComercial:</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.TipoComercial</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"><strong> @Textos.Material:</strong></div>
                <div class="controls">
                    <div class="control margin">@ViewBag.Material</div>
                </div>
            </div>
        </div>
    </div>
    
    <br/>
    
    <div class="table-bordered centered">
        <div class="control-group">
            <div class="control-label"><strong> @Textos.PesoBrutoOrigen:</strong></div>
            <div class="controls">
                <div class="control margin">@ViewBag.PesoOrigen</div>
            </div>
        </div>
        <div class="control-group">
            <div class="control-label"><strong> @Textos.Planta:</strong></div>
            <div class="controls">
                <div class="control margin">@ViewBag.PesoPlanta</div>
            </div>
        </div>
        <br/>
        <div class="control-group">
            <div class="control-label"><strong>@Textos.DiferenciaDePeso_Diferencia</strong></div>
            <div class="controls">
                <div class="control margin">@diferencia</div>
            </div>
        </div>
    </div>
    
    <br/>
    <br/>
    
    <div class="centered">
        <button type="button" class="btn btn-primary repesar confirmar-boton" data-accion="Index" data-mensaje="@string.Format(Textos.ConfirmacionGenerica,Textos.Aceptar,Textos.Vehiculo_min)">@Textos.Aprobar</button>    
        <button type="button" class="btn btn-primary acpetar confirmar-boton" data-accion="Index" data-mensaje="@string.Format(Textos.ConfirmacionGenerica,Textos.Rechazar,Textos.Vehiculo_min)">@Textos.Rechazar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn btn-primary" })
    </div>
    
    <div class="modal hide fade" id="dialogo-confirmar">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4>@Textos.Confirmacion</h4>
        </div>
        <div class="modal-body" id="dialogo-confirmar-body">
        </div>
        <div class="modal-footer">
            <button id="dialogo-confirmar-confirmar" type="submit" class="btn " name="submitAction" value="">@Textos.Aceptar</button>
            <button id="dialogo-confirmar-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
        </div>
    </div>
}
