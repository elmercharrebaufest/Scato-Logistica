@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    Layout = null;
    var items = (ListaPaginada<HumedimetroDto>)ViewBag.Items;
}


@Html.Grilla(items,
        grid => grid.Columns(
            grid.ColumnaEliminarModificar(Html, "Humedimetro"),
            grid.Columna("DescripcionCorta", Textos.DescripcionCorta),
            grid.Columna("Descripcion",  Textos.Balanza_Descripcion),
            grid.Columna("Modalidad",  Textos.Balanza_Modalidad,canSort:false)))
