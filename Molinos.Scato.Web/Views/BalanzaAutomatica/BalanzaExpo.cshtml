@model Molinos.Scato.Dominio.Dto.BalanzaAutomaticaDto

@{
    var vagones = (List<SelectListItem>)ViewBag.Vagones;
}
<div class="span12 card form-search carta-expo" id="@Model.PuestoId">
    @Html.Hidden("notificacionId" + Model.PuestoId)
    @Html.Hidden("tarjeta" + Model.PuestoId)
    @Html.Hidden("instanceId" + Model.PuestoId)
    @Html.Hidden("dato-balanza" + Model.PuestoId, Model.BalanzaId)
    @Html.Hidden("dato-tipoPesada" + Model.PuestoId)
    @Html.Hidden("dato-rechazado" + Model.PuestoId)
    @Html.Hidden("dato-actividadXaml" + Model.PuestoId)
    @Html.Hidden("dato-workflowInstanceId" + Model.PuestoId)
    @Html.Hidden("dato-workflowDefinicionId" + Model.PuestoId)
    @Html.Hidden("dato-comentario" + Model.PuestoId)
    @Html.Hidden("dato-mensaje" + Model.PuestoId)
    @Html.Hidden("dato-peso" + Model.PuestoId)
    @Html.Hidden("dato-patente" + Model.PuestoId)
    @Html.Hidden("dato-patenteOriginal" + Model.PuestoId)
    @Html.Hidden("puesto-exportacion" + Model.PuestoId, true)

    <div class="row-fluid card-head" style="min-height:inherit">
        <div class="span3" style="border:none">
            <span>@Model.NombreBalanza</span>
        </div>
        <div class="span3" style="border:none">
            <span class="nombre" id="@("etapa"+Model.PuestoId)">En Espera</span>
        </div>

        <div class="span1" style="border:none">
            <a class="btn btn-acciones-especiales" data-id="@Model.PuestoId">Opciones</a>
        </div>
    </div>
    <div class="row-fluid card-body">

        <div class="row-fluid">
            <table class="table encabezado">
                <tr>
                    <th>Patente</th>
                    <th>Doc ingreso</th>
                    <th>N° Documento</th>
                    <th>Vehiculo</th>
                    <th>Material</th>
                    <th>Tipo Comercial</th>
                    <th>Entregador</th>
                </tr>
                <tr>
                    <td id="@("patente"+Model.PuestoId)">Patente</td>
                    <td id="@("doc-ing"+Model.PuestoId)">Doc ingreso</td>
                    <td id="@("cp"+Model.PuestoId)">N° Documento</td>
                    <td id="@("vehiculo"+Model.PuestoId)">Vehiculo</td>
                    <td id="@("material"+Model.PuestoId)">Material</td>
                    <td id="@("tipo-comercial"+Model.PuestoId)">Tipo Comercial</td>
                    <td id="@("entregador"+Model.PuestoId)">Entregador</td>
                </tr>
            </table>
        </div>
        <div class="row-fluid text-center">
            <div class="span4 expo izq" id="@("expo-tara"+Model.PuestoId)">
                <div class="row-fluid">
                    <div class="expo titulo"><strong>Peso Tara</strong></div>
                </div>
                <div class="row-fluid ">
                    <div class="span6"><span class="btn tomarPeso expo-btn expo-tara" data-tipo="tara" data-balanza-id="@Model.BalanzaId" data-id="@Model.PuestoId">Pesar</span></div>
                    <div class="span6"><span id="@("peso-tara" + Model.PuestoId)">0</span><span>Kg.</span></div>
                </div>
                <div class="row-fluid ">
                    <span class="btn expo-btn expo-finalizar expo-tara @("btn"+ Model.PuestoId)" data-puesto="@Model.PuestoId">Finalizar Pesaje</span>
                </div>
            </div>
            <div class="span4 expo izq" id="@("expo-carga"+Model.PuestoId)">
                <div class="row-fluid">
                    <div class="expo titulo"><strong>Carga</strong></div>
                </div>
                <div class="row-fluid ">
                    <div class="span6"><span>Peso Neto Esperado</span></div>
                    <div class="span6"><span class="border:1px solid #ddd" id="@("orgNeto"+Model.PuestoId)">0</span><span>Kg.</span></div>
                </div>
                <div class="row-fluid ">
                    <div class="span6">
                        <span class="btn expo-btn expo-carga carga-parcial" data-puesto="@Model.PuestoId">Carga Parcial</span>
                    </div>
                    <div class="span6">
                        <span class="btn expo-btn expo-carga @("btn"+ Model.PuestoId)" data-puesto="@Model.PuestoId">Carga Finalizada</span>
                    </div>
                </div>
            </div>
            <div class="span4 expo der" id="@("expo-bruto"+Model.PuestoId)">
                <div class="row-fluid">
                    <div class="expo titulo"><strong>Peso Bruto</strong></div>
                </div>
                <div class="row-fluid ">
                    <div class="span6"><span class="btn tomarPeso expo-btn expo-bruto @("btn"+ Model.PuestoId)" data-tipo="bruto" data-balanza-id="@Model.BalanzaId" data-id="@Model.PuestoId">Pesar</span></div>
                    <div class="span6"><span id="@("peso-bruto" +Model.PuestoId)">0</span><span>Kg.</span></div>
                </div>
                <hr />
                <div class="row-fluid ">
                    <div class="span4"><span>Peso Neto</span></div>
                    <div class="span4"><div class="border:1px solid #ddd"><span id="@("peso-neto" +Model.PuestoId)">0</span><span>Kg.</span></div></div>
                    <div class="span4"><span class="btn expo-btn expo-bruto expo-finalizar @("btn"+ Model.PuestoId)" data-puesto="@Model.PuestoId">Finalizar Pesaje</span></div>
                </div>
            </div>
        </div>
    </div>
</div>
