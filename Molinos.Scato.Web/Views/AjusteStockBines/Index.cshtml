@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = Textos.AjusteYStockBines_Titulo;
}

<div class ="container-fluid">
    <div class="titSecciones">@Textos.AdministracionAjusteYStockBines</div>
</div>

<div class="container-fluid content grillaPad">
    
        <div class="span12search bordeGris margen0" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
                @Html.Label(Textos.Filtrar_AjusteDeStock)            
                <input type="text" name="filtro" class="input-large" />
                <button type="submit" class="btn">@Textos.Filtrar</button>
                
            }
        </div>
     @Html.ActionLink(Textos.AjusteStockYBines_Nuevo, "Crear", "AjusteStockBines", null, new { @class = "ajax-editar-link btn btn-primary pull-right"})

    <div id="gridContainer">
        @Html.Partial("Listar")
    </div>
</div>
