@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.SuplenciaDto

@Html.ValidationSummary(true)

<div class="control-group">
    @Html.LabelFor(model => model.UsuarioASuplantarId, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.UsuarioASuplantarId, (IEnumerable<SelectListItem>) ViewBag.Usuarios, new {@class = "control input-medium"})
        @Html.ValidationMessageFor(model => model.UsuarioASuplantarId)
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(model => model.UsuarioSuplenteId, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.UsuarioSuplenteId, (IEnumerable<SelectListItem>) ViewBag.Usuarios, new {@class = "control input-medium"})
        @Html.ValidationMessageFor(model => model.UsuarioSuplenteId)
    </div>
</div>

<div class="control-group FechaDesde">
    @Html.LabelFor(model => model.FechaDesde, new { @class = "control-label" })
    <div class="controls">
        @Html.EditorFor(model => model.FechaDesde, Model != null ? Model.FechaDesde.Formatted() : string.Empty)
        @Html.ValidationMessageFor(model => model.FechaDesde)
    </div>
</div>

<div class="control-group FechaHasta">
    @Html.LabelFor(model => model.FechaHasta, new { @class = "control-label" })
    <div class="controls">
        @Html.EditorFor(model => model.FechaHasta, Model != null ? Model.FechaHasta.Formatted() : string.Empty)
        @Html.ValidationMessageFor(model => model.FechaHasta)
    </div>
</div>
