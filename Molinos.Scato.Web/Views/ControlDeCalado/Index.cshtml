@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Seguridad
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Seguridad
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Web.Models.ControlDeCaladoModel

@{
    var items = (IList<FotosDto>)ViewBag.Items;
}

<script type="text/javascript">
    var urlCambiarPinchazos = "@Url.Action("CambiarPinchazos")";
    var UnoYDosPinchazos = @Convert.ChangeType(TipoPinchazo.UnoYDos, TypeCode.Int32);
    var DosYTresPinchazos = @Convert.ChangeType(TipoPinchazo.DosYTres, TypeCode.Int32);
    var aceptaMotivo = false;
    var cambioUsuario = true;
</script>

<link href="@Url.Content("~/Content/bootstrap-datetimepicker.css")" rel="stylesheet" type="text/css">
<script src="@Url.Script("~/Scripts/bootstrap-datetimepicker.js")" type="text/javascript"></script>
<link href="~/Content/bootstrap-toggle.min.css" rel="stylesheet" />
<script src="~/Scripts/bootstrap-toggle.min.js"></script>
<script src="@Url.Script("~/Scripts/ControlCalado.js")" type="text/javascript"></script>

<link rel="stylesheet" type="text/css" href="@Url.Css("~/Content/columna.css")">

<style>

    div.modal {
        width: 300px
    }
    /*div.modal .control-group {display: inline-block !important}*/
    /*.form-horizontal .control-label {
        padding-top: 0
    }*/
</style>

<div class="titSecciones">@Textos.ControlDeCalado</div>

<div class="container content">
    @if (PermisosHelper.Is(PermisosScato.PinchazosPorCalada))
    {
        if (Model.CambiarPinchazos && Model.UltimoCambioPinchazo != null)
        {
            <div class="row well well-small">
                <div class="col-xs-4">
                    <input id="tipoCalada" type="checkbox" @Html.Raw(Model.UltimoCambioPinchazo.TipoPinchazo == TipoPinchazo.DosYTres ? "checked" : string.Empty) data-toggle="toggle" data-on="2 y 3 pinchazos por camion/acoplado" data-off="1 y 2 pinchazos por camion/acoplado" data-onstyle="success" data-offstyle="success">
                </div>
                <div class="col-xs-8" id="pinchazosPorCalada">
                    @Html.Partial("~/Views/ControlDeCalado/_PinchazosPorCalada.cshtml", Model)
                </div>
            </div>
        }
    }
    <div class="row" style="width:auto;">
        @using (Ajax.BeginForm("Listar", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "controlCalado" }, new { id = "search-form", @class = "form-search causaBlock" }))
        {
            //Cambiar filtros
            <div class="col-lg-4 FechaDesde">
                @Html.LabelFor(model => model.FechaDesde, new { @class = "control-label small elementoEnLinea float-left" })
                <div class="controls-small elementoEnLinea">
                    @Html.TextBox("FechaDesde", Model.FechaDesde.ToString("dd/MM/yyyy HH:mm"), new { @class = "control ", @tabindex = "-1" })
                    @Html.ValidationMessageFor(model => model.FechaDesde)
                </div>
                @*@Html.Label(Textos.Fecha)
                    <div class="input-append date form_datetime" id="first">
                        <input class="span2" size="16" id="datetimepickerDesde" type="text" name="desde" value="" autocomplete="off">
                    </div>*@
            </div>
            <div class="col-lg-4 FechaHasta">
                @Html.LabelFor(model => model.FechaHasta, new { @class = "control-label small elementoEnLinea float-left" })
                <div class="controls-small elementoEnLinea">
                    @Html.TextBox("FechaHasta", Model.FechaHasta.ToString("dd/MM/yyyy HH:mm"), new { @class = "control ", @tabindex = "-1" })
                    @Html.ValidationMessageFor(model => model.FechaHasta)
                </div>
                @*@Html.Label(Textos.Turno)
                    <select name="turno">
                        <option value="mañana">@Textos.Turno_Mañana</option>
                        <option value="noche">@Textos.Turno_Noche</option>
                    </select>*@
            </div>
            <div class="col-lg-4">
                <button type="submit" class="btn btn-primary" style="margin-top: 23px;">@Textos.Buscar</button>
            </div>
        }
    </div>
    <div class="row" id="controlCalado">
        @Html.Partial("_Listar")
    </div>

    <div id="MotivoModal" class="modal hide fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4>Motivo de cambio</h4>
            </div>
            <div class="modal-body">
                <p>El motivo ingresado debe tener minimo 10 letras y máximo 200.</p>
                <textarea id="motivo" rows="3" style="width:250px"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="motivoAceptar">Aceptar</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal" aria-hidden="true">Cancelar</button>
            </div>
        </div>
    </div>
</div>
