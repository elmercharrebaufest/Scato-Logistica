@using System.Globalization
@using System.Web.Mvc.Html
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.PanelServiciosWebDto
@{
    ViewBag.Title = Textos.PanelServerAppPool;
    var serversLista = (IEnumerable<SelectListItem>)ViewBag.Servers;
}

<style>
    .field-validation-error {
        color: #ff0000;
    }
</style>
<script type="text/javascript" src="@Url.Script("~/scripts/jquery.unobtrusive-ajax.min.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/jquery.unobtrusive-ajax.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.js")"></script>
<script src="@Url.Script("~/scripts/jquery.maskedinput.js")" type="text/javascript"></script>

<div class="container-fluid">
    <div class="titSecciones">@Textos.PanelServiciosWeb</div>
</div>
<br>


<div class="container-fluid content grillaPad">
    <div id="grilla">
        <div>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>
                            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search causaBlock" }))
                            {
                                @Html.DropDownListFor(s => s.ServidorNombre, serversLista, new { @class = "control-small", id = "serversLista", Style = "margin-bottom: 0px;" })
                                <button type="submit" class="btn" id="buscar">@Textos.Buscar</button>
                            }
                        </th>
                    </tr>
                </thead>
            </table>
            <div id="gridContainer" data-grid-url="@Url.Action("Index")">
                @Html.Partial("Listar", Model)
            </div>
        </div>
    </div>
</div>
