@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Seguridad
@using Molinos.Scato.Dominio.Seguridad
@model Molinos.Scato.Web.Models.Pesada
@{
    var balanzas = (IEnumerable<SelectListItem>)ViewBag.Balanzas ?? new List<SelectListItem>();
    var proximasBalanzas = (IEnumerable<SelectListItem>)ViewBag.ProximasBalanzas;
    var almacenes = (IEnumerable<SelectListItem>)ViewBag.Almacenes;
    var hidraulicas = (IEnumerable<SelectListItem>)ViewBag.Hidraulicas;
    var calles = (IEnumerable<SelectListItem>)ViewBag.Calles;
    var documentoIngreso = (TipoDocumentoIngreso)ViewBag.DocumentoIngreso;
    var material = (string)ViewBag.Material;
    var numeroDocumento = (string)ViewBag.NumeroDocumentoIngreso;
    var tipoComercial = (string)ViewBag.TipoComercial;
    var pesoBrutoOrigen = (int?)ViewBag.PesoBrutoOrigen;
    var pesoTaraOrigen = (int?)ViewBag.PesoTaraOrigen;
    var pesoBruto = (int?)ViewBag.PesoBruto;
    var pesoTara = (int?)ViewBag.PesoTara;
    var pesoNetoOrigen = pesoBrutoOrigen != null && pesoTaraOrigen != null ? pesoBrutoOrigen - pesoTaraOrigen : null;
    var modificaAlmacen = (bool)ViewBag.ModificaAlmacen;

}
<style>
    .tablaDatos {
        width: 960px;
        margin-bottom: 0;
    }

        .tablaDatos th {
            margin-bottom: 0;
            text-align: center;
        }

    .form-horizontal .control-group {
        margin-bottom: 1px;
        padding-left: 10px;
    }

    .separacion {
        margin-bottom: 5px;
    }
</style>
@Html.Hidden("Automatizado", (bool)ViewBag.Automatizado)
<div class="row-fluid-ie7 separacion">
    <div class="grupo-carta-porte balanzaColor" id="balanza" style="padding-bottom: 0">
        @Html.LabelFor(model => model.BalanzaId):
        @if (PermisosHelper.Is(PermisosScato.Administradores))
        {
            @Html.DropDownListFor(model => model.BalanzaId, balanzas, new { @class = "control input-large", tabIndex = "-10", data_balanza_url = Url.Action("ObtenerBalanza", Model.ActividadXaml) })
        }
        else
        {
            @Html.DropDownListFor(model => model.BalanzaId, balanzas, new { @class = "control input-large", tabIndex = "-10", data_balanza_url = Url.Action("ObtenerBalanza", Model.ActividadXaml), @readonly = "readonly", @style = "pointer-events: none;" })
        }
        <button id="btnACero" type="button" class="btn hide" tabindex="1" style="margin-left: 15px">@Textos.BalanzaACero_Titulo</button>
        @Html.ValidationMessageFor(model => model.BalanzaId)
    </div>
    @Html.HiddenFor(m => m.BalanzaPuestoDeTrabajo)
</div>

<div class="row">
    <table class="tablaDatos span12search">
        <tr>
            <th>@Html.Label(Textos.Patente + ":")</th>
            <th>@Html.Label(Textos.Pesada_DocumentoIngreso + ":")</th>
            <th>@Html.Label(Textos.Pesada_NumeroDocumento + ":")</th>
            <th>@Html.Label(Textos.Material + ":")</th>
            <th>@Html.Label(Textos.TipoComercial + ":")</th>
            <th>@Html.Label(Textos.TieneEntregador + ":")</th>
        </tr>
        <tr>
            <td>
                @if (Model.Patente != null)
                {
                    @Html.TextBoxFor(model => model.Patente, new { @class = "control input-small patente-internacional uppercase", @readonly = "readonly", autocomplete = "off" })
                }
                else
                {
                    @Html.TextBoxFor(model => model.Patente, new { @class = "control input-small patente-internacional uppercase", tabIndex = 1, data_patente_url = Url.Action("ValidarPatente", Model.ActividadXaml), autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.Patente)
                }
            </td>
            <td>@documentoIngreso.DisplayEnum()</td>
            <td>@numeroDocumento</td>
            <td>@Html.DisplayFor(model => material)</td>
            <td>@Html.DisplayFor(model => tipoComercial)</td>
            <td>@ViewBag.TieneEntregador</td>

        </tr>
    </table>
</div>
<div class="row-fluid row-fluid-ie7">
    <div class="span6">
        <fieldset class="grupo-carta-porte">
            <table style="margin-left: 20px; padding: 30px">
                <thead>
                    <tr>
                        <td colspan="4">
                            <strong>@Html.Label(Textos.Pesada_PesoOrigen)</strong>
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">
                            <div class="control-group">
                                @Html.Label(@Textos.PesoBruto + ":", new { @class = "control-label" })
                                <div class="controls control-text" id="PesoBrutoOrigen">
                                    @pesoBrutoOrigen
                                </div>
                            </div>
                        </td>
                        <td colspan="2">
                            <div class="control-group">
                                @Html.Label(@Textos.Dif, new { @class = "control-label", style = "width:30px" })
                                <div class="control-label" style="width: 100px" id="difPesoBruto"></div>
                            </div>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">
                            <div class="control-group">
                                @Html.Label(@Textos.PesoTara + ":", new { @class = "control-label" })
                                <div class="controls control-text" id="PesoTaraOrigen">
                                    @pesoTaraOrigen
                                </div>
                            </div>
                        </td>
                        <td colspan="2">
                            <div class="control-group">
                                @Html.Label(@Textos.Dif, new { @class = "control-label", style = "width:30px" })
                                <div class="control-label" style="width: 100px" id="difPesoTara"></div>
                            </div>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">
                            <div class="control-group" style="border-top: 1px solid black; padding-top: 18px;">
                                @Html.Label(@Textos.PesoNeto + ":", new { @class = "control-label" })
                                <div class="controls control-text" id="PesoNetoOrigen">@pesoNetoOrigen</div>
                            </div>
                        </td>
                        <td colspan="2">
                            <div class="control-group" style="border-top: 1px solid black; padding-top: 18px;">
                                @Html.Label(@Textos.Dif, new { @class = "control-label", style = "width:30px" })
                                <div class="control-label" style="width: 100px" id="difPesoNeto"></div>
                            </div>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                </tbody>
            </table>
        </fieldset>
    </div>
    <div class="span6">
        <fieldset class="grupo-carta-porte">
            <table style="margin-left: 20px; padding: 30px">
                <thead>
                    <tr>
                        <td colspan="4">
                            <strong>@Html.Label(Textos.Pesada_PesoEnCentro)</strong>
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">
                            <div class="control-group">
                                @Html.Label(@Textos.PesoBruto + ":", new { @class = "control-label" })
                                <div class="controls">
                                    @if (Model.TipoPesada == TipoPesada.Bruto)
                                    {
                                        <div class="input-append">
                                            @Html.TextBoxFor(model => model.Peso, new { @class = "control input-small peso1", @readonly = "readonly", tabIndex = "-10", data_peso_url = Url.Action("TomarPeso", Model.ActividadXaml), style = "margin-right:10px" })
                                            @if (PermisosHelper.Is(PermisosScato.Administradores))
                                            {
                                                <button id="tomarPeso" class="btn" type="button" tabIndex="1" data-mensaje-esperar="@Textos.Pesada_Espere">@Textos.TomarPeso</button>
                                            }
                                            else
                                            {
                                                <button id="tomarPeso" class="btn" type="button" tabIndex="1" data-mensaje-esperar="@Textos.Pesada_Espere" disabled="disabled">@Textos.TomarPeso</button>
                                            }
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Peso)
                                    }
                                    else
                                    {
                                        @Html.TextBox("PesoBruto", pesoBruto, new { @class = "control input-small peso1", @readonly = "readonly", tabIndex = -10 })
                                    }
                                </div>
                            </div>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">
                            <div class="control-group">
                                @Html.Label(@Textos.PesoTara + ":", new { @class = "control-label" })
                                <div class="controls">
                                    @if (Model.TipoPesada == TipoPesada.Tara)
                                    {
                                        <div class="input-append">
                                            @Html.TextBoxFor(model => model.Peso, new { @class = "control input-small peso2", @readonly = "readonly", tabIndex = -10, data_peso_url = Url.Action("TomarPeso", Model.ActividadXaml), style = "margin-right:10px" })
                                            <button id="tomarPeso" class="btn" type="button" tabindex="2" data-mensaje-esperar="@Textos.Pesada_Espere">@Textos.TomarPeso</button>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Peso)
                                    }
                                    else
                                    {
                                            @Html.TextBox("PesoTara", pesoTara, new { @class = "control input-small peso2", @readonly = "readonly", tabIndex = -10 })
                                        
                                }
                                </div>
                            </div>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">
                            <div class="control-group" style="border-top: 1px solid black; padding-top: 10px">
                                @Html.Label(@Textos.PesoNeto + ":", new { @class = "control-label" })
                                <div class="controls">
                                    @Html.TextBox("PesoNeto", null, new { @class = "control input-small", @readonly = "readonly", tabIndex = -10 })
                                </div>
                            </div>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                </tbody>
            </table>
        </fieldset>
    </div>

</div>
<div class="row-fluid row-fluid-ie7">
    <fieldset class="grupo-carta-porte">
        <div class="span6">

            @if (Model != null && !string.IsNullOrEmpty(Model.AlmacenDesc) && !modificaAlmacen)
            {
                @Html.HiddenFor(m => m.AlmacenDesc)
                @Html.HiddenFor(m => m.AlmacenId)
                <div class="control-group">
                    @Html.Label(@Textos.Pesada_Almacen + ":", new { @class = "control-label" })
                    <div class="controls control-text">
                        @Model.AlmacenDesc
                    </div>
                </div>
            }
            else
            {
                @Html.HiddenFor(m => m.AlmacenDesc)
                <div class="control-group">
                    @Html.Label(@Textos.Pesada_Almacen + ":", new { @class = "control-label" })
                    <div class="controls">
                        @Html.DropDownListFor(model => model.AlmacenId, almacenes, Textos.Default_Almacen, new { @class = "control input-medium", tabIndex = 2 })
                        @Html.ValidationMessageFor(model => model.AlmacenId)
                    </div>
                </div>
            }
            @if ((bool)ViewBag.CargarProximaBalanza)
            {
                <div class="control-group">
                    @Html.Label(Textos.ProximaBalanza + ":", new { @class = "control-label" })
                    <div class="controls">
                        @if ((bool)ViewBag.BalanzasObligatorias)
                        {
                            @Html.DropDownListFor(model => model.ProximaBalanzaId, proximasBalanzas, new { @class = "control input-medium", tabIndex = 2 })
                            @Html.ValidationMessageFor(model => model.ProximaBalanzaId)
                        }
                        else
                        {
                            <input type="text" class="control input-medium" readonly="readonly" value="@Textos.SinAsignar" />
                        }
                    </div>
                </div>
            }
        </div>
        <div class="span6">
            <div class="control-group">
                @Html.Label(@Textos.Hidraulica + ":", new { @class = "control-label" })
                <div class="controls">
                    @if (Model != null && !string.IsNullOrEmpty(Model.HidraulicaDesc))
                    {
                        @Model.HidraulicaDesc
                    }
                    else
                    {
                        @Html.DropDownListFor(model => model.HidraulicaId, hidraulicas, new { @class = "control input-medium", tabIndex = -10 })
                        @Html.ValidationMessageFor(model => model.HidraulicaId)
                    }
                </div>
            </div>
            <div class="control-group">
                @Html.Label(@Textos.Calle + ":", new { @class = "control-label" })
                <div class="controls">
                    @if (Model != null && !string.IsNullOrEmpty(Model.CalleDesc))
                    {
                        <div class="control-text">
                            @Model.CalleDesc
                        </div>
                    }
                    else
                    {
                        @Html.DropDownListFor(model => model.CalleId, calles, new { @class = "control input-medium", tabIndex = -10 })
                        @Html.ValidationMessageFor(model => model.CalleId)
                    }
                </div>
            </div>
            <div class="control-group" style="display:none;">
                <div class="controls">
                    <label class="input-control checkbox">
                        @Html.CheckBoxFor(m => m.ControlPesada, new { @class = "", tabIndex = 2, id = "CheckBoxControlBalanza" })
                        <span class="helper">@Textos.Pesada_ControlBalanza</span>
                    </label>
                </div>
            </div>

        </div>
    </fieldset>
</div>


<div class="modal hide fade " id="dialogo-pesar">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true" tabindex="-10">&times;</button>
        <h4>@Textos.TomarPeso</h4>
    </div>
    <div class="modal-body" id="dialogo-pesar-body">
        <div class="control-group">
            <label class="control-label">@Textos.PesoManual:</label>
            <div class="controls">
                @Html.TextBox("PesoManual", null, new { @class = "control input-small", autocomplete = "off", tabIndex = 2 })
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <input id="dialogo-pesar-guardar" type="button" class="btn btn-primary" tabindex="2" value="@Textos.Guardar" />
        <input id="dialogo-pesar-cancelar" type="button" class="btn" tabindex="2" value="@Textos.Cancelar" />
    </div>
</div>

<div class="modal hide fade " id="dialogo-controlBalanza">
    <div class="modal-header">
        <button id="dialogo-controlBalanza-close" type="button" class="close" data-dismiss="modal" aria-hidden="true" tabindex="-10">&times;</button>
        <h6 style="font-weight: lighter; font-size: 14px">@Textos.ControlBalanzaPopup</h6>
    </div>
    <div class="modal-footer">
        <input id="dialogo-controlBalanza-confirmar" type="button" class="btn btn-primary" tabindex="2" value="@Textos.Confirmar" />
        <input id="dialogo-controlBalanza-cancelar" type="button" class="btn" tabindex="2" value="@Textos.Cancelar" />
    </div>
</div>
