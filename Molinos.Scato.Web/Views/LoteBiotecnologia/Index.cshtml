@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Seguridad
@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Web.Seguridad
@model Molinos.Scato.Dominio.Dto.LoteBiotecnologiaDto

@{  
    ViewBag.Title = Textos.Lote_EnviarACamara + " - " + Textos.Lote_Biotecnologia_Titulo;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Content("~/scripts/jquery.maskedinput.js")" type="text/javascript"></script>
    <script type="text/javascript" src="@Url.Script("~/Scripts/jquery.validate.unobtrusive.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
    <script type="text/javascript" src="@Url.Script("~/scripts/loteBiotecnologia.js")"></script>
}
<div id ="links" 
     data-url-buscar-material ="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales = "@Url.Action("BuscarMateriales", "Consultas")"
></div>

<div class ="container-fluid">
    <ul class="nav nav-tabs">
        @if (PermisosHelper.Is(PermisosScato.ArmarLote))
        {
            <li>
                @Html.ActionLink(Textos.Lote_Titulo, "Index", "Lote")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.BuscarLote))
        {
            <li>
                @Html.ActionLink(Textos.BuscarLote_Titulo, "BuscarLote", "Lote")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.TablaConversionMaterial))
        {
            <li>
                @Html.ActionLink(Textos.TablaConversion, "Index", "ConversionMaterial")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.ArmarLoteBiotecnologia))
        {
            <li class="active">
                @Html.ActionLink(Textos.ArmarLoteBiotecnologia, "Index", "LoteBiotecnologia")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.ArmarLoteBiotecnologia))
        {
            <li>
                @Html.ActionLink(Textos.BuscarLoteBiotecnologia, "BuscarLote", "LoteBiotecnologia")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.ArmarLoteAuditoria))
        {
            <li>
                @Html.ActionLink(Textos.BuscarLoteAuditoria, "BuscarLote", "LoteAuditoria")
            </li>
        }
        @if (PermisosHelper.Is(PermisosScato.ArmarLoteInase))
        {
            <li>
                @Html.ActionLink(Textos.BuscarLoteInase, "BuscarLote", "LoteInase")
            </li>
        }
    </ul>
    
    <div class ="container">
</div>

    <div class="container content grillaPad"> 
@* ReSharper disable Mvc.ActionNotResolved *@
        @using (Html.BeginForm("Action", "LoteBiotecnologia", FormMethod.Post, new { @class = "form-horizontal form-search causaBlock" }))
        {
            
           @Html.Hidden("soloImprimir")
            @Html.Hidden("soloDescargar")
            <div class="row">
@* ReSharper restore Mvc.ActionNotResolved *@
                <div class="span6">
                    <div class="control-group">
                        @Html.LabelFor(model => model.Material, new { @class = "control-label"})
                        <div class="controls">
                            @Html.TextBoxFor(model => model.Material, new { @class = "control"})
                            @Html.ValidationMessageFor(model => model.Material)
                            @Html.HiddenFor(model => model.MaterialId)
                        </div>
                    </div>
                </div>
                <div class="span6">
                    <div class="control-group">
                        @Html.LabelFor(model => model.CamaraDesc, new {@class = "control-label"})
                        <div class="controls">
                            @Html.DropDownListFor(model => model.CamaraId, (IEnumerable<SelectListItem>) ViewBag.Camaras,Textos.Default_Camara, new {@class = "control"})
                            @Html.Hidden("CamaraIdAnterior", "0")
                            @Html.ValidationMessageFor(model => model.CamaraId)
                        </div>
                    </div>
                </div>
            </div>      
            <br/>
            <br/>
            <br/>
            <div class="row right">
                <button class="btn btn-primary" type="submit" name="submitAction" value="Descargar">@Textos.Lote_DescargarArchivo</button>
                <button class="btn btn-primary" type="submit" name="submitAction" value="ListadoDetalle">@Textos.Lote_ListadoDetalle</button>
            </div>
        }
    </div>
    </div>
