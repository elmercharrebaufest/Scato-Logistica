@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.TalonarioDto
@{
    ViewBag.Title = Textos.Talonario_Titulo;
}

<div class ="container">
    <div class="titSecciones">@Textos.Administracion_Talonarios</div>
</div>

<div class="container content grillaPad">
    <div class="row">
        <div class="span12search bordeGris">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search ", }))
            {
                
                @Html.LabelFor(model => model.Descripcion, new { @class = "control-label" })
                <input type="text" name="filtro" class="input-large"/>                
                <button type="submit" class="btn">@Textos.Filtrar</button>
                @Html.ActionLink(Textos.Talonario_nuevo, "Crear", "Talonario", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })
            }
        </div>
    </div>

    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
        @Html.Partial("Listar")
    </div>
</div>