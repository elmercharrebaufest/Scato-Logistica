@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ControlRecorridoDto

@{
    ViewBag.Title = Textos.DiferenciaDePeso_Titulo;
    string workflow = ViewBag.Workflow;
    int pesoEsperado = ViewBag.PesoEsperado ?? 0;
    int pesoBalanza = ViewBag.PesoBalanza ?? 0;
    int diferencia = pesoBalanza - pesoEsperado;
    Model.Mensaje = Textos.DiferenciaDePeso_Titulo;
    Model.Comentario = Textos.DiferenciaDePeso_Diferencia + ": " + diferencia;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="@Url.Script("~/Scripts/controlDePesoEsperado.js")" type="text/javascript"></script>


<div class="container-fluid">
    <div class="titSecciones" style="margin-bottom:10px;">@Textos.DiferenciaDePeso_Titulo</div>
</div>

@using (Html.BeginForm("Index", "ControlDePesoEsperado", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActControlDePesoEsperado }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.WorkflowInstanceId)
    @Html.HiddenFor(model => model.NombreUsuario)
    @Html.HiddenFor(model => model.Actividad)
    @Html.HiddenFor(model => model.ActividadXaml)
    @Html.HiddenFor(model => model.PuestoDeTrabajoId)
    @Html.HiddenFor(model => model.Decision, new {@class = "valorDecision"})
    @Html.HiddenFor(model => model.Mensaje)
    @Html.HiddenFor(model => model.Comentario)
    @Html.Hidden("workflow", workflow)
     @Html.Hidden("workflowDefinicionId", (int)ViewBag.WorkflowDefinicionId)
    <div class="row-fluid row-fluid-ie7">
        
        <div class="span6">    
            <div class="control-group">
                <div class="control-label"> @(((TipoDocumentoIngreso)ViewBag.TipoDocumentoIngreso).DisplayEnum()):</div>
                <div class="controls">
                    <div class="control margin">@ViewBag.NumeroDocumentoIngreso</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"> @Textos.Workflow_Nombre:</div>
                <div class="controls">
                    <div class="control margin">@ViewBag.WorkflowDesc</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"> @Textos.TipoComercial:</div>
                <div class="controls">
                    <div class="control margin">@ViewBag.TipoComercial</div>
                </div>
            </div>
        </div>
        <div class="span6">    
            <div class="control-group">
                <div class="control-label"> @Textos.Camion_Patente:</div>
                <div class="controls">
                    <div class="control margin">@ViewBag.Patente</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"> @Textos.Transportista:</div>
                <div class="controls">
                    <div class="control margin">@ViewBag.Transportista</div>
                </div>
            </div>
            <div class="control-group">
                <div class="control-label"> @Textos.Material:</div>
                <div class="controls">
                    <div class="control margin">@ViewBag.Material</div>
                </div>
            </div>
        </div>
    </div>
    
    <br/>
    
    <div class="table-bordered centered">
        <div class="control-group">
            <div class="control-label"> @Textos.TipoComercial_PesoEsperado:</div>
            <div class="controls">
                <div class="control margin">@ViewBag.PesoEsperado</div>
            </div>
        </div>
        <div class="control-group">
            <div class="control-label"> @Textos.DiferenciaDePeso_PesoBalanza:</div>
            <div class="controls">
                <div class="control margin">@ViewBag.PesoBalanza</div>
            </div>
        </div>
        <br/>
        <div class="control-group">
            <div class="control-label">@Textos.DiferenciaDePeso_Diferencia</div>
            <div class="controls">
                <div class="control margin">@diferencia</div>
            </div>
        </div>
    </div>
    
    <br/>
    <br/>
    
    <div class="centered">
        <button type="button" class="btn btn-primary aceptar confirmar-boton" data-accion="Index" data-mensaje="@string.Format(Textos.ConfirmacionGenerica2,Textos.Aceptar,Textos.DiferenciaDePeso_Titulo)">@Textos.Aceptar</button>
        <button type="button" class="btn btn-primary repesar confirmar-boton" data-accion="Index" data-mensaje="@string.Format(Textos.ConfirmacionGenerica2,Textos.DiferenciaDePeso_Repesar,Textos.DiferenciaDePeso_Titulo)">@Textos.DiferenciaDePeso_Repesar</button>
    </div>
    
    <div class="modal hide fade" id="dialogo-confirmar">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4>@Textos.Confirmacion</h4>
        </div>
        <div class="modal-body" id="dialogo-confirmar-body">
        </div>
        <div class="modal-footer">
            <button id="dialogo-confirmar-confirmar" type="submit" class="btn " name="submitAction" value="">@Textos.Aceptar</button>
            <button id="dialogo-confirmar-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
        </div>
    </div>
}
