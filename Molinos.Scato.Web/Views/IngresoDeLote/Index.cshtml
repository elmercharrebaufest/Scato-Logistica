@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Web.Models.IngresoDeLoteModel

@{
    ViewBag.Title = Textos.ActIngresoDeLote;
    var tipoDoc = (TipoDocumentoIngreso)ViewBag.TipoDocumentoIngreso;
    var numDoc = (string)ViewBag.NumeroDocumentoIngreso;
    var patente = (string)ViewBag.Patente;
    var material = (string)ViewBag.Material;
    var almacenes = (IEnumerable<SelectListItem>)ViewBag.Almacenes;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Script("~/Scripts/ingresodelote.index.js")" type="text/javascript"></script>
}
    <div class="container-fluid">
        <div class="titSecciones">@Textos.ActIngresoDeLote</div>
    </div>
<br />
@using (Html.BeginForm("Index", "IngresoDeLote", FormMethod.Post, new { @class = "form-horizontal causaBlock", data_mensaje_espera = Textos.ActIngresoDeLote }))
{
    @Html.HiddenFor(m => m.InstanciaWorkflow)
    @Html.HiddenFor(m => m.WorkflowDefinicionId)
    @Html.HiddenFor(m => m.Material)
    @Html.HiddenFor(m => m.Centro)
    @Html.HiddenFor(m => m.Kgs)
    @Html.Hidden("ErrorLote", Textos.IngresarLote_ErrorLote)

    @Html.ValidationSummary(true)
    <div class="row" style="margin-left: 150px;">
        <table class="tablaDatos span12search" >
            <tr>
                <th>@Html.Label(Textos.TipoDocumentoIngreso + ":")</th>
                <th>@Html.Label(Textos.NumeroDocumentoIngreso + ":")</th>
                <th>@Html.Label(Textos.Camion_Patente + ":")</th>
                <th>@Html.Label(Textos.Material + ":")</th>
                <th>@Html.Label("Kgs:")</th>
            </tr>
            <tr>
                <td>@tipoDoc.DisplayEnum()</td>
                <td>@numDoc</td>
                <td>@patente</td>
                <td>@material</td>
                <td>@Html.DisplayFor(m => m.Kgs)</td>
            </tr>
        </table>
    </div>
    <div class="control-group">
        @Html.Label(Textos.Pesada_Almacen + ":", new { @class = "control-label" })
        <div class="controls">
            @Html.DropDownListFor(model => model.AlmacenId, almacenes, new { @class = "control input-medium" })
            @Html.ValidationMessageFor(model => model.AlmacenId)
        </div>
    </div>
    <div class="control-group">
        @Html.Label(Textos.IngresarLote_LoteNumero + ":", new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.NroLote, new { @class = "control input-medium loteObligatorio", maxlength = 10 })
            @Html.ValidationMessageFor(model => model.NroLote)
        </div>
    </div>@*
        <button type="submit" class="btn btn-primary lote-boton">@Textos.Aceptar</button>*@

    <div class="modal-footer">
        @Html.ActionLink(Textos.Aceptar, "Aceptar", "IngresoDeLote", null, new { @class = "lote-boton btn btn-primary causaBlock" })
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn btn-primary" })
    </div>
}

<div id="mensajeLote">

</div>