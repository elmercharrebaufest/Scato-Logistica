@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ExcepcionAlControlProveedorDto
@{
    var centros = (IEnumerable<SelectListItem>)ViewBag.Centros;
}

<div id ="links" 
     data-url-buscar-proveedores = "@Url.Action("BuscarProveedores", "Consultas")"
     data-url-buscar-proveedor-unico = "@Url.Action("BuscarProveedor", "Consultas")"
    
     data-url-buscar-material ="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales = "@Url.Action("BuscarMateriales", "Consultas")"
    
     data-url-buscar-cliente ="@Url.Action("BuscarCliente", "Consultas")"
     data-url-buscar-clientes = "@Url.Action("BuscarClientes", "Consultas")"
    
     data-url-buscar-centro ="@Url.Action("BuscarCentroUnico", "Consultas")"
     data-url-buscar-centros = "@Url.Action("BuscarCentros", "Consultas")"
    ></div>

@Html.ValidationSummary(true)
<div class="control-group">
    @Html.LabelFor(model => model.RazonSocial, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.RazonSocial, new { @class = "control input-medium" })
        @Html.ValidationMessageFor(model => model.RazonSocial)
        @Html.HiddenFor(model => model.ProveedorId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.MaterialDesc, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.MaterialDesc, new {@class = "control input-medium" })
        @Html.ValidationMessageFor(m => m.MaterialDesc)
        @Html.HiddenFor(model => model.MaterialId)
    </div>
</div>
<div class="control-group FechaDesde">
    @Html.LabelFor(model => model.FechaDesde, new { @class = "control-label" })
    <div class="controls">
        @Html.EditorFor(model => model.FechaDesde, Model != null ? Model.FechaDesde.FormattedFixed() : string.Empty)
        @Html.ValidationMessageFor(model => model.FechaDesde)
    </div>
</div>
<div class="control-group FechaHasta">
    @Html.LabelFor(model => model.FechaHasta, new { @class = "control-label" })
    <div class="controls">
        @Html.EditorFor(model => model.FechaHasta, Model != null ? Model.FechaHasta.FormattedFixed() : string.Empty)
        @Html.ValidationMessageFor(model => model.FechaHasta)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CentroNombre, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.CentroId, centros,Textos.Default_Centro)
        @Html.ValidationMessageFor(model => model.CentroId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.TipoDestinoNombre, new { @class = "control-label" })
    <div class="controls">
        @Html.EnumDropDownListFor(model => model.TipoDestino, new { @class = "", Id = "dropdownTipos" })
    </div>
</div>
<div class="control-group" id="Centro">
    @Html.LabelFor(model => model.Destino, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.DestinoNombre, new { @class = "control input-large", Id = "CentroDescripcion", data_error_requerido = string.Format(Textos.Error_Requerido, new object[] { Textos.Destino }) })
        @Html.ValidationMessageFor(model => model.DestinoNombre)
        @Html.HiddenFor(model => model.CentroDestinoId)
    </div>
</div>
<div class="control-group" id="Cliente">
    @Html.LabelFor(model => model.Destino, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.DestinoNombre, new { @class = "control input-large", id = "ClienteDescripcion", data_error_requerido = string.Format(Textos.Error_Requerido, new object[] { Textos.Destino }) })
        @Html.ValidationMessageFor(model => model.DestinoNombre)
        @Html.HiddenFor(model => model.ClienteDestinoId)
    </div>
</div>
