@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.AjusteDeStockDto

@{
    ViewBag.Title = Textos.AjusteDeStock_Crear;
    var tiposComprobante = (IEnumerable<SelectListItem>)ViewBag.TiposComprobante;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
<style>
    .field-validation-error {
        color: #ff0000;
    }
</style>
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script src="@Url.Script("~/Scripts/ajusteDeStock.index.js")" type="text/javascript"></script>
<div id ="links"    
     data-url-buscar-material ="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales = "@Url.Action("BuscarMateriales", "Consultas")"
    ></div>
@using (Html.BeginForm("Index", "AjusteDeStock", FormMethod.Post, new { @class = "form-horizontal", id = "orden-form", data_dialogo_titulo = Textos.AjusteDeStock_Crear }))
{
    @Html.ValidationSummary(true)

    <div id="mensajeInvalido" data-invalido="@Textos.Error_Invalido"/>
    <div style="padding-left: 20px">
        <div>
            @Html.LabelFor(model => model.Fecha, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBox("Fecha", Model.Fecha.Formatted(), new { @class = "date control input-small", data_date_format = Html.ClientDateFormat()})
                @Html.ValidationMessageFor(model => model.Fecha)
            </div>
        </div>
        <div>
            @Html.LabelFor(m => m.TipoComprobanteOnccaId, new {@class = "control-label"})
            <div class="controls">
                @Html.DropDownListFor(model => model.TipoComprobanteOnccaId, tiposComprobante)
                @Html.ValidationMessageFor(m => m.TipoComprobanteOnccaId)
            </div>
        </div>
        <div>
            @Html.LabelFor(model => model.NumeroDocumentoIngreso, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(model => model.NumeroDocumentoIngreso, new { @class = "control input-medium numero"})
                @Html.ValidationMessageFor(model => model.NumeroDocumentoIngreso)
            </div>
        </div>  
        <div>
            @Html.LabelFor(model => model.NumeroCTG, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(model => model.NumeroCTG, new { @class = "control input-medium numeroctg"})
                @Html.ValidationMessageFor(model => model.NumeroCTG)
            </div>
        </div>  
        <div>
            @Html.LabelFor(model => model.MaterialId, new {@class = "control-label"})
            <div class="controls">
                @Html.TextBoxFor(model => model.MaterialDesc, new {@class = "control input-large"})
                @Html.ValidationMessageFor(model => model.MaterialDesc)
                @Html.ValidationMessageFor(model => model.MaterialId)
                @Html.HiddenFor(model => model.MaterialId)
            </div>
        </div>
        <div>
            @Html.LabelFor(model => model.PesoBrutoIngreso, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(model => model.PesoBrutoIngreso, new { @class = "control input-small", id = "pesoBrutoIngreso"})
                @Html.ValidationMessageFor(model => model.PesoBrutoIngreso)
            </div>
        </div>    
        <div>
            @Html.LabelFor(model => model.PesoNetoIngreso, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(model => model.PesoNetoIngreso, new { @class = "control input-small", id = "pesoNetoIngreso"})
                @Html.ValidationMessageFor(model => model.PesoNetoIngreso)
            </div>
        </div>
        <div>
            @Html.LabelFor(model => model.PesoNetoEgreso, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(model => model.PesoNetoEgreso, new { @class = "control input-small", id = "pesoNetoEgreso"})
                @Html.ValidationMessageFor(model => model.PesoNetoEgreso)
            </div>
        </div>
        <div>
            @Html.LabelFor(model => model.Observaciones, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(model => model.Observaciones, new {@class = "control margin textarea-large"})
                @Html.ValidationMessageFor(model => model.Observaciones)
            </div>
        </div>
    </div>
}