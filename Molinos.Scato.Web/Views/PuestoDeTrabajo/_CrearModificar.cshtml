            </thead>
            <tbody data-bind="foreach: barrerasCierreSupervisor">
                <tr>
                    <td data-bind="text: Descripcion" />
                    <td><a href="#" data-bind="click: $root.removeCierreSupervisor"><i class="icon-trash"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.SensorQuiebre, new { @class = "control-label" })
