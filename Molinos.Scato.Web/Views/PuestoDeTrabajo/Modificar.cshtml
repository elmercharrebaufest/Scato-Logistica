@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.PuestoDeTrabajoDto
@{
    Layout = null;
    ViewBag.Title = Textos.PuestoDeTrabajo_Modificar;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/puestoDeTrabajo.js")" type="text/javascript"></script>
@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.PuestoDeTrabajo_Modificar }))
{
    @Html.HiddenFor(model => model.CentroId)
    @Html.HiddenFor(model => model.Automatico)
    @Html.Partial("_CrearModificar", Model)
}