@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.PuestoDeTrabajoDto
@{
    Layout = null;
    ViewBag.Title = Textos.PuestoDeTrabajo_Crear;
    Model.SinAfip = false;
    Model.SinCupo = false;
    Model.SinFotoCartaPorte = false;
    Model.ImprimeCartaPorte = false;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/puestoDeTrabajo.js")" type="text/javascript"></script>

@using (Ajax.BeginForm("Crear", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.PuestoDeTrabajo_Crear }))
{
    @Html.Partial("_CrearModificar", Model)
    <div class="control-group">
        @Html.LabelFor(model => model.Automatico, new { @class = "control-label" })
        <div class="controls">
            @Html.CheckBoxFor(m => m.Automatico)
            @Html.ValidationMessageFor(model => model.Automatico)
        </div>
    </div>
}