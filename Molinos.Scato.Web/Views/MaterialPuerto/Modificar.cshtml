@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.MaterialPuertoDto
@{
    Layout = null;
    ViewBag.Title = Textos.Modificar;
}

@Scripts.Render("~/bundles/jqueryval")

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Modificar }))
{
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)
}