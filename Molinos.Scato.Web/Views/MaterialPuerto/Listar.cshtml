@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<MaterialPuertoDto>) ViewBag.Items;
}

    @Html.Grilla(items,
        grilla => grilla.Columns(
        grilla.ColumnaEliminarModificar(Html, "MaterialPuerto"),
        grilla.Columna("Descripcion", Textos.Descripcion),
        grilla.Columna("AlmacenDesc", Textos.Almacen),
        grilla.Columna("CodigoSAP", Textos.CodigoSap)
        ))
