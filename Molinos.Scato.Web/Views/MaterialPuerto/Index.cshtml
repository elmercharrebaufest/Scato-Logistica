@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = Textos.OperacionesPuerto_Bodega_Titulo;
}

@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/accordion.icon.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/scripts/jquery.maskedinput.js"></script>
    <script type="text/javascript" src="~/scripts/autocompletar.js"></script>
}

<div class="container-fluid">
    <div class="titSecciones">@Textos.OperacionesPuerto_MaterialPuerto</div>
</div>
<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
                @Html.Label(Textos.Filtrar)
                <input type="text" name="filtro" class="input-large" />
                <button type="submit" class="btn">@Textos.Filtrar</button>
            }

        </div>            @Html.ActionLink(Textos.Crear, "Crear", "MaterialPuerto", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })

    </div>

    <div id="gridContainer">
        @Html.Partial("Listar")
    </div>
</div>