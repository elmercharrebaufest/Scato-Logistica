@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    Layout = null;
    var items = (ListaPaginada<MaterialPorWorkflowDto>)ViewBag.Items;
}

@Html.Grilla(items,
            grid => grid.Columns(
            grid.ColumnaEliminarModificar(this.Html, "MaterialPorWorkflow"),
            grid.Columna("Material.Descripcion",  Textos.Material, x => x.MaterialDesc),
            grid.Columna("Workflow.Descripcion", Textos.Workflow, x => x.WorkflowDesc)))
