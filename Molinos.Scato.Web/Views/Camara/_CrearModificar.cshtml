@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.CamaraDto
@Html.ValidationSummary(true)
<div class="control-group">
    @Html.LabelFor(model => model.DescripcionCorta, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.DescripcionCorta, new {@class = "input-xlarge"})
        @Html.ValidationMessageFor(model => model.DescripcionCorta)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Descripcion, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.Descripcion, new {@class = "input-xlarge"})
        @Html.ValidationMessageFor(model => model.Descripcion)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CodigoSAP, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.CodigoSAP, new {@class = "input-xlarge"})
        @Html.ValidationMessageFor(model => model.CodigoSAP)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.FormatoDeArchivo, new { @class = "control-label" })
    <div class="controls">
        @Html.EnumDropDownListFor(model => model.FormatoDeArchivo, new {@class = "input-xlarge"})
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.Email, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(m => m.Email, new {@class = "control input-xlarge" })
        @Html.ValidationMessageFor(m => m.Email)
    </div>
</div>

