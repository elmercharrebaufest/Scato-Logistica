@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<CamaraDto>) ViewBag.Items;
}

@Html.Grilla(items,
    grilla => grilla.Columns(
    grilla.ColumnaEliminarModificar(Html, "Camara"),
    grilla.Columna("DescripcionCorta", Textos.DescripcionCorta),
    grilla.Columna("Descripcion", Textos.Camara_Descripcion),
    grilla.Columna("CodigoSAP", Textos.Camara_CodigoSAP)
    ))
