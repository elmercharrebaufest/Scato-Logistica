@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = Textos.Casillero_Titulo;
}

<div class ="container-fluid">
    <div class="titSecciones">@Textos.Administracion_Casilleros</div>
</div>

<div class="container-fluid content grillaPad">
    <div class="row">

            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
               
            }
             @Html.ActionLink(Textos.Casillero_Nuevo, "Crear", "Casillero", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })
             @Html.ActionLink(Textos.Casillero_ModificarMasivo, "ModificarMasivo", "Casillero", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })
             @Html.ActionLink(Textos.Casillero_EliminarMasivo, "EliminarMasivo", "Casillero", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })

    </div>
    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
        @Html.Partial("Listar")
    </div>
</div>