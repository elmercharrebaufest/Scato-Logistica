@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Web.Models.CasilleroModel
@{
    Layout = null;
    ViewBag.Title = Textos.Casillero_Crear;
}
@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/casilleroCrear.js")"></script>

@using (Ajax.BeginForm("Crear", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Casillero_Crear }))
{
    <div class="control-group">
        @Html.LabelFor(model => model.Masivo, new {@class = "control-label"})
        <div class="controls">
            @Html.CheckBoxFor(model => model.Masivo, new {@class = "crearMasivo"})
            @Html.ValidationMessageFor(model => model.Masivo)
        </div>
    </div>
    @Html.Partial("_CrearModificarEliminar", Model)
}