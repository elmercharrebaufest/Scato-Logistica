@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<CasilleroDto>) ViewBag.Items;
}

@Html.Grilla(items,
    grilla => grilla.Columns(
    grilla.ColumnaEliminarModificar(Html, "Casillero"),
    grilla.Columna("Numero", Textos.Casillero),
    grilla.Columna("Capacidad", Textos.Casillero_Capacidad)
    ))
