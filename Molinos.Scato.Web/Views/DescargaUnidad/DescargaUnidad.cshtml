@using System.Globalization
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.DescargaUnidadDto
@{
    Layout = null;
    var itemsvalidos = Model != null && Model.DescargaUnidadItems != null ? Model.DescargaUnidadItems.Where(x => !x.Rechazado) : null;
    var brutoAcum = itemsvalidos != null ? itemsvalidos.Sum(s => s.PesoBruto) : null;
    var taraAcum = itemsvalidos != null ? itemsvalidos.Sum(s => s.PesoTara) : null;
    var netoAcum = itemsvalidos != null ? itemsvalidos.Sum(s => s.PesoNeto) : null;    
}
<script src="@Url.Script("~/Scripts/descargaUnidad.descargaUnidad.js")" type="text/javascript"></script>
<style>
    .field-validation-error {
        color: #b94a48;
        font-size: 10px;
    }
    .validation-summary-errors {
        color: #ff0000;
        max-width: 900px;
    }
    .tablaDatos{width:100%;}
</style>
<div class ="container-fluid" id="romaneoContainer" data-index-url="@Url.Action("CargarDescargaUnidad","DescargaUnidad", new{ Model.NroDescarga})">
    <div class="container-fluid content grillaPad">
        @Html.ValidationSummary(true)
        @Html.Hidden("RomaneoDescargar_ProximoItem", Textos.RomaneoDescargar_ProximoItem)
        @Html.Hidden("Aceptar", Textos.Aceptar)
        @Html.Hidden("EstadoFinalizado", EstadoDescargaUnidad.Finalizado)

        <div class="row-fluid">
            <table class="tablaDatos">
                <thead>
                    <tr>
                        <th>@Html.Label(Textos.NroDescarga, new { @class = "control-label" })</th>
                        <th>@Html.Label(Textos.OrdenDeDescarga, new { @class = "control-label" })</th>
                        <th>@Html.LabelFor(model => model.NroPedido, new { @class = "control-label" })</th>
                        <th>@Html.Label(Textos.Camion_Patente, new { @class = "control-label" })</th>
                        <th>@Html.Label(Textos.Romaneo_FechaIngreso, new { @class = "control-label" })</th>
                        <th>@Html.Label(Textos.Proveedor, new { @class = "control-label" })</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b><label id="lblNumero">@(Model != null && Model.NroDescarga > 0 ? Model.NroDescarga.ToString(CultureInfo.InvariantCulture) : "--")</label></b></td>
                        <td><b>@ViewBag.NumeroOrdenDeDescarga</b></td>
                        <td><b>@Html.TextBoxFor(model => model.NroPedido, new { @class = "input-medium" ,id = "numeroPedidoSap", maxlength = 10, data_cargar_pedido_url = Url.Action("CargarPedido","DescargaUnidad"), data_buscando_pedido = Textos.ActDescargaPorUnidad })</b></td>
                        <td><b>@ViewBag.Patente</b></td>
                        <td><b>@ViewBag.FechaIngreso</b></td>
                        <td><b id ="ProveedorDescripcion" class ="label" data-warning ="@Textos.Romaneo_DiscrepanciaProveedor">@Html.DisplayFor(m => m.ProveedorDescripcion)</b></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        @* ReSharper disable Mvc.ActionNotResolved *@
        @using (Html.BeginForm("Action", "DescargaUnidad", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActDescargaPorUnidad }))
        {
        @* ReSharper restore Mvc.ActionNotResolved *@
            @Html.HiddenFor(model => model.WorkflowInstanceId)
            @Html.HiddenFor(model => model.NroDescarga)
            <div class="row-fluid">
                <div class="span6">
                    <h5>Items Descargados</h5>
                </div>
                <div style="text-align: right" class="span6 pull-right">
                    <button class="btn btn-warning confirmar-boton" type="submit" id="btnRechazar" data-accion="RechazarItem" data-mensaje="@Textos.DescargaUnidad_ConfirmacionRechazarItems">@Textos.DescargaUnidades_RechazarItem</button>
                    @if (Model.NroDescarga > 0 && Model.Estado != EstadoDescargaUnidad.Finalizado)
                    {
                    @Html.ActionLink(Textos.DescargaUnidades_DescargarItems, "DescargarItem", "DescargaUnidad", new {Model.NroDescarga}, new {id = "descargarBoton", @class = "btn btn-primary ajax-editar-link"})
                    }
                    else
                    {
                        <button class="btn btn-primary" disabled="disabled">@Textos.DescargaUnidades_DescargarItems</button>
                    }                
                </div>
            </div>
            @Html.Partial("ListarItems", Model)

        <div class="row-fluid">
            <div class="span12search bordeGris form-horizontal"  style="border-bottom-style: solid; margin-bottom: 15px;">@Textos.Romaneo_PesoAcumulado
                <div class="row-carta-porte">
                    <div class="span3">
                        <label class="control-label xsmall">@Textos.Bruto: </label>
                        <div class="controls-xsmall control-text">
                            @brutoAcum &nbsp;
                        </div>
                    </div>
                    <div class="span3">
                        <label class="control-label xsmall">@Textos.Tara: </label>
                        <div class="controls-xsmall control-text">
                            @taraAcum &nbsp;
                        </div>
                    </div>
                    <div class="span3">
                        <label class="control-label xsmall">@Textos.Neto: </label>
                        <div class="controls-xsmall control-text">
                            @netoAcum &nbsp;
                        </div>
                    </div>
                </div>
            </div>
        </div>
            <div class="row">
                <div class="span6">
                    <div class="control-group">
                        @Html.LabelFor(model => model.Observaciones, new { @class = "control-label" })
                        <div class="controls">
                            @Html.TextAreaFor(model => model.Observaciones, new { @class = "input-large" })
                        </div>
                    </div>
                </div>
                <div class="span6">
                    <div class="control-group">
                        <label class="control-label">@Textos.Romaneo_Estado:</label>
                        <div class="controls control-text">
                            @Html.EnumDisplayTextFor(model => model.Estado).ToString().ToUpper()
                            @Html.HiddenFor(m => m.Estado)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="span3 pull-left">
                    <button class="btn btn-primary confirmar-boton" type="submit" id="btnTerminar" data-accion="TerminarDescarga" data-mensaje="@Textos.DescargaUnidad_Confirmacion">@Textos.TerminarDescargaUnidad</button>
                </div>
                <div class="span3 pull-left">
                    <button class="btn btn-primary confirmar-boton" type="submit" id="btnTerminarVehiculo" data-accion="TerminarVehiculo" data-mensaje="@String.Format(Textos.ConfirmacionGenerica,Textos.Terminar,Textos.Vehiculo)">@Textos.Romaneo_TerminarVehiculo</button>
                </div>
                <div class="span6 pull-right" style="text-align:right">
                     @Html.ActionLink(Textos.Aceptar, "Aceptar", "DescargaUnidad", null, new {@class = "btn"})
                </div>
            </div>
            <div class="modal hide fade" id="dialogo-confirmar">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4>@Textos.Confirmacion</h4>
                </div>
                <div class="modal-body" id="dialogo-confirmar-body">
                </div>
                <div class="modal-footer">
                    <button id="dialogo-confirmar-confirmar" type="submit" class="btn " name="submitAction" value="">@Textos.Aceptar</button>
                    <button id="dialogo-confirmar-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
                </div>
            </div>
        }
    </div>
</div>


