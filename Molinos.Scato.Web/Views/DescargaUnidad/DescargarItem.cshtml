@using System.Web.Script.Serialization
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.DescargaUnidadItemDto
@{
    ViewBag.Title = Textos.DescargaUnidadDescargar_Titulo;
    Layout = null;
    var taras = (IEnumerable<SelectListItem>)ViewBag.TaraRomaneos;
    var pesosTara = (List<string>)ViewBag.TaraRomaneosPesos;
}

@Scripts.Render("~/bundles/jqueryval")
<script src="@Url.Script("~/Scripts/descargarItemEnUnidades.js")" type="text/javascript"></script>
<script>
    var pesosTaraRomaneos = @Html.Raw(new JavaScriptSerializer().Serialize(pesosTara));
    $("#taraRomaneoDropDown").change(DefinirPesoTara);
    DefinirPesoTara();

    function DefinirPesoTara() {
        var id = $("#taraRomaneoDropDown").val();
        $.each(pesosTaraRomaneos, function (indice, valor) {
            var datos = valor.split(',');
            if (id == datos[0]) {
                if (datos[1] == "True") {
                    $('#PesoTara').removeAttr('readonly');
                    $('#PesoTara').val(parseInt(datos[2]));
                    ActualizarPesos();
                } else {
                    $('#PesoTara').attr('readonly', 'readonly');
                    $('#PesoTara').val(parseInt(datos[2]));
                    ActualizarPesos();
                    ValidarObjeto($("#descargar-form"), $("#PesoTara"));
                }
                return;
            }
        });
    }
</script>
@using (Ajax.BeginForm("DescargarItem", null, new AjaxOptions() { OnComplete = "$.unblockUI()" }, new { id = "descargar-form", @class = "form-horizontal causaBlock", data_dialogo_titulo = Textos.DescargaUnidadDescargar_Titulo, data_mensaje_espera = Textos.Romaneo_Descarga }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(m => m.ItemNro)
    @Html.HiddenFor(m => m.DescargaUnidadId)
    @Html.Hidden("proximoItem", false)
    @Html.Hidden("centroId", (int)ViewBag.CentroId)
    <div class="row-fluid">
        <table class="tablaDatos span12">
            <tr>
                <th>@Html.Label(Textos.NroDescarga)</th>
                <th>@Html.Label(Textos.Romaneo_ItemNro)</th>
                <th>@Html.Label(Textos.Romaneo_RemitoNro)</th>
                <th>@Html.Label(Textos.RomaneoDescargar_FechaRemito)</th>
                
            </tr>
            <tr>
                <td>@Html.DisplayFor(m => m.DescargaUnidadId)</td>
                <td>@Html.DisplayFor(m => m.ItemNro)</td>
                <td>@Html.TextBoxFor(m => m.RemitoNro, new { @class = "input-medium", id="remitoNro", tabindex = 1})@Html.ValidationMessageFor(m => m.RemitoNro)</td>
                <td class="FechaFabricacion">@Html.TextBoxFor(m => m.FechaRemito, new{@class = "input-medium", tabindex = 1})@Html.ValidationMessageFor(m => m.FechaRemito)</td>
            </tr>
        </table>
    </div>
    <div class="row">
         <div class="span12 bordeGris"  style="border-bottom-style: solid">
             <br/>
             <div class="span12 row-carta-porte">
                 <div class="span6" style="margin-left: 0">
                     <div class="control-group">
                         @Html.Label(Textos.Material, new { @class = "control-label" })
                         <div class="controls">
                             @Html.DropDownListFor(m => m.MaterialId, (IEnumerable<SelectListItem>)ViewBag.Materiales, new { @class = "control", data_peso_url = Url.Action("ObtenerPeso"), tabIndex= 1 })
                             @Html.ValidationMessageFor(m => m.MaterialId)
                         </div>
                     </div>
                     <div class="control-group">
                         @Html.Label(Textos.RomaneoDescargar_LoteNro, new { @class = "control-label" })
                         <div class="controls">
                             @Html.TextBoxFor(m => m.LoteProveedor, new { @class = "control input-large", tabIndex= 3 })
                             @Html.ValidationMessageFor(m => m.LoteProveedor)
                         </div>
                     </div>
                 </div>
                 <div class="span6" style="margin-left: 0">
                     <div class="control-group">
                         @Html.Label(Textos.Almacen, new { @class = "control-label" })
                         <div class="controls">
                             @Html.DropDownListFor(m => m.AlmacenId, (IEnumerable<SelectListItem>)ViewBag.Almacenes, new { @class = "control" , tabIndex= 2 })
                             @Html.ValidationMessageFor(m => m.AlmacenId)
                         </div>
                     </div>
                     <div class="control-group FechaFabricacion">
                         @Html.Label(Textos.RomaneoDescargar_FechaFabricacion, new { @class = "control-label" })
                         <div class="controls">
                             @Html.TextBoxFor(m => m.FechaFabricacion, new {@class = "control input-large", tabIndex = 4, style = "width: 75px" })
                         </div>
                     </div>
                 </div>
             </div>
        </div>
    </div>
    <br/>
    <div class="row-fluid">
        <div class="span12 bordeGris"  style="border-bottom-style: solid">@Textos.Descargar_PesoEnPlanta
            <div class="span12 row-carta-porte">
                    <div class="span4" id="balanza" style="float:left;">
                        <label class="control-label ysmall">@Textos.DescargaUnidad_Unidades:</label>
                        @Html.TextBoxFor(model => model.Unidades, new { @class = "control input-medium ", tabindex = 6})
                        @Html.ValidationMessageFor(model => model.Unidades)
                    </div>
                    <div class="span3">
                        <label class="control-label ysmall">@Textos.Tara:</label>
                        <div class="controls-xsmall" style="display: inline-block;">
                            @Html.DropDownListFor(model => model.TaraRomaneoId, taras, new { @class = "control input-small", @id = "taraRomaneoDropDown" ,tabIndex = 7})
                            @Html.ValidationMessageFor(m => m.TaraRomaneoId)
                        </div>
                    </div>
                    <div class="span2">
                        <label class="control-label">@Textos.Fecha: @Model.Fecha.Formatted()</label>
                    </div>
                    <div class="span2">
                        <label class="control-label">@Textos.Hora: @Model.Fecha.ToShortTimeString()</label>
                    </div>

            </div>
            <div class="span12 row-carta-porte">
                <div class="span4">
                    <label class="control-label ysmall">@Textos.PesoBruto:</label>
                    <div class="controls-xsmall" style="display:inline-block;">
                        @Html.TextBoxFor(m => m.PesoBruto, new { @class = "control input-small campoNumerico", @readonly = "readonly" ,tabIndex = 8 })
                        @Html.ValidationMessageFor(m => m.PesoBruto)
                    </div>
                </div>
                <div class="span4">
                    <label class="control-label ysmall">@Textos.PesoTara:</label>
                    <div class="controls-xsmall" style="display:inline-block;">
                        @Html.TextBoxFor(m => m.PesoTara, new { @class = "control input-small campoNumerico",tabIndex = 8 })
                        @Html.ValidationMessageFor(m => m.PesoTara)
                    </div>
                </div>
                <div class="span3">
                    <label class="control-label ysmall">@Textos.PesoNeto:</label>
                    <div class="controls-xsmall" style="display:inline-block;">
                        @Html.TextBoxFor(m => m.PesoNeto, new { @class = "control input-small campoNumerico", @readonly = "readonly" ,tabIndex = 8})
                        @Html.ValidationMessageFor(m => m.PesoNeto)
                    </div>
                </div>
                @Html.Hidden("PesoMaterial")
            </div>
        </div>
    </div>
}
