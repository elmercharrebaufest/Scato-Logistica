@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    ViewBag.Title = Textos.Balanza_Titulo;
}
<script src="@Url.Script("~/Scripts/balanza.index.js")" type="text/javascript"></script>

<div class ="container-fluid">
    <div class="titSecciones">@Textos.Administracion_Balanzas</div>
</div>

<div class="container-fluid content  grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
                @Html.Label(Textos.Filtrar)
                <input type="text" name="filtro" class="input-large"/>
                <button type="submit" class="btn">@Textos.Filtrar</button>                    
            }          
        </div>
        @Html.ActionLink(@Textos.Balanza_Nuevo, "Crear", "Balanza", null, new {@class = "btn btn-primary ajax-editar-link pull-right"})
    </div>

    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
        @Html.Partial("Listar")
    </div>

</div>
@Html.Hidden("BalanzaId")
@Html.Hidden("Intervalo")
<div id="cerear" data-cerear-balanza-url ="@Url.Action("CerearBalanza", "Balanza")">
    <div class="modal fade hide" id="dialogo-Cerear">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h5>@Textos.DialogoCerear_Titulo</h5>
    </div>
    <div class="modal-body" id="dialogo-cerear-body">
        <h5>@Textos.ConfirmacionCerearBalanza</h5>
    </div>
    <div class="modal-footer">
        <button id="dialogo-cerear-cerear" class="btn">@Textos.CerearBalanza</button>
        <button id="dialogo-cerear-cancelar" data-dismiss="modal" class="btn btn-warning">@Textos.Cancelar</button>
    </div>
</div>
</div>