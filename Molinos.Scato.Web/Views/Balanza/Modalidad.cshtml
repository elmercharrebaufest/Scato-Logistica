@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.BalanzaModificacionModalidadDto
@{
    ViewBag.Title = Textos.Balanza_CambiarModalidad;
    Layout = null;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="@Url.Script("~/Scripts/modalidad.js")" type="text/javascript"></script>

@using (Ajax.BeginForm("Modalidad", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Balanza_CambiarModalidad }))
{
    @Html.HiddenFor(model => model.BalanzaId)
    @Html.ValidationSummary(true)
    <div class="control-group">
        @Html.LabelFor(m => m.BalanzaNombre, new {@class = "control-label"})
        <div class="controls">
            @Html.DisplayFor(m => m.BalanzaNombre, new {@class = "control-label"})
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.Modalidad, new {@class = "control-label"})
        <div class="controls">
            @Html.EnumDropDownListFor(model => model.Modalidad)
            @Html.ValidationMessageFor(m => m.Modalidad)
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.Motivo, new {@class = "control-label"})
        <div class="controls">
            @Html.TextAreaFor(m => m.Motivo,new { id = "motivo", maxlength = "255" })
            @Html.ValidationMessageFor(m => m.Motivo)
        </div>       
    </div>
    <div class="control-group">
        <span id="contador">255</span><span> caracteres restantes.</span>
    </div>
}
