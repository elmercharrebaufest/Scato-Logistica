        @Html.ValidationMessageFor(model => model.CodigoSap)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Activo, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(model => model.Activo)
     </div>
</div>
