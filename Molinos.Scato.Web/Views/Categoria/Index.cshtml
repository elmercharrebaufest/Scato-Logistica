@*@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}*@

@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = Textos.Categoria_Titulo;
}

<div class ="container-fluid">
    <div class="titSecciones">@Textos.Administracion_Categoria</div>
</div>


<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris" style="width:auto">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search" }))
            {
                @Html.Label(Textos.Filtrar_Categoria)            
                <input type="text" name="filtro" class="input-large" />
                <button type="submit" class="btn">@Textos.Filtrar</button>                
            }
            
        </div>
        @Html.ActionLink(Textos.Categoria_Nuevo, "Crear", "Categoria", null, new { @class = "ajax-editar-link btn btn-primary pull-right" })
    </div>
    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
        @Html.Partial("Listar")
    </div>
</div>

