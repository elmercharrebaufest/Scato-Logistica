@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Seguridad
@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Web.Seguridad
@model Molinos.Scato.Dominio.Dto.FiltroPanelDeTransaccionesSapDto
@{
    ViewBag.Title = Textos.PanelDeControlTransSAP;
}

@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script src="@Url.Script("~/Scripts/accordion.icon.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/panelDeTransaccionesSap.index.js")"></script>

<div class="container-fluid">
    <div class="titSecciones">@Textos.Menu_Administracion - @Model.TipoDeServicio.DisplayEnum()</div>
</div>

<div class="container-fluid content grillaPad">
    @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "transmisiones-form", @class = "form-search", data_mensaje_espera = Textos.PanelDeControlTransSAP }))
    {
        @Html.HiddenFor(model => model.TipoDeServicio)
        <div class="accordion row-fluid">
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseOne">
                        <i class="icon-chevron-down"></i>
                        @Textos.Busqueda
                    </a>

                </div>
                <div id="collapseOne" class="accordion-body in collapse">
                    <div class="accordion-inner" style="margin-right: -73px;">
                        @Html.ValidationSummary(true)
                        <div class="row-fluid">

                            <div class="span1">
                                @Html.LabelFor(model => model.EstadoTransmisionASap, new { @class = "control-label" })
                            </div>
                            <div class="span2">
                                @Html.EnumDropDownListFor(model => model.EstadoTransmisionASap, Textos.Default_Transmision)
                            </div>

                            <div class="span2" style="margin-left:99px;">
                                @Html.LabelFor(model => model.Patente, new { @class = "control-label" })
                            </div>

                            <div class="span3 sinBorde" style="margin-left:-31px">
                                @Html.TextBoxFor(model => model.Patente, new { @class = "input-large sinMargen" })
                            </div>

                            <div class="span2 FechaHasta" style="margin-left:-50px;">
                                @Html.LabelFor(model => model.FechaDesde, new { @class = "control-label" })
                            </div>
                            <div class="span3 sinBorde" style="margin-left:-20px;">
                                @Html.EditorFor(model => model.FechaDesde, Model != null ? Model.FechaDesde.FormattedFixed() : string.Empty)
                                @Html.TextBoxFor(model => model.HoraDesde, new { @class = "input-xsmall formatoHora width30" })
                                @Html.ValidationMessageFor(model => model.FechaDesde)
                            </div>
                        </div>
                        <div class="row-fluid">

                            <div class="span1">
                                @Html.LabelFor(model => model.TipoDocumentoIngreso, new { @class = "control-label" })
                            </div>
                            <div class="span2">
                                @Html.EnumDropDownListFor(model => model.TipoDocumentoIngreso, Textos.Default_Documento)
                            </div>
                            <div class="span2" style="margin-left:99px;">
                                @Html.LabelFor(model => model.NumeroDocumentoIngreso, new { @class = "control-label" })
                            </div>

                            <div class="span3 sinBorde" style="margin-left:-31px">
                                @Html.TextBoxFor(model => model.NumeroDocumentoIngreso, new { @class = "input-large sinMargen" })
                            </div>

                            <div class="span2 FechaDesde" style="margin-left:-50px;">
                                @Html.LabelFor(model => model.FechaHasta, new { @class = "control-label" })
                            </div>

                            <div class="span3 sinBorde" style="margin-left:-20px;">
                                @Html.EditorFor(model => model.FechaHasta, Model != null ? Model.FechaHasta.FormattedFixed() : string.Empty)
                                @Html.TextBoxFor(model => model.HoraHasta, new { @class = "input-xsmall formatoHora width30" })
                                @Html.ValidationMessageFor(model => model.FechaHasta)
                            </div>
                        </div>
                        <div class="row-fluid">

                            <div class="span12 cajaButtons2" style="margin-left: -108px">
                                <button id="btnBuscar" type="submit" class="btn">@Textos.Buscar</button>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("transmisiones")
    }

    <div id="gridContainer" style="clear:both;" data-grid-url="@Url.Action("Index", "PanelDeControlTransaccionesSap")">
        @Html.Partial("Listar")
    </div>

    <div class="row-fluid">
        <div class="span2">
            <input id="btnTransmitir" type="button" data-url="@Url.Action("Transmitir")" value="@Textos.PanelDeControlTransSAP_Transmitir" class="btn acciones" />
        </div>
        <div class="span2">
            <input id="btnNoTransmitir" type="button" data-url="@Url.Action("NoTransmitir")" value="@Textos.PanelDeControlTransSAP_NoTransmitir" class="btn acciones" />
        </div>
        <div class="span4 acciones">
            <div id="cantidad" class="checkbox"></div> @Textos.PanelDeControlTransSAP_ElementosSeleccionados
        </div>
        @if (Model.TipoDeServicio == TipoDeServicio.Cupo && PermisosHelper.Is(PermisosScato.PanelDeControlTransaccionesSapCupo))
        {
            <div class="span2">
                <input id="btnRetransmitirTodas" type="button" data-url="@Url.Action("RetransmitirTodas")" data-mensaje="@Textos.Retransmitiendo" value="@Textos.PanelDeControlTransSAP_RetransmitirTodas" class="btn acciones" />
            </div>
        }
        <div class="span2">
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn pull-right acciones" })
        </div>
    </div>
</div>
