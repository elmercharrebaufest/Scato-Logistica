@model Molinos.Scato.Dominio.Dto.FiltroExcepcionPagoTasaMunicipal
@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = "Borrar excepción";
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title-editar">Borrar excepción</h4>    
</div>

<div class="modal-body">
    @using (
        Ajax.BeginForm(
            "Borrar", 
            "ExcepcionPagoTicketMunicipal", 
            new AjaxOptions
            {
                HttpMethod = "POST",
                InsertionMode = InsertionMode.Replace,
                UpdateTargetId = "gridContainer",
                OnSuccess = "onFormBorrarSuccess",
                OnFailure = "onFormError"
            }, 
            new { id = "formModalBorrar" }))
    {
        <div class="container-fluid">
            <div class="row-fluid">
                <h4>@Textos.ConfirmacionBorrado</h4>
                @Html.ValidationSummary(true)
                @Html.Hidden("idBorrar", "")
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            <button type="submit" class="btn btn-primary">Borrar</button>
        </div>
    }
</div>
