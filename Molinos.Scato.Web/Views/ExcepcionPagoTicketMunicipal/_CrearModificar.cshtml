@model Molinos.Scato.Dominio.Dto.FiltroExcepcionPagoTasaMunicipal
@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = "Editar excepción";
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title-editar">Editar excepción</h4>
</div>

<div class="modal-body">
    @using (
        Ajax.BeginForm(
            "Modificar",
            "ExcepcionPagoTicketMunicipal",
            new AjaxOptions
            {
                HttpMethod = "POST",
                InsertionMode = InsertionMode.Replace,
                UpdateTargetId = "gridContainer",
                OnSuccess = "onFormEditarSuccess",
                OnFailure = "onFormError"
            }, new { id = "formModal" }))
    {
        <div class="container-fluid">
            <div class="row-fluid">

                <div class="span6">
                    <div class="control-group control-group-puesto-comando">
                        @Html.LabelFor(model => model.FiltroEditar.PatenteActual, new { @class = "wsmall" })
                        <div class="controls">
                            @Html.TextBoxFor(
                                model => model.FiltroEditar.PatenteActual,
                                new
                                {
                                    @class = "",
                                    oninput = "this.value = this.value.toUpperCase()",
                                    style = "text-transform: uppercase;"
                                })
                            
                            @if (!ViewData.ModelState.IsValid)
                            {
                                @Html.ValidationMessageFor(model => model.FiltroEditar.PatenteActual, "")
                            }
                        </div>
                    </div>
                </div>
                @Html.ValidationSummary(true)
                @Html.HiddenFor(model => model.FiltroEditar.Id)
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    }
</div>
