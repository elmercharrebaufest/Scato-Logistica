@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.UsuarioDto
@{
    Layout = null;
    ViewBag.Title = Textos.Usuario_Crear;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/usuario.CrearModificar.js")"></script>

@using (Ajax.BeginForm("Crear", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Usuario_Crear }))
{
    @Html.Hidden("Id", 0, new {id = "Id"})
    @Html.Partial("_CrearModificar", Model)
}