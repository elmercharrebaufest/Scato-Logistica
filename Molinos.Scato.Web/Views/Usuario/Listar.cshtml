@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<UsuarioDto>)ViewBag.Items;
}

<script src="@Url.Script("~/Scripts/material.listarMateriales.js")" type="text/javascript"></script>
<style>
    .tip {
        max-width: 500px;
        white-space: normal;
    }
</style>

@Html.Grilla(items,
             grid => grid.Columns(
                grid.ColumnaEliminarCopiarModificar(Html, "Usuario"),
                grid.Columna("Nombre", Textos.Chofer_Nombre),
                grid.Columna("Apellido", Textos.Chofer_Apellido),
                grid.Columna("NombreUsuario", Textos.Usuario_NombreUsuario),
                grid.Column(header: Textos.Rol_Titulo, format: ((item) =>
                    {
                        IEnumerable<RolDto> rolesDto = (IList<RolDto>)item.RolesAsociados;
                        return Html.Raw("<div class = 'ellipsis-overflow mostrar-lista'>" + Html.DisplayFor(m => rolesDto).ToHtmlString()
                                        + "<span class = 'tip'>" + Html.DisplayFor(m => rolesDto).ToHtmlString() + "</span>" + "</div>");
                    })),
                grid.Column(header: Textos.Centro_Titulo, format: ((item) =>
                    {
                        IEnumerable<CentroDto> centrosDto = (IList<CentroDto>)item.CentrosAsociados;
                        return Html.Raw("<div class = 'ellipsis-overflow mostrar-lista'>" + Html.DisplayFor(m => centrosDto).ToHtmlString()
                                        + "<span class = 'tip'>" + Html.DisplayFor(m => centrosDto).ToHtmlString() + "</span>" + "</div>");
                    }))
                ))