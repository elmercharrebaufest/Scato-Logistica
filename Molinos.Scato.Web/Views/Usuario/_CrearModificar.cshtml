@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.UsuarioDto

<style>

    div.modal {
        width: 600px
    }
    /*div.modal .control-group {display: inline-block !important}*/
    .form-horizontal .control-label {
        padding-top: 0
    }
</style>

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@Html.Hidden("roles", "", new { id = "rolesFinales" })
@Html.Hidden("centros", "", new { id = "centrosFinales" })


@if (Model != null && Model.Id != 0)
{
    @Html.HiddenFor(m => m.Nombre)
    @Html.HiddenFor(m => m.Apellido)
    @Html.HiddenFor(m => m.NombreUsuario)
    @Html.HiddenFor(m => m.Email)
    @Html.HiddenFor(m => m.Matricula)

    @Html.HiddenFor(model => model.AvisoQuiebreApertura)
    @Html.HiddenFor(model => model.AvisoQuiebreCierre)
    @Html.HiddenFor(model => model.ReasignacionDeTarjeta)
    @Html.HiddenFor(model => model.AvisoAutorizarTiempoEnTransito)
    @Html.HiddenFor(model => model.AvisoAutorizarTiempoEnTransitoConfirmado)
    @Html.HiddenFor(model => model.AvisoAutorizarTiempoEnTransitoRechazado)
    @Html.HiddenFor(model => model.AvisoContingencia)
    @Html.HiddenFor(model => model.AvisoEntregaHexano)
    @Html.HiddenFor(model => model.AvisoLineUp)
    @Html.HiddenFor(model => model.AvisoCambioPinchazosPorCalada)


}

<div class="control-group">
    @Html.LabelFor(m => m.Nombre, new { @class = "control-label" })
    <div class="controls">
        @(Model != null && Model.Id != 0 ?
                                                            Html.DisplayFor(m => m.Nombre, new { @class = "input-large" }) :
                                                            Html.TextBoxFor(m => m.Nombre, new { @class = "input-large" }))
        @Html.ValidationMessageFor(m => m.Nombre)
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(m => m.Apellido, new { @class = "control-label" })
    <div class="controls">
        @(Model != null && Model.Id != 0 ?
                                                            Html.DisplayFor(m => m.Apellido, new { @class = "input-large" }) :
                                                            Html.TextBoxFor(m => m.Apellido, new { @class = "input-large" }))
        @Html.ValidationMessageFor(m => m.Apellido)
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(m => m.NombreUsuario, new { @class = "control-label" })
    <div class="controls">
        @(Model != null && Model.Id != 0 ?
                                                            Html.DisplayFor(m => m.NombreUsuario, new { @class = "input-large" }) :
                                                            Html.TextBoxFor(m => m.NombreUsuario, new { @class = "input-large" }))
        @Html.ValidationMessageFor(m => m.NombreUsuario)
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(m => m.Email, new { @class = "control-label" })
    <div class="controls">
        @(Model != null && Model.Id != 0 ?
                                                            Html.DisplayFor(m => m.Email, new { @class = "input-large" }) :
                                                            Html.TextBoxFor(m => m.Email, new { @class = "input-large" }))
        @Html.ValidationMessageFor(m => m.Email)
    </div>
</div>

<div id="roles">
    <div class="control-group">
        @Html.Label(Textos.Rol, new { @class = "control-label" })
        <div class="controls">
            @Html.DropDownList("Roles", (IEnumerable<SelectListItem>)ViewBag.Roles, new { id = "rol", @class = "control input-large" })
            @Html.ValidationMessageFor(m => m.RolesAsociados)
            <button class="btn btn-primary agregar" type="button" data-bind="click: addRol">@Textos.Agregar</button>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Textos.Descripcion</th>
            <th>@Textos.Eliminar</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: roles">
        <tr>
            <td data-bind="text: Descripcion" />
            <td><a href="#" data-bind="click: $root.removeRol"><i class="icon-trash"></i></a></td>
        </tr>
    </tbody>
</table>

<div id="centros">
    <div class="control-group">
        @Html.Label(Textos.Centro, new { @class = "control-label" })
        <div class="controls">
            @Html.DropDownList("Centros", (IEnumerable<SelectListItem>)ViewBag.Centros, new { id = "centro", @class = "control input-large" })
            @Html.ValidationMessageFor(m => m.CentrosAsociados)
            <button class="btn btn-primary agregar" type="button" data-bind="click: addCentro">@Textos.Agregar</button>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Textos.Descripcion</th>
            <th>@Textos.Eliminar</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: centros">
        <tr>
            <td data-bind="text: Descripcion" />
            <td><a href="#" data-bind="click: $root.removeCentro"><i class="icon-trash"></i></a></td>
        </tr>
    </tbody>
</table>