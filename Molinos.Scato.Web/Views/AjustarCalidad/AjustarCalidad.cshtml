@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.RecorridoDto
@{
    ViewBag.Title = Textos.AjustarCalidad_Titulo;
}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/ajustarCalidad.js")"></script>
<script src="~/scripts/jquery.maskedinput.js"></script>

<div id="calado">
    <div class="modal hide fade form-horizontal" id="dialogo-editar">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4 id="dialogo-editar-title">@Textos.Calado_ValorNuevo</h4>
        </div>
        <div class="modal-body" id="dialogo-editar-body">
            <form id="caladosPorCaracteristica" data-bind="submit: confirmCaladoPorCaracteristica">
                <input type="hidden" id="modificar" data-modificar-url = "@Url.Action("Modificar")" data-cargar-url = "@Url.Action("ObtenerCaracteristicas")"/>
                <input data-bind="value: newId" id="id" class="hidden" />
                <div class="row">
                    <div class="span6">
                        <div class="control-group" id="divNuevoValor">
                            @Html.Label(Textos.Calado_ValorNuevo, new { @class = "control-label" })
                            <div class="controls">
                                <input type="text" data-bind="value: newValorNuevo, attr: { id: newValorNuevo, name: newValorNuevo }" class="validarNumero validarRango campoNumerico newValorNuevo" />
                                @Html.ValidationMessage("valor", new { @class = "help-block", data_bind = "attr: { 'data-valmsg-for': newValorNuevo }" })
                            </div>
                        </div>
                        <div class="control-group">
                            @Html.Label(Textos.AjusteDeCalidad_RangoPermitido + ":", new { @class = "control-label" })
                            <div class="controls">
                                @Html.Label(Textos.AjusteDeCalidad_RangoPermitido + ":", new { @class = "label", id = "rango" })
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <input id="dialogo-editar-guardar" type="button" class="btn btn-primary" value="@Textos.Guardar"/>
            <input id="dialogo-editar-cancelar" type="button" class="btn" value="@Textos.Cancelar"/>
        </div>
    </div>
    <div class ="container-fluid">
        <div class="titSecciones">@Textos.AjustarCalidad_Titulo</div>
    </div>
    <ul class="nav nav-tabs">
        <li class="active" id="ajustarCalidadLi">
            <a href="#" id="ajustarCalidadHref" data-documento-url="@Url.Action("Index", "AjustarCalidad")">@Textos.AjustarCalidad_Titulo</a>
        </li>
        <li id="documentoOrigenLi">
            <a href="#" id="documentoOrigenHref" data-documento-url="@Url.Action("Index", "DocumentoDeOrigen")">@Textos.DocumentoDeOrigen_Titulo</a>
        </li>
    </ul>

    @using (Html.BeginForm("Modificar", "AjustarCalidad", FormMethod.Post, new { @class = "causaBlock", data_mensaje_espera = Textos.ActCalado }))
    {
        @Html.Hidden("ErrorCampoNumerico", string.Format(Textos.Error_SoloNumerico, Textos.Calado_Valor))
        @Html.Hidden("ErrorRangoValor", Textos.AnalisisDeCalidad_FueraDeRango)

        
        <table class="table table-striped table-bordered" id="caracteristicasTabla">
            <thead>
                <tr>
                    <th>@Textos.Material</th>
                    <th>@Textos.Calado_Caracteristica</th>
                    <th>@Textos.Calado_Valor</th>
                    <th>@Textos.Modificar</th>
                </tr>
            </thead>
            <tbody data-bind="foreach: caladosPorCaracteristica">
                <tr>
                    <td data-bind="text: Material" />
                    <td data-bind="text: Caracteristica" />
                    <td data-bind="commaDecimalFormatter: ValorOriginal" />
                    <td><a href="#" data-bind="click: $root.editCaladoPorCaracteristica"><i class="icon-edit" data-bind="    visible: EsModificable"></i></a></td>
                </tr>
            </tbody>
        </table> 
        <input type="hidden" name="calaldosPorCaracteristicas" data-bind="value: ko.toJSON(caladosPorCaracteristica)" />
        <br />
        <div class="row right">
            @Html.ActionLink(Textos.Cerrar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
        </div>
    }

    @Html.Hidden("errorModificar", Textos.AjustarCalidad_ErrorEnLaCarga)
    @Html.Hidden("hdnInstanceId", Model.InstanciaWorkflow)
    @Html.Hidden("hdnTipoDoc", Model.TipoDocumentoIngreso)
    @Html.Hidden("hdnNumeroDoc", Model.NumeroDocumentoIngreso)
    @Html.Hidden("hdnPatente", Model.Patente)
    @Html.Hidden("hdnRecorridoId", Model.Id)
    @Html.Hidden("hdnCaladoId", Model.Calado != null ? Model.Calado.Id : 0)
</div>


