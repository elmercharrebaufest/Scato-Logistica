@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    Layout = null;
    var items = (ListaPaginada<TarjetaSupervisorDto>)ViewBag.Items;
}
<script src="@Url.Script("~/Scripts/material.listarMateriales.js")" type="text/javascript"></script>
<style>
    .tip {
        max-width: 500px;
        white-space: normal;
    }
</style>
@Html.Grilla(items,
             grid => grid.Columns(
                grid.ColumnaEliminarModificar(Html, "TarjetaSupervisor"),
                grid.Columna("Numero", Textos.NumeroTarjeta),
                grid.Columna("Descripcion", Textos.Descripcion),
                 grid.Column(header: Textos.PuestoDeTrabajo_Titulo, format: ((item) =>
                    {
                        IEnumerable<PuestoDeTrabajoDto> puestosDto = (IList<PuestoDeTrabajoDto>)item.PuestosDeTrabajoAsociados;
                        return Html.Raw("<div class = 'ellipsis-overflow mostrar-lista'>" + Html.DisplayFor(m => puestosDto).ToHtmlString()
                                        + "<span class = 'tip'>" + Html.DisplayFor(m => puestosDto).ToHtmlString() + "</span>" + "</div>");
                    }))))
