}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/tarjetasupervisor.CrearModificar.js")"></script>

