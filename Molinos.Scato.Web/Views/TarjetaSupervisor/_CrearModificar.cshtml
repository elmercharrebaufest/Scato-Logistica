@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.TarjetaSupervisorDto


@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@Html.Hidden("puestosdetrabajo", "", new { id = "puestosFinales" })
@Html.HiddenFor(model => model.CentroId)


<div class="control-group">
    @Html.LabelFor(m => m.Numero, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(m => m.Numero, new { @class = "input-medium", maxlength = "10" })
        @Html.ValidationMessageFor(m => m.Numero)
    </div>
</div>

<div id="PuestosDeTrabajoAsociados">
    <div class="control-group">
        @Html.Label(Textos.PuestoDeTrabajo, new { @class = "control-label" })
        <div class="controls">
            @Html.DropDownList("PuestosDeTrabajo", (IEnumerable<SelectListItem>)ViewBag.PuestosDeTrabajo, new { id = "puesto", @class = "control input-large", data_bind = "value: newPuestoId" })
            @Html.ValidationMessageFor(m => m.PuestosDeTrabajoAsociados)
            <button class="btn btn-primary agregar" type="button" data-bind="click: addPuesto">@Textos.Agregar</button>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Textos.Descripcion</th>
            <th>@Textos.Eliminar</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: puestosDeTrabajo">
        <tr>
            <td data-bind="text: NombrePuesto" />
            <td><a href="#" data-bind="click: $root.removePuesto"><i class="icon-trash"></i></a></td>
        </tr>
    </tbody>
</table>

<div class="control-group">
    @Html.LabelFor(m => m.Descripcion, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(m => m.Descripcion, new { @class = "input-large" })
        @Html.ValidationMessageFor(m => m.Descripcion)
    </div>
</div>