<div id="dashboardBarrerasModal" class="modal hide fade"
     data-backdrop="static" data-keyboard="false" style="left: 50%; top: 30%; width: 1005px; margin-top: -160.542px; margin-right: auto; margin-left: -460.005px;">

    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4>Visualización de Barreras :</h4>
    </div>


    <div class="modal-body form-horizontal">
        <div class="row">

            @foreach (var group in ViewBag.ModulosBarrera)
            {
                <div class="span6" style="height: auto; margin-bottom: 2px; margin-top: 15px; border: 1px solid #ccc; border-radius: 6px;">
                    <label style="text-align: center; font-weight: bold; font-size: initial;">@group.Descripcion.ToUpper()</label>

                    @foreach (var item in group.SensoresBarreras)
                    {
                        <div class="row">
                            <div class="control-group" style="margin-left: 30px;">
                                <label class="control-label" style="font-size: small; display: inline-block; word-wrap: break-word; word-break: break-all; ">@item.NombreBarrera</label>
                                <div class="controls">
                                    <span id="@("barrera-" + item.Id + "-" + item.Barrera)" class='bar-ico bar-ent icon-barrera-cerrada' style="font-size: 80px; margin-top: 5px; color: red;"></span>
                                    <div style="margin-left: 30px;">
                                        @if (gestionarBarrera)
                                        {
                                            <a class="btn tarjetaMaestroSupervisorBarrera apertura" data-puesto-id="@ViewBag.PuestoId" data-id="@("A-" + item.Id + "-" + item.Barrera)" style="margin-top: -44px; margin-left: 80px; color: #07c35f !important;"><i class="fa fa-unlock"> </i> </a>
                                            <a class="btn tarjetaMaestroSupervisorBarrera cierre" data-puesto-id="@ViewBag.PuestoId" data-id="@("C-" + item.Id + "-" + item.BarreraBajar)" style="margin-top: -44px; color: #ea1f1f !important;"><i class="fa fa-lock"> </i> </a>
                                        }
                                        else
                                        {
                                            foreach (var barreraSupervisor in ViewBag.BarrerasSupervisor)
                                            {
                                                if (barreraSupervisor == item.Barrera)
                                                {
                                                    <a class="btn tarjetaMaestroSupervisorBarrera apertura" data-puesto-id="@ViewBag.PuestoId" data-id="@("A-" + item.Id + "-" + item.Barrera)" style="margin-top: -44px; margin-left: 80px; color: #07c35f !important;"><i class="fa fa-unlock"> </i> </a>
                                                    <a class="btn tarjetaMaestroSupervisorBarrera cierre" data-puesto-id="@ViewBag.PuestoId" data-id="@("C-" + item.Id + "-" + item.BarreraBajar)" style="margin-top: -44px; color: #ea1f1f !important;"><i class="fa fa-lock"> </i> </a>
                                                }
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            }

        </div>

    </div>



</div>

