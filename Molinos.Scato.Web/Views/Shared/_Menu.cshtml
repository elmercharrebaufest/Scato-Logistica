@{
    var cookie = new CookieUsuario();
    var centroDescripcion = cookie.Valor("CentroDescripcion");
    var centroId = cookie.Valor("centroId");
    var workflows = (IList<WorkflowInfoDto>)ViewBag.Workflows;
    var idiomas = (IEnumerable<SelectListItem>)ViewBag.Idiomas;
    var nombrePC = ViewBag.NombrePc == "NoTienePuesto" ? Textos.NoDisponible : (String)ViewBag.NombrePc;
    var sensoresBarrera = (IList<SensorBarreraDto>)ViewBag.sensoresBarrera;
    var totalSensoresBarrera = (int)ViewBag.totalSensoresBarrera;
    var gestionarBarrera = (bool)(ViewBag.GestionarBarrera ?? false);
    var requiereComentarioGestionarBarrera = (bool)(ViewBag.RequiereComentarioGestionarBarrera ?? false);
}

@Html.Hidden("cantidadBarreras", totalSensoresBarrera)
@Html.Hidden("requiereComentarioGestionarBarrera", requiereComentarioGestionarBarrera)
@Html.Hidden("gestionarBarrera", gestionarBarrera)
@Html.Hidden("centroId", centroId)


