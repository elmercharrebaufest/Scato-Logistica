            </div>
        </div>

        <span id="error-requerido" style="color:rgb(185, 74, 72); display:none;">@string.Format(Textos.Error_Requerido, "Motivo")</span>
        <span id="error-largo" style="color:rgb(185, 74, 72); display:none;">@string.Format(Textos.Error_LargoMensaje, "Motivo", "10")</span>

        @Html.Hidden("elemento-id-Menu")
        @Html.Hidden("elemento-barrera-Menu")
        @Html.Hidden("url-Menu")
        @Html.Hidden("elemento-accion-Menu")
    </div>

    <div class="modal-footer">
        <a href="#" id="guardarEventoBarrera" class="btn btn-primary">Aceptar</a>
        <a data-dismiss="modal" aria-hidden="true" href="#" id="cancelar" class="btn close">Cancelar </a>
    </div>
</div>

<div id="modalGestionBarrera" class="modal hide fade"
     data-backdrop="static" data-keyboard="false" style="width: 405px; margin-right: auto; ">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
        <h4 id="dialogo-editar-title">Opciones de Barrera</h4>
    </div>
    <div class="modal-body form-horizontal">
        <div class="row">
            @if (Enumerable.Count(sensoresBarrera) > 0)
            {
                <div class="control-group" style="margin-left: 30px;">
                    <label class="control-label" style="font-size: small; display: inline-block; word-wrap: break-word; word-break: break-all; ">@sensoresBarrera[0].NombreBarrera</label>
                    <div class="controls">
                        <span id="@("barrera-" + sensoresBarrera[0].Id + "-" + sensoresBarrera[0].Barrera)" class='bar-ico bar-ent icon-barrera-cerrada' style="font-size: 80px; margin-top: 5px; color: red;"></span>
                        <div>
                            @if (gestionarBarrera)
                            {
                                foreach (var sensor in sensoresBarrera)
                                {
                                    <a class="btn tarjetaMaestroSupervisorBarrera apertura" data-puesto-id="@ViewBag.PuestoId" data-id="@("A-" + sensor.Id + "-" + sensor.Barrera)" style="margin-top: -44px; margin-left: 80px; color: #07c35f !important;"><i class="fa fa-unlock"> </i> </a>
                                    <a class="btn tarjetaMaestroSupervisorBarrera cierre" data-puesto-id="@ViewBag.PuestoId" data-id="@("C-" + sensor.Id + "-" + sensor.BarreraBajar)" style="margin-top: -44px; color: #ea1f1f !important;"><i class="fa fa-lock"> </i> </a>
                                }
                            }
                            else
                            {
                                foreach (var barreraSupervisor in ViewBag.BarrerasSupervisor)
                                {
                                    if (barreraSupervisor == sensoresBarrera[0].Barrera)
                                    {
                                        <a class="btn tarjetaMaestroSupervisorBarrera apertura" data-puesto-id="@ViewBag.PuestoId" data-id="@("A-" + sensoresBarrera[0].Id + "-" + sensoresBarrera[0].Barrera)" style="margin-top: -44px; margin-left: 80px; color: #07c35f !important;"><i class="fa fa-unlock"> </i> </a>
                                        <a class="btn tarjetaMaestroSupervisorBarrera cierre" data-puesto-id="@ViewBag.PuestoId" data-id="@("C-" + sensoresBarrera[0].Id + "-" + sensoresBarrera[0].BarreraBajar)" style="margin-top: -44px; color: #ea1f1f !important;"><i class="fa fa-lock"> </i> </a>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="modal-footer">
        <a data-dismiss="modal" aria-hidden="true" href="#" id="cancelar" class="btn close">Cancelar </a>
    </div>
</div>