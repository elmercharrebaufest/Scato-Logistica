@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ActividadPorDispositivoDto
@{
    Layout = null;
    ViewBag.Title = Textos.ActividadPorDispositivo_Modificar;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/actividadPorDispositivo.js")" type="text/javascript"></script>

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.ActividadPorDispositivo_Modificar }))
{
    @Html.HiddenFor(model => model.CentroId)
    @Html.HiddenFor(model => model.PuestoDeTrabajoId)
    @Html.Partial("_CrearModificar", Model)
}