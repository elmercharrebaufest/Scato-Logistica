@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model IList<Molinos.Scato.Dominio.Dto.CentroDto>

@{
    ViewBag.Title = Textos.GenerarArchivosOncca_Titulo;
}

@section scripts
{
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
    <script src="@Url.Script("~/Scripts/generararchivosoncca.index.js")" type="text/javascript"></script>
}
<style>
    .field-validation-error {
        color: #ff0000;
    }
</style>
<div class ="container">
    <div class="titSecciones">@Textos.GenerarArchivosOncca_Titulo</div>
</div>

    <div class="container content grillaPad"> 
        @using (Html.BeginForm("Generar", "GenerarArchivosOncca", null, FormMethod.Post, new { @class = "form-horizontal form-search", id = "oncca-form", data_mensaje_espera = Textos.GenerarArchivosOncca_Generando }))
        {
            if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
            {
                <div class="alert alert-error">
                    @Html.ValidationSummary(true)
                </div>
            }

            <div style="max-height: 170px; overflow: auto; margin-bottom: 3px">
                <table class="table table-striped table-bordered">
                    <thead> 
                        <tr>
                            <th>&nbsp;</th>
                            <th>@Textos.Codigo</th>
                            <th>@Textos.Centro</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td><input type="checkbox" class="centrocheck" name="centrosSeleccionados" value="@Model[i].Id" /></td>
                                <td>@Html.DisplayFor(m => m[i].CodigoSAP)</td>
                                <td>@Html.DisplayFor(m => m[i].Descripcion)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="control-group FechaInicio">
                @Html.Label("fechaInicio", Textos.FechaInicio)
                <div class="controls">
                    @Html.TextBox("fechaInicio", DateTime.Now.Formatted(), new {@class = "control input-small"})
                    @Html.ValidationMessage("fechaInicio")
                </div>
            </div>
            <div class="control-group FechaFin">
                @Html.Label("fechaFin", Textos.FechaFin)
                <div class="controls">
                    @Html.TextBox("fechaFin", DateTime.Now.Formatted(), new {@class = "control input-small"})
                    @Html.ValidationMessage("fechaFin")
                </div>
            </div>

            <div class="control-group">
                @Html.Label("tipoArchivo", Textos.GenerarArchivosOncca_TipoDeArchivo)
                <div class="controls">
                    @Html.DropDownList("tipoArchivo", (IEnumerable<SelectListItem>) ViewBag.TiposArchivo, new {@class = "control input"})
                    @Html.ValidationMessage("tipoArchivo")
                </div>
            </div>
        <div class="centered">
            <button id="aceptar" class="btn btn-primary" type="submit">@Textos.Aceptar</button>
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new {@class="btn"})
        </div>

        }

</div>