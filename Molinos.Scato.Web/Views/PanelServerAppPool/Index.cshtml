@using System.Globalization
@using System.Web.Mvc.Html
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.PanelServerAppPoolDto

@{
    ViewBag.Title = Textos.PanelServerAppPool;
    var serversLista = (IEnumerable<SelectListItem>)ViewBag.Servers;
}

<style>
    .field-validation-error {
        color: #ff0000;
    }
</style>
<div id="links" data-url-obtener-eventos="@Url.Action("ObtenerEventos", "PanelServerAppPool")"></div>
<script type="text/javascript" src="@Url.Script("~/scripts/jquery.unobtrusive-ajax.min.js")"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/jquery.unobtrusive-ajax.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.js")"></script>
<script src="@Url.Script("~/scripts/jquery.maskedinput.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/panelServerAppPool.js")"></script>

<div class="container">
    <div class="titSecciones">@Textos.PanelServerAppPool</div>
</div>
<br>

<div class="container content grillaPad">
    <div id="grilla">
        <div class="span10">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>
                            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form", @class = "form-search causaBlock" }))
                            {
                                @Html.DropDownListFor(s => s.ServidorNombre, serversLista, new { @class = "control-small", id = "serversLista", Style = "margin-bottom: 0px;" })
                                <button type="submit" class="btn" id="buscar">@Textos.Buscar</button>
                                <button class="btn" id="verLogs">@Textos.VerEventos</button>
                                <button class="btn" id="DescargarLog">@Textos.DescargarLogs</button>
                            }
                        </th>
                    </tr>
                </thead>
            </table>
            <div id="gridContainer" data-grid-url="@Url.Action("Index")">
                @Html.Partial("Listar", Model)
            </div>
        </div>
    </div>
</div>

@Html.Hidden("url")
<div class="modal hide fade " id="dialogo-config-recycling">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true" tabindex="-10">&times;</button>
        <h4>Configurar Tiempo</h4>
    </div>
    <div class="modal-body" id="dialogo-recycling-body">
        <div class="control-group">
            <label class="control-label">@Textos.Tiempo (min)</label>
            <div class="controls">
                @Html.TextBox("Tiempo", null, new { @class = "control input-small", autocomplete = "off", tabIndex = 2 })
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <input id="dialogo-config-guardar" type="button" class="btn btn-primary" tabindex="2" value="Aceptar" />
        <input id="dialogo-config-cancelar" type="button" class="btn" tabindex="2" value="Cancelar" />
    </div>
</div>

@Html.Hidden("url")
<div class="modal hide fade " id="dialogo-obtener-eventos">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true" tabindex="-10" id="close-dialogo-logs">&times;</button>
        <h4>Ver Eventos</h4>
    </div>
    <div class="modal-body" id="dialogo-obtener-eventos-body">
        <table class="table table-striped table-bordered table-small">
            <tr>
                <th>
                    <label class="control-label">@Textos.LogId</label>
                    @Html.TextBox("EventoId", null, new { @class = "control input-small", autocomplete = "off", tabIndex = 2, data_error_requerido = string.Format(Textos.Error_Requerido, new object[] { Textos.LogId }) })
                    @Html.ValidationMessage("EventoId")
                </th>
                <th>
                    <label class="control-label">@Textos.Fecha @Textos.FechaDesde</label>
                    @Html.TextBox("FechaDesde", null, new { @class = "control input-medium datetime", tabIndex = 2, data_error_requerido = string.Format(Textos.Error_Requerido, new object[] { Textos.Fecha + " " + Textos.FechaDesde }) })
                    @Html.ValidationMessage("FechaDesde")
                </th>
                <th>
                    <label class="control-label">@Textos.Fecha @Textos.FechaHasta</label>
                    @Html.TextBox("FechaHasta", null, new { @class = "control input-medium", tabIndex = 2, data_error_requerido = string.Format(Textos.Error_Requerido, new object[] { Textos.Fecha + " " + Textos.FechaHasta }) })
                    @Html.ValidationMessage("FechaHasta")
                </th>
                <th><button id="dialogo-obtener-eventos-ver" type="button" class="btn btn-primary" tabindex="2">Ver</button></th>
                <th><button id="dialogo-obtener-eventos-cancelar" type="button" class="btn" tabindex="2">Cancelar</button></th>
            </tr>
        </table>
        <div id="listaLogs">
        </div>
    </div>
</div>

<div class="modal hide fade " id="dialogo-descargar-logs" data-url-obtener-logs="@Url.Action("ObtenerLogs", "PanelServerAppPool")">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true" tabindex="-10" id="close-dialogo-logs">&times;</button>
        <h4>Descargar Logs</h4>
    </div>
    <div class="modal-body" id="dialogo-descargar-logs-body">
        <table class="table table-striped table-bordered table-small" id="archivos">
               
        </table>
    </div>
</div>