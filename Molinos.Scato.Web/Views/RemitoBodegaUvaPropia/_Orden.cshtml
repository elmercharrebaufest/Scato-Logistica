@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.RemitoBodegaUvaDto
@{
    var tiposComerciales = (IEnumerable<SelectListItem>)ViewBag.TiposComerciales;
    var materiales = (IEnumerable<SelectListItem>)ViewBag.Materiales;
    var vinedos = (IEnumerable<SelectListItem>)ViewBag.Vinedos;
    var tiposDocumentos = (IEnumerable<SelectListItem>)ViewBag.TiposDocumentos;
    var tiposVehiculo = (IEnumerable<SelectListItem>)ViewBag.TiposVehiculoBodega;
    var workflow = (string)ViewBag.Workflow;
    var centroId = (int)ViewBag.CentroId;
}

<div id ="links" 
     data-url-obtener-proveedores-sap ="@Url.Action("ObtenerProveedoresSap", "Consultas")"
     data-url-buscar-proveedor ="@Url.Action("BuscarProveedor", "Consultas")"
     data-url-buscar-proveedores = "@Url.Action("BuscarProveedores", "Consultas")"
    
     data-url-buscar-transportistas = "@Url.Action("BuscarTransportistas", "Consultas")"
     data-url-buscar-transportista-unico = "@Url.Action("BuscarTransportista", "Consultas")"
     data-url-buscar-choferes = "@Url.Action("BuscarChoferes", "Consultas")"
     data-url-buscar-chofer-unico = "@Url.Action("BuscarChoferUnico", "Consultas")"

     data-url-filtrar-materiales = "@Url.Action("FiltrarMaterialesPorVinedo", "RemitoBodegaUvaPropia")"
     data-url-filtrar-cuarteles = "@Url.Action("FiltrarCuartelesPorVinedo", "RemitoBodegaUvaPropia")"
     data-url-obtener-descargas = "@Url.Action("ObtenerDescargas", "RemitoBodegaUvaPropia")"
     data-url-obtener-clase = "@Url.Action("ObtenerClasePorMaterial", "RemitoBodegaUvaPropia")"
    >
</div>

@Html.HiddenFor(model => model.Id)
@Html.Hidden("workflow", workflow)
@Html.Hidden("centroId", centroId)
@Html.Hidden("descargasFinales", "", new { id = "descargasFinales" })
<div id="mensajeInvalido" data-invalido="@Textos.Error_Invalido"></div>
<div id="remitoUvaContainer" class="row-fluid row-fluid-ie7">
    <div class="span6">
        <fieldset class="grupo-carta-porte">
            <div class="row row-carta-porte">
                <div class="control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Proveedor, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Proveedor, new { @class = "control input-xlarge", autocomplete = "off", @readonly = "readonly" })
                        @Html.HiddenFor(model => model.ProveedorId)
                    </div>
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.TipoComercial, new { @class = "control-label small" })
                <div class="" id ="tiposComerciales" data-alta-rapida='@Html.Raw(Json.Encode(((IEnumerable<string>)ViewBag.TiposComercialesTransportista).Select(x => x)))'>
                    @Html.DropDownListFor(model => model.TipoComercialId, tiposComerciales, new { @class = "control input-large" })
                    @Html.ValidationMessageFor(model => model.TipoComercialId)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.Patente, new { @class = "control-label small" })
                <div class="">
                    @Html.TextBoxFor(model => model.Patente, new { @class = "control input-medium patente-internacional uppercase", autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.Patente)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.NroRemito, new { @class = "control-label small" })
                <div class="">
                    @Html.TextBoxFor(model => model.NroRemito, new { @class = "control input-medium", autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.NroRemito)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.Transportista, new { @class = "control-label small" })
                <div class="">
                    @Html.TextBoxFor(model => model.Transportista, new { @class = "control input-medium autocompletado-obligatorio", data_error_requerido = String.Format(Textos.Error_Requerido, Textos.Transportista) })
                    @Html.ValidationMessageFor(model => model.Transportista)
                    @Html.HiddenFor(model => model.TransportistaId)
                    @Html.HiddenFor(model => model.EsTransportista)
                </div>
            </div>
            <br />
            @Textos.CartaPorte_DatosChofer
            <div class="row row-carta-porte">
                <div id="divSpan6" class="span8 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.Cuil, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Chofer.Cuil, new { @class = "control input-medium cuilValido", data_error_cuil_invalido = string.Format(Textos.CuilInvalido) })
                        @Html.TextBox("sinCuil", null, new { @disabled = "disabled", style = "display:none", @class = "control input-medium" })

                        @Html.ValidationMessageFor(model => model.Chofer.Cuil)
                    </div>
                </div>
                <div class="span4 control-group control-group-no-bottom">
                    <label class="control-label xsmall-label">Extranjero</label>
                    <div class="controls-small">
                        @Html.CheckBoxFor(model => model.EsExtranjero, new { @class = "input-small", @id = "esExtranjero", @name = "esExtranjero" })
                    </div>
                </div>
            </div>
            <div class="row row-carta-porte">
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.TipoDocumentoIdentidadId, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.DropDownListFor(model => model.Chofer.TipoDocumentoIdentidadId, tiposDocumentos, new { @class = "control  input-small", autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.Chofer.TipoDocumentoIdentidadId)
                    </div>
                </div>
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.NumeroDeDocumento, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Chofer.NumeroDeDocumento, new { @class = "control input-small ", maxlength = 10 })
                        @Html.ValidationMessageFor(model => model.Chofer.NumeroDeDocumento)
                    </div>
                </div>
            </div>
            <div class="row row-carta-porte">
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.Nombre, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.HiddenFor(model => model.Chofer.Id)
                        @Html.TextBoxFor(model => model.Chofer.Nombre, new { @class = "control input-small ", data_url_buscar_choferes = Url.Action("BuscarChoferes", "Consultas", new { campo = "Nombre" }) })
                        @Html.ValidationMessageFor(model => model.Chofer.Nombre)
                    </div>
                </div>
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.Chofer.Apellido, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.Chofer.Apellido, new { @class = "control input-small ", data_url_buscar_choferes = Url.Action("BuscarChoferes", "Consultas", new { campo = "Apellido" }) })
                        @Html.ValidationMessageFor(model => model.Chofer.Apellido)
                    </div>
                </div>
            </div>
            <br />
            <div class="row row-carta-porte">
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.MarcaCamion, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.MarcaCamion, new { @class = "control input-small", autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.MarcaCamion)
                    </div>
                </div>
                <div class="span6 control-group control-group-no-bottom">
                    @Html.LabelFor(model => model.ModeloCamion, new { @class = "control-label small" })
                    <div class="controls-small">
                        @Html.TextBoxFor(model => model.ModeloCamion, new { @class = "control input-small", autocomplete = "off" })
                        @Html.ValidationMessageFor(model => model.ModeloCamion)
                    </div>
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.TipoVehiculoBodegaId, new { @class = "control-label small" })
                <div class="">
                    @Html.DropDownListFor(model => model.TipoVehiculoBodegaId, tiposVehiculo, null, new { @class = "control input-medium" })
                    @Html.ValidationMessageFor(model => model.TipoVehiculoBodegaId)
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.TipoCosecha, new { @class = "control-label small" })
                <div class="">
                    @Html.RadioButtonFor(model => model.TipoCosecha, TipoCosecha.Manual, new { @class = "control input-small", @style = "width:auto;background:none;border:none" }) @Textos.Manual
                    @Html.RadioButtonFor(model => model.TipoCosecha, TipoCosecha.Mecanica, new { @class = "control input-small", @style = "width:auto;background:none;border:none" }) @Textos.Mecanica
                    @Html.ValidationMessageFor(model => model.TipoCosecha)
                </div>
            </div>
        </fieldset>
    </div>
    <div class="span6">
        <fieldset class="grupo-carta-porte">@Textos.DatosGeneralUva
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.Vinedo, new { @class = "control-label small" })
                <div class="">
                    @Html.DropDownListFor(model => model.VinedoId, vinedos, new { @class = "control input-medium" })
                    @Html.ValidationMessageFor(model => model.Vinedo)
                </div>
            </div>
            <div class="control-group control-group-no-bottom materialdiv" data-materialmensaje ="@Textos.Error_VinedoSinMaterial">
                @Html.LabelFor(model => model.Material, new { @class = "control-label small" })
                <div class="">
                    @Html.DropDownListFor(model => model.MaterialIdYPosicion, materiales, new { @class = "control input-large" })
                    @Html.ValidationMessageFor(model => model.MaterialIdYPosicion, null, new { @class = "materialMensaje" })
                </div>
            </div>
            <div class="control-group control-group-no-bottom">
                @Html.LabelFor(model => model.Cosecha, new { @class = "control-label small" })
                <div class="">
                    @Html.TextBoxFor(model => model.Cosecha, new { @class = "control input-medium", autocomplete = "off", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.Cosecha)
                </div>
            </div>

            <div id="descargaDeBinesViewModel">
                @Textos.Cuarteles
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>@Textos.TipoDeBin</th>
                            <th>@Textos.CodigoCuartel</th>
                            <th>@Textos.CantidadDeBines</th>
                            <th>@Textos.Eliminar</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: descargasDeBines">
                        <tr>
                            <td data-bind="text: Tipo" />
                            <td data-bind="text: Cuartel" />
                            <td data-bind="text: CantidadBines" />
                            <td><a href="#" data-bind="click: $root.removeDescarga"><i class="icon-trash"></i></a></td>
                        </tr>
                    </tbody>
                </table>

                <div class="control-group">
                    @Html.Label(Textos.TipoDeBin, new { @class = "control-label small" })
                    <div class="controls">
                        @Html.DropDownList("TipoDeBines", (IEnumerable<SelectListItem>)ViewBag.TiposDeBines, new { id = "tiposDeBines", @class = "control input-large", data_bind = "value: newTipoDeBin" })
                    </div>
                </div>
                <div class="control-group">
                    @Html.Label(Textos.CodigoCuartel, new { @class = "control-label small" })
                    <div class="controls">
                        @Html.DropDownList("CodigoCuartel", new List<SelectListItem>(), new { id = "codigosCuartel", @class = "control input-large", data_bind = "value: newCodigoCuartelId" })
                    </div>
                </div>
                <div class="control-group">
                    @Html.Hidden("cantidadBines", Textos.CantidadBines, new { id = "textoCantidad" })
                    @Html.Hidden("porcentajeDeUvas", Textos.PorcentajeDeUvas, new { id = "textoPorcentaje" })
                    @Html.Label(Textos.CantidadDeBines, new { @class = "control-label labelCantidad small" })
                    <div class="controls">
                        @Html.TextBox("Cantidad", String.Empty, new { id = "cantidad", name = "cantidad", @class = "control input-large porcentajeDeUvas campoCantidad", data_bind = "value: newCantidad", maxlength = 3, data_error = Textos.Error_SumaPorcentaje })
                        <div class="control-group">@Html.ValidationMessage("cantidad", new { @class = "validaPorcentajeDeUvas help-block" })</div>
                        <button class="btn btn-primary agregar" type="button" data-bind="click: addDescarga">@Textos.Agregar</button>
                    </div>
                </div>
            </div>
            <fieldset class="grupo-carta-porte">@Textos.PesoOrigen
                <div class="row row-carta-porte" style="margin-top: 14px">
                    <div class="span4 control-group control-group-no-bottom">
                        <label class="control-label xsmall">@Textos.CartaPorte_PesoBrutoOrigen</label>
                        <div class="controls-xsmall">
                            @Html.TextBoxFor(model => model.PesoBrutoOrigen, new
                       {
                           @class = "control input-xsmall pesoBrutoNumerico pesoBrutoPositivo", maxlength = 5,
                           data_error_numerico = string.Format(Textos.Error_SoloNumerico, new object[] { Textos.CartaPorte_PesoBrutoOrigen }),
                           data_error_positivo = string.Format(Textos.Error_SoloPositivo, new object[] { Textos.CartaPorte_PesoBrutoOrigen })
                       })
                            @Html.ValidationMessageFor(model => model.PesoBrutoOrigen)
                        </div>
                    </div>
                    <div class="span4 control-group control-group-no-bottom">
                        <label class="control-label xsmall">@Textos.CartaPorte_PesoTaraOrigen</label>
                        <div class="controls-xsmall">
                            @Html.TextBoxFor(model => model.PesoTaraOrigen, new
                       {
                           @class = "control input-xsmall pesoTaraNumerico pesoTaraPositivo", maxlength = 5,
                           data_error_numerico = string.Format(Textos.Error_SoloNumerico, new object[] { Textos.CartaPorte_PesoTaraOrigen }),
                           data_error_positivo = string.Format(Textos.Error_SoloPositivo, new object[] { Textos.CartaPorte_PesoTaraOrigen })
                       })
                            @Html.ValidationMessageFor(model => model.PesoTaraOrigen)
                        </div>
                    </div>
                    <div class="span4 control-group control-group-no-bottom">
                        <label class="control-label xsmall">@Textos.CartaPorte_PesoNetoOrigen</label>
                        <div class="controls-xsmall">
                            @Html.TextBoxFor(model => model.PesoNetoOrigen, new
                       {
                           @class = "control input-xsmall pesoNetoPositivo",
                           @readonly = "readonly",
                           data_error_positivo = string.Format(Textos.Error_SoloPositivo, new object[] { Textos.CartaPorte_PesoNetoOrigen })
                       })
                            @Html.ValidationMessageFor(model => model.PesoNetoOrigen)
                        </div>
                    </div>
                </div>
            </fieldset>
        </fieldset>
    </div>
</div>

<div id="autocompleteTran"></div>