@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.RolDto
@{
    ViewBag.Title = Textos.Rol_Modificar;
    Layout = null;
}
@Scripts.Render("~/bundles/jqueryval")
<script src="~/scripts/knockout-2.2.1.js"  type="text/javascript"></script>
<script src="@Url.Script("~/Scripts/rol.CrearModificar.js")"></script>

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Rol_Modificar }))
{
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)           
}
