@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.RolDto


@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@Html.Hidden("permisos", "", new {id = "permisosFinales"})

<div id="permisosViewModel">
    <div class="control-group">
        @Html.LabelFor(m => m.Descripcion, new {@class = "control-label"})
        <div class="controls">
            @Html.TextBoxFor(m => m.Descripcion, new {@class = "input-xlarge"})
            @Html.ValidationMessageFor(m => m.Descripcion)
        </div>
    </div>

    <div id="permisos">
    
        <div class="control-group">
            @Html.Label(Textos.Permiso_TipoPermiso, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownList("TiposPermiso", (IEnumerable<SelectListItem>) ViewBag.TiposPermiso, new {id = "tipoPermiso", @class = "control input-large"})
            </div>
        </div>    

        <div class="control-group">
            @Html.Label(Textos.Permiso, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownList("Permisos", (IEnumerable<SelectListItem>) ViewBag.Permisos, new {id = "permiso", @class = "control input-large", data_bind = "value: newPermisoId"})
                @Html.ValidationMessageFor(m => m.PermisosAsociados)
                <button class="btn btn-primary agregar" type="button" data-bind="click: addPermiso">@Textos.Agregar</button>
            </div>
        </div>    
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@Textos.Permiso_TipoPermiso</th><th>@Textos.Descripcion</th><th>@Textos.Eliminar</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: permisos">
            <tr>
                <td data-bind="text: TipoPermisoDesc" />
                <td data-bind="text: Descripcion" />
                <td><a href="#" data-bind="click: $root.removePermiso"><i class="icon-trash"></i></a></td>
            </tr>    
        </tbody>
    </table> 
</div>
