@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.ExcepcionEnvioCamaraDto
@{
    var tiposComerciales = (IEnumerable<SelectListItem>) ViewBag.TiposComerciales;
}
<script>
    var caracteristicaCalidadId = "";
    @if (Model != null) {
        <text>
    caracteristicaCalidadId = [@string.Join(", ", Model.CaracteristicasDeCalidadId ?? new List<int>())];
    onSelectMaterial();
        </text>
    }
</script>
<div id ="links" 
     data-url-obtener-proveedores-sap ="@Url.Action("ObtenerProveedoresSap", "Consultas")"
     data-url-buscar-proveedor ="@Url.Action("BuscarProveedor", "Consultas")"
     data-url-buscar-proveedores = "@Url.Action("BuscarProveedores", "Consultas")"
    
     data-url-buscar-entregador ="@Url.Action("BuscarEntregador", "Consultas")"
     data-url-buscar-entregadores = "@Url.Action("BuscarEntregadores", "Consultas")"
    
     data-url-buscar-material ="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales = "@Url.Action("BuscarMateriales", "Consultas")"
    ></div>
@Html.Hidden("ObtenerCaracteristicas", Url.Action("ObtenerCaracteristicas", "ExcepcionEnvioCamara"))
<div class="control-group">
    @Html.LabelFor(m => m.MaterialId, new {@class = "control-label"})
    <div class="controls">
        @if (Model != null && Model.Id != 0)
        {
            @Html.TextBoxFor(model => model.MaterialDesc, new {@class = "control input-large", @readonly = "readonly"})
        }
        else
        {
            @Html.TextBoxFor(model => model.MaterialDesc, new {@class = "control input-large"})   
        }
        @Html.ValidationMessageFor(m => m.MaterialDesc)
        @Html.HiddenFor(model => model.MaterialId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.CaracteristicaId, new {@class = "control-label"})
    <div class="controls">
        <div id="caracteristicasDropdown">
        </div>
        @Html.ValidationMessageFor(model => model.CaracteristicasDeCalidadId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.TipoComercialId, new {@class = "control-label"})
    <div class="controls">
        @Html.DropDownListFor(model => model.TipoComercialId, tiposComerciales, new {@class = "control input-large"})
        @Html.ValidationMessageFor(m => m.TipoComercialId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.ProveedorDesc, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.ProveedorDesc, new {@class = "control input-large" })
        @Html.ValidationMessageFor(model => model.ProveedorDesc)
        @Html.HiddenFor(model => model.ProveedorId)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(m => m.EntregadorDesc, new {@class = "control-label"})
    <div class="controls">
        @Html.TextBoxFor(model => model.EntregadorDesc, new {@class = "control input-large"})
        @Html.ValidationMessageFor(model => model.EntregadorDesc)
        @Html.HiddenFor(model => model.EntregadorId)
    </div>
</div>

<div id="autocompleteProv"></div>