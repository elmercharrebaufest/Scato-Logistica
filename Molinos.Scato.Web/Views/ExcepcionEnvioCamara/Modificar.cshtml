@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.ExcepcionEnvioCamaraDto
@{
    ViewBag.Title = Textos.TipoDocumentoIdentidad_Modificar;
    Layout = null;
}

@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Script("~/scripts/autocompletar.js")"></script>
<script type="text/javascript" src="@Url.Script("~/Scripts/excepcionEnvioCamara.js")"></script>

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", id = "orden-form", data_dialogo_titulo = Textos.ExcepcionEnvioCamara_Modificar }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)           
}
