@using Molinos.Scato.Dominio.Recursos
@{
    ViewBag.Title = Textos.ControlDeTiempo_Titulo;
}

<div class ="container-fluid">
    <div class="titSecciones">@Textos.ControlDeTiempo_Administracion</div>
</div>

<div class="container-fluid content grillaPad">
    <div class="row">
        <div class="span12search bordeGris">
            @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "search-form" }))
            {
                
            }
            @Html.ActionLink(Textos.ControlDeTiempo_Nuevo, "Crear", "ControlDeTiempo", null , new {@class = "ajax-editar-link btn btn-primary pull-right"})
        </div>
    </div>
    
    <div id="gridContainer">
        @Html.Partial("Listar")
    </div>
</div>