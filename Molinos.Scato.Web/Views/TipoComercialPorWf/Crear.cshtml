@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.TipoComercialPorWfDto

@{
    ViewBag.Title = Textos.Crear;
    Layout = null;
    var workflows = (IEnumerable<SelectListItem>) ViewBag.Worflows;
}

@Scripts.Render("~/bundles/jqueryval")
<script src="@Url.Script("~/Scripts/tiposComercialesPorWf.Crear.js")" type="text/javascript"></script>

@using (Ajax.BeginForm("Crear", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.TipoComercialPorWf_Crear }))
{
    <div class="control-group">
        @Html.LabelFor(model => model.WorkflowId, new {@class = "control-label"})
        <div class="controls">
            @Html.DropDownListFor(model => model.WorkflowId, workflows, new {@class = "control input-xlarge"})
            @Html.ValidationMessageFor(model => model.WorkflowId)
        </div>
    </div>
    
    <div class="control-group">
        @Html.LabelFor(model => model.TipoComercialId, new {@class = "control-label"})
        <div class="controls">
            <select name="TipoComercialId" class="control input-xlarge" id="TipoComercialId" data-val-required="@Textos.TipoComercialPorWf_ErrorTipoComercial" data-val="true" data-primera-opcion="@Textos.TipoComercialPorWf_Seleccionar" />  
            @Html.ValidationMessageFor(model => model.TipoComercialId)
        </div>
    </div>
}
