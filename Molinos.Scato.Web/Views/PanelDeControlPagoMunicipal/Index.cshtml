@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Enums
@using Molinos.Scato.Dominio.Helpers
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Dominio.Seguridad
@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Web.Seguridad
@model Molinos.Scato.Dominio.Dto.FiltroPanelPagoMunicipalDto
@{
    ViewBag.Title = "Panel de control pago municipal";
    var workflows = (IEnumerable<SelectListItem>)ViewBag.Workflows;
}

@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
<script src="@Url.Script("~/Scripts/accordion.icon.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Script("~/scripts/panelDePagoMunicipal.index.js")"></script>

<div class="container-fluid">
    <div class="titSecciones">Gestión de Reprocesos por Contingencia</div>
</div>

<div class="container-fluid content grillaPad">
    @using (Ajax.BeginForm("Index", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "gridContainer" }, new { id = "transmisiones-form", @class = "form-search", data_mensaje_espera = Textos.PanelDeControlTransSAP }))
    {
        @Html.HiddenFor(model => model.TipoDeServicio)
        <div class="accordion row-fluid">
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseOne">
                        <i class="icon-chevron-down"></i>
                        @Textos.Busqueda
                    </a>

                </div>
                <div id="collapseOne" class="accordion-body in collapse">
                    <div class="accordion-inner" style="margin-right: -73px;">
                        @Html.ValidationSummary(true)
                        <div class="row-fluid">


                            <div class="span2" style="margin-left:99px;">
                                @Html.LabelFor(model => model.Patente, new { @class = "control-label" })
                            </div>

                            <div class="span3 sinBorde" style="margin-left:-31px">
                                @Html.TextBoxFor(model => model.Patente, new { @class = "input-large sinMargen" })
                            </div>

                            <div class="span2 FechaHasta" style="margin-left:-50px;">
                                @Html.LabelFor(model => model.IngresoDesde, new { @class = "control-label" })
                            </div>
                            <div class="span3 sinBorde" style="margin-left:-20px;">
                                @Html.EditorFor(model => model.IngresoDesde, Model != null ? Model.IngresoDesde.FormattedFixed() : string.Empty)
                                @Html.ValidationMessageFor(model => model.IngresoDesde)
                            </div>
                        </div>
                        <div class="row-fluid">

                            <div class="span2" style="margin-left:99px;">
                                @Html.LabelFor(model => model.NroDocumento, new { @class = "control-label" })
                            </div>

                            <div class="span3 sinBorde" style="margin-left:-31px">
                                @Html.TextBoxFor(model => model.NroDocumento, new { @class = "input-large sinMargen" })
                            </div>

                            <div class="span2 FechaDesde" style="margin-left:-50px;">
                                @Html.LabelFor(model => model.IngresoHasta, new { @class = "control-label" })
                            </div>

                            <div class="span3 sinBorde" style="margin-left:-20px;">
                                @Html.EditorFor(model => model.IngresoHasta, Model != null ? Model.IngresoHasta.FormattedFixed() : string.Empty)
                                @Html.ValidationMessageFor(model => model.IngresoHasta)
                            </div>
                        </div>

                        <div class="row-fluid">
                            <div class="span2" style="margin-left:99px;">
                                @Html.LabelFor(model => model.PagoConsumido, new { @class = "control-label" })
                            </div>

                            <div class="span3 sinBorde" style="margin-left:-31px">
                                @Html.CheckBox("PagoConsumido", new { @class = "input-large sinMargen" })
                                @* Si quieres mostrar mensaje de error solo al enviar *@
                                @Html.ValidationMessageFor(model => model.PagoConsumido, "", new { @class = "text-danger", style = "display:none;" })
                            </div>

                            <div class="span2" style="margin-left:-50px;">
                                @Html.LabelFor(model => model.WorkflowCodigo, new { @class = "control-label" })
                            </div>
                            <div class="span3 sinBorde" style="margin-left:-20px">
                                @Html.DropDownListFor(model => model.WorkflowCodigo, workflows, Textos.Default_Workflow, new { @class = "control" })
                                @if (!ViewData.ModelState.IsValid)
                                {
                                    @Html.ValidationMessageFor(model => model.WorkflowCodigo, "")
                                }
                                @Html.Hidden("WorkflowDescripcion", "")
                            </div>

                        </div>
                        <div class="row-fluid">

                            <div class="span12 cajaButtons2" style="margin-left: -108px">
                                <button id="btnBuscar" type="submit" class="btn">@Textos.Buscar</button>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("transmisiones")
    }

    <div id="gridContainer" style="clear:both;" data-grid-url="@Url.Action("Index", "PanelDeControlPagoMunicipal")">
        @Html.Partial("Listar")
    </div>

    <div class="row-fluid">
        <div class="span2">
            <input id="btnTransmitir" type="button" data-url="@Url.Action("Reprocesar")" value="Reprocesar" class="btn acciones" />
        </div>
        
        <div class="span4 acciones">
            <div id="cantidad" class="checkbox"></div> @Textos.PanelDeControlTransSAP_ElementosSeleccionados
        </div>
        
        <div class="span2">
            @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn pull-right acciones" })
        </div>
    </div>
</div>
