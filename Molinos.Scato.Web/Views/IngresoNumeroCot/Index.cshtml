@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Web.Models.IngresoNumeroCotModel

@{
    ViewBag.Title = Textos.ActIngresoNumeroCot;

}

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Script("~/Scripts/ingresoNumeroCot.index.js")" type="text/javascript"></script>
}

<div class="container-fluid">
    <div class="titSecciones">@Textos.ActIngresoNumeroCot</div>
</div>

@using (Html.BeginForm("Index", "IngresoNumeroCot", FormMethod.Post, new { @class = "form-horizontal causaBlock", data_mensaje_espera = Textos.ActIngresoNumeroCot, onsubmit = "return false;" }))
{
    @Html.HiddenFor(m => m.InstanciaWorkflow)
    @Html.HiddenFor(m => m.WorkflowDefinicionId)
    
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
    {
        <div class="alert alert-error">
            @Html.ValidationSummary(true)
        </div>
    }
    <br />
    <div class="control-group">
        @Html.Label(Textos.IngresarNumeroCot_Titulo + ":", new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(model => model.NumeroCot, new { @class = "control input-medium", maxlength = 15 })
            @Html.ValidationMessageFor(model => model.NumeroCot)
        </div>
    </div>
    @Html.ActionLink(Textos.Aceptar, "Aceptar", "IngresoNumeroCot", null, new{@class = "contrato-boton btn btn-primary causaBlock", id="btnAceptar"}) 
    <span>&nbsp;</span>
    @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn btn-primary" })  
}

<div id ="mensajeContrato">
</div>