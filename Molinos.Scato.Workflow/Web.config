      </netMsmqBinding>
      <customBinding>
        <binding name="ZSDWS_SCATO">
          <textMessageEncoding messageVersion="Soap11" />
          <httpTransport authenticationScheme="Basic" />
        </binding>
        <binding name="CustomSoapBinding">
          <security defaultAlgorithmSuite="Default" authenticationMode="UserNameOverTransport" requireDerivedKeys="false" includeTimestamp="false" messageSecurityVersion="WSSecurity10WSTrustFebruary2005WSSecureConversationFebruary2005WSSecurityPolicy11BasicSecurityProfile10" />
          <textMessageEncoding messageVersion="Soap11" />
          <httpsTransport maxReceivedMessageSize="2000000000" />
        </binding>
      </customBinding>
    </bindings>
    <client>
