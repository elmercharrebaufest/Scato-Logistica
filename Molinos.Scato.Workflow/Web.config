    <bindings>
      <basicHttpBinding>
        <binding name="ServiciosScatoBinding" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="20000000" maxBufferSize="20000000" maxReceivedMessageSize="20000000" useDefaultWebProxy="true">
          <security mode="None" />
        </binding>
        <binding name="CommonBinding" openTimeout="00:10:00" closeTimeout="00:02:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="20000000" maxBufferSize="20000000" maxReceivedMessageSize="20000000" useDefaultWebProxy="true">
          <security mode="None" />
        </binding>
      </basicHttpBinding>
      <basicHttpsBinding>
        <binding name="CommonBinding" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="20000000" maxBufferSize="20000000" maxReceivedMessageSize="20000000" useDefaultWebProxy="true">
          <security mode="Transport" />
        </binding>
      </basicHttpsBinding>
      <netMsmqBinding>
