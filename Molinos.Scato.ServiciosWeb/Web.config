      <basicHttpBinding>
        <binding name="LoginCmsSoapBinding">
          <security mode="Transport" />
        </binding>
        <binding name="ServiciosScatoBinding" maxReceivedMessageSize="2147483647">
          <security mode="None" />
          <!--<security mode="TransportCredentialOnly">
            <transport clientCredentialType="Ntlm" />
          </security>-->
        </binding>
        <binding name="ServicioSuscriptorBinding" maxReceivedMessageSize="2147483647">
          <security mode="None">
          </security>
        </binding>
        <binding name="LoginCmsSoapBinding1" />
        <binding name="CommonBinding" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="200000000" maxBufferSize="200000000" maxReceivedMessageSize="200000000" useDefaultWebProxy="true">
          <security mode="None" />
        </binding>
        <binding name="OrquestadorBinding" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="200000000" maxBufferSize="200000000" maxReceivedMessageSize="200000000" useDefaultWebProxy="true">
          <security mode="TransportCredentialOnly">
            <transport clientCredentialType="Ntlm" />
          </security>
        </binding>
        <binding name="CTGServiceBinding" maxReceivedMessageSize="2147483647" sendTimeout="00:02:00">
          <security mode="Transport" />
        </binding>
        <binding name="CTGServiceBinding1" />
        <binding name="GestionarCartasDePortePESoapBinding">
          <security mode="TransportWithMessageCredential" />
        </binding>
        <binding name="GestionarCartasDePortePESoapBinding1" />
        <binding name="calpesSoap" />
      </basicHttpBinding>
      <netMsmqBinding>
        <binding name="QueueBinding" exactlyOnce="true" receiveRetryCount="0" maxRetryCycles="3" retryCycleDelay="00:00:05" receiveErrorHandling="Move">
          <security mode="None" />
        </binding>
        <binding name="PoisonBinding">
          <security mode="None" />
        </binding>
      </netMsmqBinding>
      <customBinding>
        <binding name="ZSDWS_SCATO" sendTimeout="00:05:00" openTimeout="00:05:00" receiveTimeout="00:05:00">
          <textMessageEncoding messageVersion="Soap11" />
          <httpTransport authenticationScheme="Basic" maxBufferPoolSize="200000000" maxBufferSize="200000000" maxReceivedMessageSize="200000000" />
        </binding>
        <binding name="CustomSoapBinding">
          <security defaultAlgorithmSuite="Default" authenticationMode="UserNameOverTransport" requireDerivedKeys="false" includeTimestamp="false" messageSecurityVersion="WSSecurity10WSTrustFebruary2005WSSecureConversationFebruary2005WSSecurityPolicy11BasicSecurityProfile10" />
          <textMessageEncoding messageVersion="Soap11" />
          <httpsTransport maxReceivedMessageSize="2000000000" />
        </binding>
      </customBinding>
    </bindings>
