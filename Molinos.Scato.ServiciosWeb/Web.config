      <endpoint address="http://localhost/Scato.Web/ServicioHub/ServicioNotificarUsuario.svc" binding="basicHttpBinding" bindingConfiguration="CommonBinding" contract="Molinos.Scato.Servicios.IServicioNotificarUsuario" name="ServicioNotificarUsuario" />
      <endpoint address="https://fwshomo.afip.gov.ar/wscpe/services/soap" binding="basicHttpBinding" bindingConfiguration="CTGServiceBinding" contract="AfipCPDigitalService.CpePortType" name="CpeEndPoint" />

