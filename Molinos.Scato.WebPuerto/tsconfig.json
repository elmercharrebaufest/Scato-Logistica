/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@ScatoServicios/*":["app/shared/servicios/*"],
      "@ScatoModels/*":["app/shared/modelos/*"],
      "@ScatoInterfaces/*":["app/shared/interfaces/*"],
      "@ScatoEnums/*":["app/shared/enums/*"]
    },
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "es2015",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom",
      "dom.Iterable"
    ]
  }
}
