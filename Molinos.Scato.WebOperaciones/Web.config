        <add name="wcfProfiling" type="Molinos.Scato.WebOperaciones.Helpers.WcfProfiling.WcfMiniProfilerClientBehavior, Molinos.Scato.WebOperaciones, Version=1.0.0.0, Culture=neutral" />
        <add name="internacionalizacion" type="Molinos.Scato.Servicios.Behavior.InternacionalizacionBehavior, Molinos.Scato.Servicios, Version=1.0.0.0, Culture=neutral" />
